   360	(defvar greger--treesit-indent-rules
   361	  `((greger
   362	     ((node-is "user") column-0 0)
   363	     ((node-is "assistant") column-0 0)
   364	     ((node-is "system") column-0 0)
   365	     ((node-is "thinking") column-0 0)
   366	     ((node-is "tool_use") column-0 0)
   367	     ((node-is "tool_result") column-0 0)
   368	     ((node-is "server_tool_use") column-0 0)
   369	     ((node-is "web_search_tool_result") column-0 0)))
   370	  "Tree-sitter indentation rules for `greger-mode'.")
   371	
