# greger-openrouter.el:

     1	;;; greger-openrouter.el --- OpenRouter client for greger -*- lexical-binding: t -*-
     2	
     3	;; Copyright (C) 2025 Andreas Jansson
     4	
     5	;; Author: Andreas Jansson <andreas@jansson.me.uk>
     6	;; Version: 0.1.0
     7	;; URL: https://github.com/andreasjansson/greger.el
     8	;; SPDX-License-Identifier: MIT
     9	
    10	;;; Commentary:
    11	;; OpenRouter API client for greger - provides access to 400+ models including
    12	;; GPT-5, GPT-5 Codex, and others through OpenRouter's unified API.
    13	
    14	;;; Code:
    15	
    16	(require 'json)
    17	(require 'cl-lib)
    18	
    19	(defconst greger-openrouter-api-url "https://openrouter.ai/api/v1/responses"
    20	  "OpenRouter Responses API endpoint.")
    21	
    22	(cl-defstruct greger-openrouter-state
    23	  accumulated-output
    24	  current-text
    25	  current-reasoning-text
    26	  process
    27	  output-buffer
    28	  undo-handle
    29	  block-start-callback
    30	  text-delta-callback
    31	  block-stop-callback
    32	  complete-callback
    33	  restore-callback
    34	  error-callback
    35	  error-message)
    36	
    37	(cl-defun greger-openrouter-stream (&key model dialog tools server-tools buffer block-start-callback text-delta-callback block-stop-callback complete-callback thinking-budget max-tokens auth-key error-callback)
    38	  "Stream request to OpenRouter API.
    39	MODEL is the OpenRouter model identifier.
    40	DIALOG is the conversation history.
    41	TOOLS are tool definitions.
    42	SERVER-TOOLS are server tool names like web_search.
    43	BUFFER is the output buffer.
    44	BLOCK-START-CALLBACK is called when content blocks begin.
    45	TEXT-DELTA-CALLBACK for incremental text.
    46	BLOCK-STOP-CALLBACK when blocks complete.
    47	COMPLETE-CALLBACK when the entire response finishes.
    48	THINKING-BUDGET is the number of thinking tokens.
    49	MAX-TOKENS is the maximum number of tokens to generate.
    50	AUTH-KEY is the OpenRouter API key.
    51	ERROR-CALLBACK is called when errors occur."
    52	  (let* ((output-buffer (or buffer (current-buffer)))
    53	         (undo-handle (prepare-change-group output-buffer))
    54	         (request-spec (greger-openrouter--build-request model dialog tools server-tools thinking-budget max-tokens auth-key))
    55	         (restore-callback (lambda (state)
    56	                             (let ((buffer (greger-openrouter-state-output-buffer state)))
    57	                               (when (buffer-live-p buffer)
    58	                                 (with-current-buffer buffer
    59	                                   (undo-amalgamate-change-group (greger-openrouter-state-undo-handle state))
    60	                                   (accept-change-group (greger-openrouter-state-undo-handle state)))))))
    61	         (process (greger-openrouter--start-curl-process request-spec))
    62	         (state (make-greger-openrouter-state
    63	                 :accumulated-output ""
    64	                 :current-text ""
    65	                 :process process
    66	                 :block-start-callback block-start-callback
    67	                 :text-delta-callback text-delta-callback
    68	                 :block-stop-callback block-stop-callback
    69	                 :complete-callback complete-callback
    70	                 :restore-callback restore-callback
    71	                 :output-buffer output-buffer
    72	                 :undo-handle undo-handle
    73	                 :error-callback error-callback)))
    74	    
    75	    (activate-change-group undo-handle)
    76	    
    77	    (set-process-filter process
    78	                        (lambda (_proc output)
    79	                          (greger-openrouter--process-output-chunk output state)))
    80	    
    81	    (set-process-sentinel process
    82	                          (lambda (proc _event)
    83	                            (greger-openrouter--handle-completion proc state)))
    84	    
    85	    (set-process-query-on-exit-flag process nil)
    86	    
    87	    state))
    88	
    89	(defun greger-openrouter--build-request (model dialog tools server-tools thinking-budget max-tokens auth-key)
    90	  "Build OpenRouter Responses API request."
    91	  (let* ((headers (greger-openrouter--build-headers auth-key))
    92	         (data (greger-openrouter--build-data model dialog tools server-tools thinking-budget max-tokens)))
    93	    (message "url: %s; request data: %s" greger-openrouter-api-url data)
    94	    (list :url greger-openrouter-api-url
    95	          :method "POST"
    96	          :headers headers
    97	          :data data)))
    98	
    99	(defun greger-openrouter--build-headers (api-key)
   100	  "Build OpenRouter headers - Bearer auth."
   101	  `(("Content-Type" . "application/json")
   102	    ("Authorization" . ,(concat "Bearer " api-key))
   103	    ("HTTP-Referer" . "https://github.com/andreasjansson/greger.el")
   104	    ("X-Title" . "Greger.el")))
   105	
   106	(defun greger-openrouter--build-data (model dialog tools server-tools thinking-budget max-tokens)
   107	  "Build OpenRouter request data in Responses API format.
   108	SERVER-TOOLS is a list of server tool names like (\"web_search\") that will be
   109	converted to OpenAI's Responses API format."
   110	  (let* ((messages (greger-openrouter--convert-dialog-to-messages dialog))
   111	         (request-data `(("model" . ,model)
   112	                         ("max_output_tokens" . ,max-tokens)
   113	                         ("stream" . t))))
   114	    
   115	    (push `("input" . ,messages) request-data)
   116	    
   117	    (when (or tools server-tools)
   118	      (let ((all-tools (greger-openrouter--convert-all-tools tools server-tools)))
   119	        (push `("tools" . ,all-tools) request-data)))
   120	    
   121	    (when (and thinking-budget (> thinking-budget 0))
   122	      (push `("reasoning" . (("effort" . "medium"))) request-data))
   123	    
   124	    (json-encode request-data)))
   125	
   126	(defun greger-openrouter--convert-all-tools (tools server-tools)
   127	  "Convert both user TOOLS and SERVER-TOOLS to Responses API format.
   128	USER tools are converted using the standard OpenAI function format.
   129	SERVER-TOOLS like web_search are converted to OpenAI's server tool format."
   130	  (let ((converted-tools '()))
   131	    
   132	    (when tools
   133	      (setq converted-tools (greger-openrouter--convert-tools tools)))
   134	    
   135	    (when (member "web_search" server-tools)
   136	      (push `((type . "web_search")
   137	              (search_context_size . "medium"))
   138	            converted-tools))
   139	    
   140	    (vconcat (nreverse converted-tools))))
   141	
   142	(defun greger-openrouter--convert-dialog-to-messages (dialog)
   143	  "Convert Greger dialog format to Responses API input format."
   144	  (let (messages
   145	        system-content)
   146	    (dolist (msg dialog)
   147	      (let ((role (alist-get 'role msg))
   148	            (content (alist-get 'content msg)))
   149	        
   150	        (cond
   151	         ((string= role "system")
   152	          (setq system-content content))
   153	         
   154	         ((stringp content)
   155	          (push `((type . "message")
   156	                  (role . ,role)
   157	                  (content . [((type . "input_text")
   158	                               (text . ,content))]))
   159	                messages))
   160	         
   161	         ((listp content)
   162	          (let ((converted (greger-openrouter--convert-content-blocks role content)))
   163	            (when converted
   164	              (setq messages (append converted messages))))))))
   165	    
   166	    (let ((result (nreverse messages)))
   167	      (when system-content
   168	        (setq result (cons `((type . "message")
   169	                             (role . "system")
   170	                             (content . [((type . "input_text")
   171	                                          (text . ,system-content))]))
   172	                           result)))
   173	      result)))
   174	
   175	(defun greger-openrouter--convert-content-blocks (role content-blocks)
   176	  "Convert Greger content blocks to Responses API format."
   177	  (let (result-messages
   178	        current-content-items)
   179	    
   180	    (dolist (block content-blocks)
   181	      (let ((type (alist-get 'type block)))
   182	        (cond
   183	         ((string= type "text")
   184	          (push `((type . "input_text")
   185	                  (text . ,(alist-get 'text block)))
   186	                current-content-items))
   187	         
   188	         ((string= type "thinking")
   189	          (push `((type . "input_text")
   190	                  (text . ,(alist-get 'thinking block)))
   191	                current-content-items))
   192	         
   193	         ((string= type "tool_use")
   194	          (when current-content-items
   195	            (push `((type . "message")
   196	                    (role . ,role)
   197	                    (content . ,(vconcat (nreverse current-content-items))))
   198	                  result-messages)
   199	            (setq current-content-items nil)))
   200	         
   201	         ((string= type "tool_result")
   202	          (push `((type . "message")
   203	                  (role . "user")
   204	                  (content . [((type . "input_text")
   205	                               (text . ,(alist-get 'content block)))]))
   206	                result-messages)))))
   207	    
   208	    (when current-content-items
   209	      (push `((type . "message")
   210	              (role . ,role)
   211	              (content . ,(vconcat (nreverse current-content-items))))
   212	            result-messages))
   213	    
   214	    (nreverse result-messages)))
   215	
   216	(defun greger-openrouter--convert-tools (tools)
   217	  "Convert Anthropic tool format to Responses API format.
   218	The Responses API uses a flat structure with type, name, description, parameters
   219	at the top level (not nested under 'function' like Chat Completions).
   220	Also strips 'default' values and ensures 'required' is always a vector."
   221	  (mapcar
   222	   (lambda (tool)
   223	     (let* ((input-schema (alist-get 'input_schema tool))
   224	            (cleaned-schema (greger-openrouter--remove-defaults-from-schema input-schema))
   225	            (fixed-schema (greger-openrouter--fix-required-field cleaned-schema)))
   226	       `((type . "function")
   227	         (name . ,(alist-get 'name tool))
   228	         (description . ,(alist-get 'description tool))
   229	         (strict . nil)
   230	         (parameters . ,fixed-schema))))
   231	   tools))
   232	
   233	(defun greger-openrouter--fix-required-field (schema)
   234	  "Ensure the 'required' field is always a vector, not nil.
   235	OpenAI expects 'required' to be an array, even if empty."
   236	  (if (not (listp schema))
   237	      schema
   238	    (mapcar
   239	     (lambda (entry)
   240	       (if (and (consp entry) (eq (car entry) 'required))
   241	           ;; Convert nil or empty list to empty vector
   242	           (cons 'required (if (cdr entry)
   243	                               (if (vectorp (cdr entry))
   244	                                   (cdr entry)
   245	                                 (vconcat (cdr entry)))
   246	                             []))
   247	         (if (consp entry)
   248	             (cons (car entry)
   249	                   (greger-openrouter--fix-required-field (cdr entry)))
   250	           entry)))
   251	     schema)))
   252	
   253	(defun greger-openrouter--remove-defaults-from-schema (schema)
   254	  "Remove 'default' keys from SCHEMA recursively.
   255	OpenAI function calling doesn't support default values."
   256	  (cond
   257	   ((not (consp schema)) schema)
   258	   
   259	   ;; Check if this is an alist (list of cons cells)
   260	   ((and (listp schema) (consp (car schema)))
   261	    ;; This is an alist - filter out 'default' keys
   262	    (let ((filtered (seq-filter
   263	                     (lambda (pair)
   264	                       (not (eq (car pair) 'default)))
   265	                     schema)))
   266	      ;; Recursively process values
   267	      (mapcar (lambda (pair)
   268	                (cons (car pair)
   269	                      (greger-openrouter--remove-defaults-from-schema (cdr pair))))
   270	              filtered)))
   271	   
   272	   ;; Regular list - process each element
   273	   ((listp schema)
   274	    (mapcar #'greger-openrouter--remove-defaults-from-schema schema))
   275	   
   276	   ;; Cons cell - process both parts
   277	   ((consp schema)
   278	    (cons (greger-openrouter--remove-defaults-from-schema (car schema))
   279	          (greger-openrouter--remove-defaults-from-schema (cdr schema))))
   280	   
   281	   ;; Atom - return as-is
   282	   (t schema)))
   283	
   284	(defun greger-openrouter--process-output-chunk (output state)
   285	  "Process streaming output chunk."
   286	  (setf (greger-openrouter-state-accumulated-output state)
   287	        (concat (greger-openrouter-state-accumulated-output state) output))
   288	  
   289	  (greger-openrouter--process-events state))
   290	
   291	(defun greger-openrouter--process-events (state)
   292	  "Process OpenAI-style SSE events."
   293	  (let ((accumulated (greger-openrouter-state-accumulated-output state)))
   294	    
   295	    (while (string-match "\n" accumulated)
   296	      (let* ((line-end (match-end 0))
   297	             (line (substring accumulated 0 (1- line-end))))
   298	        
   299	        (when (string-prefix-p "data: " line)
   300	          (let ((data-json (substring line 6)))
   301	            (unless (string= data-json "[DONE]")
   302	              (greger-openrouter--handle-event data-json state))))
   303	        
   304	        (setq accumulated (substring accumulated line-end))))
   305	    
   306	    (setf (greger-openrouter-state-accumulated-output state) accumulated)))
   307	
   308	(defun greger-openrouter--handle-event (data-json state)
   309	  "Handle Responses API streaming event."
   310	
   311	  (message "data-json: %s" data-json)
   312	
   313	  (condition-case err
   314	      (let* ((data (json-read-from-string data-json))
   315	             (error-data (alist-get 'error data))
   316	             (event-type (alist-get 'type data)))
   317	        
   318	        ;; Check for API errors first
   319	        (when error-data
   320	          (let ((error-message (format "OpenRouter API error: %s" 
   321	                                       (or (alist-get 'message error-data)
   322	                                           (json-encode error-data)))))
   323	            (setf (greger-openrouter-state-error-message state) error-message)
   324	            (message "OpenRouter error: %s" error-message)
   325	            (error error-message)))
   326	        
   327	        (let* ((item (alist-get 'item data))
   328	               (content-part (alist-get 'content_part data))
   329	               (delta (alist-get 'delta data))
   330	               (response (alist-get 'response data)))
   331	          
   332	          (cond
   333	           ;; Handle reasoning summary part being added (starts thinking block)
   334	           ((string= event-type "response.reasoning_summary_part.added")
   335	            (when-let ((block-start-callback (greger-openrouter-state-block-start-callback state)))
   336	              (funcall block-start-callback
   337	                       `((type . "thinking")
   338	                         (thinking . "")
   339	                         (signature . "")))))
   340	           
   341	           ;; Handle reasoning summary text updates
   342	           ((string= event-type "response.reasoning_summary_text.delta")
   343	            (when-let ((text (alist-get 'delta data)))
   344	              (setf (greger-openrouter-state-current-reasoning-text state)
   345	                    (concat (or (greger-openrouter-state-current-reasoning-text state) "") text))
   346	              (when-let ((text-delta-callback (greger-openrouter-state-text-delta-callback state)))
   347	                (funcall text-delta-callback text))))
   348	           
   349	           ;; Handle content part being added (starts the text block)
   350	           ((string= event-type "response.content_part.added")
   351	            (when-let* ((part (alist-get 'part data))
   352	                        ((string= (alist-get 'type part) "output_text")))
   353	              (when-let ((block-start-callback (greger-openrouter-state-block-start-callback state)))
   354	                (funcall block-start-callback
   355	                         `((type . "text")
   356	                           (text . ""))))))
   357	           
   358	           ;; Handle incremental text updates
   359	           ((string= event-type "response.output_text.delta")
   360	            (when-let ((text (alist-get 'delta data)))
   361	              (let ((text-delta-callback (greger-openrouter-state-text-delta-callback state)))
   362	                (setf (greger-openrouter-state-current-text state)
   363	                      (concat (greger-openrouter-state-current-text state) text))
   364	                (when text-delta-callback
   365	                  (funcall text-delta-callback text)))))
   366	           
   367	           ;; Handle output item done (end of a content block)
   368	           ;; Don't call block-stop here - let complete-callback handle all blocks at once
   369	           ((string= event-type "response.output_item.done")
   370	            nil)
   371	           
   372	           ;; Handle completion - streaming already handled everything
   373	           ((string= event-type "response.completed")
   374	            nil))))
   375	    (error
   376	     (let ((error-message (format "Failed to parse event: %s" (error-message-string err))))
   377	       (setf (greger-openrouter-state-error-message state) error-message)
   378	       (message "OpenRouter parse error: %s" error-message)))))
   379	
   380	
   381	
   382	(defun greger-openrouter--handle-finish (state _finish-reason)
   383	  "Handle completion based on finish reason."
   384	  (let ((content-blocks (greger-openrouter--build-content-blocks state))
   385	        (block-stop-callback (greger-openrouter-state-block-stop-callback state)))
   386	    
   387	    (when block-stop-callback
   388	      (dolist (block content-blocks)
   389	        (let ((type (alist-get 'type block)))
   390	          (funcall block-stop-callback type block))))
   391	    
   392	    (when-let ((callback (greger-openrouter-state-complete-callback state)))
   393	      (funcall callback content-blocks))))
   394	
   395	(defun greger-openrouter--build-content-blocks (state)
   396	  "Build Anthropic-style content blocks from accumulated state.
   397	Note: We don't include citations from web search because the text already
   398	contains inline markdown links to sources."
   399	  (let ((reasoning-text (greger-openrouter-state-current-reasoning-text state))
   400	        (current-text (greger-openrouter-state-current-text state))
   401	        blocks)
   402	    
   403	    (when reasoning-text
   404	      (push `((type . "thinking")
   405	              (thinking . ,reasoning-text)
   406	              (signature . ""))
   407	            blocks))
   408	    
   409	    (when current-text
   410	      (push `((type . "text")
   411	              (text . ,current-text))
   412	            blocks))
   413	    
   414	    (nreverse blocks)))
   415	
   416	
   417	
   418	(defun greger-openrouter--convert-citations-to-annotations (citations)
   419	  "Convert Greger citation list back to OpenRouter annotations format."
   420	  (vconcat
   421	   (mapcar
   422	    (lambda (citation)
   423	      (let ((url (alist-get 'url citation))
   424	            (title (alist-get 'title citation))
   425	            (cited-text (alist-get 'cited_text citation)))
   426	        `((type . "url_citation")
   427	          (url_citation . ((url . ,url)
   428	                           (title . ,title)
   429	                           (content . ,cited-text)
   430	                           (start_index . 0)
   431	                           (end_index . 0))))))
   432	    citations)))
   433	
   434	(defun greger-openrouter--convert-annotations-to-citations (annotations)
   435	  "Convert OpenRouter annotations from web search to Greger citations format."
   436	  (when (vectorp annotations)
   437	    (let (citations)
   438	      (seq-doseq (annotation annotations)
   439	        (when (string= (alist-get 'type annotation) "url_citation")
   440	          (let ((url (alist-get 'url annotation))
   441	                (start-idx (alist-get 'start_index annotation))
   442	                (end-idx (alist-get 'end_index annotation)))
   443	            (push `((type . "web_search_result_location")
   444	                    (url . ,url)
   445	                    (title . "")
   446	                    (cited_text . ,(format "chars %d-%d" start-idx end-idx))
   447	                    (encrypted_index . ""))
   448	                  citations))))
   449	      (nreverse citations))))
   450	
   451	(defun greger-openrouter--handle-completion (proc state)
   452	  "Handle process completion."
   453	  (when (memq (process-status proc) '(exit signal))
   454	    (funcall (greger-openrouter-state-restore-callback state) state)
   455	    
   456	    (let ((exit-code (process-exit-status proc))
   457	          (stored-error (greger-openrouter-state-error-message state)))
   458	      (cond
   459	       ((and (= exit-code 0) (not stored-error))
   460	        ;; Just call complete callback - streaming already rendered everything
   461	        (when-let ((callback (greger-openrouter-state-complete-callback state)))
   462	          (funcall callback (greger-openrouter--build-content-blocks state))))
   463	       
   464	       ((= exit-code 2)
   465	        (message "Process interrupted"))
   466	       
   467	       (t
   468	        (let ((error-message (or stored-error
   469	                                 (format "Process exited with status code %d" exit-code))))
   470	          (when-let ((callback (greger-openrouter-state-error-callback state)))
   471	            (funcall callback error-message))))))))
   472	
   473	(defun greger-openrouter--start-curl-process (request-spec)
   474	  "Start curl process for OpenRouter."
   475	  (start-process-shell-command
   476	   "greger-openrouter-curl" nil
   477	   (greger-openrouter--build-curl-command request-spec)))
   478	
   479	(defun greger-openrouter--build-curl-command (request-spec)
   480	  "Build curl command for OpenRouter."
   481	  (let ((url (plist-get request-spec :url))
   482	        (method (plist-get request-spec :method))
   483	        (headers (plist-get request-spec :headers))
   484	        (data (plist-get request-spec :data)))
   485	    (format "curl -s -X %s %s %s %s"
   486	            method
   487	            (mapconcat (lambda (header)
   488	                         (format "-H \"%s: %s\"" (car header) (cdr header)))
   489	                       headers " ")
   490	            (if data
   491	                (format "--data-raw %s" (shell-quote-argument data))
   492	              "")
   493	            url)))
   494	
   495	(defun greger-openrouter--cancel-request (state)
   496	  "Cancel streaming request."
   497	  (let ((process (greger-openrouter-state-process state)))
   498	    (when (process-live-p process)
   499	      (message "Interrupting generation")
   500	      (interrupt-process process)
   501	      (sit-for 0.1)
   502	      (delete-process process))
   503	    (funcall (greger-openrouter-state-restore-callback state) state)))
   504	
   505	(provide 'greger-openrouter)
   506	
   507	;;; greger-openrouter.el ends here

---------



# greger-parser.el:

     1	;;; greger-parser.el --- Parser for greger dialog format -*- lexical-binding: t -*-
     2	
     3	;; Copyright (C) 2025 Andreas Jansson
     4	
