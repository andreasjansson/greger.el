   681	(defun greger-debug-request ()
   682	  "Debug the request data by parsing the buffer and saving the request data output.
   683	After saving, opens the JSON file in a new buffer for inspection."
   684	  (interactive)
   685	  (let* ((filename (read-string "Save to filename (default: request.json): " nil nil "request.json"))
   686	         (dialog (greger-parser-markdown-buffer-to-dialog (current-buffer)))
   687	         (tools (when greger-tools
   688	                  (greger-tools-get-schemas greger-tools)))
   689	         (server-tools (when greger-server-tools
   690	                         (greger-server-tools-get-schemas greger-server-tools)))
   691	         (model greger-model)
   692	         (request-data (greger-client--build-data model dialog tools server-tools greger-current-thinking-budget greger-max-tokens))
   693	         (parsed-json (json-read-from-string request-data)))
   694	
   695	    (with-temp-file filename
   696	      (let ((json-encoding-pretty-print t))
   697	        (insert (json-encode parsed-json))))
   698	    (message "Request data saved to %s" filename)
   699	    ;; Open the file in a new buffer for inspection
   700	    (find-file filename)))
   701	
   702	(defun greger-buffer (&optional no-tools)
   703	  "Send buffer content to AI as an agent dialog with tool support.
   704	When NO-TOOLS is set, disable tools and thinking."
   705	  (interactive "P")
   706	  (greger--ensure-buffer-can-be-submitted)
   707	
   708	  (let ((greger-tools (if no-tools '() greger-tools))
   709	        (greger-server-tools (if no-tools '() greger-server-tools))
   710	        (greger-current-thinking-budget (if no-tools 0 greger-current-thinking-budget)))
   711	    (greger--process-evals)
   712	    
   713	    (greger--run-agent-loop (make-greger-state
   714	                             :current-iteration 0
   715	                             :chat-buffer (current-buffer)
   716	                             :directory default-directory
   717	                             :tool-use-metadata `(:safe-shell-commands () :allow-all-shell-commands ,greger-allow-all-shell-commands)))))
   718	
   719	(defun greger-buffer-no-tools ()
   720	  "Send the buffer content to AI as a dialog without tool use or thinking."
   721	  (interactive)
   722	  (greger-buffer t))
   723	
   724	(defmacro greger--maybe-save-excursion (&rest body)
   725	  "Execute BODY, optionally preserving point position.
   726	If `greger-follow-mode' is enabled, point follows output
   727	at the end of the buffer.
   728	If `greger-follow-mode' is disabled, use `save-excursion'
   729	to preserve point position."
   730	  `(if greger-follow-mode
   731	       (progn ,@body)
   732	     (save-excursion ,@body)))
   733	
   734	(defun greger--live-chat-buffer (state)
   735	  "Return the chat buffer from STATE if it's still live."
   736	  (let ((buffer (greger-state-chat-buffer state)))
   737	    (when (buffer-live-p buffer)
   738	      buffer)))
   739	
   740	(defun greger--get-current-status ()
   741	  "Get the current greger status: \='idle, \='generating, or \='executing."
   742	  (let ((state (buffer-local-value 'greger--current-state (current-buffer))))
   743	    (cond
   744	     ;; Check if we're executing tools
   745	     ((and state
   746	           (greger-state-executing-tools state)
   747	           (> (hash-table-count (greger-state-executing-tools state)) 0))
   748	      'executing)
   749	     ;; Check if we're generating (client-state is active)
   750	     ((and state (greger-state-client-state state))
   751	      'generating)
   752	     ;; Otherwise we're idle
   753	     (t 'idle))))
   754	
   755	(defun greger--mode-line-info ()
   756	  "Generate mode line information showing model and current state."
   757	  (let ((status (greger--get-current-status))
   758	        (model-name (symbol-name greger-model)))
   759	    (concat model-name
   760	            (if (> greger-current-thinking-budget 0)
   761	                (format " [T:%d]" greger-current-thinking-budget)
   762	              "")
   763	            (pcase status
   764	              ('generating " [Generating]")
   765	              ('executing " [Executing]")
   766	              ('idle "")))))
   767	
   768	(defun greger--set-buffer-read-only (read-only)
   769	  "Set buffer read-only state for greger operations.
   770	READ-ONLY is t to make read-only, nil to make writable."
   771	  (if read-only
   772	      (unless greger--buffer-read-only-by-greger
   773	        (setq greger--buffer-read-only-by-greger t)
   774	        (setq buffer-read-only t))
   775	    (when greger--buffer-read-only-by-greger
   776	      (setq greger--buffer-read-only-by-greger nil)
   777	      (setq buffer-read-only nil))))
   778	
   779	(defun greger--update-buffer-state ()
   780	  "Update buffer read-only state based on current greger state."
   781	  (let ((status (greger--get-current-status)))
   782	    (greger--set-buffer-read-only (not (eq status 'idle)))
   783	    ;; Force mode line update
   784	    (force-mode-line-update)))
   785	
   786	(defun greger--ensure-buffer-can-be-submitted ()
   787	  "Ensure buffer can be submitted by fixing common issues with last message.
   788	Uses tree-sitter to find the last node and applies heuristics:
   789	- If last assistant text is empty or whitespace-only, insert '.'
   790	- If last assistant text ends with whitespace, trim it
   791	- If last message is thinking, insert '# ASSISTANT\\n\\n.' before submitting"
   792	  (let* ((root-node (treesit-buffer-root-node))
   793	         (last-node (greger--find-last-message-node root-node)))
   794	
   795	    (when last-node
   796	      (let ((node-type (treesit-node-type last-node)))
   797	        (cond
   798	         ((string= node-type "user")
   799	          (greger--insert-if-empty-content last-node "Continue"))
   800	
   801	         ((string= node-type "assistant")
   802	          (greger--insert-if-empty-content last-node "."))
   803	
   804	         ((string= node-type "thinking")
   805	          (greger--insert-assistant-after-thinking last-node)))))))
   806	
   807	(defun greger--find-last-message-node (root-node)
   808	  "Find the last message node in ROOT-NODE."
   809	  (let ((children (treesit-node-children root-node))
   810	        (last-message-node nil))
   811	    (dolist (child children)
   812	      (let ((node-type (treesit-node-type child)))
   813	        (when (member node-type '("assistant" "thinking" "user" "system"
   814	                                  "tool_use" "server_tool_use" "tool_result"
   815	                                  "web_search_tool_result" "untagged_text"))
   816	          (setq last-message-node child))))
   817	    last-message-node))
   818	
   819	(defun greger--insert-if-empty-content (node text)
   820	  "Add TEXT to NODE content if content is empty."
   821	  (let* ((header (treesit-node-child node 0 t))
   822	         (start-pos (treesit-node-end header))
   823	         (end-pos (treesit-node-end node))
   824	         (content (buffer-substring-no-properties start-pos end-pos)))
   825	
   826	    ;; Insert a dot if content is empty
   827	    (when (string= (string-trim content) "")
   828	      (greger--maybe-save-excursion
   829	       (goto-char end-pos)
   830	       (insert text)))))
   831	
   832	(defun greger--insert-assistant-after-thinking (thinking-node)
   833	  "Insert assistant response after THINKING-NODE."
   834	  (let ((end-pos (treesit-node-end thinking-node)))
   835	    (greger--maybe-save-excursion
   836	     (goto-char end-pos)
   837	     (insert "\n\n# ASSISTANT\n\n."))))
   838	
   839	(defun greger--run-agent-loop (state)
   840	  "Run the main agent loop with STATE.
   841	Dispatches to provider-specific implementation based on greger-provider."
   842	  (if (eq greger-provider 'openrouter)
   843	      (greger-openrouter--run-agent-loop state)
   844	    (greger--run-agent-loop-claude state)))
   845	
   846	(defun greger-openrouter--run-agent-loop (state)
   847	  "Run agent loop using OpenRouter - parallel to greger--run-agent-loop-claude."
   848	  (let* ((tools (greger-tools-get-schemas greger-tools))
   849	         (server-tools greger-server-tools)
   850	         (chat-buffer (greger-state-chat-buffer state))
   851	         (dialog (greger-parser-markdown-buffer-to-dialog chat-buffer))
   852	         (safe-shell-commands (greger-parser-find-safe-shell-commands-in-buffer chat-buffer))
   853	         (tool-use-metadata (greger-state-tool-use-metadata state))
   854	         (current-iteration (greger-state-current-iteration state))
   855	         (auth-key (or (and greger-openrouter-api-key-fn 
   856	                            (funcall greger-openrouter-api-key-fn))
   857	                       (getenv "OPENROUTER_API_KEY"))))
   858	    
   859	    (setf (plist-get tool-use-metadata :safe-shell-commands) safe-shell-commands)
   860	    
   861	    (when (>= current-iteration greger-max-iterations)
   862	      (error "Maximum iterations (%d) reached" greger-max-iterations))
   863	    
   864	    (unless auth-key
   865	      (error "No OpenRouter API key found. Set OPENROUTER_API_KEY environment variable or configure greger-openrouter-api-key-fn"))
   866	    
   867	    (with-current-buffer chat-buffer
   868	      (let ((client-state (greger-openrouter-stream
   869	                           :model greger-openrouter-model
   870	                           :dialog dialog
   871	                           :tools tools
   872	                           :server-tools server-tools
   873	                           :buffer chat-buffer
   874	                           :thinking-budget greger-current-thinking-budget
   875	                           :auth-key auth-key
   876	                           :block-start-callback (lambda (content-block)
   877	                                                   (greger--append-streaming-content-header state content-block))
   878	                           :text-delta-callback (lambda (text)
   879	                                                  (greger--append-text state (greger--clean-excessive-newlines text)))
   880	                           :block-stop-callback (lambda (type content-block)
   881	                                                  (greger--append-handle-content-block-stop state type content-block))
   882	                           :complete-callback (lambda (content-blocks) 
   883	                                                (greger--handle-stream-completion state content-blocks))
   884	                           :error-callback (lambda (error-message)
   885	                                             (greger--handle-client-error state error-message))
   886	                           :max-tokens greger-max-tokens)))
   887	        
   888	        (setf (greger-state-client-state state) client-state)
   889	        (setq greger--current-state state)
   890	        (greger--update-buffer-state)))))
   891	
   892	(defun greger--run-agent-loop-claude (state)
   893	  "Run the main agent loop with STATE using Claude/Anthropic.
   894	This is the original implementation, unchanged."
   895	  (let* ((tools (greger-tools-get-schemas greger-tools))
   896	         (server-tools (when greger-server-tools
   897	                         (greger-server-tools-get-schemas greger-server-tools)))
   898	         (chat-buffer (greger-state-chat-buffer state))
   899	         (dialog (greger-parser-markdown-buffer-to-dialog chat-buffer))
   900	         (safe-shell-commands (greger-parser-find-safe-shell-commands-in-buffer chat-buffer))
   901	         (tool-use-metadata (greger-state-tool-use-metadata state))
   902	         (current-iteration (greger-state-current-iteration state))
   903	         (auth-key (or (and greger-anthropic-key-fn (funcall greger-anthropic-key-fn))
   904	                       (getenv "ANTHROPIC_API_KEY"))))
   905	
   906	    (setf (plist-get tool-use-metadata :safe-shell-commands) safe-shell-commands)
   907	
   908	    (when (>= current-iteration greger-max-iterations)
   909	      (error "Maximum iterations (%d) reached, stopping agent execution" greger-max-iterations))
   910	
   911	    (unless auth-key
   912	      (error "No API key found.  Set ANTHROPIC_API_KEY environment variable or configure greger-anthropic-key-fn"))
   913	
   914	
   915	    (with-current-buffer chat-buffer
   916	      (let ((client-state (greger-client-stream
   917	                           :model greger-model
   918	                           :dialog dialog
   919	                           :tools tools
   920	                           :server-tools server-tools
   921	                           :buffer chat-buffer
   922	                           :thinking-budget greger-current-thinking-budget
   923	                           :auth-key auth-key
   924	                           :block-start-callback (lambda (content-block)
   925	                                                   (greger--append-streaming-content-header state content-block))
   926	                           :text-delta-callback (lambda (text)
   927	                                                  (greger--append-text state (greger--clean-excessive-newlines text)))
   928	                           :block-stop-callback (lambda (type content-block)
   929	                                                  (greger--append-handle-content-block-stop state type content-block))
   930	                           :complete-callback (lambda (content-blocks) (greger--handle-stream-completion state content-blocks))
   931	                           :error-callback (lambda (error-message)
   932	                                             (greger--handle-client-error state error-message))
   933	                           :max-tokens greger-max-tokens)))
   934	
   935	        ;; Store the client state for potential cancellation
   936	        (setf (greger-state-client-state state) client-state)
   937	        ;; Set buffer-local variable for greger-interrupt to access
   938	        (setq greger--current-state state) ;; TODO: why do we set that _here_? Or should it be greger--current-client-state instead?
   939	        (greger--update-buffer-state)))))
   940	
   941	(defun greger--clean-excessive-newlines (text)
   942	  "Remove excessive newlines from the end of TEXT, keeping at most two.
   943	If TEXT ends with more than two consecutive newlines, remove all but the
   944	first two."
   945	  (replace-regexp-in-string "\n\n\n+\\'" "\n\n" text))
   946	
   947	(defun greger--force-code-close (state)
   948	  (with-current-buffer (greger-state-chat-buffer state)
   949	    (let ((end-is-code nil)
   950	          (inhibit-read-only t))
   951	     (save-excursion
   952	       (goto-char (point-max))
   953	       (insert "\n")
   954	       (when (string= (treesit-node-type (treesit-node-at (1- (point-max)))) "code_content")
   955	         (setq end-is-code t))
   956	       (delete-char -1))
   957	     (when end-is-code
   958	       (insert "<$code-close/>")))))
   959	
   960	(defun greger--append-streaming-content-header (state content-block)
   961	  "Append appropriate header for streaming CONTENT-BLOCK to STATE."
   962	
   963	  (greger--force-code-close state)
   964	
   965	  (let ((type (alist-get 'type content-block))
   966	        (has-citations (assq 'citations content-block)))
   967	    (cond
   968	     ((and (string= type "text") (not has-citations))
   969	      (greger--append-text state (concat "\n\n" greger-parser-assistant-tag "\n\n")))
   970	     ((string= type "thinking")
   971	      (greger--append-text state (concat "\n\n" greger-parser-thinking-tag "\n\n")))
   972	     (t nil))))
   973	
   974	(defun greger--handle-stream-completion (state content-blocks)
   975	  "Handle completion of stream with STATE and CONTENT-BLOCKS."
   976	  (if-let ((tool-calls (greger--extract-tool-calls content-blocks)))
   977	      (progn
   978	        (setf (greger-state-current-iteration state)
   979	              (1+ (greger-state-current-iteration state)))
   980	        ;; TODO: execute tool calls in greger--append-content-block instead
   981	        (greger--execute-tools tool-calls state))
   982	    (greger--finish-response state))
   983	
   984	  (when-let ((buffer (greger--live-chat-buffer state)))
   985	    (with-current-buffer buffer
   986	      (greger--update-buffer-state))))
   987	
   988	(defun greger--content-block-supports-streaming (content-block)
   989	  "Check if CONTENT-BLOCK can be streamed incrementally.
   990	Returns non-nil for text and thinking blocks without citations, which can
   991	be displayed as they arrive rather than waiting for completion."
   992	  (let ((type (alist-get 'type content-block))
   993	        (citations (alist-get 'citations content-block)))
   994	    (and (or (string= type "text") (string= type "thinking"))
   995	         (not citations))))
   996	
   997	(defun greger--append-handle-content-block-stop (state type content-block)
   998	  "Append non-streaming CONTENT-BLOCK of TYPE to STATE."
   999	  ;; Only append markdown if it hasn't done that already during streaming
  1000	  (unless (greger--content-block-supports-streaming content-block)
  1001	    (let ((markdown (greger-parser--block-to-markdown content-block)))
  1002	      (greger--append-text state (concat "\n\n" markdown))))
  1003	
  1004	  ;; Special cases for tool use and thinking
  1005	  (cond
  1006	   ((string= type "tool_use")
  1007	    (let ((tool-id (alist-get 'id content-block)))
  1008	      (greger--append-text state (concat "\n\n" (greger--tool-result-placeholder tool-id)))))
  1009	   ((string= type "thinking")
  1010	    (let ((signature (alist-get 'signature content-block)))
  1011	      (greger--insert-thinking-signature state signature))))
  1012	
  1013	  ;; Update buffer state after client completes
  1014	  (when-let ((buffer (greger--live-chat-buffer state)))
  1015	    (with-current-buffer buffer
  1016	      (greger--update-buffer-state))))
  1017	
  1018	(defun greger--insert-thinking-signature (state signature)
  1019	  "Insert thinking SIGNATURE after the last thinking tag, using STATE.
  1020	Assumes the last inserted thing is a thinking tag."
  1021	  (with-current-buffer (greger-state-chat-buffer state)
  1022	    (save-excursion
  1023	      (goto-char (point-max))
  1024	      (re-search-backward "^# THINKING")
  1025	      (forward-line 1)
  1026	      (let ((inhibit-read-only t))
  1027	        (insert "\n"
  1028	                "Signature: " signature
  1029	                "\n")))))
  1030	
  1031	(defun greger--extract-tool-calls (content-blocks)
  1032	  "Extract tool call from CONTENT-BLOCKS."
  1033	  (let ((tool-calls '()))
  1034	    (dolist (block content-blocks)
  1035	      (when (string= (alist-get 'type block) "tool_use")
  1036	        (push block tool-calls)))
  1037	    (reverse tool-calls)))
  1038	
  1039	(defun greger--tool-result-placeholder (tool-id)
  1040	  "Generate placeholder string for TOOL-ID."
  1041	  ;; It's ugly that we need to insert the trailing \n
  1042	  ;; But we need it because otherwise the closing tool tag is not recognized.
  1043	  ;; TODO: update greger-grammar
  1044	  (let ((placeholder (concat (greger-parser--wrapped-tool-content greger-parser-tool-result-tag tool-id "") "\n")))
  1045	    ;; Add a text property to the first character to indicate this is a generating tool result
  1046	    (put-text-property 0 1 'greger-tool-result-generating t placeholder)
  1047	    placeholder))
  1048	
  1049	(defun greger--execute-tools (tool-calls state)
  1050	  "Execute TOOL-CALLS using STATE in parallel with callbacks."
  1051	  (let* ((total-tools (length tool-calls))
  1052	         (completed-tools 0)
  1053	         (executing-tools-map (make-hash-table :test 'equal)))
  1054	
  1055	    ;; Initialize executing-tools in state if not already set
  1056	    (unless (greger-state-executing-tools state)
  1057	      (setf (greger-state-executing-tools state) executing-tools-map))
  1058	
  1059	    ;; Update buffer state to show we're executing tools
  1060	    (when-let ((buffer (greger--live-chat-buffer state)))
  1061	      (with-current-buffer buffer
  1062	        (greger--update-buffer-state)
  1063	
  1064	        (greger--maybe-save-excursion
  1065	         (goto-char (point-max)))))
  1066	
  1067	    ;; Execute all tools in parallel
  1068	    (dolist (tool-call tool-calls)
  1069	      (let* ((tool-name (alist-get 'name tool-call))
  1070	             (tool-input (alist-get 'input tool-call))
  1071	             (tool-id (alist-get 'id tool-call))
  1072	             (default-directory (greger-state-directory state))
  1073	
  1074	             ;; TODO: This is ugly, we really should be separating the creation and execution of tools
  1075	             ;; We're only doing this because for synchronous tools we can't set the tool in the
  1076	             ;; hashmap after execution, because sync tools have already removed the key then.
  1077	             (placeholder-tool (make-greger-tool :cancel-fn nil)))
  1078	
  1079	        (puthash tool-id placeholder-tool (greger-state-executing-tools state))
  1080	
  1081	        (greger--update-buffer-state)
  1082	        (sit-for 0.001) ;; update the buffer state
  1083	
  1084	        (let ((greger-tool (greger-tools-execute
  1085	                            :tool-name tool-name
  1086	                            :args tool-input
  1087	                            :callback (lambda (result error)
  1088	                                        ;; Remove tool from executing-tools when complete
  1089	                                        (remhash tool-id (greger-state-executing-tools state))
  1090	
  1091	                                        (greger--handle-tool-completion
  1092	                                         :tool-id tool-id
  1093	                                         :result result
  1094	                                         :error error
  1095	                                         :state state
  1096	                                         :completion-callback (lambda ()
  1097	                                                                ;; TODO: add completed-tools to state instead of this nested callback
  1098	                                                                (setq completed-tools (1+ completed-tools))
  1099	                                                                (when (and (= completed-tools total-tools)
  1100	                                                                           (greger-state-chat-buffer state))
  1101	                                                                  (greger--run-agent-loop state)))))
  1102	                            :streaming-callback (lambda (text)
  1103	                                                  (greger--append-tool-result-text state tool-id text))
  1104	                            :buffer (greger-state-chat-buffer state)
  1105	                            :metadata (greger-state-tool-use-metadata state))))
  1106	
  1107	          ;; TODO: here again, it's ugly
  1108	          (when (greger-tool-cancel-fn greger-tool)
  1109	            (puthash tool-id greger-tool (greger-state-executing-tools state))))))))
  1110	
  1111	(defun greger--append-text (state text)
  1112	  "Append TEXT to the chat buffer in STATE."
  1113	  (let ((buffer (greger-state-chat-buffer state)))
  1114	    (with-current-buffer buffer
  1115	      (let ((inhibit-read-only t))
  1116	        (greger--maybe-save-excursion
  1117	         (goto-char (point-max))
  1118	         (insert text))))))
  1119	
  1120	(cl-defun greger--handle-tool-completion (&key tool-id result error state completion-callback)
  1121	  "Handle completion of a tool execution.
  1122	Updates buffer and calls callback when tool execution finishes.
  1123	TOOL-ID is the tool identifier.
  1124	RESULT is the tool execution result.
  1125	ERROR is any error that occurred.
  1126	STATE contains the current agent state.
  1127	COMPLETION-CALLBACK is called when complete."
  1128	  (let ((tool-result-text (if error
  1129	                              (if (listp error)
  1130	                                  (error-message-string error)
  1131	                                error)
  1132	                            result)))
  1133	
  1134	    (greger--append-tool-result-text state tool-id tool-result-text t)
  1135	
  1136	    ;; Call completion callback
  1137	    (funcall completion-callback)))
  1138	
  1139	(defun greger--append-tool-result-text (state tool-id text &optional is-completed)
  1140	  "Append TEXT to the tool result content node for TOOL-ID in STATE's buffer.
  1141	When IS-COMPLETED is non-nil, also trim trailing newline after the tool's
  1142	end tag and update the buffer state."
  1143	  (when-let ((buffer (greger--live-chat-buffer state)))
  1144	    (with-current-buffer buffer
  1145	      (when-let ((inhibit-read-only t)
  1146	                 (tool-result-content-node (greger--find-tool-result-content-node tool-id))
  1147	                 (tool-result-content-start (treesit-node-start tool-result-content-node))
  1148	                 (tool-result-content-end (treesit-node-end tool-result-content-node)))
  1149	        (greger--maybe-save-excursion
  1150	         ;; Check if this is a vterm full replacement
  1151	         (if (string-prefix-p "VTERM_FULL_REPLACE:" text)
  1152	             ;; Replace entire tool result content with vterm buffer content
  1153	             (let ((vterm-content (substring text (length "VTERM_FULL_REPLACE:"))))
  1154	               (delete-region tool-result-content-start (1- tool-result-content-end))
  1155	               (goto-char tool-result-content-start)
  1156	               (insert vterm-content))
  1157	           ;; Regular streaming - append text directly (no terminal sequence processing)
  1158	           (progn
  1159	             (goto-char (1- tool-result-content-end))
  1160	             (insert text)))
  1161	
  1162	         (when is-completed
  1163	           ;; Trim trailing newline after closing tag
  1164	           (when-let* ((tool-result-content-node (greger--find-tool-result-content-node tool-id)) ;; content node might have gotten outdated, so need to get it again
  1165	                       (tool-end-tag (treesit-node-next-sibling tool-result-content-node t)))
  1166	             (when (string= (treesit-node-type tool-end-tag) "tool_end_tag")
  1167	               (goto-char (treesit-node-end tool-end-tag))
  1168	               (when (looking-at-p "\n")
  1169	                 (delete-char 1))))
  1170	
  1171	           ;; Remove the generating property from the tool result
  1172	           (when-let ((tool-result-node (greger--find-tool-result-node tool-id)))
  1173	             (let ((start (treesit-node-start tool-result-node))
  1174	                   (end (treesit-node-end tool-result-node)))
  1175	               (remove-text-properties start end '(greger-tool-result-generating))))
  1176	
  1177	           ;; Update buffer state after tool completion
  1178	           (greger--update-buffer-state)))))))
  1179	
  1180	(defun greger--find-tool-result-content-node (tool-id)
  1181	  "Find the tool_content node for the tool_result with TOOL-ID.
  1182	Uses treesit to query for a tool_result with matching id and returns
  1183	the tool_content node within its content section."
  1184	  (when-let* ((query `((tool_result (id (value) @id) (:match ,tool-id @id)
  1185	                                    (content) @content)))
  1186	              (capture (treesit-query-capture (treesit-buffer-root-node) query))
  1187	              (content-node (alist-get 'content capture))
  1188	              ;; for some reason, querying directly for tool_content fails, but this works
  1189	              (content-node-first-child (car (treesit-node-children content-node))))
  1190	    (treesit-search-subtree content-node-first-child "tool_content")))
  1191	
  1192	(defun greger--find-tool-result-node (tool-id)
  1193	  "Find the tool_result node with TOOL-ID.
  1194	Uses treesit to query for a tool_result with matching id and returns
  1195	the tool_result node itself."
  1196	  (let* ((query `((tool_result (id (value) @id) (:match ,tool-id @id)) @tool-result))
  1197	         (capture (treesit-query-capture (treesit-buffer-root-node) query)))
  1198	    (alist-get 'tool-result capture)))
  1199	
  1200	(defun greger--handle-client-error (state error-message)
  1201	  "Handle client error with STATE and ERROR-MESSAGE."
  1202	  ;; This will be called from the main thread via the completion handler
  1203	  (when-let ((buffer (greger--live-chat-buffer state)))
  1204	    (with-current-buffer buffer
  1205	      ;; Clear the buffer-local agent state
  1206	      (setq greger--current-state nil)
  1207	      ;; Update buffer state to idle
  1208	      (greger--update-buffer-state)))
  1209	  ;; Reset the state
  1210	  (setf (greger-state-current-iteration state) 0)
  1211	  (setf (greger-state-client-state state) nil)
  1212	  ;; Raise the error in the main thread where it can be caught by tests
  1213	  (warn "%s" error-message))
  1214	
  1215	(defun greger--finish-response (state)
  1216	  "Finish the agent response using STATE."
  1217	  (when-let ((buffer (greger--live-chat-buffer state)))
  1218	    (with-current-buffer buffer
  1219	      (let ((inhibit-read-only t))
  1220	        (greger--maybe-save-excursion
  1221	         (goto-char (point-max))
  1222	         (unless (looking-back (concat greger-parser-user-tag "\n\n") nil)
  1223	           (greger--force-code-close state)
  1224	           (insert "\n\n" greger-parser-user-tag "\n\n"))))
  1225	      ;; Clear the buffer-local agent state
  1226	      (setq greger--current-state nil)
  1227	      ;; Update buffer state to idle
  1228	      (greger--update-buffer-state)))
  1229	  ;; Reset the state
  1230	  (setf (greger-state-current-iteration state) 0)
  1231	  (setf (greger-state-client-state state) nil))
  1232	
  1233	;; Eval functionality
  1234	
  1235	(defun greger--eval-code (language code)
