# ASSISTANT

Looking at the actual code, here's what the agent loop really does:

```elisp
(def-agent (dialog model tools server-tools buffer)
  (set iteration 0)
  (set max-iterations 100)
  (set safe-shell-commands (extract-safe-commands buffer))
  
  (while (< iteration max-iterations)
    ;; Parse current buffer state to dialog
    (set dialog (parse-buffer buffer))
    
    ;; Stream response with multiple callbacks
    (set client-state 
         (stream-llm model dialog 
                     :tools tools 
                     :server-tools server-tools
                     :thinking-budget thinking-budget
                     :max-tokens max-tokens
                     :on-block-start (lambda (block) 
                                       (append-header buffer block))
                     :on-text-delta (lambda (text) 
                                      (append-text buffer text))
                     :on-block-stop (lambda (type block)
                                      (handle-block-stop buffer type block))
                     :on-complete (lambda (content-blocks)
                                    ;; This is where the loop continues
                                    (handle-completion content-blocks))
                     :on-error (lambda (error)
                                 (handle-error error))))
    
    ;; Store state for cancellation support
    (set-buffer-state buffer :client-state client-state)
    
    ;; Wait for stream completion (async)
    (await client-state)
    
    ;; Extract tool calls from completed response
    (set tool-calls (filter-tool-calls content-blocks))
    
    (if tool-calls
        (progn
          (set iteration (+ iteration 1))
          
          ;; Execute tools in parallel with streaming
          (set executing-tools (make-hash-table))
          (foreach tool-call tool-calls
            (let ((tool-id (get tool-call 'id)))
              ;; Track executing tools for cancellation
              (puthash tool-id 'executing executing-tools)
              
              ;; Execute with streaming callback
              (execute-tool-async tool-call
                :buffer buffer
                :metadata (list :safe-shell-commands safe-shell-commands)
                :on-stream (lambda (text)
                            (append-tool-result buffer tool-id text))
                :on-complete (lambda (result)
                              (remhash tool-id executing-tools)
                              (append-tool-result buffer tool-id result :final t)
                              ;; When all tools done, continue loop
                              (when (hash-empty-p executing-tools)
                                (continue-loop))))))
          
          (set-buffer-state buffer :executing-tools executing-tools)
          ;; Loop continues after all tools complete
          )
      ;; No tool calls - finish
      (progn
        (append-text buffer "\n\n# USER\n\n")
        (return)))))
```

Key differences from the initial sketch:
- **Streaming is core**: Multiple callbacks for incremental updates
- **Parallel tool execution**: Not sequential map
- **State management**: Tracking client-state and executing-tools for cancellation
- **Safe commands**: Extracted from buffer for shell command security
- **Buffer updates throughout**: Not just at the end
- **Async coordination**: Waiting for all parallel tools before continuing

For the "every 5 steps use gpt5 for course correction" scenario:

```elisp
(def-agent (dialog model tools buffer)
  (set iteration 0)
  (set max-iterations 100)
  (set primary-model 'claude-sonnet-4-5)
  (set reflection-model 'gpt-5)
  
  (while (< iteration max-iterations)
    (set dialog (parse-buffer buffer))
    
    ;; Every 5 iterations, do reflection with GPT-5
    (when (and (> iteration 0) (= (mod iteration 5) 0))
      (let ((reflection-dialog (append dialog '(((role . "user")
                                                  (content . "Review the current status and suggest course corrections if needed."))))))
        (stream-llm reflection-model reflection-dialog
                   :tools '()  ; No tools for reflection
                   :thinking-budget 0  ; No thinking for reflection
                   :on-text-delta (lambda (text) (append-text buffer text))
                   :on-complete (lambda (blocks) 
                                 (append-text buffer "\n\n# USER\n\nContinuing with original task.\n\n")))
        (await)))
    
    ;; Regular step with primary model
    (stream-llm primary-model dialog
               :tools tools
               :thinking-budget 4096
               :on-block-start (lambda (block) (append-header buffer block))
               :on-text-delta (lambda (text) (append-text buffer text))
               :on-complete (lambda (blocks)
                             (let ((tool-calls (filter-tool-calls blocks)))
                               (if tool-calls
                                   (progn
                                     (execute-tools-parallel tool-calls buffer)
                                     (set iteration (+ iteration 1)))
                                 (return)))))
    (await)))
```

