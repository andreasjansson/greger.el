(defun greger-stdlib--run-shell-command-with-vterm (command working-directory callback timeout enable-environment streaming-callback)
  "Execute COMMAND using vterm in WORKING-DIRECTORY and call CALLBACK with (result error).
Returns a cancel function that can interrupt the command execution."
  (let* ((buffer-name (format " *greger-shell-vterm-%s*" (random)))
         (vterm-buffer (get-buffer-create buffer-name))
         (timer nil)
         (command-complete nil)
         (command-output "")
         (command-error nil)
         (cancel-func nil)
         (original-dir default-directory))
    
    (with-current-buffer vterm-buffer
      ;; Set up the working directory
      (setq default-directory working-directory)
      
      ;; Set up vterm environment
      (let ((vterm-environment (append
                               (list "PAGER=cat")
                               (when enable-environment
                                 ;; Add environment variables that would be available in interactive shell
                                 (let ((shell-env (greger-stdlib--get-shell-environment)))
                                   shell-env))
                               vterm-environment))
            (vterm-kill-buffer-on-exit nil)  ; Don't kill buffer on exit, we need to read the output
            (vterm-shell (if enable-environment
                            ;; Use interactive shell to source .bash_profile and .bashrc
                            (format "bash -i -c %s" (shell-quote-argument command))
                          ;; Use non-interactive shell
                          (format "bash -c %s" (shell-quote-argument command)))))
        
        ;; Initialize vterm
        (vterm-mode)
        
        ;; Set up process sentinel to detect completion
        (let ((process vterm--process))
          (when process
            (set-process-sentinel process
                                  (lambda (proc event)
                                    (when (string-match "\\(finished\\|exited\\)" event)
                                      (setq command-complete t)
                                      (setq command-output (with-current-buffer vterm-buffer (buffer-string)))
                                      (unless (string-match "exited abnormally" event)
                                        ;; Normal completion
                                        (when timer (cancel-timer timer))
                                        (funcall callback command-output nil)
                                        (kill-buffer vterm-buffer))
                                      (when (string-match "exited abnormally" event)
                                        ;; Command failed
                                        (setq command-error (format "Command failed: %s" event))
                                        (when timer (cancel-timer timer))
                                        (funcall callback nil command-error)
                                        (kill-buffer vterm-buffer))))))
          
          ;; Set up timeout
          (when timeout
            (setq timer (run-with-timer timeout nil
                                       (lambda ()
                                         (when (not command-complete)
                                           (when (process-live-p process)
                                             (kill-process process))
                                           (setq command-error "Command timed out")
                                           (funcall callback nil command-error)
                                           (kill-buffer vterm-buffer))))))
          
          ;; Set up streaming callback if provided
          (when streaming-callback
            (let ((last-output ""))
              (add-hook 'after-change-functions
                        (lambda (start end old-len)
                          (let ((current-output (buffer-string)))
                            (unless (string= current-output last-output)
                              (let ((new-text (substring current-output (length last-output))))
                                (funcall streaming-callback new-text nil))
                              (setq last-output current-output))))
                        nil t)))
          
          ;; Return cancel function
          (setq cancel-func (lambda ()
                             (when timer (cancel-timer timer))
                             (when (and process (process-live-p process))
                               (kill-process process))
                             (when (buffer-live-p vterm-buffer)
                               (kill-buffer vterm-buffer))
                             (funcall callback nil "Command cancelled by user")))))
        
        ;; Execute the command by sending it to the vterm
        (vterm-send-string command)
        (vterm-send-return)))
    
    ;; Return the cancel function
    cancel-func))

(defun greger-stdlib--get-shell-environment ()
  "Get environment variables from an interactive shell."
  (let ((env-output (shell-command-to-string "bash -i -c 'env'")))
    (mapcar (lambda (line)
              (let ((eq-pos (string-match "=" line)))
                (if eq-pos
                    (format "%s=%s" 
                            (substring line 0 eq-pos)
                            (substring line (1+ eq-pos)))
                  line)))
            (split-string env-output "\n" t))))

(defun greger-stdlib--ripgrep (pattern path callback case-sensitive file-type
