+(defun greger-ui--process-terminal-sequences (text)
+  "Process terminal control sequences in TEXT.
+This is a fallback function that embeds vterm for full terminal emulation.
+If vterm is not available, it just inserts the text as-is."
+  (if (fboundp 'vterm-mode)
+      (greger-ui--process-terminal-sequences-with-vterm text)
+    ;; Fallback: just insert the text without processing
+    (insert text)))
