#!/usr/bin/env emacs --script
;; Debug test for vterm first character and color issues

;; Load the necessary files
(add-to-list 'load-path "/Users/andreas/projects/greger.el")
(load-file "greger-stdlib.el")

;; Initialize package system for vterm
(require 'package)
(setq package-archives '(("gnu" . "https://elpa.gnu.org/packages/")
                         ("melpa" . "https://melpa.org/packages/")))
(package-initialize)

;; Try to install vterm
(unless (package-installed-p 'vterm)
  (package-refresh-contents)
  (package-install 'vterm))

;; Create metadata to allow all shell commands for testing
(setq test-metadata '(:allow-all-shell-commands t))

;; Debug test with detailed output analysis
(message "=== Debug Test: First character and color issues ===")
(let ((test-completed nil)
      (test-result nil)
      (test-error nil)
      (streaming-messages '()))
  
  (defun test-callback (result error)
    (setq test-completed t)
    (setq test-result result)
    (setq test-error error))
  
  (defun test-streaming (text)
    (push text streaming-messages)
    (message "STREAMING: %S" text))
  
  (greger-stdlib--shell-command
   "printf '\\033[31mRED\\033[0m Normal'"
   #'test-callback
   default-directory
   10
   nil
   t ; use-vterm = true
   #'test-streaming
   test-metadata)
  
  ;; Wait for completion
  (let ((counter 0))
    (while (and (not test-completed) (< counter 100))
      (sleep-for 0.1)
      (setq counter (1+ counter))))
  
  (if test-completed
      (progn
        (message "✅ Test completed")
        (message "Final result: %S" test-result)
        (message "Error: %S" test-error)
        
        ;; Analyze streaming messages
        (message "\n--- Streaming Analysis ---")
        (dolist (msg (reverse streaming-messages))
          (message "Stream: %S" msg))
        
        ;; Analyze character by character
        (message "\n--- Character Analysis ---")
        (let ((result-str (if (stringp test-result) test-result test-result)))
          (dotimes (i (length result-str))
            (let ((char (aref result-str i))
                  (props (text-properties-at i result-str)))
              (message "Char %d: %c (byte %d) props: %S" i char char props))))
        
        ;; Check first character specifically
        (message "\n--- First Character Analysis ---")
        (when (> (length test-result) 0)
          (let ((first-char (aref test-result 0))
                (first-props (text-properties-at 0 test-result)))
            (message "First char: %c (byte %d)" first-char first-char)
            (message "First char props: %S" first-props)
            (if (plist-get first-props 'font-lock-face)
                (message "✅ First character has color properties")
              (message "❌ First character missing color properties")))))
    (message "❌ Test timed out")))

(message "\n=== Debug test completed ===")
</tool.toolu_014ekWp8nZsmCkDwdF2gX35M>

