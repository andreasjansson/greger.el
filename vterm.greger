;;; Test vterm integration with greger shell-command when vterm is available

(add-to-list 'load-path "/Users/andreas/projects/greger.el")
(add-to-list 'load-path "~/.emacs.d/elpa/vterm-20241218.331")
(require 'greger-stdlib)

;; Try to load vterm
(condition-case err
    (progn
      (require 'vterm)
      (message "vterm loaded successfully")
      
      ;; Test with vterm enabled
      (message "Testing with use-vterm=t and vterm available...")
      (let ((result-output nil)
            (result-error nil)
            (completed nil))
        (greger-stdlib--shell-command
         "echo 'Hello World from vterm'"
         (lambda (output error)
           (setq result-output output)
           (setq result-error error)
           (setq completed t)
           (message "Vterm Output: %s" output)
           (message "Vterm Error: %s" error))
         nil  ; working-directory
         nil  ; timeout
         nil  ; enable-environment
         t    ; use-vterm
         nil  ; streaming-callback
         '(:safe-shell-commands ("echo 'Hello World from vterm'") :allow-all-shell-commands nil))
        
        ;; Wait a bit for async completion
        (sleep-for 2)
        (message "Test completed - vterm integration working!")))
  (error (message "vterm not available: %s" (error-message-string err))))

(message "Test completed!")
</tool.toolu_01NzBYj63a8mPS1NLsurh5PZ>

