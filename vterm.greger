1064:                  (delete-char 1))))
1065: 
1066:            ;; Remove the generating property from the tool result
1067:            (when-let ((tool-result-node (greger--find-tool-result-node tool-id)))
1068:              (let ((start (treesit-node-start tool-result-node))
1069:                    (end (treesit-node-end tool-result-node)))
1070:                (remove-text-properties start end '(greger-tool-result-generating))))
1071: 
1072:            ;; Update buffer state after tool completion
1073:            (greger--update-buffer-state)))))))
1074: 
1075: (defun greger--find-tool-result-content-node (tool-id)
1076:   "Find the tool_content node for the tool_result with TOOL-ID.
1077: Uses treesit to query for a tool_result with matching id and returns
1078: the tool_content node within its content section."
1079:   (when-let* ((query `((tool_result (id (value) @id) (:match ,tool-id @id)
1080:                                     (content) @content)))
</tool.toolu_015YCGs84xFsv97ZLYdNGkZP>

