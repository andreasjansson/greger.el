;;; Test vterm integration with greger shell-command

(add-to-list 'load-path "/Users/andreas/projects/greger.el")
(require 'greger-stdlib)

;; Test that the function accepts the use-vterm parameter
(message "Testing shell-command function signature...")

;; Test with vterm disabled
(message "Testing with use-vterm=nil...")
(condition-case err
    (greger-stdlib--shell-command
     "echo 'Hello World'"
     (lambda (output error)
       (message "Output: %s" output)
       (message "Error: %s" error))
     nil  ; working-directory
     nil  ; timeout
     nil  ; enable-environment
     nil  ; use-vterm
     nil  ; streaming-callback
     '(:safe-shell-commands ("echo 'Hello World'") :allow-all-shell-commands nil))
  (error (message "Error: %s" (error-message-string err))))

;; Test with vterm enabled (should error if vterm not available)
(message "Testing with use-vterm=t...")
(condition-case err
    (greger-stdlib--shell-command
     "echo 'Hello World'"
     (lambda (output error)
       (message "Output: %s" output)
       (message "Error: %s" error))
     nil  ; working-directory
     nil  ; timeout
     nil  ; enable-environment
     t    ; use-vterm
     nil  ; streaming-callback
     '(:safe-shell-commands ("echo 'Hello World'") :allow-all-shell-commands nil))
  (error (message "Expected error when vterm not available: %s" (error-message-string err))))

(message "Test completed!")
</tool.toolu_01SQp1YAe8nmvRqA1xtzvQjA>

