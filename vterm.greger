<tool.toolu_018tDuqGiKPXviA4mfiBkYeR>
#!/usr/bin/env emacs --script

;; Test script for interactive input handling in vterm-enabled shell-command

;; Load the required modules
(require 'vterm)

;; Test interactive input detection
(defun test-interactive-input ()
  "Test interactive input detection"
  (interactive)
  (let ((buffer (get-buffer-create "*test-vterm*")))
    (with-current-buffer buffer
      (vterm-mode)
      ;; Send a command that prompts for input
      (vterm-send-string "read -p 'Enter your name: ' name && echo Hello $name")
      (vterm-send-return)
      ;; Check if there's a prompt at the end
      (goto-char (point-max))
      (forward-line 0)
      (let ((line (buffer-substring-no-properties (point) (point-max))))
        (message "Last line: %s" line)
        (when (string-match-p "Enter your name:" line)
          (message "Interactive prompt detected!"))))))

;; Run the test
(test-interactive-input)
</tool.toolu_018tDuqGiKPXviA4mfiBkYeR>

