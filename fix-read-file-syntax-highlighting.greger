 7: (defun greger-ui-test--key-binding-at-point (key)
 8:   "Get the effective key binding for KEY at point.
 9: This checks text properties, overlays, and local/global keymaps."
10:   (or
11:    ;; Check keymap text property
12:    (let ((keymap (get-char-property (point) 'keymap)))
13:      (when keymap (lookup-key keymap key)))
14:    ;; Check local-map text property
15:    (let ((keymap (get-char-property (point) 'local-map)))
16:      (when keymap (lookup-key keymap key)))
17:    ;; Fall back to normal key lookup
18:    (key-binding key)))
19: 
20: 
21: (defun greger-ui-test--visible-text ()
22:   "Extract only the visible text from the current buffer.
23: Text with the 'invisible property set to t is excluded."
24:   (let ((result "")
25:         (pos (point-min)))
26:     (while (< pos (point-max))
27:       (let* ((next-change (next-single-property-change pos 'invisible nil (point-max)))
28:              (invisible (get-text-property pos 'invisible)))
29:         (unless invisible
30:           (setq result (concat result (buffer-substring-no-properties pos next-change))))
31:         (setq pos next-change)))
32:     result))
33: 
34: (defun greger-ui-test--send-key (key)
35:   (let ((fn (greger-ui-test--key-binding-at-point key)))
36:     (funcall fn))
37: 
38:   ;; force font-lock to update
39:   (font-lock-flush (point-min) (point-max))
40:   (font-lock-ensure (point-min) (point-max)))
41: 
42: (defun greger-ui-test-font-lock-face-at (text &optional offset)
43:   "Get the font-lock-face property at TEXT in the current buffer.
44: OFFSET specifies position within the match (default 0 for match beginning).
45: Returns nil if TEXT is not found."
46:   (save-excursion
47:     (goto-char (point-min))
48:     (when (re-search-forward (regexp-quote text) nil t)
49:       (let ((pos (+ (match-beginning 0) (or offset 0))))
50:         (when (and (>= pos (match-beginning 0))
