563: (defun greger-ui--tool-result-syntax-highlighting (tool-result-node _override _start _end)
564:   "Apply syntax highlighting to TOOL-RESULT-NODE based on corresponding tool use.
565: _OVERRIDE, _START, and _END are font-lock parameters."
566:   (unless (greger-ui--syntax-highlighted-p tool-result-node)
567:     (when-let* ((tool-use-node (greger-ui--find-corresponding-tool-use tool-result-node))
568:                 (tool-name (greger-parser--extract-tool-use-name tool-use-node))
569:                 (content-node (treesit-search-subtree tool-result-node "content"))
570:                 (start (treesit-node-start content-node))
571:                 (end (treesit-node-end content-node))
572:                 (text (treesit-node-text content-node))
573:                 (tool-use-params (greger-parser--extract-tool-use-params tool-use-node)))
574: 
575:       (cond
576:        ((string= tool-name "read-file")
577:         (when-let ((path (alist-get 'path tool-use-params)))
578:           (greger-ui--syntax-highlight-text start end text path)))
579:        (t nil)))
580:     (greger-ui--set-syntax-highlighted tool-result-node)))
