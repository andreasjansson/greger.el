119: (defun greger-ui--tool-content-head-folding (node _override _start _end)
120:   "Font-lock function to make tool_content_head TAB-able for tail visibility.
121: NODE is the matched tree-sitter node, OVERRIDE is the override setting,
122: START and END are the region bounds."
123:   (let* ((node-start (treesit-node-start node))
124:          (node-end (treesit-node-end node))
125:          (parent (treesit-node-parent node)))
126: 
127:     (when parent
128:       ;; Find the corresponding tail safely
129:       (let ((tail-node (treesit-search-subtree parent "^tool_content_tail$" nil nil 1)))
130:         (when tail-node
131:           (let* ((tail-start (treesit-node-start tail-node))
132:                  (tail-end (treesit-node-end tail-node))
133:                  (is-tail-visible (or (get-text-property tail-start 'greger-ui-tool-content-expanded)
134:                                       (not greger-ui-folding-mode)))
135:                  (line-count (max 1 (count-lines tail-start tail-end))))
136:             ;; Mark the head as foldable and store tail info
137:             (put-text-property node-start node-end 'greger-ui-foldable-tool-content t)
138:             (put-text-property node-start node-end 'greger-ui-tool-tail-start tail-start)
139:             (put-text-property node-start node-end 'greger-ui-tool-tail-end tail-end)
140:             (put-text-property node-start node-end 'keymap greger-ui-tool-content-head-keymap)
141:             ;; Clean up old overlays first
142:             (let ((old-overlay (get-text-property node-start 'greger-ui-fold-overlay)))
143:               (when (and old-overlay (overlayp old-overlay))
144:                 (delete-overlay old-overlay)
145:                 (remove-text-properties node-start node-end '(greger-ui-fold-overlay nil))))
146: 
147:             ;; Add overlay with fold indicator when tail is hidden
148:             (unless is-tail-visible
149:               (let ((overlay (make-overlay (-  node-end 2) (1- node-end))))
150:                 (overlay-put overlay 'after-string
151:                              (propertize (format "\n[+%d lines, TAB to expand]" line-count)
152:                                          'face '(:foreground "gray" :height 0.8 :slant italic)))
153:                 (overlay-put overlay 'greger-ui-fold-overlay t)
154:                 (overlay-put overlay 'evaporate t)
155:                 ;; Store overlay reference for cleanup
156:                 (put-text-property node-start node-end 'greger-ui-fold-overlay overlay)))))))))
157: 
158: (defun greger-ui--tool-content-tail-folding (node _override _start _end)
159:   "Font-lock function to make tool_content_tail invisible by default.
160: NODE is the matched tree-sitter node"
161:   (let* ((node-start (treesit-node-start node))
162:          (node-end (treesit-node-end node))
163:          (is-visible (get-text-property node-start 'greger-ui-tool-content-expanded)))
164: 
165:     ;; Apply invisibility (default is invisible unless expanded, but respect global folding mode)
166:     (put-text-property node-start node-end 'invisible
167:                        (and greger-ui-folding-mode (not is-visible)))
168:     (put-text-property node-start node-end 'keymap greger-ui-tool-content-tail-keymap)))
169: 
