790: (cl-defun greger--handle-tool-completion (&key tool-id result error state completion-callback)
791:   "Handle completion of a tool execution.
792: Updates buffer and calls callback when tool execution finishes.
793: TOOL-ID is the tool identifier.
794: RESULT is the tool execution result.
795: ERROR is any error that occurred.
796: STATE contains the current agent state.
797: COMPLETION-CALLBACK is called when complete."
798:   (let ((tool-result-text (if error
799:                               (if (listp error)
800:                                   (error-message-string error)
801:                                 error)
802:                             result)))
803: 
804:     (greger--append-tool-result-text state tool-id tool-result-text t)
805: 
806:     ;; Call completion callback
807:     (funcall completion-callback)))
808: 
809: (defun greger--append-tool-result-text (state tool-id text &optional is-completed)
810:   "Append TEXT to the tool result content node for TOOL-ID in STATE's buffer.
811: When IS-COMPLETED is non-nil, also trim trailing newline after the tool's
812: end tag and update the buffer state."
813:   (when-let ((buffer (greger--live-chat-buffer state)))
814:     (with-current-buffer buffer
815:       (when-let ((inhibit-read-only t)
816:                  (tool-result-content-node (greger--find-tool-result-content-node tool-id))
817:                  (tool-result-content-end (treesit-node-end tool-result-content-node)))
818:         (greger--maybe-save-excursion
819:          (goto-char (1- tool-result-content-end))
820: 
</tool.toolu_012PmWbT2AhyTmuAHgadLTvR>

