837: (defun greger--find-tool-result-content-node (tool-id)
838:   "Find the tool_content node for the tool_result with TOOL-ID.
839: Uses treesit to query for a tool_result with matching id and returns
840: the tool_content node within its content section."
841:   (let* ((query `((tool_result (id (value) @id) (:match ,tool-id @id)
842:                                (content) @content)))
843:          (capture (treesit-query-capture (treesit-buffer-root-node) query))
844:          (content-node (alist-get 'content capture))
845:          ;; for some reason, querying directly for tool_content fails, but this works
846:          (content-node-first-child (car (treesit-node-children content-node))))
847:     (treesit-search-subtree content-node-first-child "tool_content")))
