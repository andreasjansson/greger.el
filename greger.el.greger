  1393	            (buffer-string)))
  1394	      ;; Clean up the temporary buffer
  1395	      (when (buffer-live-p vterm-buffer)
  1396	        (with-current-buffer vterm-buffer
  1397	          (when (and vterm--process (process-live-p vterm--process))
  1398	            (set-process-query-on-exit-flag vterm--process nil)))
