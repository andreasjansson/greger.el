    36	;;; Constants and configuration
    37	
    38	(defconst greger-client-api-url "https://api.anthropic.com/v1/messages"
    39	  "Claude API endpoint URL.")
    40	
    41	;;; Data structures
    42	
    43	(cl-defstruct greger-client-state
    44	  accumulated-output
    45	  content-blocks
    46	  process
    47	  output-buffer ;; used for undo handle
    48	  undo-handle
    49	  block-start-callback
    50	  text-delta-callback
    51	  block-stop-callback
    52	  complete-callback
    53	  restore-callback
    54	  error-callback
    55	  error-message)
