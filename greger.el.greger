# greger.el:

     1	;;; greger.el --- Agentic coding environment with tool use, using Claude -*- lexical-binding: t -*-
     2	
     3	;; Copyright (C) 2025 Andreas Jansson
     4	
     5	;; Author: Andreas Jansson <andreas@jansson.me.uk>
     6	;; Version: 0.1.0
     7	;; URL: https://github.com/andreasjansson/greger.el
     8	;; Package-Requires: ((emacs "29.1"))
     9	;; Keywords: agent, agentic, ai, chat, language-models, tools
    10	;; SPDX-License-Identifier: MIT
    11	
    12	;; Permission is hereby granted, free of charge, to any person obtaining a copy
    13	;; of this software and associated documentation files (the "Software"), to deal
    14	;; in the Software without restriction, including without limitation the rights
    15	;; to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
    16	;; copies of the Software, and to permit persons to whom the Software is
    17	;; furnished to do so, subject to the following conditions:
    18	
    19	;; The above copyright notice and this permission notice shall be included in all
    20	;; copies or substantial portions of the Software.
    21	
    22	;; THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    23	;; IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    24	;; FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    25	;; AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    26	;; LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
    27	;; OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
    28	;; SOFTWARE.
    29	
    30	;;; Commentary:
    31	;; Agentic coding environment using Claude and a suite of built-in tools.
    32	;; Capable of viewing and editing files, searching code, listing files,
    33	;; searching the web and downloading web pages.  Extensible with custom
    34	;; tools defined in Emacs Lisp.
    35	
    36	;;; Code:
    37	
    38	(require 'cl-lib)
    39	(require 'json)
    40	(require 'treesit)
    41	
    42	(require 'greger-client)
    43	(require 'greger-parser)
    44	(require 'greger-tools)
    45	(require 'greger-stdlib)
    46	(require 'greger-ui)
    47	(require 'greger-prompt)
    48	
    49	;; Eval functionality
    50	(defconst greger-available-models
    51	  '(claude-sonnet-4-20250514
    52	    claude-opus-4-20250514
    53	    claude-opus-4-1-20250805
    54	    claude-sonnet-4-5)
    55	  "List of available models.")
    56	
    57	(defcustom greger-model 'claude-sonnet-4-20250514
    58	  "The currently used model."
    59	  :type `(choice ,@(mapcar (lambda (model) `(const ,model)) greger-available-models))
    60	  :group 'greger)
    61	
    62	(defcustom greger-default-system-prompt "You are Greger, and expert coding agent.
    63	
    64	${greger-prompt-code-style}"
    65	  "Default system prompt used for AI interactions."
    66	  :type 'string
    67	  :group 'greger)
    68	
    69	(defcustom greger-max-tokens 27000
    70	  "Maximum number of tokens to generate."
    71	  :type 'integer
    72	  :group 'greger)
    73	
    74	(defcustom greger-thinking-budget 4096
    75	  "Default budget for thinking (internal reasoning) content, in tokens.
    76	Set to 0 to disable thinking entirely."
    77	  :type 'integer
    78	  :group 'greger)
    79	
    80	(defcustom greger-local-grammar-path nil
    81	  "Local path or Git branch for greger grammar development.
    82	When set to a local directory path (starting with / or ~), the grammar
    83	will be installed from that local directory. When set to a string not
    84	starting with / or ~, it will be treated as a Git branch name.
    85	This is useful for development when you want to test local changes
    86	or changes from a development branch."
    87	  :type '(choice (const :tag "Use main branch from GitHub" nil)
    88	                 (directory :tag "Local grammar directory path")
    89	                 (string :tag "Git branch name"))
    90	  :group 'greger)
    91	
    92	(defcustom greger-allow-all-shell-commands nil
    93	  "Allow all shell commands to run without permission.
    94	May order 4,000 pounds of meat."
    95	  :type 'boolean
    96	  :group 'greger)
    97	
    98	(defcustom greger-anthropic-key-fn nil
    99	  "Function to call to get the Anthropic API key.
   100	This function should return a string containing the API key.
   101	If nil, the ANTHROPIC_API_KEY environment variable will be used."
   102	  :type '(choice (const nil) function)
   103	  :group 'greger)
   104	
   105	;; Tool configuration and agent functionality
   106	
   107	(defcustom greger-tools '("read-file" "write-new-file" "replace-file" "str-replace" "make-directory" "rename-file" "delete-files" "list-directory" "ripgrep" "shell-command" "read-webpage")
   108	  "List of tools available to the agent."
   109	  :type '(repeat symbol)
   110	  :group 'greger)
   111	
   112	(defcustom greger-server-tools '("web_search")
   113	  "List of server tools available to the agent (e.g., web_search)."
   114	  :type '(repeat symbol)
   115	  :group 'greger)
   116	
   117	(defcustom greger-max-iterations 100
   118	  "Maximum number of agent iterations before stopping."
   119	  :type 'integer
   120	  :group 'greger)
   121	
   122	;;; Agent state structure
   123	
   124	(cl-defstruct greger-state
   125	  current-iteration
   126	  chat-buffer
   127	  directory
   128	  tool-use-metadata
   129	  client-state
   130	  executing-tools)
   131	
   132	(defvar-local greger--current-state nil
   133	  "Buffer-local variable to track the current state.")
   134	
   135	(defvar-local greger--buffer-read-only-by-greger nil
   136	  "Buffer-local variable to track if buffer is read-only due to greger activity.")
   137	
   138	(defvar-local greger-current-thinking-budget greger-thinking-budget
   139	  "Thinking budget for the current Greger chat.")
   140	
   141	(defvar-local greger-follow-mode t
   142	  "When non-nil, keep point at the bottom of the chat during updates.
   143	When nil, preserve point position using `save-excursion'.")
   144	
   145	(defcustom greger-citation-summary-face 'underline
   146	  "Face to use for citation text when folded."
   147	  :type 'face
   148	  :group 'greger)
   149	
   150	(defface greger-user-header-face
   151	  '((t (:foreground "cyan" :weight bold :height 1.1)))
   152	  "Face for USER headers."
   153	  :group 'greger)
   154	
   155	(defface greger-assistant-header-face
   156	  '((t (:foreground "green" :weight bold :height 1.1)))
   157	  "Face for ASSISTANT headers."
   158	  :group 'greger)
   159	
   160	(defface greger-system-header-face
   161	  '((t (:foreground "orange" :weight bold :height 1.1)))
   162	  "Face for SYSTEM headers."
   163	  :group 'greger)
   164	
   165	(defface greger-thinking-header-face
   166	  '((t (:foreground "magenta" :weight bold :height 1.1)))
   167	  "Face for THINKING headers."
   168	  :group 'greger)
   169	
   170	(defface greger-tool-header-face
   171	  '((t (:foreground "yellow" :weight bold :height 1.1)))
   172	  "Face for tool-related headers (TOOL USE, TOOL RESULT, etc.)."
   173	  :group 'greger)
   174	
   175	(defface greger-field-name-face
   176	  '((t (:foreground "lightyellow")))
   177	  "Face for field names like \='Name:\=', \='ID:\=', etc."
   178	  :group 'greger)
   179	
   180	(defface greger-tool-param-name-face
   181	  '((t (:foreground "lightgreen")))
   182	  "Face for tool parameter names like \='path\=', \='content\=', etc."
   183	  :group 'greger)
   184	
   185	(defface greger-key-face
   186	  '((t (:foreground "lightblue")))
   187	  "Face for tool parameter names like \='path\=', \='content\=', etc."
   188	  :group 'greger)
   189	
   190	(defface greger-tool-tag-face
   191	  '((t (:foreground "gray" :height 0.6)))
   192	  "Face for tool start and end tags."
   193	  :group 'greger)
   194	
   195	(defface greger-citation-face
   196	  '((t (:underline "#555588")))
   197	  "Face for links."
   198	  :group 'greger)
   199	
   200	(defface greger-link-face
   201	  '((t (:foreground "aqua" :weight semi-bold)))
   202	  "Face for links."
   203	  :group 'greger)
   204	
   205	(defface greger-eval-tag-face
   206	  '((t (:foreground "#4A90E2")))
   207	  "Face for eval tags (<eval>, </eval>)."
   208	  :group 'greger)
   209	
   210	(defface greger-eval-language-face
   211	  '((t (:foreground "#4AE290")))
   212	  "Face for eval tags (<eval>, </eval>)."
   213	  :group 'greger)
   214	
   215	(defface greger-eval-result-face
   216	  '((t (:foreground "#8FA5C7")))
   217	  "Face for eval result content - blue-ish gray."
   218	  :group 'greger)
   219	
   220	(defface greger-eval-arrow-face
   221	  '((t (:foreground "#5A7BA7" :weight bold)))
   222	  "Face for eval result arrow overlay - darker blue-ish gray."
   223	  :group 'greger)
   224	
   225	(defface greger-error-face
   226	  '((t (:background "red" :foreground "white")))
   227	  "Face for parse errors in greger-mode."
   228	  :group 'greger)
   229	
   230	(defface greger-code-content-face
   231	  '((((class color) (background dark))
   232	     (:background "#2a2a2a"))
   233	    (((class color) (background light))
   234	     (:background "#f8f8f8"))
   235	    (t (:background "gray")))
   236	  "Face for code content blocks.
   237	Background is slightly less dark than default for dark themes,
   238	or slightly less bright than default for light themes."
   239	  :group 'greger)
   240	
   241	(defface greger-code-backtick-face
   242	  '((((class color) (background dark))
   243	     (:foreground "#b5651d" :background "#2a2a2a"))
   244	    (((class color) (background light))
   245	     (:foreground "#8b4513" :background "#f8f8f8"))
   246	    (t (:foreground "orange" :background "gray")))
   247	  "Face for backticks around code content - orange-ish gray color."
   248	  :group 'greger)
   249	
   250	(defvar greger-mode-map
   251	  (let ((map (make-sparse-keymap)))
   252	    (define-key map (kbd "M-<return>") #'greger-buffer)
   253	    (define-key map (kbd "M-RET") #'greger-buffer)  ; Alternative for Linux compatibility
   254	    (define-key map (kbd "C-M-<return>") #'greger-buffer-no-tools)
   255	    (define-key map (kbd "C-M-RET") #'greger-buffer-no-tools)  ; Alternative for Linux compatibility
   256	    (define-key map (kbd "C-g") #'greger-interrupt)
   257	    (define-key map (kbd "C-; a") #'greger-insert-assistant-tag)
   258	    (define-key map (kbd "C-; u") #'greger-insert-user-tag)
   259	    (define-key map (kbd "C-; s") #'greger-insert-system-tag)
   260	    (define-key map (kbd "C-; m") #'greger-set-model)
   261	    (define-key map (kbd "C-; c") #'greger-ui-copy-code)
   262	    (define-key map (kbd "C-; t") #'greger-toggle-thinking)
   263	    (define-key map (kbd "C-; f") #'greger-toggle-follow-mode)
   264	    (define-key map (kbd "C-; C-f") #'greger-ui-toggle-folding)
   265	    (define-key map (kbd "C-; b") #'greger-mention-buffer-file)
   266	    map)
   267	  "Keymap for `greger-mode'.")
