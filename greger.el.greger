    28	;;; Commentary:
    29	;; Greger UI components for folding, etc.
    30	
    31	;;; Code:
    32	
    33	(require 'treesit)
    34	(require 'diff)
    35	(require 'diff-mode)
    36	
    37	(require 'greger-parser)
    38	
    39	;; Additional faces for eval results
    40	(defface greger-eval-arrow-face
    41	  '((t (:foreground "#0066cc" :weight bold)))
    42	  "Face for eval result arrow."
    43	  :group 'greger)
    44	
    45	(defvar greger-ui-citation-keymap
    46	  (let ((map (make-sparse-keymap)))
    47	    (define-key map [mouse-1] #'greger-ui--toggle-citation-fold)
    48	    (define-key map (kbd "TAB") #'greger-ui--toggle-citation-fold)
    49	    map)
    50	  "Keymap for citation text to handle mouse clicks.")
    51	
    52	(defvar greger-ui-url-link-keymap
    53	  (let ((map (make-sparse-keymap)))
    54	    (define-key map [mouse-1] #'greger-ui--open-url-at-point)
    55	    (define-key map (kbd "RET") #'greger-ui--open-url-at-point)
    56	    map))
    57	
    58	(defvar greger-ui-tool-content-head-keymap
    59	  (let ((map (make-sparse-keymap)))
    60	    (define-key map [mouse-1] #'greger-ui--toggle-tool-content-head-fold)
    61	    (define-key map (kbd "TAB") #'greger-ui--toggle-tool-content-head-fold)
    62	    map))
    63	
    64	(defvar greger-ui-tool-content-tail-keymap
    65	  (let ((map (make-sparse-keymap)))
    66	    (define-key map [mouse-1] #'greger-ui--toggle-tool-content-tail-fold)
    67	    (define-key map (kbd "TAB") #'greger-ui--toggle-tool-content-tail-fold)
    68	    map))
    69	
    70	(defvar greger-ui-eval-result-content-head-keymap
    71	  (let ((map (make-sparse-keymap)))
    72	    (define-key map (kbd "TAB") 'greger-ui-toggle-eval-result-content)
    73	    map)
    74	  "Keymap for eval result content head.")
    75	
    76	(defvar greger-ui-eval-result-content-tail-keymap
    77	  (let ((map (make-sparse-keymap)))
    78	    (define-key map (kbd "TAB") 'greger-ui-toggle-eval-result-content)
    79	    map)
    80	  "Keymap for eval result content tail.")
    81	
    82	(defvar greger-ui-folding-mode t)
    83	
    84	(defun greger-ui-toggle-folding ()
    85	  "Toggle `greger-ui-folding-mode' and re-fontify the buffer."
    86	  (interactive)
    87	  (setq greger-ui-folding-mode (not greger-ui-folding-mode))
    88	  
    89	  ;; Always clean up overlays when toggling
    90	  (greger-ui--cleanup-fold-overlays)
    91	  (greger-ui--cleanup-eval-fold-overlays)
    92	  
    93	  (font-lock-flush (point-min) (point-max))
    94	  (message "Greger UI folding mode: %s" (if greger-ui-folding-mode "enabled" "disabled")))
    95	
    96	(defun greger-ui--cleanup-eval-fold-overlays ()
    97	  "Clean up all eval fold text properties in the current buffer."
    98	  ;; Remove display properties that were added for eval arrows and expansion messages
    99	  (save-excursion
   100	    (goto-char (point-min))
   101	    (while (< (point) (point-max))
   102	      (let ((display-prop (get-text-property (point) 'display)))
   103	        (when (and display-prop
   104	                   (or (string-match-p "⇒" display-prop)
   105	                       (string-match-p "\\[\\+.*lines.*TAB.*expand\\]" display-prop)))
   106	          (remove-text-properties (point) (1+ (point)) '(display nil))))
   107	      (forward-char 1))))
   108	
   109	(defun greger-ui--cleanup-fold-overlays ()
   110	  "Remove all fold overlays in the current buffer."
   111	  (dolist (overlay (overlays-in (point-min) (point-max)))
   112	    (when (overlay-get overlay 'greger-ui-fold-overlay)
   113	      (delete-overlay overlay))))
   114	
   115	;; Folding and hiding
   116	
   117	(defun greger-ui--citation-entry-folding (node _override _start _end)
   118	  "Font-lock function to hide citation entries within assistant blocks.
   119	NODE is the matched tree-sitter node, OVERRIDE is the override setting,
   120	START and END are the region bounds."
   121	  (let* ((node-start (treesit-node-start node))
   122	         (node-end (treesit-node-end node))
   123	         (parent (treesit-node-parent node))
   124	         (first-text (treesit-search-subtree parent "^text$" nil nil 1))
   125	         (last-text (treesit-search-subtree parent "^text$" t nil 1))
   126	         (text-start (treesit-node-start first-text))
   127	         (text-end (- (treesit-node-end last-text) 2))
   128	         (uncle (treesit-node-prev-sibling parent))
   129	         (aunt (treesit-node-next-sibling parent))
   130	         (should-fold (and greger-ui-folding-mode
   131	                           (not (get-text-property text-start 'greger-ui-citation-expanded))))
   132	         (invisible-start text-end)
   133	         (invisible-end (- node-end 2)))
   134	
   135	    (put-text-property text-start text-end 'face 'greger-citation-face)
   136	    (put-text-property text-start text-end 'greger-ui-expandable-citation-entry t)
   137	    (put-text-property text-start text-end 'mouse-face 'highlight)
   138	    (put-text-property text-start text-end 'keymap greger-ui-citation-keymap)
   139	    (put-text-property text-start text-end 'invisible-start invisible-start)
   140	    (put-text-property text-start text-end 'invisible-end invisible-end)
   141	
   142	    (when (and uncle (equal (treesit-node-type uncle) "assistant"))
   143	      (let* ((uncle-last-citation-entry (treesit-search-subtree uncle "^citation_entry$" t nil 1)))
   144	
   145	        (if uncle-last-citation-entry
   146	            ;; uncle always invisible when folding mode is on
   147	            (put-text-property (treesit-node-end uncle-last-citation-entry) node-start 'invisible
   148	                               (and greger-ui-folding-mode should-fold))
   149	
   150	          (let* ((uncle-last-child (treesit-node-child uncle -1))
   151	                 (uncle-last-child-end (treesit-node-end uncle-last-child)))
   152	            (put-text-property (- uncle-last-child-end 2) text-start 'invisible greger-ui-folding-mode)))))
   153	
   154	    (when (and aunt (equal (treesit-node-type aunt) "assistant"))
   155	      (let* ((aunt-header (treesit-search-subtree aunt "assistant_header"))
   156	             (aunt-header-end (treesit-node-end aunt-header)))
   157	        (setq invisible-end (+ aunt-header-end 2))))
   158	
   159	    (put-text-property (+ invisible-start 0) invisible-end 'invisible should-fold)))
   160	
   161	(defun greger-ui--tool-content-head-folding (node _override _start _end)
   162	  "Font-lock function to make tool_content_head TAB-able for tail visibility.
   163	NODE is the matched tree-sitter node, OVERRIDE is the override setting,
   164	START and END are the region bounds."
   165	  (let* ((node-start (treesit-node-start node))
   166	         (node-end (treesit-node-end node))
   167	         (parent (treesit-node-parent node))
   168	         ;; Check if the tool result is still generating
   169	         (tool-result-node (treesit-parent-until node (lambda (n) (string= (treesit-node-type n) "tool_result"))))
   170	         (is-generating (when tool-result-node
   171	                          (get-text-property (treesit-node-start tool-result-node) 'greger-tool-result-generating))))
   172	
   173	    (when (and parent (not is-generating))
   174	      ;; Find the corresponding tail safely
   175	      (let ((tail-node (treesit-search-subtree parent "^tool_content_tail$" nil nil 1)))
   176	        (when tail-node
   177	          (let* ((tail-start (treesit-node-start tail-node))
   178	                 (tail-end (treesit-node-end tail-node))
   179	                 (is-tail-visible (or (get-text-property tail-start 'greger-ui-tool-content-expanded)
   180	                                      (not greger-ui-folding-mode)))
   181	                 (line-count (max 1 (count-lines tail-start tail-end))))
   182	            ;; Mark the head as foldable and store tail info
   183	            (put-text-property node-start node-end 'greger-ui-foldable-tool-content t)
   184	            (put-text-property node-start node-end 'greger-ui-tool-tail-start tail-start)
   185	            (put-text-property node-start node-end 'greger-ui-tool-tail-end tail-end)
   186	            (put-text-property node-start node-end 'keymap greger-ui-tool-content-head-keymap)
   187	            ;; Clean up old overlays first
   188	            (let ((old-overlay (get-text-property node-start 'greger-ui-fold-overlay)))
   189	              (when (and old-overlay (overlayp old-overlay))
   190	                (delete-overlay old-overlay)
   191	                (remove-text-properties node-start node-end '(greger-ui-fold-overlay nil))))
   192	
   193	            ;; Add overlay with fold indicator when tail is hidden
   194	            (unless is-tail-visible
   195	              (let ((overlay (make-overlay (-  node-end 2) (1- node-end))))
   196	                (overlay-put overlay 'after-string
   197	                             (propertize (format "\n[+%d lines, TAB to expand]" line-count)
   198	                                         'face '(:foreground "gray" :height 0.8 :slant italic)))
   199	                (overlay-put overlay 'greger-ui-fold-overlay t)
   200	                (overlay-put overlay 'evaporate t)
   201	                ;; Store overlay reference for cleanup
   202	                (put-text-property node-start node-end 'greger-ui-fold-overlay overlay)))))))))
   203	
   204	(defun greger-ui--tool-content-tail-folding (node _override _start _end)
   205	  "Font-lock function to make tool_content_tail invisible by default.
   206	NODE is the matched tree-sitter node"
   207	  (let* ((node-start (treesit-node-start node))
   208	         (node-end (treesit-node-end node))
   209	         (is-visible (get-text-property node-start 'greger-ui-tool-content-expanded))
   210	         ;; Check if the tool result is still generating
   211	         (tool-result-node (treesit-parent-until node (lambda (n) (string= (treesit-node-type n) "tool_result"))))
   212	         (is-generating (when tool-result-node
   213	                          (get-text-property (treesit-node-start tool-result-node) 'greger-tool-result-generating))))
   214	
   215	    ;; Don't apply folding if the tool result is still generating
   216	    (unless is-generating
   217	      ;; Apply invisibility (default is invisible unless expanded, but respect global folding mode)
   218	      (put-text-property node-start node-end 'invisible
   219	                         (and greger-ui-folding-mode (not is-visible)))
   220	      (put-text-property node-start node-end 'keymap greger-ui-tool-content-tail-keymap))))
   221	
   222	(defun greger-ui--thinking-signature-hiding (node _override _start _end)
   223	  "Hide thinking signature.  NODE is the matched tree-sitter node."
   224	  (let* ((node-start (treesit-node-start node))
   225	         (node-end (treesit-node-end node))
   226	         (invisible-end (+ node-end 2)))
   227	    (put-text-property node-start invisible-end 'invisible greger-ui-folding-mode)))
   228	
   229	(defun greger-ui--make-tool-tag-invisible (node _override _start _end)
   230	  "Make tool tag NODE invisible while preserving face styling."
   231	  (condition-case nil
   232	      (let ((node-start (treesit-node-start node))
   233	            (node-end (min (1+ (treesit-node-end node)) (point-max))))
   234	        ;; In Emacs 29.4, be more careful about invisible property boundaries
   235	        ;; to prevent accidentally marking too much content as invisible
   236	        (when (<= node-end (point-max))
   237	          (put-text-property node-start node-end 'invisible greger-ui-folding-mode)
   238	          (unless greger-ui-folding-mode
   239	            (put-text-property node-start node-end 'font-lock-face '(:height 0.8 :foreground "gray70")))))
   240	    (treesit-node-outdated
   241	     ;; Node became outdated, skip this operation
   242	     nil)))
   243	
   244	(defun greger-ui--make-tool-result-id-invisible (node _override _start _end)
   245	  "Make id NODE invisible while preserving face styling."
   246	  (let ((node-start (treesit-node-start node))
   247	        (node-end (treesit-node-end node)))
   248	    (put-text-property node-start node-end 'invisible greger-ui-folding-mode)))
   249	
   250	(defun greger-ui--make-tool-use-id-invisible (node _override _start _end)
   251	  "Make id NODE invisible while preserving face styling."
   252	  (let ((node-start (treesit-node-start node))
   253	        (node-end (1- (treesit-node-end node))))
   254	    (put-text-property node-start node-end 'invisible greger-ui-folding-mode)))
   255	
   256	(defun greger-ui--eval-result-content-head-folding (node _override _start _end)
   257	  "Make eval_result_content_head TAB-able for tail visibility.
   258	NODE is the matched tree-sitter node, similar to tool content head folding."
   259	  (let* ((node-start (treesit-node-start node))
   260	         (node-end (treesit-node-end node))
   261	         (parent (treesit-node-parent node)))
   262	
   263	    (when parent
   264	      ;; Find the corresponding tail safely
   265	      (let ((tail-node (treesit-search-subtree parent "^eval_result_content_tail$" nil nil 1)))
   266	        (when tail-node
   267	          (let* ((tail-start (treesit-node-start tail-node))
   268	                 (tail-end (treesit-node-end tail-node))
   269	                 (is-tail-visible (or (get-text-property tail-start 'greger-ui-eval-result-content-expanded)
   270	                                      (not greger-ui-folding-mode)))
   271	                 (line-count (max 1 (count-lines tail-start tail-end))))
   272	            ;; Mark the head as foldable
   273	            (put-text-property node-start node-end 'keymap greger-ui-eval-result-content-head-keymap)
   274	            (put-text-property node-start node-end 'font-lock-face 'greger-eval-result-face)
   275	            
   276	            ;; Clean up any existing overlays in this region first
   277	            (dolist (overlay (overlays-in (- node-end 2) node-end))
   278	              (when (overlay-get overlay 'greger-ui-fold-overlay)
   279	                (delete-overlay overlay)))
   280	            
   281	            ;; Add expansion indicator when not visible
   282	            (unless is-tail-visible
   283	              (let ((overlay (make-overlay (- node-end 2) (1- node-end))))
   284	                (overlay-put overlay 'after-string
   285	                             (propertize (format "\n[+%d lines, TAB to expand]" line-count)
   286	                                         'face '(:foreground "gray" :height 0.8 :slant italic)))
   287	                (overlay-put overlay 'greger-ui-fold-overlay t)
   288	                (overlay-put overlay 'evaporate t)))))))))
   289	
   290	(defun greger-ui--eval-result-content-tail-folding (node _override _start _end)
   291	  "Font-lock function to make eval_result_content_tail invisible by default.
   292	NODE is the matched tree-sitter node, similar to tool content tail folding."
   293	  (let* ((node-start (treesit-node-start node))
   294	         (node-end (treesit-node-end node))
   295	         (is-visible (get-text-property node-start 'greger-ui-eval-result-content-expanded)))
   296	
   297	    ;; Apply invisibility (default is invisible unless expanded, but respect global folding mode)
   298	    (put-text-property node-start node-end 'invisible
   299	                       (and greger-ui-folding-mode (not is-visible)))
   300	    (put-text-property node-start node-end 'keymap greger-ui-eval-result-content-tail-keymap)
   301	    (put-text-property node-start node-end 'font-lock-face 'greger-eval-result-face)))
   302	
   303	(defun greger-ui--make-eval-result-tag-invisible (node _override _start _end)
   304	  "Handle eval result end tag visibility and styling based on folding mode."
   305	  (condition-case nil
   306	      (let ((node-start (treesit-node-start node))
   307	            (node-end (min (treesit-node-end node) (point-max))))
   308	
   309	        (when (<= node-end (point-max))
   310	          (if greger-ui-folding-mode
   311	              ;; Hide end tag when folding mode is enabled
   312	              (put-text-property node-start node-end 'invisible t)
   313	            ;; Show styled tag when folding mode is disabled
   314	            (progn
   315	              (remove-text-properties node-start node-end '(invisible nil))
   316	              (put-text-property node-start node-end 'font-lock-face 'greger-tool-tag-face)))))
   317	    (treesit-node-outdated
   318	     ;; Node became outdated, skip this operation
   319	     nil)))
   320	
   321	(defun greger-ui--make-code-close-invisible (node _override _start _end)
   322	  "Make code_close NODE invisible when folding mode is enabled."
   323	  (condition-case nil
   324	      (let ((node-start (treesit-node-start node))
   325	            (node-end (min (treesit-node-end node) (point-max))))
   326	
   327	        (when (<= node-end (point-max))
   328	          (if greger-ui-folding-mode
   329	              ;; Hide code_close when folding mode is enabled
   330	              (put-text-property node-start node-end 'invisible t)
   331	            ;; Show styled code_close when folding mode is disabled
   332	            (progn
   333	              (remove-text-properties node-start node-end '(invisible nil))
   334	              (put-text-property node-start node-end 'font-lock-face 'greger-tool-tag-face)))))
   335	    (treesit-node-outdated
   336	     ;; Node became outdated, skip this operation
   337	     nil)))
   338	
   339	(defun greger-ui--eval-result-start-tag-with-arrow (node _override _start _end)
   340	  "Show arrow for eval result start tag NODE when folding mode is enabled."
   341	  (let ((node-start (treesit-node-start node))
   342	        (node-end (treesit-node-end node)))
   343	    (if greger-ui-folding-mode
   344	        ;; Show arrow when folding mode is enabled
   345	        (progn
   346	          (remove-text-properties node-start node-end '(font-lock-face nil))
   347	          (put-text-property node-start node-end 'display (propertize "⇒" 'face 'greger-eval-arrow-face)))
   348	      ;; Show styled tag when folding mode is disabled
   349	      (remove-text-properties node-start node-end '(display nil invisible nil))
   350	      (put-text-property node-start node-end 'font-lock-face 'greger-tool-tag-face))))
