  1261	  "Process a single eval block represented by EVAL-NODE.
  1262	If CLEAR-EXISTING, clear any existing eval results."
  1263	  (let* ((start-tag-node (treesit-search-subtree eval-node "eval_start_brace"))
  1264	         (end-tag-node (treesit-search-subtree eval-node "eval_end_brace"))
  1265	         (content-node (treesit-search-subtree eval-node "eval_content"))
  1266	         (language (greger--extract-eval-language start-tag-node))
  1267	         (code (treesit-node-text content-node t))
  1268	         (eval-id (greger--generate-eval-id))
  1269	         (result (greger--eval-code language (string-trim code)))
  1270	         (existing-result-node (treesit-search-subtree eval-node "eval_result"))
  1271	         (new-result-block (format "<eval-result-%s>%s</eval-result-%s>" eval-id result eval-id))
  1272	         (content-end (treesit-node-end content-node))
  1273	         (end-tag-start (treesit-node-start end-tag-node)))
  1274	
