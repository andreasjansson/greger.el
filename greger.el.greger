   375	;;;###autoload
   376	(defun greger-set-grammar-branch (branch)
   377	  "Set the git branch to use for greger grammar installation and install it.
   378	BRANCH should be a git branch name (e.g., 'main', 'dev', 'feature-branch').
   379	Use nil to revert to the default 'main' branch."
   380	  (interactive "sBranch name (empty for main): ")
   381	  (if (and branch (not (string-empty-p branch)))
   382	      (progn
   383	        (setq greger-local-grammar-path branch)
   384	        (message "Grammar branch set to: %s" branch)
   385	        (greger-install-grammar))
   386	    (progn
   387	      (setq greger-local-grammar-path nil)
   388	      (message "Reverted to main branch")
   389	      (greger-install-grammar))))
   390	
   391	(defun greger--install-eval-grammars ()
   392	  "Install language grammars needed for eval tag support."
   393	  (let ((grammars '((elisp "https://github.com/Wilfred/tree-sitter-elisp")
   394	                    (bash "https://github.com/tree-sitter/tree-sitter-bash"))))
   395	    (dolist (grammar grammars)
   396	      (let ((lang (car grammar)))
   397	        (unless (treesit-language-available-p lang)
   398	          (add-to-list 'treesit-language-source-alist grammar)
   399	          (treesit-install-language-grammar lang))))))
   400	
   401	;;;###autoload
   402	(defun greger-install-grammar ()
   403	  "Install greger tree-sitter grammar.
   404	Uses branch from `greger-local-grammar-path' if set, otherwise uses 'main'."
   405	  (interactive)
   406	  (message "=== GREGER GRAMMAR INSTALLATION DEBUG ===")
   407	  (message "greger-local-grammar-path: %S" greger-local-grammar-path)
   408	  
   409	  ;; Remove any existing greger entries first
   410	  (message "treesit-language-source-alist before cleanup: %S" treesit-language-source-alist)
   411	  (setq treesit-language-source-alist
   412	        (assq-delete-all 'greger treesit-language-source-alist))
   413	  (message "treesit-language-source-alist after cleanup: %S" treesit-language-source-alist)
   414	  
   415	  (let* ((grammar-source 
   416	          (cond 
   417	           ;; Local path (starts with / or ~)
   418	           ((and greger-local-grammar-path
   419	                 (or (string-prefix-p "/" greger-local-grammar-path)
   420	                     (string-prefix-p "~" greger-local-grammar-path)))
   421	            (let ((expanded-path (expand-file-name greger-local-grammar-path)))
   422	              (message "Installing greger grammar from local path: %s" expanded-path)
   423	              (list 'greger expanded-path)))
   424	           ;; Git branch name
   425	           (greger-local-grammar-path
   426	            (message "Installing greger grammar from branch: %s" greger-local-grammar-path)
   427	            (list 'greger "https://github.com/andreasjansson/greger-grammar" greger-local-grammar-path))
   428	           ;; Default to main branch
   429	           (t
   430	            (message "Installing greger grammar from main branch")
   431	            (list 'greger "https://github.com/andreasjansson/greger-grammar" "main")))))
   432	    
   433	    (message "Grammar source: %S" grammar-source)
   434	    (add-to-list 'treesit-language-source-alist grammar-source)
   435	    (message "treesit-language-source-alist after adding: %S" treesit-language-source-alist)
   436	    
   437	    (message "Calling treesit-install-language-grammar...")
   438	    (treesit-install-language-grammar 'greger)
   439	    (message "treesit-install-language-grammar completed")
   440	    
   441	    (message "Checking grammar availability...")
   442	    (message "treesit-language-available-p result: %S" (treesit-language-available-p 'greger))
   443	    (message "treesit-ready-p result: %S" (treesit-ready-p 'greger))
   444	    
   445	    ;; Try to get detailed info
   446	    (condition-case err
   447	        (progn
   448	          (message "Testing query validation...")
   449	          (treesit-query-validate 'greger '((eval)))
   450	          (message "Query validation succeeded!"))
   451	      (error 
   452	       (message "Query validation failed: %S" err)))
   453	    
   454	    (unless (treesit-ready-p 'greger)
   455	      (error "Tree-sitter for Greger isn't available"))
   456	    
   457	    (message "=== GREGER GRAMMAR INSTALLATION DEBUG END ===")))
   458	
   459	;;;###autoload
   460	(define-derived-mode greger-mode prog-mode "Greger"
   461	  "Major mode for editing Greger files with tree-sitter support."
   462	  ;; Try to use tree-sitter if available
   463	  (unless (treesit-language-available-p 'greger)
   464	    (greger-install-grammar))
   465	  (unless (treesit-ready-p 'greger)
   466	    (error "Greger grammar is not installed"))
   467	
   468	  (treesit-parser-create 'greger)
   469	  (setq-local treesit-font-lock-settings greger--treesit-font-lock-settings)
   470	  (setq-local treesit-font-lock-feature-list
   471	              '((tool-tags tool-syntax-highlighting eval-tags code-styling)
   472	                (headers folding comments tool-result-syntax)
   473	                (error)))
   474	  (setq-local treesit-simple-indent-rules greger--treesit-indent-rules)
   475	
   476	  ;; This crashes Emacs 29.0.91 but not Emacs 30.1. TODO: test if it crashes Emacs 29.1
   477	  ;; Reproduce: At beginning of buffer, run (treesit-search-forward-goto (treesit-node-at (point)) "" t t t)
   478	  (setq-local treesit-defun-type-regexp (rx line-start
   479	                                            (or "system"
   480	                                                "user"
   481	                                                "assistant"
   482	                                                "tool_use"
   483	                                                "server_tool_user"
   484	                                                "tool_result"
   485	                                                "web_search_tool_result")
   486	                                            line-end))
   487	
   488	  ;; Install eval grammars and set up embedded language parsing
   489	  (greger--install-eval-grammars)
   490	  (setq-local treesit-range-settings
   491	              (treesit-range-rules
   492	               :embed 'bash
   493	               :host 'greger
   494	               :local t
   495	               '(((eval (eval_start_brace (eval_language) @lang) (eval_content) @content)
   496	                  (:match "sh" @lang)))
   497	               :embed 'elisp
   498	               :host 'greger
   499	               :local t
   500	               '((eval (eval_content) @content))))
   501	
   502	  (treesit-major-mode-setup)
   503	
   504	  (setq-local mode-line-misc-info '(:eval (greger--mode-line-info)))
   505	  (use-local-map greger-mode-map)
   506	
   507	  (setq-local greger-current-thinking-budget greger-thinking-budget))
   508	
   509	;;;###autoload
   510	(defun greger (&optional with-context)
   511	  "Create a new buffer and switch to `greger-mode`.
   512	With WITH-CONTEXT (e.g. \[universal-argument] \[greger]), save
   513	the current buffer, split the window if not already split, and
   514	insert location information at the beginning of the user section."
   515	  (interactive "P")
   516	  (let ((buffer (generate-new-buffer "*greger*"))
   517	        (source-info (when with-context
   518	                       (save-buffer)
   519	                       (list (buffer-file-name)
   520	                             (line-number-at-pos)
   521	                             (current-column)))))
   522	    (when with-context
   523	      ;; Split horizontally if not already split
   524	      (when (= (length (window-list)) 1)
   525	        (split-window-right))
   526	      ;; Move to the next window
   527	      (other-window 1))
   528	    (switch-to-buffer buffer)
   529	    (greger-mode)
   530	    (insert greger-parser-system-tag
   531	            "\n\n" greger-default-system-prompt "\n\n"
   532	            greger-parser-user-tag
   533	            "\n\n")
   534	    (when source-info
   535	      (let ((file-name (nth 0 source-info))
   536	            (line-num (nth 1 source-info))
   537	            (column (nth 2 source-info)))
   538	        (insert (format "In %s, at line %d%s, implement the following:\n\n"
   539	                        file-name
   540	                        line-num
   541	                        (if (> column 0)
   542	                            (format " and column %d" column)
   543	                          "")))))
   544	    buffer))
   545	
   546	(defun greger-insert-assistant-tag ()
   547	  "Insert the assistant tag into the buffer."
   548	  (interactive)
   549	  (insert greger-parser-assistant-tag "\n\n"))
   550	
   551	(defun greger-insert-user-tag ()
   552	  "Insert the user tag into the buffer."
   553	  (interactive)
   554	  (insert greger-parser-user-tag "\n\n"))
   555	
   556	(defun greger-insert-system-tag ()
   557	  "Insert the system tag into the buffer."
   558	  (interactive)
   559	  (insert greger-parser-system-tag "\n\n"))
   560	
   561	(defun greger-interrupt ()
   562	  "Interrupt ongoing generation if active, otherwise call `keyboard-quit'."
   563	  (interactive)
   564	
   565	  ;; to not get stuck in read only
   566	  (greger--set-buffer-read-only nil)
   567	
   568	  (let* ((buffer (current-buffer))
   569	         (state (buffer-local-value 'greger--current-state buffer)))
   570	    (cond
   571	
   572	     ;; If there are executing tools, cancel them
   573	     ((and state
   574	           (greger-state-executing-tools state)
   575	           (> (hash-table-count (greger-state-executing-tools state)) 0))
   576	      (let ((executing-tools (greger-state-executing-tools state)))
   577	        (maphash (lambda (_tool-id greger-tool)
   578	                   (let ((cancel-fn (greger-tool-cancel-fn greger-tool)))
   579	                     (when (functionp cancel-fn)
   580	                       (funcall cancel-fn))))
   581	                 executing-tools)
   582	        (greger--update-buffer-state))
   583	      'executing)
   584	
   585	     ;; If there's an active client state, cancel the streaming request
   586	     ((and state (greger-state-client-state state))
   587	      (if (eq greger-provider 'openrouter)
   588	          (greger-openrouter--cancel-request (greger-state-client-state state))
   589	        (greger-client--cancel-request (greger-state-client-state state)))
   590	      (greger--finish-response state)
   591	      'generating)
   592	
   593	     ;; Default case: call keyboard-quit
   594	     (t
   595	      (keyboard-quit)
   596	      'idle))))
   597	
   598	(defun greger-set-model ()
   599	  "Set the current model."
   600	  (interactive)
   601	  (let ((model (completing-read "Choose model: " greger-available-models nil t)))
   602	    (customize-set-variable 'greger-model (intern model))
   603	    (message "Model set to %s" model)))
   604	
   605	(defun greger-toggle-thinking ()
   606	  "Toggle thinking on/off."
   607	  (interactive)
   608	  (if (> greger-current-thinking-budget 0)
   609	      (progn
   610	        (setq-local greger-current-thinking-budget 0)
   611	        (message "Thinking disabled"))
   612	    (progn
   613	      (setq-local greger-current-thinking-budget greger-thinking-budget)
   614	      (message "Thinking enabled (budget: %d tokens)" greger-current-thinking-budget)))
   615	  (force-mode-line-update))
   616	
   617	(defun greger-toggle-follow-mode ()
   618	  "Toggle follow mode on/off.
   619	When follow mode is enabled, point moves to the bottom during chat updates.
   620	When disabled, point position is preserved using `save-excursion'."
   621	  (interactive)
   622	  (setq-local greger-follow-mode (not greger-follow-mode))
   623	  (when greger-follow-mode
   624	    (goto-char (point-max)))
   625	  (message "Follow mode %s" (if greger-follow-mode "enabled" "disabled"))
   626	  (force-mode-line-update))
   627	
   628	(defun greger-mention-buffer-file (buffer)
   629	  "Insert the file path of BUFFER at point.
   630	When called interactively, prompts for buffer selection.
   631	When called programmatically, BUFFER can be a buffer object or buffer name.
   632	Uses relative path if file is in current working directory or subdirectory.
   633	Uses ~/path notation if file is in home directory or subdirectory."
   634	  (interactive "bBuffer: ")
   635	
   636	  (if-let* ((buf (if (bufferp buffer) buffer (get-buffer buffer)))
   637	            (file-path (when buf (buffer-file-name buf))))
   638	      (let* ((file-path-abs (expand-file-name file-path))
   639	             (home-dir (expand-file-name "~/"))
   640	             (cwd (file-name-as-directory (expand-file-name default-directory)))
   641	             (formatted-path (cond
   642	                              ;; If file is in cwd or subdirectory, use relative path
   643	                              ((string-prefix-p cwd file-path-abs)
   644	                               (file-relative-name file-path))
   645	                              ;; If file is in home directory or subdirectory, use ~/path
   646	                              ((string-prefix-p home-dir file-path-abs)
   647	                               (concat "~/" (file-relative-name file-path home-dir)))
   648	                              ;; Otherwise, use absolute path
   649	                              (t file-path))))
   650	        (insert formatted-path))
   651	    (user-error "Buffer %s has no associated file" (or (buffer-name buf) buffer))))
   652	
   653	(defun greger-set-provider ()
   654	  "Interactively set the API provider."
   655	  (interactive)
   656	  (let ((choice (completing-read
   657	                 "Select provider: "
   658	                 '(("Anthropic (Claude) - Default" . anthropic)
   659	                   ("OpenRouter (Beta)" . openrouter))
   660	                 nil t)))
   661	    (setq greger-provider (cdr (assoc choice 
   662	                                      '(("Anthropic (Claude) - Default" . anthropic)
   663	                                        ("OpenRouter (Beta)" . openrouter)))))
   664	    (message "Provider set to: %s" choice)))
   665	
   666	(defun greger-set-openrouter-model ()
   667	  "Set the OpenRouter model when using OpenRouter provider."
   668	  (interactive)
   669	  (unless (eq greger-provider 'openrouter)
   670	    (user-error "OpenRouter provider not active. Use M-x greger-set-provider first"))
   671	  (let ((models '("openai/gpt-5"
   672	                  "openai/gpt-5-codex" 
   673	                  "openai/gpt-5-mini"
   674	                  "anthropic/claude-sonnet-4"
   675	                  "anthropic/claude-opus-4"
   676	                  "google/gemini-2.5-pro")))
   677	    (setq greger-openrouter-model 
   678	          (completing-read "OpenRouter model: " models nil nil))
   679	    (message "OpenRouter model set to: %s" greger-openrouter-model)))
   680	
   681	(defun greger-debug-request ()
   682	  "Debug the request data by parsing the buffer and saving the request data output.
   683	After saving, opens the JSON file in a new buffer for inspection."
   684	  (interactive)
   685	  (let* ((filename (read-string "Save to filename (default: request.json): " nil nil "request.json"))
   686	         (dialog (greger-parser-markdown-buffer-to-dialog (current-buffer)))
   687	         (tools (when greger-tools
   688	                  (greger-tools-get-schemas greger-tools)))
   689	         (server-tools (when greger-server-tools
   690	                         (greger-server-tools-get-schemas greger-server-tools)))
   691	         (model greger-model)
   692	         (request-data (greger-client--build-data model dialog tools server-tools greger-current-thinking-budget greger-max-tokens))
   693	         (parsed-json (json-read-from-string request-data)))
   694	
   695	    (with-temp-file filename
   696	      (let ((json-encoding-pretty-print t))
   697	        (insert (json-encode parsed-json))))
   698	    (message "Request data saved to %s" filename)
   699	    ;; Open the file in a new buffer for inspection
   700	    (find-file filename)))
   701	
   702	(defun greger-buffer (&optional no-tools)
   703	  "Send buffer content to AI as an agent dialog with tool support.
   704	When NO-TOOLS is set, disable tools and thinking."
   705	  (interactive "P")
   706	  (greger--ensure-buffer-can-be-submitted)
   707	
   708	  (let ((greger-tools (if no-tools '() greger-tools))
   709	        (greger-server-tools (if no-tools '() greger-server-tools))
   710	        (greger-current-thinking-budget (if no-tools 0 greger-current-thinking-budget)))
   711	    (greger--process-evals)
   712	    
   713	    (greger--run-agent-loop (make-greger-state
   714	                             :current-iteration 0
   715	                             :chat-buffer (current-buffer)
   716	                             :directory default-directory
   717	                             :tool-use-metadata `(:safe-shell-commands () :allow-all-shell-commands ,greger-allow-all-shell-commands)))))
   718	
   719	(defun greger-buffer-no-tools ()
   720	  "Send the buffer content to AI as a dialog without tool use or thinking."
   721	  (interactive)
   722	  (greger-buffer t))
   723	
   724	(defmacro greger--maybe-save-excursion (&rest body)
   725	  "Execute BODY, optionally preserving point position.
   726	If `greger-follow-mode' is enabled, point follows output
   727	at the end of the buffer.
   728	If `greger-follow-mode' is disabled, use `save-excursion'
   729	to preserve point position."
   730	  `(if greger-follow-mode
   731	       (progn ,@body)
   732	     (save-excursion ,@body)))
   733	
   734	(defun greger--live-chat-buffer (state)
   735	  "Return the chat buffer from STATE if it's still live."
   736	  (let ((buffer (greger-state-chat-buffer state)))
   737	    (when (buffer-live-p buffer)
   738	      buffer)))
   739	
   740	(defun greger--get-current-status ()
   741	  "Get the current greger status: \='idle, \='generating, or \='executing."
   742	  (let ((state (buffer-local-value 'greger--current-state (current-buffer))))
   743	    (cond
   744	     ;; Check if we're executing tools
   745	     ((and state
   746	           (greger-state-executing-tools state)
   747	           (> (hash-table-count (greger-state-executing-tools state)) 0))
   748	      'executing)
   749	     ;; Check if we're generating (client-state is active)
   750	     ((and state (greger-state-client-state state))
   751	      'generating)
   752	     ;; Otherwise we're idle
   753	     (t 'idle))))
   754	
   755	(defun greger--mode-line-info ()
   756	  "Generate mode line information showing model and current state."
   757	  (let ((status (greger--get-current-status))
   758	        (model-name (symbol-name greger-model)))
   759	    (concat model-name
   760	            (if (> greger-current-thinking-budget 0)
   761	                (format " [T:%d]" greger-current-thinking-budget)
   762	              "")
   763	            (pcase status
   764	              ('generating " [Generating]")
   765	              ('executing " [Executing]")
   766	              ('idle "")))))
   767	
   768	(defun greger--set-buffer-read-only (read-only)
   769	  "Set buffer read-only state for greger operations.
   770	READ-ONLY is t to make read-only, nil to make writable."
   771	  (if read-only
   772	      (unless greger--buffer-read-only-by-greger
   773	        (setq greger--buffer-read-only-by-greger t)
   774	        (setq buffer-read-only t))
   775	    (when greger--buffer-read-only-by-greger
   776	      (setq greger--buffer-read-only-by-greger nil)
   777	      (setq buffer-read-only nil))))
   778	
   779	(defun greger--update-buffer-state ()
   780	  "Update buffer read-only state based on current greger state."
   781	  (let ((status (greger--get-current-status)))
   782	    (greger--set-buffer-read-only (not (eq status 'idle)))
   783	    ;; Force mode line update
   784	    (force-mode-line-update)))
   785	
   786	(defun greger--ensure-buffer-can-be-submitted ()
   787	  "Ensure buffer can be submitted by fixing common issues with last message.
   788	Uses tree-sitter to find the last node and applies heuristics:
   789	- If last assistant text is empty or whitespace-only, insert '.'
   790	- If last assistant text ends with whitespace, trim it
   791	- If last message is thinking, insert '# ASSISTANT\\n\\n.' before submitting"
   792	  (let* ((root-node (treesit-buffer-root-node))
   793	         (last-node (greger--find-last-message-node root-node)))
   794	
   795	    (when last-node
   796	      (let ((node-type (treesit-node-type last-node)))
   797	        (cond
   798	         ((string= node-type "user")
   799	          (greger--insert-if-empty-content last-node "Continue"))
   800	
   801	         ((string= node-type "assistant")
   802	          (greger--insert-if-empty-content last-node "."))
   803	
   804	         ((string= node-type "thinking")
   805	          (greger--insert-assistant-after-thinking last-node)))))))
   806	
   807	(defun greger--find-last-message-node (root-node)
   808	  "Find the last message node in ROOT-NODE."
   809	  (let ((children (treesit-node-children root-node))
   810	        (last-message-node nil))
   811	    (dolist (child children)
   812	      (let ((node-type (treesit-node-type child)))
   813	        (when (member node-type '("assistant" "thinking" "user" "system"
   814	                                  "tool_use" "server_tool_use" "tool_result"
   815	                                  "web_search_tool_result" "untagged_text"))
   816	          (setq last-message-node child))))
   817	    last-message-node))
   818	
   819	(defun greger--insert-if-empty-content (node text)
   820	  "Add TEXT to NODE content if content is empty."
   821	  (let* ((header (treesit-node-child node 0 t))
   822	         (start-pos (treesit-node-end header))
   823	         (end-pos (treesit-node-end node))
   824	         (content (buffer-substring-no-properties start-pos end-pos)))
   825	
   826	    ;; Insert a dot if content is empty
   827	    (when (string= (string-trim content) "")
   828	      (greger--maybe-save-excursion
   829	       (goto-char end-pos)
   830	       (insert text)))))
   831	
   832	(defun greger--insert-assistant-after-thinking (thinking-node)
   833	  "Insert assistant response after THINKING-NODE."
   834	  (let ((end-pos (treesit-node-end thinking-node)))
   835	    (greger--maybe-save-excursion
   836	     (goto-char end-pos)
   837	     (insert "\n\n# ASSISTANT\n\n."))))
   838	
   839	(defun greger--run-agent-loop (state)
   840	  "Run the main agent loop with STATE.
   841	Dispatches to provider-specific implementation based on greger-provider."
   842	  (if (eq greger-provider 'openrouter)
   843	      (greger-openrouter--run-agent-loop state)
   844	    (greger--run-agent-loop-claude state)))
   845	
   846	(defun greger-openrouter--run-agent-loop (state)
   847	  "Run agent loop using OpenRouter - parallel to greger--run-agent-loop-claude."
   848	  (let* ((tools (greger-tools-get-schemas greger-tools))
   849	         (enable-web-search (and greger-server-tools
   850	                                 (member "web_search" greger-server-tools)))
   851	         (chat-buffer (greger-state-chat-buffer state))
   852	         (dialog (greger-parser-markdown-buffer-to-dialog chat-buffer))
   853	         (safe-shell-commands (greger-parser-find-safe-shell-commands-in-buffer chat-buffer))
   854	         (tool-use-metadata (greger-state-tool-use-metadata state))
   855	         (current-iteration (greger-state-current-iteration state))
   856	         (auth-key (or (and greger-openrouter-api-key-fn 
   857	                            (funcall greger-openrouter-api-key-fn))
   858	                       (getenv "OPENROUTER_API_KEY"))))
   859	    
   860	    (setf (plist-get tool-use-metadata :safe-shell-commands) safe-shell-commands)
   861	    
   862	    (when (>= current-iteration greger-max-iterations)
   863	      (error "Maximum iterations (%d) reached" greger-max-iterations))
   864	    
   865	    (unless auth-key
   866	      (error "No OpenRouter API key found. Set OPENROUTER_API_KEY environment variable or configure greger-openrouter-api-key-fn"))
   867	    
   868	    (with-current-buffer chat-buffer
   869	      (let ((client-state (greger-openrouter-stream
   870	                           :model greger-openrouter-model
   871	                           :dialog dialog
   872	                           :tools tools
   873	                           :enable-web-search enable-web-search
   874	                           :buffer chat-buffer
   875	                           :thinking-budget greger-current-thinking-budget
   876	                           :auth-key auth-key
   877	                           :block-start-callback (lambda (content-block)
   878	                                                   (greger--append-streaming-content-header state content-block))
   879	                           :text-delta-callback (lambda (text)
   880	                                                  (greger--append-text state (greger--clean-excessive-newlines text)))
   881	                           :block-stop-callback (lambda (type content-block)
   882	                                                  (greger--append-handle-content-block-stop state type content-block))
   883	                           :complete-callback (lambda (content-blocks) 
   884	                                                (greger--handle-stream-completion state content-blocks))
   885	                           :error-callback (lambda (error-message)
   886	                                             (greger--handle-client-error state error-message))
   887	                           :max-tokens greger-max-tokens)))
   888	        
   889	        (setf (greger-state-client-state state) client-state)
   890	        (setq greger--current-state state)
   891	        (greger--update-buffer-state)))))
   892	
   893	(defun greger--run-agent-loop-claude (state)
   894	  "Run the main agent loop with STATE using Claude/Anthropic.
   895	This is the original implementation, unchanged."
   896	  (let* ((tools (greger-tools-get-schemas greger-tools))
   897	         (server-tools (when greger-server-tools
   898	                         (greger-server-tools-get-schemas greger-server-tools)))
   899	         (chat-buffer (greger-state-chat-buffer state))
   900	         (dialog (greger-parser-markdown-buffer-to-dialog chat-buffer))
   901	         (safe-shell-commands (greger-parser-find-safe-shell-commands-in-buffer chat-buffer))
   902	         (tool-use-metadata (greger-state-tool-use-metadata state))
   903	         (current-iteration (greger-state-current-iteration state))
   904	         (auth-key (or (and greger-anthropic-key-fn (funcall greger-anthropic-key-fn))
   905	                       (getenv "ANTHROPIC_API_KEY"))))
   906	
   907	    (setf (plist-get tool-use-metadata :safe-shell-commands) safe-shell-commands)
   908	
   909	    (when (>= current-iteration greger-max-iterations)
   910	      (error "Maximum iterations (%d) reached, stopping agent execution" greger-max-iterations))
   911	
   912	    (unless auth-key
   913	      (error "No API key found.  Set ANTHROPIC_API_KEY environment variable or configure greger-anthropic-key-fn"))
   914	
   915	
   916	    (with-current-buffer chat-buffer
   917	      (let ((client-state (greger-client-stream
   918	                           :model greger-model
   919	                           :dialog dialog
   920	                           :tools tools
   921	                           :server-tools server-tools
   922	                           :buffer chat-buffer
   923	                           :thinking-budget greger-current-thinking-budget
   924	                           :auth-key auth-key
   925	                           :block-start-callback (lambda (content-block)
   926	                                                   (greger--append-streaming-content-header state content-block))
   927	                           :text-delta-callback (lambda (text)
   928	                                                  (greger--append-text state (greger--clean-excessive-newlines text)))
   929	                           :block-stop-callback (lambda (type content-block)
   930	                                                  (greger--append-handle-content-block-stop state type content-block))
   931	                           :complete-callback (lambda (content-blocks) (greger--handle-stream-completion state content-blocks))
   932	                           :error-callback (lambda (error-message)
   933	                                             (greger--handle-client-error state error-message))
   934	                           :max-tokens greger-max-tokens)))
   935	
   936	        ;; Store the client state for potential cancellation
   937	        (setf (greger-state-client-state state) client-state)
   938	        ;; Set buffer-local variable for greger-interrupt to access
   939	        (setq greger--current-state state) ;; TODO: why do we set that _here_? Or should it be greger--current-client-state instead?
   940	        (greger--update-buffer-state)))))
   941	
   942	(defun greger--clean-excessive-newlines (text)
   943	  "Remove excessive newlines from the end of TEXT, keeping at most two.
   944	If TEXT ends with more than two consecutive newlines, remove all but the
   945	first two."
   946	  (replace-regexp-in-string "\n\n\n+\\'" "\n\n" text))
   947	
   948	(defun greger--force-code-close (state)
   949	  (with-current-buffer (greger-state-chat-buffer state)
   950	    (let ((end-is-code nil)
   951	          (inhibit-read-only t))
   952	     (save-excursion
   953	       (goto-char (point-max))
   954	       (insert "\n")
   955	       (when (string= (treesit-node-type (treesit-node-at (1- (point-max)))) "code_content")
   956	         (setq end-is-code t))
   957	       (delete-char -1))
   958	     (when end-is-code
   959	       (insert "<$code-close/>")))))
   960	
   961	(defun greger--append-streaming-content-header (state content-block)
   962	  "Append appropriate header for streaming CONTENT-BLOCK to STATE."
   963	
   964	  (greger--force-code-close state)
   965	
   966	  (let ((type (alist-get 'type content-block))
   967	        (has-citations (assq 'citations content-block)))
   968	    (cond
   969	     ((and (string= type "text") (not has-citations))
   970	      (greger--append-text state (concat "\n\n" greger-parser-assistant-tag "\n\n")))
   971	     ((string= type "thinking")
   972	      (greger--append-text state (concat "\n\n" greger-parser-thinking-tag "\n\n")))
   973	     (t nil))))
   974	
   975	(defun greger--handle-stream-completion (state content-blocks)
   976	  "Handle completion of stream with STATE and CONTENT-BLOCKS."
   977	  (if-let ((tool-calls (greger--extract-tool-calls content-blocks)))
   978	      (progn
   979	        (setf (greger-state-current-iteration state)
   980	              (1+ (greger-state-current-iteration state)))
   981	        ;; TODO: execute tool calls in greger--append-content-block instead
   982	        (greger--execute-tools tool-calls state))
   983	    (greger--finish-response state))
   984	
   985	  (when-let ((buffer (greger--live-chat-buffer state)))
   986	    (with-current-buffer buffer
   987	      (greger--update-buffer-state))))
   988	
   989	(defun greger--content-block-supports-streaming (content-block)
   990	  "Check if CONTENT-BLOCK can be streamed incrementally.
   991	Returns non-nil for text and thinking blocks without citations, which can
   992	be displayed as they arrive rather than waiting for completion."
   993	  (let ((type (alist-get 'type content-block))
   994	        (citations (alist-get 'citations content-block)))
   995	    (and (or (string= type "text") (string= type "thinking"))
   996	         (not citations))))
   997	
   998	(defun greger--append-handle-content-block-stop (state type content-block)
   999	  "Append non-streaming CONTENT-BLOCK of TYPE to STATE."
  1000	  ;; Only append markdown if it hasn't done that already during streaming
  1001	  (unless (greger--content-block-supports-streaming content-block)
  1002	    (let ((markdown (greger-parser--block-to-markdown content-block)))
  1003	      (greger--append-text state (concat "\n\n" markdown))))
  1004	
  1005	  ;; Special cases for tool use and thinking
  1006	  (cond
  1007	   ((string= type "tool_use")
  1008	    (let ((tool-id (alist-get 'id content-block)))
  1009	      (greger--append-text state (concat "\n\n" (greger--tool-result-placeholder tool-id)))))
  1010	   ((string= type "thinking")
  1011	    (let ((signature (alist-get 'signature content-block)))
  1012	      (greger--insert-thinking-signature state signature))))
  1013	
  1014	  ;; Update buffer state after client completes
  1015	  (when-let ((buffer (greger--live-chat-buffer state)))
  1016	    (with-current-buffer buffer
  1017	      (greger--update-buffer-state))))
  1018	
  1019	(defun greger--insert-thinking-signature (state signature)
  1020	  "Insert thinking SIGNATURE after the last thinking tag, using STATE.
  1021	Assumes the last inserted thing is a thinking tag."
  1022	  (with-current-buffer (greger-state-chat-buffer state)
  1023	    (save-excursion
  1024	      (goto-char (point-max))
  1025	      (re-search-backward "^# THINKING")
  1026	      (forward-line 1)
  1027	      (let ((inhibit-read-only t))
  1028	        (insert "\n"
  1029	                "Signature: " signature
  1030	                "\n")))))
  1031	
  1032	(defun greger--extract-tool-calls (content-blocks)
  1033	  "Extract tool call from CONTENT-BLOCKS."
  1034	  (let ((tool-calls '()))
  1035	    (dolist (block content-blocks)
  1036	      (when (string= (alist-get 'type block) "tool_use")
  1037	        (push block tool-calls)))
  1038	    (reverse tool-calls)))
  1039	
  1040	(defun greger--tool-result-placeholder (tool-id)
  1041	  "Generate placeholder string for TOOL-ID."
  1042	  ;; It's ugly that we need to insert the trailing \n
  1043	  ;; But we need it because otherwise the closing tool tag is not recognized.
  1044	  ;; TODO: update greger-grammar
  1045	  (let ((placeholder (concat (greger-parser--wrapped-tool-content greger-parser-tool-result-tag tool-id "") "\n")))
  1046	    ;; Add a text property to the first character to indicate this is a generating tool result
  1047	    (put-text-property 0 1 'greger-tool-result-generating t placeholder)
  1048	    placeholder))
  1049	
  1050	(defun greger--execute-tools (tool-calls state)
  1051	  "Execute TOOL-CALLS using STATE in parallel with callbacks."
  1052	  (let* ((total-tools (length tool-calls))
  1053	         (completed-tools 0)
  1054	         (executing-tools-map (make-hash-table :test 'equal)))
  1055	
  1056	    ;; Initialize executing-tools in state if not already set
  1057	    (unless (greger-state-executing-tools state)
  1058	      (setf (greger-state-executing-tools state) executing-tools-map))
  1059	
  1060	    ;; Update buffer state to show we're executing tools
  1061	    (when-let ((buffer (greger--live-chat-buffer state)))
  1062	      (with-current-buffer buffer
  1063	        (greger--update-buffer-state)
  1064	
  1065	        (greger--maybe-save-excursion
  1066	         (goto-char (point-max)))))
  1067	
  1068	    ;; Execute all tools in parallel
  1069	    (dolist (tool-call tool-calls)
  1070	      (let* ((tool-name (alist-get 'name tool-call))
  1071	             (tool-input (alist-get 'input tool-call))
  1072	             (tool-id (alist-get 'id tool-call))
  1073	             (default-directory (greger-state-directory state))
  1074	
  1075	             ;; TODO: This is ugly, we really should be separating the creation and execution of tools
  1076	             ;; We're only doing this because for synchronous tools we can't set the tool in the
  1077	             ;; hashmap after execution, because sync tools have already removed the key then.
  1078	             (placeholder-tool (make-greger-tool :cancel-fn nil)))
  1079	
  1080	        (puthash tool-id placeholder-tool (greger-state-executing-tools state))
  1081	
  1082	        (greger--update-buffer-state)
  1083	        (sit-for 0.001) ;; update the buffer state
  1084	
  1085	        (let ((greger-tool (greger-tools-execute
  1086	                            :tool-name tool-name
  1087	                            :args tool-input
  1088	                            :callback (lambda (result error)
  1089	                                        ;; Remove tool from executing-tools when complete
  1090	                                        (remhash tool-id (greger-state-executing-tools state))
  1091	
  1092	                                        (greger--handle-tool-completion
  1093	                                         :tool-id tool-id
  1094	                                         :result result
  1095	                                         :error error
  1096	                                         :state state
  1097	                                         :completion-callback (lambda ()
  1098	                                                                ;; TODO: add completed-tools to state instead of this nested callback
  1099	                                                                (setq completed-tools (1+ completed-tools))
  1100	                                                                (when (and (= completed-tools total-tools)
  1101	                                                                           (greger-state-chat-buffer state))
  1102	                                                                  (greger--run-agent-loop state)))))
  1103	                            :streaming-callback (lambda (text)
  1104	                                                  (greger--append-tool-result-text state tool-id text))
  1105	                            :buffer (greger-state-chat-buffer state)
  1106	                            :metadata (greger-state-tool-use-metadata state))))
  1107	
  1108	          ;; TODO: here again, it's ugly
  1109	          (when (greger-tool-cancel-fn greger-tool)
  1110	            (puthash tool-id greger-tool (greger-state-executing-tools state))))))))
  1111	
  1112	(defun greger--append-text (state text)
  1113	  "Append TEXT to the chat buffer in STATE."
  1114	  (let ((buffer (greger-state-chat-buffer state)))
  1115	    (with-current-buffer buffer
  1116	      (let ((inhibit-read-only t))
  1117	        (greger--maybe-save-excursion
  1118	         (goto-char (point-max))
  1119	         (insert text))))))
  1120	
  1121	(cl-defun greger--handle-tool-completion (&key tool-id result error state completion-callback)
  1122	  "Handle completion of a tool execution.
  1123	Updates buffer and calls callback when tool execution finishes.
  1124	TOOL-ID is the tool identifier.
  1125	RESULT is the tool execution result.
  1126	ERROR is any error that occurred.
  1127	STATE contains the current agent state.
  1128	COMPLETION-CALLBACK is called when complete."
  1129	  (let ((tool-result-text (if error
  1130	                              (if (listp error)
  1131	                                  (error-message-string error)
  1132	                                error)
  1133	                            result)))
  1134	
  1135	    (greger--append-tool-result-text state tool-id tool-result-text t)
  1136	
  1137	    ;; Call completion callback
  1138	    (funcall completion-callback)))
  1139	
  1140	(defun greger--append-tool-result-text (state tool-id text &optional is-completed)
  1141	  "Append TEXT to the tool result content node for TOOL-ID in STATE's buffer.
  1142	When IS-COMPLETED is non-nil, also trim trailing newline after the tool's
  1143	end tag and update the buffer state."
  1144	  (when-let ((buffer (greger--live-chat-buffer state)))
  1145	    (with-current-buffer buffer
  1146	      (when-let ((inhibit-read-only t)
  1147	                 (tool-result-content-node (greger--find-tool-result-content-node tool-id))
  1148	                 (tool-result-content-start (treesit-node-start tool-result-content-node))
  1149	                 (tool-result-content-end (treesit-node-end tool-result-content-node)))
  1150	        (greger--maybe-save-excursion
  1151	         ;; Check if this is a vterm full replacement
  1152	         (if (string-prefix-p "VTERM_FULL_REPLACE:" text)
  1153	             ;; Replace entire tool result content with vterm buffer content
  1154	             (let ((vterm-content (substring text (length "VTERM_FULL_REPLACE:"))))
  1155	               (delete-region tool-result-content-start (1- tool-result-content-end))
  1156	               (goto-char tool-result-content-start)
  1157	               (insert vterm-content))
  1158	           ;; Regular streaming - append text directly (no terminal sequence processing)
  1159	           (progn
  1160	             (goto-char (1- tool-result-content-end))
  1161	             (insert text)))
  1162	
  1163	         (when is-completed
  1164	           ;; Trim trailing newline after closing tag
  1165	           (when-let* ((tool-result-content-node (greger--find-tool-result-content-node tool-id)) ;; content node might have gotten outdated, so need to get it again
  1166	                       (tool-end-tag (treesit-node-next-sibling tool-result-content-node t)))
  1167	             (when (string= (treesit-node-type tool-end-tag) "tool_end_tag")
  1168	               (goto-char (treesit-node-end tool-end-tag))
  1169	               (when (looking-at-p "\n")
  1170	                 (delete-char 1))))
  1171	
  1172	           ;; Remove the generating property from the tool result
  1173	           (when-let ((tool-result-node (greger--find-tool-result-node tool-id)))
  1174	             (let ((start (treesit-node-start tool-result-node))
  1175	                   (end (treesit-node-end tool-result-node)))
  1176	               (remove-text-properties start end '(greger-tool-result-generating))))
  1177	
  1178	           ;; Update buffer state after tool completion
  1179	           (greger--update-buffer-state)))))))
  1180	
  1181	(defun greger--find-tool-result-content-node (tool-id)
  1182	  "Find the tool_content node for the tool_result with TOOL-ID.
  1183	Uses treesit to query for a tool_result with matching id and returns
  1184	the tool_content node within its content section."
  1185	  (when-let* ((query `((tool_result (id (value) @id) (:match ,tool-id @id)
  1186	                                    (content) @content)))
  1187	              (capture (treesit-query-capture (treesit-buffer-root-node) query))
  1188	              (content-node (alist-get 'content capture))
  1189	              ;; for some reason, querying directly for tool_content fails, but this works
  1190	              (content-node-first-child (car (treesit-node-children content-node))))
  1191	    (treesit-search-subtree content-node-first-child "tool_content")))
