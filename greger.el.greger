    93	(greger-register-tool "replace-file"
    94	                      :description "Replace the entire contents of an existing file. Slow but reliable - replaces the complete file contents. Use str-replace for targeted changes in larger files."
    95	                      :properties '((path . ((type . "string")
    96	                                             (description . "Path to the file to replace")))
    97	                                    (contents . ((type . "string")
    98	                                                 (description . "New contents to replace the entire file")))
    99	                                    (git-commit-message . ((type . "string")
   100	                                                           (description . "Git commit message for this change"))))
   101	                      :required '("path" "contents" "git-commit-message")
   102	                      :function 'greger-stdlib--replace-file
   103	                      :pass-buffer t)
