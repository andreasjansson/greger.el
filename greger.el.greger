  1242	(defun greger--process-terminal-sequences-with-vterm (text)
  1243	  "Process terminal control sequences in TEXT using vterm for accurate rendering.
  1244	
  1245	This function creates a temporary vterm buffer, sends the text to it, and
  1246	extracts the properly rendered output. This ensures that all ANSI escape
  1247	sequences are handled correctly with full terminal emulation."
  1248	  (let ((vterm-buffer (generate-new-buffer " *greger-terminal*")))
  1249	    (unwind-protect
  1250	        (with-current-buffer vterm-buffer
  1251	          ;; Set up vterm environment for non-interactive use
  1252	          (let ((vterm-kill-buffer-on-exit nil)
  1253	                (vterm-shell "cat"))  ; Use cat as shell to just echo input
  1254	            (vterm-mode)
  1255	            
  1256	            ;; Configure process to not prompt on exit
  1257	            (when vterm--process
  1258	              (set-process-query-on-exit-flag vterm--process nil))
  1259	            
  1260	            ;; Send the text to vterm for processing
  1261	            (vterm-send-string text)
  1262	            
  1263	            ;; Wait a brief moment for vterm to process the text
  1264	            (sit-for 0.1)
  1265	            
  1266	            ;; Extract the rendered content
  1267	            (buffer-string)))
  1268	      ;; Clean up the temporary buffer
  1269	      (when (buffer-live-p vterm-buffer)
  1270	        (with-current-buffer vterm-buffer
  1271	          (when (and vterm--process (process-live-p vterm--process))
  1272	            (set-process-query-on-exit-flag vterm--process nil)))
