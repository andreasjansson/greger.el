   115	                                    (replace-all . ((type . "boolean")
   116	                                                    (description . "If true, replace all instances of original-content. If false (default), replace only the first instance")
   117	                                                    (default . nil))))
   118	                      :required '("path" "original-content" "new-content" "git-commit-message")
   119	                      :function 'greger-stdlib--str-replace
