  1246	    ;; Process evals in the last user section only
  1247	    (when-let* ((user-nodes (treesit-query-capture root-node '((user) @user)))
  1248	                (last-user-node (cdar (last user-nodes))))
  1249	      (greger--process-evals-in-node last-user-node :clear-existing t))))
