   137	                                                 (description . "Current path of the file")))
   138	                                    (new-path . ((type . "string")
   139	                                                 (description . "New path for the file")))
   140	                                    (git-commit-message . ((type . "string")
   141	                                                           (description . "Git commit message for this change"))))
