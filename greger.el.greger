   363	(defun greger-ui--open-url-at-point ()
   364	  "Open URL at point in default web browser."
   365	  (interactive)
   366	  (let* ((node (treesit-node-at (point)))
   367	         (text (treesit-node-text node t))
   368	
   369	         ;; remove leading `## `
   370	         (url (substring text 3)))
   371	    (browse-url url)))
