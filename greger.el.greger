  1234	(defun greger--process-evals ()
  1235	  "Process all eval blocks in current buffer according to greger eval semantics.
  1236	- Evaluate evals in system section every time
  1237	- Evaluate evals in current user section (last user section only)
  1238	- Replace eval blocks with eval results
  1239	- Raise errors if evaluation fails"
  1240	  (when-let* ((root-node (treesit-buffer-root-node))
