    21	;; IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    22	;; FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    23	;; AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    24	;; LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
    25	;; OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
    26	;; SOFTWARE.
    27	
    28	;;; Commentary:
    29	;; Defines tools registration functions
    30	
    31	;;; Code:
    32	
    33	(require 'json)
    34	(require 'cl-lib)
    35	
    36	;; Tool structure for tracking executing tools
    37	(cl-defstruct greger-tool
    38	  cancel-fn)
    39	
    40	;; Registry to hold tool definitions
    41	(defvar greger-tools-registry (make-hash-table :test 'equal)
    42	  "Hash table mapping tool names to their definitions.")
    43	
    44	;; Registry to hold server tool definitions
    45	(defvar greger-server-tools-registry (make-hash-table :test 'equal)
    46	  "Hash table mapping server tool names to their definitions.")
    47	
    48	;; greger-register-tool is the main public API of this package, so it uses the package prefix "greger-"
    49	;; rather than the file prefix "greger-tools-"
    50	;; package-lint: disable=wrong-prefix
    51	(defun greger-register-tool (name &rest args)
    52	  "Register a tool with NAME and properties specified in ARGS.
    53	ARGS should be a plist containing :description, :properties,
    54	:required,
    55	:function, and optionally :pass-buffer, :pass-callback, and
    56	:pass-metadata.
    57	
    58	Example:
    59	  (greger-register-tool \='rename-file
    60	    :description \='Rename or move a file from one path to another\='
    61	    :properties \='((old-path . ((type . \='string\=')
    62	                              (description . \='Current path of the file\=')))
    63	                  (new-path . ((type . \='string\=')
    64	                              (description . \='New path for the file\=')))
    65	                  (git-commit-message . ((type . \='string\=')
    66	                                        (description .
    67	                                         \='Git commit message\='))))
    68	    :required \='(\='old-path\=' \='new-path\=' \='git-commit-message\=')
    69	    :function \='greger-tools--rename-file
    70	    :pass-buffer t
    71	    :pass-callback t
    72	    :streaming t
    73	    :pass-metadata t)
    74	
    75	  When :pass-callback is set to t, the callback function will be passed to the
    76	  tool function as a \='callback\=' parameter instead of
    77	  `greger-tools-execute\='
    78	  calling the callback with the result.
    79	  When :pass-metadata is set to t, the metadata from the parser will be passed
    80	  as a \='metadata\=' parameter."
    81	  (let ((description (plist-get args :description))
    82	        (properties (plist-get args :properties))
    83	        (required (plist-get args :required))
    84	        (function (plist-get args :function))
    85	        (pass-buffer (plist-get args :pass-buffer))
    86	        (pass-callback (plist-get args :pass-callback))
    87	        (streaming (plist-get args :streaming))
    88	        (pass-metadata (plist-get args :pass-metadata)))
    89	    (puthash name
    90	             (list :schema (list (cons 'name name)
    91	                                 (cons 'description description)
    92	                                 (cons 'input_schema
    93	                                       (list (cons 'type "object")
    94	                                             (cons 'properties properties)
    95	                                             (cons 'required required))))
    96	                   :function function
    97	                   :pass-buffer pass-buffer
    98	                   :pass-callback pass-callback
    99	                   :streaming streaming
   100	                   :pass-metadata pass-metadata)
   101	             greger-tools-registry)))
   102	
   103	;; greger-register-server-tool is the main public API for server tools, so it uses the package prefix "greger-"
   104	;; rather than the file prefix "greger-tools-"
   105	;; package-lint: disable=wrong-prefix
   106	(defmacro greger-register-server-tool (name &rest args)
   107	  "Register a server tool with NAME and properties specified in ARGS.
   108	Server tools are processed by the server (e.g., Anthropic's web search tool).
   109	ARGS should be a plist containing at least :type and any other
   110	named parameters specific to the server tool.
   111	
   112	Example:
   113	  (greger-register-server-tool \\='web_search\\='
   114	    :type \\='web_search_20250305\\='
   115	    :max_uses 5
   116	    :allowed_domains \\='[\\='example.com\\=' \\='trusteddomain.org\\=']
   117	    :user_location \\='((type . \\='approximate\\=')
   118	                     (city . \\='San Francisco\\=')
   119	                     (region . \\='California\\=')
   120	                     (country . \\='US\\=')
   121	                     (timezone . \\='America/Los_Angeles\\=')))
   122	
   123	The raw JSON string will be displayed for the server tool definition."
   124	  (let ((type (plist-get args :type))
   125	        (remaining-args (copy-sequence args)))
   126	    ;; Remove :type from remaining-args
   127	    (setq remaining-args (cl-copy-list remaining-args))
   128	    (cl-remf remaining-args :type)
   129	
   130	    ;; Build the tool definition alist - extract symbol name from quoted form
   131	    (let ((tool-def (list (cons 'type type)
   132	                          (cons 'name (if (and (listp name) (eq (car name) 'quote))
   133	                                          (symbol-name (cadr name))
   134	                                        (if (symbolp name)
   135	                                            (symbol-name name)
   136	                                          name))))))
   137	      ;; Add remaining parameters
   138	      (while remaining-args
   139	        (let ((key (pop remaining-args))
   140	              (value (pop remaining-args)))
   141	          (when key
   142	            (push (cons (intern (substring (symbol-name key) 1)) value) tool-def))))
   143	
   144	      ;; Store with string key like regular tools
   145	      `(puthash ,(if (and (listp name) (eq (car name) 'quote))
   146	                     (symbol-name (cadr name))
   147	                   (if (symbolp name)
   148	                       (symbol-name name)
   149	                     name))
   150	                (reverse ',tool-def)
   151	                greger-server-tools-registry))))
   152	
   153	(defun greger-tools-get-schemas (tool-names)
   154	  "Get tool schemas for TOOL-NAMES."
   155	  (mapcar (lambda (tool-name)
   156	            (let ((tool-def (gethash tool-name greger-tools-registry)))
   157	              (if tool-def
   158	                  (plist-get tool-def :schema)
   159	                (error "Unknown tool: %s" tool-name))))
   160	          tool-names))
   161	
   162	(defun greger-server-tools-get-schemas (tool-names)
   163	  "Get server tool schemas for TOOL-NAMES as JSON strings."
   164	  (mapcar (lambda (tool-name)
   165	            (let* ((lookup-key (if (symbolp tool-name) (symbol-name tool-name) tool-name))
   166	                   (tool-def (gethash lookup-key greger-server-tools-registry)))
   167	              (if tool-def
   168	                  (json-encode tool-def)
   169	                (error "Unknown server tool: %s" tool-name))))
   170	          tool-names))
   171	
   172	(defun greger-server-tools-get-all-schemas ()
   173	  "Get all registered server tool schemas as JSON strings."
   174	  (let ((tools '()))
   175	    (maphash (lambda (_name def)
   176	               (push (json-encode def) tools))
   177	             greger-server-tools-registry)
   178	    tools))
   179	
   180	(cl-defun greger-tools-execute (&key tool-name args callback streaming-callback buffer metadata)
   181	  "Execute TOOL-NAME with ARGS and call CALLBACK with (result error).
   182	Returns a greger-tool struct for tracking execution and cancellation.
   183	If the tool has :pass-buffer set, BUFFER will be passed to the tool function.
   184	If the tool has :pass-callback set, CALLBACK will be passed to the tool
   185	function instead of `greger-tools-execute' calling the callback with result.
   186	If the tool has :pass-metadata set, METADATA will be passed to the tool
   187	function.
   188	If the tool has :streaming set, STREAMING-CALLBACK will be passed to the tool
   189	function for streaming output."
   190	
   191	  (let ((tool-def (gethash tool-name greger-tools-registry))
   192	        (cancel-fn nil))
   193	    (if tool-def
   194	        (let ((func (plist-get tool-def :function))
   195	              (pass-buffer (plist-get tool-def :pass-buffer))
   196	              (pass-callback (plist-get tool-def :pass-callback))
   197	              (streaming (plist-get tool-def :streaming))
   198	              (pass-metadata (plist-get tool-def :pass-metadata)))
   199	          ;; Add buffer parameter if pass-buffer is set and buffer is provided
   200	          (when (and pass-buffer buffer)
   201	            (setq args (cons (cons 'buffer buffer) args)))
   202	          ;; Add callback parameter if pass-callback is set
   203	          (when pass-callback
   204	            (setq args (cons (cons 'callback callback) args)))
   205	          ;; Add metadata parameter if pass-metadata is set and metadata is provided
   206	          (when (and pass-metadata metadata)
   207	            (setq args (cons (cons 'metadata metadata) args)))
   208	          (when streaming
   209	            (setq args (cons (cons 'streaming-callback streaming-callback) args)))
   210	          (condition-case err
   211	              (if pass-callback
   212	                  ;; Async case: When pass-callback is set,
   213	                  ;; the function handles calling the callback
   214	                  (let ((result (greger-tools--call-function-with-args func args tool-def)))
   215	                    ;; When the result of an async tool is a
   216	                    ;; function, it's assumed to be a cancel
   217	                    ;; function
   218	                    (when (functionp result)
   219	                      (setq cancel-fn result)))
   220	
   221	                ;; Sync case: call callback with result
   222	                (let ((result (greger-tools--call-function-with-args func args tool-def)))
   223	                  (when (functionp result)
   224	                    (setq cancel-fn result))
   225	                  (funcall callback result nil)))
   226	
   227	            ;; Errors from both sync and async tools are handled with a callback
   228	            (error
   229	             (funcall callback nil err))))
   230	      (funcall callback nil (format "Unknown tool: %s" tool-name)))
   231	    ;; Return greger-tool struct
   232	    (make-greger-tool :cancel-fn cancel-fn)))
   233	
   234	(defun greger-tools--call-function-with-args (func args tool-def)
   235	  "Call FUNC with arguments extracted from ARGS alist based on function signature.
   236	Returns the result of calling the function.
   237	TOOL-DEF provides the tool definition for accessing defaults."
   238	  (let ((func-args (greger-tools--extract-function-args func args tool-def)))
   239	    (apply func func-args)))
   240	
   241	(defun greger-tools--extract-function-args (func args tool-def)
   242	  "Extract arguments for FUNC from ARGS alist based on function signature.
   243	TOOL-DEF provides the tool definition for accessing defaults and required
   244	parameters.  Returns a list of arguments in the correct order for the function."
   245	
   246	  (let ((arg-list (help-function-arglist func t))
   247	        (required-params (when tool-def
   248	                           (let* ((schema (plist-get tool-def :schema))
   249	                                  (input-schema (alist-get 'input_schema schema)))
   250	                             (alist-get 'required input-schema)))))
   251	    (cl-loop for arg-name in arg-list
   252	             until (eq arg-name '&rest)
   253	             unless (eq arg-name '&optional)
   254	             collect
   255	             (let* ((arg-symbol (if (symbolp arg-name) arg-name (intern (symbol-name arg-name))))
   256	                    (arg-key (intern (symbol-name arg-symbol)))
   257	                    (arg-provided-p (assoc arg-key args))
   258	                    (is-required (member (symbol-name arg-key) required-params)))
   259	               (cond
   260	                ;; Required parameter not provided
   261	                ((and is-required (not arg-provided-p))
   262	                 (error "Required parameter missing: %s" arg-key))
   263	                ;; Parameter provided (required or optional)
   264	                (arg-provided-p
   265	                 (greger-tools--maybe-parse-json-value (alist-get arg-key args) arg-key tool-def))
   266	                ;; Optional parameter not provided - use default or nil
   267	                (t
   268	                 (greger-tools--get-default-from-schema arg-key tool-def)))))))
   269	
   270	(defun greger-tools--get-default-from-schema (arg-key tool-def)
   271	  "Get default value for ARG-KEY from TOOL-DEF schema."
   272	  (when tool-def
   273	    (let* ((schema (plist-get tool-def :schema))
   274	           (input-schema (alist-get 'input_schema schema))
   275	           (properties (alist-get 'properties input-schema))
   276	           (arg-property (alist-get arg-key properties))
   277	           (default-value (alist-get 'default arg-property)))
   278	      default-value)))
   279	
   280	(defun greger-tools--maybe-parse-json-value (value arg-key tool-def)
   281	  "Parse VALUE as JSON if ARG-KEY requires JSON parsing based on TOOL-DEF schema.
   282	Handles arrays, booleans, and numbers."
   283	  (let* ((schema (plist-get tool-def :schema))
   284	         (input-schema (alist-get 'input_schema schema))
   285	         (properties (alist-get 'properties input-schema))
   286	         (arg-property (alist-get arg-key properties))
   287	         (param-type (alist-get 'type arg-property)))
   288	    (cond
   289	     ;; Parse JSON array string
   290	     ((and (stringp value) (string= param-type "array"))
   291	      (condition-case nil
   292	          (json-parse-string value :array-type 'list)
   293	        (error value))) ; Return original value if parsing fails
   294	
   295	     ;; Parse boolean strings
   296	     ((and (stringp value) (string= param-type "boolean"))
   297	      (cond
   298	       ((string= value "true") t)
   299	       ((string= value "false") nil)
   300	       ((string= value ":json-true") t)
   301	       ((string= value ":json-false") nil)
   302	       (t nil))) ; Return nil if not a recognized boolean
   303	
   304	     ((and (symbolp value) (string= param-type "boolean"))
   305	      (cond
   306	       ((eq value :json-true) t)
   307	       ((eq value :json-false) nil)
   308	       ((eq value t) t)        ; Handle regular Emacs Lisp t
   309	       ((null value) nil)      ; Handle regular Emacs Lisp nil
   310	       (t nil))) ; Return nil if not a recognized symbol
   311	
   312	     ;; Parse number strings
   313	     ((or (string= param-type "integer") (string= param-type "number"))
   314	      (condition-case nil
   315	          (if (string-match-p "^-?[0-9]+$" value)
   316	              (string-to-number value)
   317	            (if (string-match-p "^-?[0-9]*\\.[0-9]+$" value)
   318	                (string-to-number value)
   319	              value)) ; Return original if not a number
   320	        (error value)))
   321	
   322	     ;; For other types (string, object), return as-is
   323	     (t value))))
   324	
   325	(provide 'greger-tools)
   326	
   327	;;; greger-tools.el ends here

---------



