   157	(greger-register-tool "list-directory"
   158	                      :description "List files and directories in a given directory"
   159	                      :properties '((path . ((type . "string")
   160	                                             (description . "Path to the directory to list. Defaults to current directory.")
   161	                                             (default . ".")))
   162	                                    (exclude-directories-recursive . ((type . "array")
   163	                                                                      (items . ((type . "string")))
   164	                                                                      (description . "List of directory names to exclude when recursively listing files.")
   165	                                                                      (default . (".git" "__pycache__" "node_modules" ".wrangler"))))
   166	                                    (recursive . ((type . "boolean")
   167	                                                  (description . "Whether to list files recursively")
   168	                                                  (default . nil))))
   169	                      :required '()
