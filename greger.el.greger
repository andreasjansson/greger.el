   241	;;; Stream processing
   242	
   243	(defun greger-client--check-for-error (output state)
   244	  "Check OUTPUT for error responses and store error message if found.
   245	Returns error information if found, nil otherwise.
   246	STATE is the greger client state."
   247	  (condition-case nil
   248	      (let ((data (json-read-from-string output)))
   249	        (when (and (listp data)
   250	                   (string= (alist-get 'type data) "error"))
   251	          (let* ((error-info (alist-get 'error data))
   252	                 (error-message (alist-get 'message error-info))
   253	                 (error-type (alist-get 'type error-info))
   254	                 (error-string (format "API Error (%s): %s" error-type error-message)))
   255	            ;; Store the error message for later processing in completion handler
   256	            (setf (greger-client-state-error-message state) error-string)
   257	            error-info)))
   258	    (json-error nil)
   259	    (json-readtable-error nil)))
   260	
   261	(defun greger-client--process-output-chunk (output state)
   262	  "Process a chunk of OUTPUT using STATE."
   263	
   264	  ;; Uncomment this line for raw debugging output of every
   265	  ;; streaming message returned from the Anthropic API
   266	  ;; (message "output: %s" output)
   267	
   268	  ;; Check for error responses and call error callback if found
   269	  (greger-client--check-for-error output state)
   270	
   271	  ;; Update working buffer for chunk processing
   272	  (setf (greger-client-state-accumulated-output state)
   273	        (concat (greger-client-state-accumulated-output state) output))
   274	
   275	  (greger-client--process-events state))
   276	
   277	(defun greger-client--process-events (state)
   278	  "Process Claude streaming events from accumulated output in STATE."
   279	  (let ((accumulated (greger-client-state-accumulated-output state)))
   280	
   281	    ;; Process complete lines (events)
   282	    (while (string-match "\n" accumulated)
   283	      (let* ((line-end (match-end 0))
   284	             (line (substring accumulated 0 (1- line-end))))
   285	
   286	        ;; Process the line if it's a data event
   287	        (when (string-prefix-p "data: " line)
   288	          (let ((data-json (substring line 6)))
   289	            (unless (string= data-json "[DONE]")
   290	              (greger-client--handle-event data-json state))))
   291	
   292	        ;; Remove processed line
   293	        (setq accumulated (substring accumulated line-end))))
   294	
   295	    ;; Store remaining incomplete data
   296	    (setf (greger-client-state-accumulated-output state) accumulated)))
   297	
   298	(defun greger-client--handle-event (data-json state)
   299	  "Handle a Claude streaming event with DATA-JSON using STATE."
   300	  (let* ((data (json-read-from-string data-json))
   301	         (type (alist-get 'type data)))
   302	    (cond
   303	
   304	     ;; Handle errors
   305	     ((string= type "error")
   306	      (greger-client--handle-error data))
   307	
   308	     ;; Content block start - create new content block
   309	     ((string= type "content_block_start")
   310	      (greger-client--handle-content-block-start data state))
   311	
   312	     ;; Content block delta - update existing content block
   313	     ((string= type "content_block_delta")
   314	      (greger-client--handle-content-block-delta data state))
   315	
   316	     ;; Content block stop - finalize tool input if needed
   317	     ((string= type "content_block_stop")
   318	      (greger-client--handle-content-block-stop data state)))))
   319	
   320	(defun greger-client--handle-error (data)
   321	  (if-let* ((err (alist-get 'error data))
   322	            (message (alist-get 'message err)))
   323	      (warn "Anthropic API threw error: %s" message)
   324	    (warn "Anthropic API threw error")))
   325	
   326	(defun greger-client--handle-content-block-start (data state)
   327	  "Initialize new streaming content block from DATA in STATE."
   328	  (let* ((index (alist-get 'index data))
   329	         (content-block (copy-alist (alist-get 'content_block data)))
   330	         (blocks (greger-client-state-content-blocks state))
   331	         (type (alist-get 'type content-block))
   332	         (citations (alist-get 'citations content-block)))
   333	
   334	    ;; Initialize content for accumulation.
   335	    ;; For tool_use and server_tool_use we make the input object a
   336	    ;; string while we accumulate the output, and turn it back into
   337	    ;; an object again in greger-client--handle-content-stop
   338	    ;; Initialize content fields based on content block type
   339	    (cond
   340	     ((string= type "tool_use")
   341	      (setf (alist-get 'input content-block) ""))
   342	     ((string= type "server_tool_use")
   343	      (setf (alist-get 'input content-block) ""))
   344	     ((string= type "text")
   345	      (setf (alist-get 'text content-block) "")
   346	      ;; For text blocks with citations, initialize citations as empty list
   347	      (when citations
   348	        (setf (alist-get 'citations content-block) '())))
   349	     ((string= type "thinking")
   350	      (setf (alist-get 'thinking content-block) ""))
   351	     ;; web_search_tool_result blocks come pre-populated with content - no initialization needed
   352	     )
   353	
   354	    (when-let ((callback (greger-client-state-block-start-callback state)))
   355	      (funcall callback content-block))
   356	
   357	    ;; Add block at the right index
   358	    (greger-client--ensure-block-at-index blocks index content-block state)))
   359	
   360	(defun greger-client--handle-content-block-delta (data state)
   361	  "Process incremental content update from streaming DATA in STATE."
   362	  (let* ((index (alist-get 'index data))
   363	         (delta (alist-get 'delta data))
   364	         (delta-type (alist-get 'type delta))
   365	         (blocks (greger-client-state-content-blocks state))
   366	         (block (nth index blocks)))
   367	
   368	    ;; TODO: do we need to handle content block stop out-of-order,
   369	    ;; before content-block start has created the block in the state's content-blocks?
   370	
   371	    (cond
   372	
   373	     ;; assistant text
   374	     ;; {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"I'll search for the"}}
   375	     ((string= delta-type "text_delta")
   376	      (let ((text-delta (alist-get 'text delta))
   377	            (has-citations (alist-get 'citations block)))
   378	        (setf (alist-get 'text block)
   379	              (concat (alist-get 'text block) text-delta))
   380	        ;; Only call text callback for live display if this block doesn't have citations
   381	        ;; Citation blocks should not stream text - they'll be handled in block-stop
   382	        (unless has-citations
   383	          (when-let ((callback (greger-client-state-text-delta-callback state)))
   384	            (funcall callback text-delta)))))
   385	
   386	     ;; assistant thinking
   387	     ;; data: {"type":"content_block_delta","index":0,"delta":{"type":"thinking_delta","thinking":" needing to search for"}}
   388	     ((string= delta-type "thinking_delta")
   389	      (let ((thinking-delta (alist-get 'thinking delta)))
   390	        (setf (alist-get 'thinking block)
   391	              (concat (alist-get 'thinking block) thinking-delta))
   392	        (when-let ((callback (greger-client-state-text-delta-callback state)))
   393	          (funcall callback thinking-delta))))
   394	
   395	     ;; assistant thinking signature
   396	     ((string= delta-type "signature_delta")
   397	      (let ((signature-delta (alist-get 'signature delta)))
   398	        (setf (alist-get 'signature block)
   399	              (concat (alist-get 'signature block) signature-delta))))
   400	
   401	     ;; tool_use and server_tool_use
   402	     ;; {"type":"content_block_delta","index":1,"delta":{"type":"input_json_delta","partial_json":""}}
   403	     ((string= delta-type "input_json_delta")
   404	      (let ((partial-json (alist-get 'partial_json delta)))
   405	        (setf (alist-get 'input block)
   406	              (concat (alist-get 'input block) partial-json))))
   407	
   408	     ;; Citations accumulation
   409	     ;; {"type":"content_block_delta","index":3,"delta":{"type":"citations_delta","citation":{"type":"web_search_result_location",...}}}
   410	     ((string= delta-type "citations_delta")
   411	      (let ((citation (alist-get 'citation delta))
   412	            (current-citations (alist-get 'citations block)))
   413	        ;; Add the new citation to the list
   414	        (setf (alist-get 'citations block)
   415	              (append current-citations (list citation))))))))
   416	
   417	(defun greger-client--handle-content-block-stop (data state)
   418	  "Finalize the current block and send callbacks from STATE.
   419	DATA is the streaming entry for the stop content block."
   420	  (let* ((index (alist-get 'index data))
   421	         (blocks (greger-client-state-content-blocks state))
   422	         (block (nth index blocks))
   423	         (type (alist-get 'type block)))
   424	
   425	    ;; TODO: do we need to handle content block stop out-of-order,
   426	    ;; before content-block start has created the block in the state's content-blocks?
   427	
   428	    (cond
   429	     ;; Handle tool use blocks - turn accumulated JSON string back into an object
   430	     ((or (string= type "tool_use") (string= type "server_tool_use"))
   431	      (let ((input-str (alist-get 'input block)))
   432	        (if (string-empty-p input-str)
   433	            (setf (alist-get 'input block) '())
   434	          (setf (alist-get 'input block) (json-read-from-string input-str))))))
   435	
   436	    (when-let ((callback (greger-client-state-block-stop-callback state)))
   437	      (funcall callback type block))))
   438	
   439	(defun greger-client--ensure-block-at-index (_blocks index new-block state)
   440	  "Ensure BLOCKS list has NEW-BLOCK at INDEX, extending if necessary.
   441	STATE is used to update the parsed content blocks."
   442	  (let ((current-blocks (greger-client-state-content-blocks state)))
   443	    ;; Extend list if needed
   444	    (while (<= (length current-blocks) index)
   445	      (setq current-blocks (append current-blocks (list nil))))
   446	
   447	    ;; Set the block at index
   448	    (setf (nth index current-blocks) new-block)
   449	    (setf (greger-client-state-content-blocks state) current-blocks)))
   450	
   451	(defun greger-client--handle-completion (proc state)
   452	  "Handle process completion for PROC using STATE."
   453	  (when (memq (process-status proc) '(exit signal))
   454	    (funcall (greger-client-state-restore-callback state) state)
   455	
   456	    (let ((exit-code (process-exit-status proc))
   457	          (stored-error (greger-client-state-error-message state)))
   458	      (cond
   459	
   460	       ;; Process succeeded - call completion callback
   461	       ((and (= exit-code 0) (not stored-error))
   462	        (when-let ((callback (greger-client-state-complete-callback state)))
   463	          (funcall callback (greger-client-state-content-blocks state))))
   464	
   465	       ;; Exit code 2 means process interrupted
   466	       ((= exit-code 2)
   467	        (message "Process interrupted"))
   468	
   469	       ;; Process failed - raise error with stored message or generic message
   470	       (t
   471	        (let ((error-message (or stored-error
   472	                                 (format "Process exited with status code %d" exit-code))))
   473	          (when-let ((callback (greger-client-state-error-callback state)))
   474	            (funcall callback error-message))))))))
   475	
   476	(defun greger-client--cancel-request (state)
   477	  "Cancel streaming request using STATE."
   478	  (let ((process (greger-client-state-process state)))
   479	    (when (process-live-p process)
   480	      (message "Interrupting generation")
   481	      (interrupt-process process)
   482	      (sit-for 0.1)
   483	      (delete-process process))
   484	    (funcall (greger-client-state-restore-callback state) state)))
   485	
   486	;;; Utility functions
   487	
   488	(defun greger-client--start-curl-process (request-spec)
   489	  "Start curl process with REQUEST-SPEC."
   490	  (start-process-shell-command
   491	   "greger-curl" nil
   492	   (greger-client--build-curl-command request-spec)))
   493	
   494	(defun greger-client--build-curl-command (request-spec)
   495	  "Build curl command from REQUEST-SPEC."
   496	  (let ((url (plist-get request-spec :url))
   497	        (method (plist-get request-spec :method))
   498	        (headers (plist-get request-spec :headers))
   499	        (data (plist-get request-spec :data)))
   500	    (format "curl -s -X %s %s %s %s"
   501	            method
   502	            (mapconcat (lambda (header)
   503	                         (format "-H \"%s: %s\"" (car header) (cdr header)))
   504	                       headers " ")
   505	            (if data
   506	                (format "--data-raw %s" (shell-quote-argument data))
   507	              "")
   508	            url)))
   509	
   510	(provide 'greger-client)
   511	
   512	;;; greger-client.el ends here

---------



# greger-openrouter.el:

     1	;;; greger-openrouter.el --- OpenRouter client for greger -*- lexical-binding: t -*-
     2	
     3	;; Copyright (C) 2025 Andreas Jansson
     4	
     5	;; Author: Andreas Jansson <andreas@jansson.me.uk>
     6	;; Version: 0.1.0
     7	;; URL: https://github.com/andreasjansson/greger.el
     8	;; SPDX-License-Identifier: MIT
     9	
    10	;;; Commentary:
    11	;; OpenRouter API client for greger - provides access to 400+ models including
    12	;; GPT-5, GPT-5 Codex, and others through OpenRouter's unified API.
    13	
    14	;;; Code:
    15	
    16	(require 'json)
    17	(require 'cl-lib)
    18	
    19	(defconst greger-openrouter-api-url "https://openrouter.ai/api/v1/chat/completions"
    20	  "OpenRouter API endpoint.")
    21	
    22	(cl-defstruct greger-openrouter-state
    23	  accumulated-output
    24	  current-tool-calls
    25	  current-text
    26	  thinking-started
    27	  text-started
    28	  annotations
    29	  current-reasoning-text
    30	  current-reasoning-details
    31	  process
    32	  output-buffer
    33	  undo-handle
    34	  block-start-callback
    35	  text-delta-callback
    36	  block-stop-callback
    37	  complete-callback
    38	  restore-callback
    39	  error-callback
    40	  error-message)
    41	
    42	(cl-defun greger-openrouter-stream (&key model dialog tools buffer enable-web-search block-start-callback text-delta-callback block-stop-callback complete-callback thinking-budget max-tokens auth-key error-callback)
    43	  "Stream request to OpenRouter API.
    44	MODEL is the OpenRouter model identifier.
    45	DIALOG is the conversation history.
    46	TOOLS are tool definitions.
    47	BUFFER is the output buffer.
    48	ENABLE-WEB-SEARCH determines if we append :online to the model.
    49	BLOCK-START-CALLBACK is called when content blocks begin.
    50	TEXT-DELTA-CALLBACK for incremental text.
    51	BLOCK-STOP-CALLBACK when blocks complete.
    52	COMPLETE-CALLBACK when the entire response finishes.
    53	THINKING-BUDGET is the number of thinking tokens.
    54	MAX-TOKENS is the maximum number of tokens to generate.
    55	AUTH-KEY is the OpenRouter API key.
    56	ERROR-CALLBACK is called when errors occur."
    57	  (let* ((output-buffer (or buffer (current-buffer)))
    58	         (undo-handle (prepare-change-group output-buffer))
    59	         (request-spec (greger-openrouter--build-request model dialog tools thinking-budget max-tokens auth-key enable-web-search))
    60	         (restore-callback (lambda (state)
    61	                             (let ((buffer (greger-openrouter-state-output-buffer state)))
    62	                               (when (buffer-live-p buffer)
    63	                                 (with-current-buffer buffer
    64	                                   (undo-amalgamate-change-group (greger-openrouter-state-undo-handle state))
    65	                                   (accept-change-group (greger-openrouter-state-undo-handle state)))))))
    66	         (process (greger-openrouter--start-curl-process request-spec))
    67	         (state (make-greger-openrouter-state
    68	                 :accumulated-output ""
    69	                 :current-tool-calls (make-hash-table :test 'equal)
    70	                 :current-text ""
    71	                 :process process
    72	                 :block-start-callback block-start-callback
    73	                 :text-delta-callback text-delta-callback
    74	                 :block-stop-callback block-stop-callback
    75	                 :complete-callback complete-callback
    76	                 :restore-callback restore-callback
    77	                 :output-buffer output-buffer
    78	                 :undo-handle undo-handle
    79	                 :error-callback error-callback)))
    80	    
    81	    (activate-change-group undo-handle)
    82	    
    83	    (set-process-filter process
    84	                        (lambda (_proc output)
    85	                          (greger-openrouter--process-output-chunk output state)))
    86	    
    87	    (set-process-sentinel process
    88	                          (lambda (proc _event)
    89	                            (greger-openrouter--handle-completion proc state)))
    90	    
    91	    (set-process-query-on-exit-flag process nil)
    92	    
    93	    state))
    94	
    95	(defun greger-openrouter--build-request (model dialog tools thinking-budget max-tokens auth-key enable-web-search)
    96	  "Build OpenRouter API request."
    97	  (let* ((headers (greger-openrouter--build-headers auth-key))
    98	         (data (greger-openrouter--build-data model dialog tools thinking-budget max-tokens enable-web-search)))
    99	    (message "url: %s; request data: %s" greger-openrouter-api-url data)
   100	    (list :url greger-openrouter-api-url
   101	          :method "POST"
   102	          :headers headers
   103	          :data data)))
   104	
   105	(defun greger-openrouter--build-headers (api-key)
   106	  "Build OpenRouter headers - Bearer auth."
   107	  `(("Content-Type" . "application/json")
   108	    ("Authorization" . ,(concat "Bearer " api-key))
   109	    ("HTTP-Referer" . "https://github.com/andreasjansson/greger.el")
   110	    ("X-Title" . "Greger.el")))
   111	
   112	(defun greger-openrouter--build-data (model dialog tools thinking-budget max-tokens enable-web-search)
   113	  "Build OpenRouter request data in OpenAI format."
   114	  (let* ((messages (greger-openrouter--convert-dialog-to-messages dialog))
   115	         (actual-model (if enable-web-search
   116	                           (concat model ":online")
   117	                         model))
   118	         (request-data `(("model" . ,actual-model)
   119	                         ("max_tokens" . ,max-tokens)
   120	                         ("stream" . t))))
   121	    
   122	    (push `("messages" . ,messages) request-data)
   123	    
   124	    (when tools
   125	      (let ((converted-tools (greger-openrouter--convert-tools tools)))
   126	        (push `("tools" . ,converted-tools) request-data)
   127	        (push `("tool_choice" . "auto") request-data)))
   128	    
   129	    (when (and thinking-budget (> thinking-budget 0))
   130	      (push `("reasoning" . (("max_tokens" . ,thinking-budget))) request-data)
   131	      (push `("include_reasoning" . t) request-data))
   132	    
   133	    (json-encode request-data)))
   134	
   135	(defun greger-openrouter--convert-dialog-to-messages (dialog)
   136	  "Convert Greger dialog format to OpenAI message format."
   137	  (let (messages
   138	        system-message)
   139	    (dolist (msg dialog)
   140	      (let ((role (alist-get 'role msg))
   141	            (content (alist-get 'content msg)))
   142	        
   143	        (cond
   144	         ((string= role "system")
   145	          (setq system-message content))
   146	         
   147	         ((stringp content)
   148	          (push `((role . ,role) (content . ,content)) messages))
   149	         
   150	         ((listp content)
   151	          (let ((converted (greger-openrouter--convert-content-blocks role content)))
   152	            (when converted
   153	              (setq messages (append converted messages))))))))
   154	    
   155	    (let ((result (nreverse messages)))
   156	      (when system-message
   157	        (setq result (cons `((role . "system") (content . ,system-message)) result)))
   158	      result)))
   159	
   160	(defun greger-openrouter--convert-content-blocks (role content-blocks)
   161	  "Convert Greger content blocks to OpenRouter message format.
   162	Handles thinking blocks by decoding reasoning_details from signature field.
   163	Converts citations back to OpenRouter annotations format."
   164	  (let (result-messages
   165	        current-text
   166	        tool-calls
   167	        reasoning-details)
   168	    
   169	    (dolist (block content-blocks)
   170	      (let ((type (alist-get 'type block)))
   171	        (cond
   172	         ((string= type "text")
   173	          (setq current-text (alist-get 'text block)))
   174	         
   175	         ((string= type "thinking")
   176	          (let ((thinking-text (alist-get 'thinking block))
   177	                (signature (alist-get 'signature block)))
   178	            
   179	            (setq current-text thinking-text)
   180	            
   181	            (when (and signature (not (string-empty-p signature)))
   182	              (condition-case nil
   183	                  (let* ((decoded (decode-coding-string (base64-decode-string signature) 'utf-8))
   184	                         (parsed (json-read-from-string decoded)))
   185	                    (when (vectorp parsed)
   186	                      (setq reasoning-details parsed)))
   187	                (error nil)))))
   188	         
   189	         ((string= type "tool_use")
   190	          (let ((tool-call `((id . ,(alist-get 'id block))
   191	                             (type . "function")
   192	                             (function . ((name . ,(alist-get 'name block))
   193	                                          (arguments . ,(json-encode (alist-get 'input block))))))))
   194	            (push tool-call tool-calls)))
   195	         
   196	         ((string= type "tool_result")
   197	          (let ((tool-msg `((role . "tool")
   198	                            (tool_call_id . ,(alist-get 'tool_use_id block))
   199	                            (content . ,(alist-get 'content block)))))
   200	            (push tool-msg result-messages))))))
   201	    
   202	    (when (or current-text tool-calls reasoning-details)
   203	      (let ((msg `((role . ,role))))
   204	        (when current-text
   205	          (push `(content . ,current-text) msg))
   206	        (when tool-calls
   207	          (push `(tool_calls . ,(vconcat (nreverse tool-calls))) msg))
   208	        (when reasoning-details
   209	          (push `(reasoning_details . ,reasoning-details) msg))
   210	        (push msg result-messages)))
   211	    
   212	    (nreverse result-messages)))
   213	
   214	(defun greger-openrouter--convert-tools (tools)
   215	  "Convert Anthropic tool format to OpenAI function calling format.
   216	OpenAI doesn't support 'default' values in parameters, so we strip them.
   217	Also ensures 'required' is always a vector (array in JSON) not null."
   218	  (mapcar
   219	   (lambda (tool)
   220	     (let* ((input-schema (alist-get 'input_schema tool))
   221	            (cleaned-schema (greger-openrouter--remove-defaults-from-schema input-schema))
   222	            (fixed-schema (greger-openrouter--fix-required-field cleaned-schema)))
   223	       `((type . "function")
   224	         (function . ((name . ,(alist-get 'name tool))
   225	                      (description . ,(alist-get 'description tool))
   226	                      (parameters . ,fixed-schema))))))
   227	   tools))
   228	
   229	(defun greger-openrouter--fix-required-field (schema)
   230	  "Ensure the 'required' field is always a vector, not nil.
   231	OpenAI expects 'required' to be an array, even if empty."
   232	  (if (not (listp schema))
   233	      schema
   234	    (mapcar
   235	     (lambda (entry)
   236	       (if (and (consp entry) (eq (car entry) 'required))
   237	           ;; Convert nil or empty list to empty vector
   238	           (cons 'required (if (cdr entry)
   239	                               (if (vectorp (cdr entry))
   240	                                   (cdr entry)
   241	                                 (vconcat (cdr entry)))
   242	                             []))
   243	         (if (consp entry)
   244	             (cons (car entry)
   245	                   (greger-openrouter--fix-required-field (cdr entry)))
   246	           entry)))
   247	     schema)))
   248	
   249	(defun greger-openrouter--remove-defaults-from-schema (schema)
   250	  "Remove 'default' keys from SCHEMA recursively.
   251	OpenAI function calling doesn't support default values."
   252	  (cond
   253	   ((not (consp schema)) schema)
   254	   
   255	   ;; Check if this is an alist (list of cons cells)
   256	   ((and (listp schema) (consp (car schema)))
   257	    ;; This is an alist - filter out 'default' keys
   258	    (let ((filtered (seq-filter
   259	                     (lambda (pair)
   260	                       (not (eq (car pair) 'default)))
   261	                     schema)))
   262	      ;; Recursively process values
   263	      (mapcar (lambda (pair)
   264	                (cons (car pair)
   265	                      (greger-openrouter--remove-defaults-from-schema (cdr pair))))
   266	              filtered)))
   267	   
   268	   ;; Regular list - process each element
   269	   ((listp schema)
   270	    (mapcar #'greger-openrouter--remove-defaults-from-schema schema))
   271	   
   272	   ;; Cons cell - process both parts
   273	   ((consp schema)
   274	    (cons (greger-openrouter--remove-defaults-from-schema (car schema))
   275	          (greger-openrouter--remove-defaults-from-schema (cdr schema))))
   276	   
   277	   ;; Atom - return as-is
   278	   (t schema)))
   279	
   280	(defun greger-openrouter--process-output-chunk (output state)
   281	  "Process streaming output chunk."
   282	  (setf (greger-openrouter-state-accumulated-output state)
   283	        (concat (greger-openrouter-state-accumulated-output state) output))
   284	  
   285	  (greger-openrouter--process-events state))
   286	
   287	(defun greger-openrouter--process-events (state)
   288	  "Process OpenAI-style SSE events."
   289	  (let ((accumulated (greger-openrouter-state-accumulated-output state)))
   290	    
   291	    (while (string-match "\n" accumulated)
   292	      (let* ((line-end (match-end 0))
   293	             (line (substring accumulated 0 (1- line-end))))
   294	        
   295	        (when (string-prefix-p "data: " line)
   296	          (let ((data-json (substring line 6)))
   297	            (unless (string= data-json "[DONE]")
   298	              (greger-openrouter--handle-event data-json state))))
   299	        
   300	        (setq accumulated (substring accumulated line-end))))
   301	    
   302	    (setf (greger-openrouter-state-accumulated-output state) accumulated)))
   303	
   304	(defun greger-openrouter--handle-event (data-json state)
   305	  "Handle OpenAI-style streaming event."
   306	
   307	  (message "data-json: %s" data-json)
   308	
   309	  (condition-case err
   310	      (let* ((data (json-read-from-string data-json))
   311	             (error-data (alist-get 'error data)))
   312	        
   313	        ;; Check for API errors first
   314	        (when error-data
   315	          (let ((error-message (format "OpenRouter API error: %s" 
   316	                                       (or (alist-get 'message error-data)
   317	                                           (json-encode error-data)))))
   318	            (setf (greger-openrouter-state-error-message state) error-message)
   319	            (message "OpenRouter error: %s" error-message)
   320	            (error error-message)))
   321	        
   322	        (let* ((choices (alist-get 'choices data))
   323	               (choice (when choices (aref choices 0)))
   324	               (delta (alist-get 'delta choice))
   325	               (message (alist-get 'message choice))
   326	               (finish-reason (alist-get 'finish_reason choice)))
   327	          
   328	          (when delta
   329	            (cond
   330	             ((or (alist-get 'reasoning delta) (alist-get 'reasoning_details delta))
   331	              (greger-openrouter--handle-reasoning-delta delta state))
   332	             
   333	             ((and (alist-get 'content delta)
   334	                   (not (string-empty-p (alist-get 'content delta))))
   335	              (let ((text (alist-get 'content delta))
   336	                    (block-start-callback (greger-openrouter-state-block-start-callback state))
   337	                    (text-delta-callback (greger-openrouter-state-text-delta-callback state)))
   338	                
   339	                (unless (greger-openrouter-state-text-started state)
   340	                  (setf (greger-openrouter-state-text-started state) t)
   341	                  (when block-start-callback
   342	                    (funcall block-start-callback
   343	                             `((type . "text")
   344	                               (text . "")))))
   345	                
   346	                (setf (greger-openrouter-state-current-text state)
   347	                      (concat (greger-openrouter-state-current-text state) text))
   348	                (when text-delta-callback
   349	                  (funcall text-delta-callback text))))
   350	             
   351	             ((alist-get 'tool_calls delta)
   352	              (greger-openrouter--accumulate-tool-calls delta state)))
   353	            
   354	            (when (alist-get 'annotations delta)
   355	              (setf (greger-openrouter-state-annotations state)
   356	                    (alist-get 'annotations delta))))
   357	          
   358	          (when (and message (alist-get 'annotations message))
   359	            (setf (greger-openrouter-state-annotations state)
   360	                  (alist-get 'annotations message)))
   361	          
   362	          (when finish-reason
   363	            (greger-openrouter--handle-finish state finish-reason))))
   364	    (error
   365	     (let ((error-message (format "Failed to parse event: %s" (error-message-string err))))
   366	       (setf (greger-openrouter-state-error-message state) error-message)
   367	       (message "OpenRouter parse error: %s" error-message)))))
   368	
   369	(defun greger-openrouter--handle-reasoning-delta (delta state)
   370	  "Handle reasoning/thinking delta and convert to Greger thinking format.
   371	Accumulates both readable text and full reasoning_details array."
   372	  (let ((reasoning-text (alist-get 'reasoning delta))
   373	        (reasoning-details (alist-get 'reasoning_details delta))
   374	        (block-start-callback (greger-openrouter-state-block-start-callback state))
   375	        (text-delta-callback (greger-openrouter-state-text-delta-callback state)))
   376	    
   377	    (unless (greger-openrouter-state-thinking-started state)
   378	      (setf (greger-openrouter-state-thinking-started state) t)
   379	      (when block-start-callback
   380	        (funcall block-start-callback
   381	                 `((type . "thinking")
   382	                   (thinking . "")
   383	                   (signature . "")))))
   384	    
   385	    (when reasoning-text
   386	      (setf (greger-openrouter-state-current-reasoning-text state)
   387	            (concat (or (greger-openrouter-state-current-reasoning-text state) "")
   388	                    reasoning-text))
   389	      (when text-delta-callback
   390	        (funcall text-delta-callback reasoning-text)))
   391	    
   392	    (when reasoning-details
   393	      (let ((current (or (greger-openrouter-state-current-reasoning-details state) [])))
   394	        (setf (greger-openrouter-state-current-reasoning-details state)
   395	              (vconcat current reasoning-details))))))
   396	
   397	(defun greger-openrouter--accumulate-tool-calls (delta state)
   398	  "Accumulate tool call deltas."
   399	  (let ((tool-calls (alist-get 'tool_calls delta))
   400	        (accumulated (greger-openrouter-state-current-tool-calls state)))
   401	    
   402	    (when tool-calls
   403	      (seq-doseq (call tool-calls)
   404	        (let* ((index (alist-get 'index call))
   405	               (id (alist-get 'id call))
   406	               (function-delta (alist-get 'function call))
   407	               (name (alist-get 'name function-delta))
   408	               (arguments (alist-get 'arguments function-delta))
   409	               (existing (gethash index accumulated)))
   410	          
   411	          (if existing
   412	              (let ((existing-args (alist-get 'arguments existing)))
   413	                (setf (alist-get 'arguments existing)
   414	                      (concat existing-args arguments)))
   415	            (puthash index
   416	                     `((id . ,id)
   417	                       (name . ,name)
   418	                       (arguments . ,arguments))
   419	                     accumulated)))))))
   420	
   421	(defun greger-openrouter--handle-finish (state finish-reason)
   422	  "Handle completion based on finish reason."
   423	  (let ((content-blocks (greger-openrouter--build-content-blocks state))
   424	        (block-stop-callback (greger-openrouter-state-block-stop-callback state)))
   425	    
   426	    (when block-stop-callback
   427	      (dolist (block content-blocks)
   428	        (let ((type (alist-get 'type block)))
   429	          (funcall block-stop-callback type block))))
   430	    
   431	    (when-let ((callback (greger-openrouter-state-complete-callback state)))
   432	      (funcall callback content-blocks))))
   433	
   434	(defun greger-openrouter--build-content-blocks (state)
   435	  "Build Anthropic-style content blocks from accumulated state.
   436	Includes THINKING blocks with base64-encoded reasoning_details in signature field."
   437	  (let ((reasoning-text (greger-openrouter-state-current-reasoning-text state))
   438	        (reasoning-details (greger-openrouter-state-current-reasoning-details state))
   439	        (current-text (greger-openrouter-state-current-text state))
   440	        (tool-calls (greger-openrouter-state-current-tool-calls state))
   441	        (annotations (greger-openrouter-state-annotations state))
   442	        blocks)
   443	    
   444	    (when (and reasoning-text reasoning-details)
   445	      (let ((signature-base64 (base64-encode-string 
   446	                               (encode-coding-string (json-encode reasoning-details) 'utf-8)
   447	                               t)))
   448	        (push `((type . "thinking")
   449	                (thinking . ,reasoning-text)
   450	                (signature . ,signature-base64))
   451	              blocks)))
   452	    
   453	    (when (> (hash-table-count tool-calls) 0)
   454	      (maphash
   455	       (lambda (_index call)
   456	         (let* ((id (alist-get 'id call))
   457	                (name (alist-get 'name call))
   458	                (arguments (alist-get 'arguments call))
   459	                (parsed-args (condition-case nil
   460	                                 (json-read-from-string arguments)
   461	                               (error '()))))
   462	           (push `((type . "tool_use")
   463	                   (id . ,id)
   464	                   (name . ,name)
   465	                   (input . ,parsed-args))
   466	                 blocks)))
   467	       tool-calls))
   468	    
   469	    (when current-text
   470	      (push `((type . "text")
   471	              (text . ,current-text))
   472	            blocks))
   473	    
   474	    (nreverse blocks)))
   475	
   476	
   477	
   478	(defun greger-openrouter--convert-citations-to-annotations (citations)
   479	  "Convert Greger citation list back to OpenRouter annotations format."
   480	  (vconcat
   481	   (mapcar
   482	    (lambda (citation)
   483	      (let ((url (alist-get 'url citation))
   484	            (title (alist-get 'title citation))
   485	            (cited-text (alist-get 'cited_text citation)))
   486	        `((type . "url_citation")
   487	          (url_citation . ((url . ,url)
   488	                           (title . ,title)
   489	                           (content . ,cited-text)
   490	                           (start_index . 0)
   491	                           (end_index . 0))))))
   492	    citations)))
   493	
   494	(defun greger-openrouter--handle-completion (proc state)
   495	  "Handle process completion."
   496	  (when (memq (process-status proc) '(exit signal))
   497	    (funcall (greger-openrouter-state-restore-callback state) state)
   498	    
   499	    (let ((exit-code (process-exit-status proc))
   500	          (stored-error (greger-openrouter-state-error-message state)))
   501	      (cond
   502	       ((and (= exit-code 0) (not stored-error))
   503	        (when-let ((callback (greger-openrouter-state-complete-callback state)))
   504	          (funcall callback (greger-openrouter--build-content-blocks state))))
   505	       
   506	       ((= exit-code 2)
   507	        (message "Process interrupted"))
   508	       
   509	       (t
   510	        (let ((error-message (or stored-error
   511	                                 (format "Process exited with status code %d" exit-code))))
   512	          (when-let ((callback (greger-openrouter-state-error-callback state)))
   513	            (funcall callback error-message))))))))
   514	
   515	(defun greger-openrouter--start-curl-process (request-spec)
   516	  "Start curl process for OpenRouter."
   517	  (start-process-shell-command
   518	   "greger-openrouter-curl" nil
   519	   (greger-openrouter--build-curl-command request-spec)))
   520	
   521	(defun greger-openrouter--build-curl-command (request-spec)
   522	  "Build curl command for OpenRouter."
   523	  (let ((url (plist-get request-spec :url))
   524	        (method (plist-get request-spec :method))
   525	        (headers (plist-get request-spec :headers))
   526	        (data (plist-get request-spec :data)))
   527	    (format "curl -s -X %s %s %s %s"
   528	            method
   529	            (mapconcat (lambda (header)
   530	                         (format "-H \"%s: %s\"" (car header) (cdr header)))
   531	                       headers " ")
   532	            (if data
   533	                (format "--data-raw %s" (shell-quote-argument data))
   534	              "")
   535	            url)))
   536	
   537	(defun greger-openrouter--cancel-request (state)
   538	  "Cancel streaming request."
   539	  (let ((process (greger-openrouter-state-process state)))
   540	    (when (process-live-p process)
   541	      (message "Interrupting generation")
   542	      (interrupt-process process)
   543	      (sit-for 0.1)
   544	      (delete-process process))
   545	    (funcall (greger-openrouter-state-restore-callback state) state)))
   546	
   547	(provide 'greger-openrouter)
   548	
   549	;;; greger-openrouter.el ends here

---------



# greger-parser.el:

     1	;;; greger-parser.el --- Parser for greger dialog format -*- lexical-binding: t -*-
     2	
