  1193	(defun greger--find-tool-result-node (tool-id)
  1194	  "Find the tool_result node with TOOL-ID.
  1195	Uses treesit to query for a tool_result with matching id and returns
  1196	the tool_result node itself."
  1197	  (let* ((query `((tool_result (id (value) @id) (:match ,tool-id @id)) @tool-result))
  1198	         (capture (treesit-query-capture (treesit-buffer-root-node) query)))
  1199	    (alist-get 'tool-result capture)))
