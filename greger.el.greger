   112	;;; Request building
   113	
   114	(defun greger-client--filter-thinking-messages (messages)
   115	  "Filter out thinking content blocks from MESSAGES."
   116	  (delq nil
   117	        (mapcar (lambda (message)
   118	                  (let ((content (alist-get 'content message)))
   119	                    (cond
   120	                     ;; String content - keep message as-is
   121	                     ((stringp content) message)
   122	                     ;; List content - filter out thinking blocks
   123	                     ((listp content)
   124	                      (let ((filtered-content (cl-remove-if
   125	                                               (lambda (block)
   126	                                                 (and (listp block)
   127	                                                      (string= (alist-get 'type block) "thinking")))
   128	                                               content)))
   129	                        (when filtered-content
   130	                          `((role . ,(alist-get 'role message))
   131	                            (content . ,filtered-content)))))
   132	                     ;; Other content types - keep message as-is
   133	                     (t message))))
   134	                messages)))
   135	
   136	(defun greger-client--add-cache-control (messages)
   137	  "Add ephemeral cache control to the last non-thinking content block in MESSAGES."
   138	  (let ((last-non-thinking-block nil))
   139	    ;; Walk all messages and find the last non-thinking content block
   140	    (dolist (message messages)
   141	      (let ((content (alist-get 'content message)))
   142	        (when (listp content)
   143	          (dolist (block content)
   144	            (when (and (listp block)
   145	                       (not (string= (alist-get 'type block) "thinking")))
   146	              (setq last-non-thinking-block block))))))
   147	
   148	    ;; Add cache control directly to the block by modifying it in place
   149	    (when last-non-thinking-block
   150	      (let ((cache-control '(cache_control . ((type . "ephemeral")))))
   151	        (setcdr last-non-thinking-block (cons (car last-non-thinking-block) (cdr last-non-thinking-block)))
   152	        (setcar last-non-thinking-block cache-control)))))
   153	
   154	(defun greger-client--build-request (model dialog tools server-tools thinking-budget max-tokens auth-key)
   155	  "Build Claude request to be sent to the Claude API.
   156	MODEL is the Claude mode.
   157	DIALOG is the chat dialog.
   158	TOOLS are tool definitions.
   159	SERVER-TOOLS are server tool definitions.
   160	THINKING-BUDGET is the number of thinking tokens.
   161	MAX-TOKENS is the maximum number of tokens to generate.
   162	AUTH-KEY is the Anthropic API key to use for authentication."
   163	  (let* ((headers (greger-client--build-headers auth-key))
   164	         (data (greger-client--build-data model dialog tools server-tools thinking-budget max-tokens)))
   165	    (list :url greger-client-api-url
   166	          :method "POST"
   167	          :headers headers
   168	          :data data)))
   169	
   170	
   171	
   172	(defun greger-client--build-headers (api-key)
   173	  "Build headers for Claude with API-KEY."
   174	  `(("Content-Type" . "application/json")
   175	    ("x-api-key" . ,api-key)
   176	    ("anthropic-version" . "2023-06-01")
   177	    ("anthropic-beta" . "token-efficient-tools-2025-02-19")))
   178	
   179	(defun greger-client--build-data (model dialog tools server-tools thinking-budget max-tokens)
   180	  "Build request data for Claude MODEL with DIALOG and optional tools.
   181	TOOLS and SERVER-TOOLS add function calling capabilities to the request.
   182	THINKING-BUDGET specifies the token budget for thinking content.
   183	MAX-TOKENS is the maximum number of tokens to generate."
   184	  (let ((dialog (copy-tree dialog)) ;; we're mutating dialog
   185	        (system-message nil)
   186	        (user-messages ())
   187	        (request-data nil))
   188	
   189	    ;; Separate system messages from user/assistant messages
   190	    (dolist (message dialog)
   191	      (let ((role (alist-get 'role message))
   192	            (content (alist-get 'content message)))
   193	        (if (string= role "system")
   194	            (unless system-message
   195	              (setq system-message content))
   196	          (push `((role . ,role)
   197	                  (content . ,content))
   198	                user-messages))))
   199	
   200	    ;; Reverse to get correct order
   201	    (setq user-messages (nreverse user-messages))
   202	
   203	    ;; Filter out thinking messages if thinking-budget is 0
   204	    (when (and thinking-budget (= thinking-budget 0))
   205	      (setq user-messages (greger-client--filter-thinking-messages user-messages)))
   206	
   207	    ;; Add ephemeral cache-control
   208	    (greger-client--add-cache-control user-messages)
   209	
   210	    ;; Build base request
   211	    (let ((max-tokens (+ max-tokens (or thinking-budget 0))))
   212	      (setq request-data `(("model" . ,(symbol-name model))
   213	                           ("messages" . ,user-messages)
   214	                           ("max_tokens" . ,max-tokens)
   215	                           ("stream" . t))))
   216	
   217	    ;; Add system message if present
   218	    (when system-message
   219	      (push `("system" . ,system-message) request-data))
   220	
   221	    ;; Add tools if present
   222	    (when (or tools server-tools)
   223	      ;; TODO: why are we parsing server tools here?
   224	      (let* ((parsed-server-tools (when server-tools
   225	                                    (mapcar (lambda (json-string)
   226	                                              (json-parse-string json-string :object-type 'alist))
   227	                                            server-tools)))
   228	             (all-tools (append (or tools '()) (or parsed-server-tools '()))))
   229	        (push `("tools" . ,all-tools) request-data)
   230	        (push `("tool_choice" . (("type" . "auto"))) request-data)))
   231	
   232	    ;; Add thinking configuration if present
   233	    (when thinking-budget
   234	      (if (> thinking-budget 0)
   235	          (push `("thinking" . (("type" . "enabled")
   236	                                ("budget_tokens" . ,thinking-budget))) request-data)
   237	        (push `("thinking" . (("type" . "disabled"))) request-data)))
   238	
   239	    (json-encode request-data)))
   240	
   241	;;; Stream processing
   242	
   243	(defun greger-client--check-for-error (output state)
   244	  "Check OUTPUT for error responses and store error message if found.
   245	Returns error information if found, nil otherwise.
   246	STATE is the greger client state."
   247	  (condition-case nil
   248	      (let ((data (json-read-from-string output)))
   249	        (when (and (listp data)
   250	                   (string= (alist-get 'type data) "error"))
   251	          (let* ((error-info (alist-get 'error data))
   252	                 (error-message (alist-get 'message error-info))
   253	                 (error-type (alist-get 'type error-info))
   254	                 (error-string (format "API Error (%s): %s" error-type error-message)))
   255	            ;; Store the error message for later processing in completion handler
   256	            (setf (greger-client-state-error-message state) error-string)
   257	            error-info)))
   258	    (json-error nil)
   259	    (json-readtable-error nil)))
   260	
   261	(defun greger-client--process-output-chunk (output state)
   262	  "Process a chunk of OUTPUT using STATE."
   263	
   264	  ;; Uncomment this line for raw debugging output of every
   265	  ;; streaming message returned from the Anthropic API
   266	  ;; (message "output: %s" output)
   267	
   268	  ;; Check for error responses and call error callback if found
   269	  (greger-client--check-for-error output state)
   270	
   271	  ;; Update working buffer for chunk processing
   272	  (setf (greger-client-state-accumulated-output state)
   273	        (concat (greger-client-state-accumulated-output state) output))
   274	
   275	  (greger-client--process-events state))
   276	
   277	(defun greger-client--process-events (state)
   278	  "Process Claude streaming events from accumulated output in STATE."
   279	  (let ((accumulated (greger-client-state-accumulated-output state)))
   280	
   281	    ;; Process complete lines (events)
   282	    (while (string-match "\n" accumulated)
   283	      (let* ((line-end (match-end 0))
   284	             (line (substring accumulated 0 (1- line-end))))
   285	
   286	        ;; Process the line if it's a data event
   287	        (when (string-prefix-p "data: " line)
   288	          (let ((data-json (substring line 6)))
   289	            (unless (string= data-json "[DONE]")
   290	              (greger-client--handle-event data-json state))))
   291	
   292	        ;; Remove processed line
   293	        (setq accumulated (substring accumulated line-end))))
   294	
   295	    ;; Store remaining incomplete data
   296	    (setf (greger-client-state-accumulated-output state) accumulated)))
   297	
   298	(defun greger-client--handle-event (data-json state)
   299	  "Handle a Claude streaming event with DATA-JSON using STATE."
   300	  (let* ((data (json-read-from-string data-json))
   301	         (type (alist-get 'type data)))
   302	    (cond
   303	
   304	     ;; Handle errors
   305	     ((string= type "error")
   306	      (greger-client--handle-error data))
   307	
   308	     ;; Content block start - create new content block
   309	     ((string= type "content_block_start")
   310	      (greger-client--handle-content-block-start data state))
   311	
   312	     ;; Content block delta - update existing content block
   313	     ((string= type "content_block_delta")
   314	      (greger-client--handle-content-block-delta data state))
   315	
   316	     ;; Content block stop - finalize tool input if needed
   317	     ((string= type "content_block_stop")
   318	      (greger-client--handle-content-block-stop data state)))))
   319	
   320	(defun greger-client--handle-error (data)
   321	  (if-let* ((err (alist-get 'error data))
   322	            (message (alist-get 'message err)))
   323	      (warn "Anthropic API threw error: %s" message)
   324	    (warn "Anthropic API threw error")))
   325	
   326	(defun greger-client--handle-content-block-start (data state)
   327	  "Initialize new streaming content block from DATA in STATE."
   328	  (let* ((index (alist-get 'index data))
   329	         (content-block (copy-alist (alist-get 'content_block data)))
   330	         (blocks (greger-client-state-content-blocks state))
   331	         (type (alist-get 'type content-block))
   332	         (citations (alist-get 'citations content-block)))
   333	
   334	    ;; Initialize content for accumulation.
   335	    ;; For tool_use and server_tool_use we make the input object a
   336	    ;; string while we accumulate the output, and turn it back into
   337	    ;; an object again in greger-client--handle-content-stop
   338	    ;; Initialize content fields based on content block type
   339	    (cond
   340	     ((string= type "tool_use")
   341	      (setf (alist-get 'input content-block) ""))
   342	     ((string= type "server_tool_use")
   343	      (setf (alist-get 'input content-block) ""))
   344	     ((string= type "text")
   345	      (setf (alist-get 'text content-block) "")
   346	      ;; For text blocks with citations, initialize citations as empty list
   347	      (when citations
   348	        (setf (alist-get 'citations content-block) '())))
   349	     ((string= type "thinking")
   350	      (setf (alist-get 'thinking content-block) ""))
   351	     ;; web_search_tool_result blocks come pre-populated with content - no initialization needed
   352	     )
   353	
   354	    (when-let ((callback (greger-client-state-block-start-callback state)))
   355	      (funcall callback content-block))
   356	
   357	    ;; Add block at the right index
   358	    (greger-client--ensure-block-at-index blocks index content-block state)))
   359	
   360	(defun greger-client--handle-content-block-delta (data state)
   361	  "Process incremental content update from streaming DATA in STATE."
   362	  (let* ((index (alist-get 'index data))
   363	         (delta (alist-get 'delta data))
   364	         (delta-type (alist-get 'type delta))
   365	         (blocks (greger-client-state-content-blocks state))
   366	         (block (nth index blocks)))
   367	
   368	    ;; TODO: do we need to handle content block stop out-of-order,
   369	    ;; before content-block start has created the block in the state's content-blocks?
   370	
   371	    (cond
   372	
   373	     ;; assistant text
   374	     ;; {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"I'll search for the"}}
   375	     ((string= delta-type "text_delta")
   376	      (let ((text-delta (alist-get 'text delta))
   377	            (has-citations (alist-get 'citations block)))
   378	        (setf (alist-get 'text block)
   379	              (concat (alist-get 'text block) text-delta))
   380	        ;; Only call text callback for live display if this block doesn't have citations
   381	        ;; Citation blocks should not stream text - they'll be handled in block-stop
   382	        (unless has-citations
   383	          (when-let ((callback (greger-client-state-text-delta-callback state)))
   384	            (funcall callback text-delta)))))
   385	
   386	     ;; assistant thinking
   387	     ;; data: {"type":"content_block_delta","index":0,"delta":{"type":"thinking_delta","thinking":" needing to search for"}}
   388	     ((string= delta-type "thinking_delta")
   389	      (let ((thinking-delta (alist-get 'thinking delta)))
   390	        (setf (alist-get 'thinking block)
   391	              (concat (alist-get 'thinking block) thinking-delta))
   392	        (when-let ((callback (greger-client-state-text-delta-callback state)))
   393	          (funcall callback thinking-delta))))
   394	
   395	     ;; assistant thinking signature
   396	     ((string= delta-type "signature_delta")
   397	      (let ((signature-delta (alist-get 'signature delta)))
   398	        (setf (alist-get 'signature block)
   399	              (concat (alist-get 'signature block) signature-delta))))
   400	
   401	     ;; tool_use and server_tool_use
   402	     ;; {"type":"content_block_delta","index":1,"delta":{"type":"input_json_delta","partial_json":""}}
   403	     ((string= delta-type "input_json_delta")
   404	      (let ((partial-json (alist-get 'partial_json delta)))
   405	        (setf (alist-get 'input block)
   406	              (concat (alist-get 'input block) partial-json))))
   407	
   408	     ;; Citations accumulation
   409	     ;; {"type":"content_block_delta","index":3,"delta":{"type":"citations_delta","citation":{"type":"web_search_result_location",...}}}
   410	     ((string= delta-type "citations_delta")
   411	      (let ((citation (alist-get 'citation delta))
   412	            (current-citations (alist-get 'citations block)))
   413	        ;; Add the new citation to the list
   414	        (setf (alist-get 'citations block)
   415	              (append current-citations (list citation))))))))
   416	
   417	(defun greger-client--handle-content-block-stop (data state)
   418	  "Finalize the current block and send callbacks from STATE.
   419	DATA is the streaming entry for the stop content block."
   420	  (let* ((index (alist-get 'index data))
   421	         (blocks (greger-client-state-content-blocks state))
   422	         (block (nth index blocks))
   423	         (type (alist-get 'type block)))
   424	
   425	    ;; TODO: do we need to handle content block stop out-of-order,
   426	    ;; before content-block start has created the block in the state's content-blocks?
   427	
   428	    (cond
   429	     ;; Handle tool use blocks - turn accumulated JSON string back into an object
   430	     ((or (string= type "tool_use") (string= type "server_tool_use"))
   431	      (let ((input-str (alist-get 'input block)))
   432	        (if (string-empty-p input-str)
   433	            (setf (alist-get 'input block) '())
   434	          (setf (alist-get 'input block) (json-read-from-string input-str))))))
   435	
   436	    (when-let ((callback (greger-client-state-block-stop-callback state)))
   437	      (funcall callback type block))))
   438	
   439	(defun greger-client--ensure-block-at-index (_blocks index new-block state)
   440	  "Ensure BLOCKS list has NEW-BLOCK at INDEX, extending if necessary.
   441	STATE is used to update the parsed content blocks."
   442	  (let ((current-blocks (greger-client-state-content-blocks state)))
   443	    ;; Extend list if needed
   444	    (while (<= (length current-blocks) index)
   445	      (setq current-blocks (append current-blocks (list nil))))
   446	
   447	    ;; Set the block at index
   448	    (setf (nth index current-blocks) new-block)
   449	    (setf (greger-client-state-content-blocks state) current-blocks)))
   450	
   451	(defun greger-client--handle-completion (proc state)
   452	  "Handle process completion for PROC using STATE."
   453	  (when (memq (process-status proc) '(exit signal))
   454	    (funcall (greger-client-state-restore-callback state) state)
   455	
   456	    (let ((exit-code (process-exit-status proc))
   457	          (stored-error (greger-client-state-error-message state)))
   458	      (cond
   459	
   460	       ;; Process succeeded - call completion callback
   461	       ((and (= exit-code 0) (not stored-error))
   462	        (when-let ((callback (greger-client-state-complete-callback state)))
   463	          (funcall callback (greger-client-state-content-blocks state))))
   464	
   465	       ;; Exit code 2 means process interrupted
   466	       ((= exit-code 2)
   467	        (message "Process interrupted"))
   468	
   469	       ;; Process failed - raise error with stored message or generic message
   470	       (t
   471	        (let ((error-message (or stored-error
   472	                                 (format "Process exited with status code %d" exit-code))))
   473	          (when-let ((callback (greger-client-state-error-callback state)))
   474	            (funcall callback error-message))))))))
   475	
   476	(defun greger-client--cancel-request (state)
   477	  "Cancel streaming request using STATE."
   478	  (let ((process (greger-client-state-process state)))
   479	    (when (process-live-p process)
   480	      (message "Interrupting generation")
   481	      (interrupt-process process)
   482	      (sit-for 0.1)
   483	      (delete-process process))
   484	    (funcall (greger-client-state-restore-callback state) state)))
   485	
   486	;;; Utility functions
   487	
   488	(defun greger-client--start-curl-process (request-spec)
   489	  "Start curl process with REQUEST-SPEC."
   490	  (start-process-shell-command
   491	   "greger-curl" nil
   492	   (greger-client--build-curl-command request-spec)))
   493	
   494	(defun greger-client--build-curl-command (request-spec)
   495	  "Build curl command from REQUEST-SPEC."
   496	  (let ((url (plist-get request-spec :url))
   497	        (method (plist-get request-spec :method))
   498	        (headers (plist-get request-spec :headers))
   499	        (data (plist-get request-spec :data)))
   500	    (format "curl -s -X %s %s %s %s"
   501	            method
   502	            (mapconcat (lambda (header)
   503	                         (format "-H \"%s: %s\"" (car header) (cdr header)))
   504	                       headers " ")
   505	            (if data
   506	                (format "--data-raw %s" (shell-quote-argument data))
   507	              "")
   508	            url)))
   509	
   510	(provide 'greger-client)
   511	
   512	;;; greger-client.el ends here

---------



# greger-parser.el:

     1	;;; greger-parser.el --- Parser for greger dialog format -*- lexical-binding: t -*-
