# greger-stdlib.el:

     1	;;; greger-stdlib.el --- Tool definitions for greger agent -*- lexical-binding: t -*-
     2	
     3	;; Copyright (C) 2025 Andreas Jansson
     4	
     5	;; Author: Andreas Jansson <andreas@jansson.me.uk>
     6	;; Version: 0.1.0
     7	;; URL: https://github.com/andreasjansson/greger.el
     8	;; SPDX-License-Identifier: MIT
     9	
    10	;; Permission is hereby granted, free of charge, to any person obtaining a copy
    11	;; of this software and associated documentation files (the "Software"), to deal
    12	;; in the Software without restriction, including without limitation the rights
    13	;; to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
    14	;; copies of the Software, and to permit persons to whom the Software is
    15	;; furnished to do so, subject to the following conditions:
    16	
    17	;; The above copyright notice and this permission notice shall be included in all
    18	;; copies or substantial portions of the Software.
    19	
    20	;; THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    21	;; IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    22	;; FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    23	;; AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    24	;; LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
    25	;; OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
    26	;; SOFTWARE.
    27	
    28	;;; Commentary:
    29	;; Defines tools available to the greger agent
    30	
    31	;;; Code:
    32	
    33	(require 'cl-lib)
    34	(require 'ansi-color)
    35	
    36	(require 'greger-tools)
    37	(require 'greger-web)
    38	(require 'greger-client)
    39	
    40	;; Configuration for Claude interactive input
    41	(defcustom greger-stdlib-claude-interactive-input t
    42	  "Whether to use Claude for automated interactive input responses.
    43	When enabled, Claude will be consulted first for interactive prompts.
    44	If Claude responds with 'USER', the user will be prompted.
    45	Password prompts always go to the user regardless of this setting."
    46	  :type 'boolean
    47	  :group 'greger)
    48	
    49	(defcustom greger-stdlib-claude-interactive-timeout 10.0
    50	  "Timeout in seconds for Claude API calls during interactive input.
    51	If Claude doesn't respond within this time, fallback to user input."
    52	  :type 'float
    53	  :group 'greger)
    54	
    55	;; Server tool registrations
    56	
    57	(greger-register-server-tool "web_search"
    58	                             :type "web_search_20250305"
    59	                             :max_uses 5)
    60	
    61	;; Tool registrations
    62	
    63	;; Editing tools
    64	
    65	(greger-register-tool "read-file"
    66	                      :description "Read the contents of a file from the filesystem"
    67	                      :properties '((path . ((type . "string")
    68	                                             (description . "Path to the file to read")))
    69	                                    (include-line-numbers . ((type . "boolean")
    70	                                                             (description . "Whether to include line numbers in the output. If you plan to modify the file, you should include line numbers here so you know which lines to edit.")
    71	                                                             (default . nil)))
    72	                                    (start-line . ((type . "integer")
    73	                                                   (description . "Starting line number (1-based) to begin reading from. If not specified, reads from the beginning of the file.")
    74	                                                   (default . nil)))
    75	                                    (end-line . ((type . "integer")
    76	                                                 (description . "Ending line number (1-based) to stop reading at (inclusive). If not specified, reads to the end of the file.")
    77	                                                 (default . nil))))
    78	                      :required '("path")
    79	                      :function 'greger-stdlib--read-file)
