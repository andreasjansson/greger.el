# greger.el:

     1	;;; greger.el --- Agentic coding environment with tool use, using Claude -*- lexical-binding: t -*-
     2	
     3	;; Copyright (C) 2025 Andreas Jansson
     4	
     5	;; Author: Andreas Jansson <andreas@jansson.me.uk>
