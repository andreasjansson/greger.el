478: (defun greger-openrouter--convert-citations-to-annotations (citations)
479:   "Convert Greger citation list back to OpenRouter annotations format."
480:   (vconcat
481:    (mapcar
482:     (lambda (citation)
483:       (let ((url (alist-get 'url citation))
484:             (title (alist-get 'title citation))
485:             (cited-text (alist-get 'cited_text citation)))
486:         `((type . "url_citation")
487:           (url_citation . ((url . ,url)
488:                            (title . ,title)
489:                            (content . ,cited-text)
490:                            (start_index . 0)
491:                            (end_index . 0))))))
492:     citations)))
493: 
494: (defun greger-openrouter--handle-completion (proc state)
495:   "Handle process completion."
496:   (when (memq (process-status proc) '(exit signal))
497:     (funcall (greger-openrouter-state-restore-callback state) state)
498:     
499:     (let ((exit-code (process-exit-status proc))
500:           (stored-error (greger-openrouter-state-error-message state)))
501:       (cond
502:        ((and (= exit-code 0) (not stored-error))
503:         (when-let ((callback (greger-openrouter-state-complete-callback state)))
504:           (funcall callback (greger-openrouter--build-content-blocks state))))
505:        
506:        ((= exit-code 2)
507:         (message "Process interrupted"))
508:        
509:        (t
510:         (let ((error-message (or stored-error
511:                                  (format "Process exited with status code %d" exit-code))))
512:           (when-let ((callback (greger-openrouter-state-error-callback state)))
513:             (funcall callback error-message))))))))
514: 
515: (defun greger-openrouter--start-curl-process (request-spec)
516:   "Start curl process for OpenRouter."
517:   (start-process-shell-command
518:    "greger-openrouter-curl" nil
519:    (greger-openrouter--build-curl-command request-spec)))
520: 
521: (defun greger-openrouter--build-curl-command (request-spec)
522:   "Build curl command for OpenRouter."
523:   (let ((url (plist-get request-spec :url))
524:         (method (plist-get request-spec :method))
525:         (headers (plist-get request-spec :headers))
526:         (data (plist-get request-spec :data)))
527:     (format "curl -s -X %s %s %s %s"
528:             method
529:             (mapconcat (lambda (header)
530:                          (format "-H \"%s: %s\"" (car header) (cdr header)))
531:                        headers " ")
532:             (if data
533:                 (format "--data-raw %s" (shell-quote-argument data))
534:               "")
535:             url)))
536: 
537: (defun greger-openrouter--cancel-request (state)
538:   "Cancel streaming request."
539:   (let ((process (greger-openrouter-state-process state)))
540:     (when (process-live-p process)
541:       (message "Interrupting generation")
542:       (interrupt-process process)
543:       (sit-for 0.1)
544:       (delete-process process))
545:     (funcall (greger-openrouter-state-restore-callback state) state)))
546: 
547: (provide 'greger-openrouter)
548: 
