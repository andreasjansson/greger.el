   253	;; Helper functions
   254	
   255	(cl-defun greger-stdlib--assert-arg-string (name value &key min-length)
   256	  "Assert that VALUE is a string, error with NAME if not."
   257	  (unless (stringp value)
   258	    (error "Invalid argument: %s must be a string" name))
   259	  (when (and min-length (< (length value) min-length))
   260	    (error "Invalid argument: %s must have a length of at least %d" name min-length)))
   261	
   262	(defun greger-stdlib--assert-arg-bool (name value)
   263	  "Assert that VALUE is a boolean, error with NAME if not."
   264	  (unless (booleanp value)
   265	    (error "Invalid argument: %s must be a boolean" name)))
   266	
   267	(defun greger-stdlib--assert-arg-string-vector (name value)
   268	  "Assert that VALUE is a vector of strings, error with NAME if not."
   269	  (unless (vectorp value)
   270	    (error "Invalid argument: %s must be a vector" name))
   271	  (seq-doseq (item value)
   272	    (unless (stringp item)
   273	      (error "Invalid argument: each element in %s must be a string" name))))
   274	
   275	(cl-defun greger-stdlib--assert-arg-int (name value &key ge le)
   276	  "Assert that VALUE is an integer within the specified bounds.
   277	Error with NAME if not. Either bound can be nil to skip that check."
   278	  (unless (integerp value)
   279	    (error "Invalid argument: %s must be an integer" name))
   280	  (when (and ge (< value ge))
   281	    (error "Invalid argument: %s must be >= %d" name ge))
   282	  (when (and le (> value le))
   283	    (error "Invalid argument: %s must be <= %d" name le)))
   284	
   285	(defun greger-stdlib--assert-arg-string-web-url (name value)
   286	  "Assert that VALUE is a valid web URL string, error with NAME if not."
   287	  (greger-stdlib--assert-arg-string name value)
   288	  (when (string-empty-p (string-trim value))
   289	    (error "Invalid argument: %s cannot be empty" name))
   290	  (unless (greger-web-is-web-url-p value)
   291	    (error "Invalid argument: %s must be a valid URL (starting with http:// or https://)" name)))
   292	
   293	(cl-defun greger-stdlib--run-async-subprocess (&key command args working-directory callback timeout env streaming-callback)
   294	  "Run COMMAND with ARGS in WORKING-DIRECTORY and call CALLBACK.
   295	CALLBACK will be called with (output nil) on success or (nil error-message) on
   296	failure.
   297	TIMEOUT specifies the maximum time in seconds to wait for completion,
   298	the default is no timeout.
   299	ENV is an optional alist of environment variables to set.
   300	STREAMING-CALLBACK, if provided, will be called with each chunk of output
   301	as it arrives from the subprocess.
   302	Returns a cancel function that can be called to interrupt the process."
   303	  (let* ((process-name (format "greger-subprocess-%s" (make-temp-name "")))
   304	         (process-buffer (generate-new-buffer (format " *%s*" process-name)))
   305	         (default-directory (expand-file-name (or working-directory ".")))
   306	         (process-environment (if env
   307	                                  (append (mapcar (lambda (pair) (format "%s=%s" (car pair) (cdr pair))) env)
   308	                                          process-environment)
   309	                                process-environment))
   310	         (process nil)
   311	         (callback-called nil)
   312	         (timeout-timer nil))
   313	
   314	    (condition-case err
   315	        (progn
   316	          (setq process (apply #'start-process process-name process-buffer command args))
   317	          (set-process-query-on-exit-flag process nil)
   318	
   319	          ;; Set up timeout timer if specified
   320	          (when timeout
   321	            (setq timeout-timer
   322	                  (run-at-time timeout nil
   323	                               (lambda ()
   324	                                 (when (and process (process-live-p process))
   325	                                   (unless callback-called
   326	                                     (setq callback-called t)
   327	                                     (when timeout-timer
   328	                                       (cancel-timer timeout-timer))
   329	                                     (interrupt-process process)
   330	                                     (sit-for 0.1)
   331	                                     (when (process-live-p process)
   332	                                       (delete-process process))
   333	                                     (when (buffer-live-p process-buffer)
   334	                                       (kill-buffer process-buffer))
   335	                                     (funcall callback nil (format "Command timed out after %d seconds" timeout))))))))
   336	
   337	          (set-process-sentinel
   338	           process
   339	           (lambda (proc _event)
   340	             (unless callback-called
   341	               (setq callback-called t)
   342	               ;; Cancel timeout timer if it's running
   343	               (when timeout-timer
   344	                 (cancel-timer timeout-timer))
   345	               (let* ((exit-status (process-exit-status proc))
   346	                      (output (with-current-buffer process-buffer
   347	                                (buffer-string)))
   348	                      (callback-output (cond
   349	                                        ((and (not streaming-callback)
   350	                                              (string-empty-p (string-trim output)))
   351	                                         "(no output)")
   352	                                        ;; when streaming, don't output the text
   353	                                        (streaming-callback "")
   354	                                        (t output)))
   355	                      (callback-error-message (concat (format "Command failed with exit code %d" exit-status)
   356	                                                      (if streaming-callback
   357	                                                          ""
   358	                                                        (concat ": " callback-output)))))
   359	                 (when (buffer-live-p process-buffer)
   360	                   (kill-buffer process-buffer))
   361	                 (cond
   362	                  ((= exit-status 0)
   363	                   (funcall callback callback-output nil))
   364	                  (t
   365	                   (funcall callback nil callback-error-message)))))))
   366	
   367	          (when streaming-callback
   368	            (set-process-filter
   369	             process
   370	             (lambda (_proc output)
   371	               ;; TODO: handle this in a font-lock function instead so
   372	               ;; ansi color codes are applied when a buffer is opened too
   373	               (funcall streaming-callback (ansi-color-apply output)))))
   374	
   375	          ;; Return cancel function
   376	          (lambda ()
   377	            ;; Cancel timeout timer if it's running
   378	            (when timeout-timer
   379	              (cancel-timer timeout-timer))
   380	            (when (and process (process-live-p process))
   381	              (interrupt-process process)
   382	              (sit-for 0.1)
   383	              (when (process-live-p process)
   384	                (delete-process process)))
   385	            (unless callback-called
   386	              (setq callback-called t)
   387	              (when (buffer-live-p process-buffer)
   388	                (kill-buffer process-buffer))
   389	              ;; Call callback with cancellation error
   390	              (funcall callback nil "Command execution was cancelled"))))
   391	      (error
   392	       (when (buffer-live-p process-buffer)
   393	         (kill-buffer process-buffer))
   394	       (funcall callback nil (format "Failed to start process: %s" (error-message-string err)))
   395	       ;; Return no-op cancel function if process failed to start
   396	       (lambda () nil)))))
   397	
   398	(defun greger-stdlib--find-git-repo-root (start-dir)
   399	  "Find the git repository root starting from START-DIR."
   400	  (let ((dir (expand-file-name start-dir)))
   401	    (while (and dir
   402	                (not (file-exists-p (expand-file-name ".git" dir)))
   403	                (not (string= dir (directory-file-name dir))))
   404	      (setq dir (file-name-directory (directory-file-name dir))))
   405	    (when (and dir (file-exists-p (expand-file-name ".git" dir)))
   406	      dir)))
   407	
   408	(defun greger-stdlib--is-file-tracked-by-git (path repo-root)
   409	  "Check if PATH is tracked by git in REPO-ROOT.
   410	Returns t if the file is tracked, nil otherwise."
   411	  (let ((default-directory repo-root)
   412	        (relative-path (file-relative-name (expand-file-name path) repo-root)))
   413	    (= 0 (call-process "git" nil nil nil "ls-files" "--error-unmatch" relative-path))))
   414	
   415	;; Tools below
   416	
   417	(defun greger-stdlib--git-stage-and-commit (files commit-message &optional chat-buffer)
   418	  "Stage FILES and commit with COMMIT-MESSAGE using git command line.
   419	If CHAT-BUFFER is provided, also stage and commit the chat buffer file."
   420	  (condition-case err
   421	      (let* ((first-file (car files))
   422	             (file-dir (file-name-directory (expand-file-name first-file)))
   423	             (repo-root (greger-stdlib--find-git-repo-root file-dir)))
   424	        (unless repo-root
   425	          (error "File %s is not in a git repository" first-file))
   426	
   427	        ;; Set default-directory to the repository root for git operations
   428	        (let ((default-directory repo-root)
   429	              (all-files files))
   430	
   431	          ;; Add chat buffer file if provided, it has a file, and it's already tracked in git
   432	          (when (and chat-buffer (buffer-file-name chat-buffer))
   433	            (let ((chat-file (buffer-file-name chat-buffer)))
   434	              ;; Only proceed if the chat file is already tracked by git
   435	              (when (greger-stdlib--is-file-tracked-by-git chat-file repo-root)
   436	                ;; Save the chat buffer first if it has unsaved changes
   437	                (with-current-buffer chat-buffer
   438	                  (when (buffer-modified-p)
   439	                    (save-buffer)))
   440	                ;; Add chat file to the list of files to stage
   441	                (push chat-file all-files))))
   442	
   443	          ;; Stage the files
   444	          (dolist (file all-files)
   445	            (let ((relative-path (file-relative-name (expand-file-name file) repo-root)))
   446	              (unless (= 0 (call-process "git" nil nil nil "add" relative-path))
   447	                (error "Failed to stage file: %s" file))))
   448	
   449	          ;; Create the commit
   450	          (unless (= 0 (call-process "git" nil nil nil "commit" "-m" commit-message))
   451	            (error "Failed to create commit"))
   452	
   453	          (format "Successfully staged %d file(s) and committed with message: %s"
   454	                  (length all-files) commit-message)))
   455	    (error "Git operation failed: %s" (error-message-string err))))
   456	
   457	(defun greger-stdlib--read-file (path include-line-numbers start-line end-line)
   458	  "Read file at PATH.  If INCLUDE-LINE-NUMBERS is non-nil, prepend line numbers.
   459	If START-LINE is specified, start reading from that line (1-based).
   460	If END-LINE is specified, stop reading at that line (inclusive, 1-based)."
   461	  (greger-stdlib--assert-arg-string "path" path)
   462	  (greger-stdlib--assert-arg-bool "include-line-numbers" include-line-numbers)
   463	  (when start-line
   464	    (greger-stdlib--assert-arg-int "start-line" start-line :ge 1))
   465	  (when end-line
   466	    (greger-stdlib--assert-arg-int "end-line" end-line :ge 1))
   467	
   468	  (when (and start-line end-line (> start-line end-line))
   469	    (error "Invalid value: start-line must be <= end-line"))
   470	
   471	  (let ((expanded-path (expand-file-name path)))
   472	    (unless (file-exists-p expanded-path)
   473	      (error "File does not exist: %s" expanded-path))
   474	
   475	    (unless (file-readable-p expanded-path)
   476	      (error "File is not readable: %s" expanded-path))
   477	
   478	    (when (file-directory-p expanded-path)
   479	      (error "Path is a directory, not a file: %s" expanded-path))
   480	
   481	    (condition-case err
   482	        (with-temp-buffer
   483	          (insert-file-contents expanded-path)
   484	          (let* ((all-lines (split-string (buffer-string) "\n"))
   485	                 ;; Remove trailing empty line if it exists (from trailing newline)
   486	                 (all-lines (if (and (> (length all-lines) 0)
   487	                                     (string-empty-p (car (last all-lines))))
   488	                                (butlast all-lines)
   489	                              all-lines))
   490	                 (total-lines (length all-lines))
   491	                 (actual-start (or start-line 1))
   492	                 (actual-end (or end-line total-lines))
   493	                 (selected-lines (greger-stdlib--extract-line-range all-lines actual-start actual-end))
   494	                 (contents (mapconcat #'identity selected-lines "\n")))
   495	            (if include-line-numbers
   496	                (greger-stdlib--add-line-numbers-with-offset contents actual-start)
   497	              contents)))
   498	      (error "Failed to read file: %s" (error-message-string err)))))
   499	
   500	(defun greger-stdlib--extract-line-range (lines start-line end-line)
   501	  "Extract lines from LINES between START-LINE and END-LINE (1-based, inclusive)."
   502	  (let ((start-index (1- start-line))  ; Convert to 0-based index
   503	        (end-index (1- end-line)))     ; Convert to 0-based index
   504	    ;; Ensure indices are within bounds
   505	    (setq start-index (max 0 start-index))
   506	    (setq end-index (min (1- (length lines)) end-index))
   507	    ;; Extract the range
   508	    (cl-subseq lines start-index (1+ end-index))))
   509	
   510	(defun greger-stdlib--add-line-numbers-with-offset (content start-line-num)
   511	  "Add line numbers to CONTENT string starting from START-LINE-NUM."
   512	  (let* ((lines (split-string content "\n"))
   513	         (line-num start-line-num)
   514	         (max-width (length (number-to-string (+ start-line-num (length lines) -1))))
   515	         (number-format (concat "%" (number-to-string max-width) "d: %s"))
   516	         result)
   517	
   518	    ;; Add line numbers to each line
   519	    (dolist (line lines)
   520	      (push (format number-format line-num line) result)
   521	      (setq line-num (1+ line-num)))
   522	
   523	    ;; Join back with newlines
   524	    (mapconcat #'identity (reverse result) "\n")))
   525	
   526	(defun greger-stdlib--list-directory (path &optional exclude-directories-recursive recursive)
   527	  "List directory contents at PATH with detailed file information.
   528	Similar to \\='ls -Rla\\='.
   529	EXCLUDE-DIRECTORIES-RECURSIVE is a vector of directory names to exclude when
   530	recursively listing (defaults to [\".git\" \"__pycache__\"]).
   531	If RECURSIVE is non-nil, list files recursively."
   532	  (greger-stdlib--assert-arg-string "path" path)
   533	
   534	  (let ((expanded-path (expand-file-name path))
   535	        (original-path path))
   536	    (unless (file-exists-p expanded-path)
   537	      (error "Directory does not exist: %s" expanded-path))
   538	
   539	    (unless (file-directory-p expanded-path)
   540	      (error "Path is not a directory: %s" expanded-path))
   541	
   542	    (unless (file-readable-p expanded-path)
   543	      (error "Directory is not readable: %s" expanded-path))
   544	
   545	    (condition-case err
   546	        (greger-stdlib--list-directory-recursive expanded-path exclude-directories-recursive original-path recursive)
   547	      (error "Failed to list directory: %s" (error-message-string err)))))
   548	
   549	(defun greger-stdlib--list-directory-recursive (path exclude-directories-recursive original-path recursive &optional prefix)
   550	  "Recursively list directory contents with detailed information.
   551	PATH is the actual directory path to list.
   552	EXCLUDE-DIRECTORIES-RECURSIVE is vector of directory names to exclude when
   553	recursively listing.
   554	ORIGINAL-PATH is used for display purposes at the root level.
   555	RECURSIVE determines if we should recurse into subdirectories.
   556	PREFIX is used internally for nested directory structure."
   557	  (let ((all-results '())
   558	        (subdirs '())
   559	        (display-path (cond
   560	                       ;; Root level: use original path or relative notation
   561	                       ((string= (or prefix "") "")
   562	                        (let ((display-path-base (or original-path path)))
   563	                          (if (string= display-path-base ".")
   564	                              "./"
   565	                            (file-name-as-directory display-path-base))))
   566	                       ;; Nested level with absolute original path: build absolute path
   567	                       ((and original-path (file-name-absolute-p original-path))
   568	                        (file-name-as-directory
   569	                         (expand-file-name prefix (directory-file-name original-path))))
   570	                       ;; Nested level with relative path: use relative notation
   571	                       (t (concat "./" prefix)))))
   572	
   573	    ;; Build current directory listing
   574	    (let ((current-listing '()))
   575	      ;; Add directory header
   576	      (push (format "%s:" display-path) current-listing)
   577	
   578	      ;; Add current and parent directory entries
   579	      (push (greger-stdlib--format-file-info path "." exclude-directories-recursive) current-listing)
   580	      (unless (string= (expand-file-name path) (expand-file-name "/"))
   581	        (push (greger-stdlib--format-file-info (file-name-directory (directory-file-name path)) ".." exclude-directories-recursive) current-listing))
   582	
   583	      ;; Process files and directories
   584	      (let ((files (directory-files path t)))
   585	        (dolist (file (sort files #'string<))
   586	          (let* ((basename (file-name-nondirectory file)))
   587	            (when (and (not (string= basename "."))
   588	                       (not (string= basename "..")))
   589	              (let ((formatted (greger-stdlib--format-file-info file basename exclude-directories-recursive)))
   590	                (when formatted
   591	                  (push formatted current-listing)))
   592	              ;; Collect subdirectories for recursive processing, excluding based on pattern
   593	              (when (and recursive
   594	                         (file-directory-p file)
   595	                         (greger-stdlib--should-include-directory-in-recursive-listing-p basename exclude-directories-recursive))
   596	                (push file subdirs))))))
   597	
   598	      ;; Add current directory to results (reverse to get correct order)
   599	      (setq all-results (reverse current-listing)))
   600	
   601	    ;; Process subdirectories recursively if requested
   602	    (when recursive
   603	      (dolist (subdir (reverse subdirs)) ; Reverse to maintain alphabetical order
   604	        (let* ((basename (file-name-nondirectory subdir))
   605	               (subdir-results (greger-stdlib--list-directory-recursive
   606	                                subdir exclude-directories-recursive original-path recursive
   607	                                (concat (or prefix "") basename "/"))))
   608	          (setq all-results (append all-results (list "" subdir-results))))))
   609	
   610	    ;; Return results
   611	    (if (> (length all-results) 1) ; More than just the header
   612	        (mapconcat #'identity all-results "\n")
   613	      (format "%s:\nDirectory is empty" display-path))))
   614	
   615	(defun greger-stdlib--format-file-info (filepath displayname _exclude-directories-recursive)
   616	  "Format file information similar to \\='ls -la\\=' output.
   617	FILEPATH is the full path to the file.
   618	DISPLAYNAME is the name to display in the output.
   619	_EXCLUDE-DIRECTORIES-RECURSIVE is unused in this function."
   620	  (when (file-exists-p filepath)
   621	    (let* ((attrs (file-attributes filepath))
   622	           (file-type (nth 0 attrs))
   623	           (size (nth 7 attrs))
   624	           (mode-string (greger-stdlib--file-mode-string attrs))
   625	           (size-or-dir (if (eq file-type t) "(dir)" (format "%8d" size))))
   626	
   627	      (format "%s  %s  %s"
   628	              mode-string
   629	              size-or-dir
   630	              displayname))))
   631	
   632	(defun greger-stdlib--file-mode-string (attrs)
   633	  "Convert file attributes to mode string like \\='drwxr-xr-x\\='.
   634	ATTRS should be the result of `file-attributes'."
   635	  (let* ((file-type (nth 0 attrs))
   636	         (mode (nth 8 attrs))
   637	         (type-char (cond
   638	                     ((eq file-type t) "d")          ; directory
   639	                     ((stringp file-type) "l")       ; symbolic link
   640	                     (t "-")))                       ; regular file
   641	         (perms (if (stringp mode)
   642	                    (substring mode 1)  ; Skip the type character from mode string
   643	                  "rwxrwxrwx")))       ; Default fallback
   644	    (concat type-char perms)))
   645	
   646	(defun greger-stdlib--should-include-directory-in-recursive-listing-p (directory-name exclude-directories-recursive)
   647	  "Return t if directory with DIRECTORY-NAME should be included in listing.
   648	EXCLUDE-DIRECTORIES-RECURSIVE is a vector of directory names to exclude.
   649	If EXCLUDE-DIRECTORIES-RECURSIVE is nil, use default excludes.
   650	If EXCLUDE-DIRECTORIES-RECURSIVE is an empty vector, exclude nothing."
   651	  (let ((actual-exclude-list (if (null exclude-directories-recursive)
   652	                                 [".git" "__pycache__"]
   653	                               exclude-directories-recursive)))
   654	    (not (seq-contains-p actual-exclude-list directory-name))))
   655	
   656	(defun greger-stdlib--write-new-file (path contents git-commit-message &optional buffer)
   657	  "Write CONTENTS to a new file at PATH.  Fails if file already exists.
   658	GIT-COMMIT-MESSAGE will be used for the git commit.
   659	If BUFFER is provided, it will be staged and committed along with the new file."
   660	  (greger-stdlib--assert-arg-string "path" path)
   661	  (greger-stdlib--assert-arg-string "contents" contents)
   662	
   663	  (let ((expanded-path (expand-file-name path)))
   664	
   665	    ;; Check if file already exists
   666	    (when (file-exists-p expanded-path)
   667	      (error "File already exists: %s" expanded-path))
   668	
   669	    (when (string-suffix-p ".el" expanded-path)
   670	      (let ((balance (greger-stdlib--count-paren-balance contents)))
   671	        (unless (= balance 0)
   672	          (error "Unbalanced parentheses in Emacs Lisp content: contents has balance %d. Must be 0. Try again!" balance))))
   673	
   674	    ;; Check if parent directory exists, if not create it
   675	    (let ((parent-dir (file-name-directory expanded-path)))
   676	      (unless (file-exists-p parent-dir)
   677	        (make-directory parent-dir t)))
   678	
   679	    ;; Write the file
   680	    (condition-case err
   681	        (with-temp-buffer
   682	          (insert contents)
   683	          (write-file expanded-path))
   684	      (error "Failed to write file: %s" (error-message-string err)))
   685	
   686	    ;; Stage and commit changes - infer the file to stage
   687	    (let ((git-result (greger-stdlib--git-stage-and-commit (list expanded-path) git-commit-message buffer)))
   688	      (format "Successfully wrote new file %s with %d characters. %s"
   689	              expanded-path (length contents) git-result))))
   690	
   691	(defun greger-stdlib--make-directory (path git-commit-message &optional buffer)
   692	  "Recursively create directory at PATH.
   693	GIT-COMMIT-MESSAGE will be used for the git commit.
   694	If BUFFER is provided, it will be staged and committed along with the directory."
   695	  (greger-stdlib--assert-arg-string "path" path)
   696	
   697	  (let ((expanded-path (expand-file-name path)))
   698	
   699	    ;; Check if path already exists
   700	    (if (file-exists-p expanded-path)
   701	        (if (file-directory-p expanded-path)
   702	            (format "Directory already exists: %s" expanded-path)
   703	          (error "Path exists but is not a directory: %s" expanded-path))
   704	
   705	      ;; Create directory recursively
   706	      (condition-case err
   707	          (progn
   708	            (make-directory expanded-path t)
   709	            ;; For directory creation, we might want to stage a .gitkeep file or similar
   710	            ;; For now, we'll stage the directory path itself (though git doesn't track empty dirs)
   711	            (let ((git-result (greger-stdlib--git-stage-and-commit (list expanded-path) git-commit-message buffer)))
   712	              (format "Successfully created directory: %s. %s" expanded-path git-result)))
   713	        (error "Failed to create directory: %s" (error-message-string err))))))
   714	
   715	(defun greger-stdlib--rename-file (old-path new-path git-commit-message &optional buffer)
   716	  "Rename file from OLD-PATH to NEW-PATH.
   717	GIT-COMMIT-MESSAGE will be used for the git commit.
   718	If BUFFER is provided, it will be staged and committed with the renamed file."
   719	  (greger-stdlib--assert-arg-string "old-path" old-path)
   720	  (greger-stdlib--assert-arg-string "new-path" new-path)
   721	
   722	  (let ((expanded-old-path (expand-file-name old-path))
   723	        (expanded-new-path (expand-file-name new-path)))
   724	
   725	    ;; Check if old file exists
   726	    (unless (file-exists-p expanded-old-path)
   727	      (error "Source file does not exist: %s" expanded-old-path))
   728	
   729	    ;; Check if new file already exists
   730	    (when (file-exists-p expanded-new-path)
   731	      (error "Destination file already exists: %s" expanded-new-path))
   732	
   733	    ;; Ensure destination directory exists
   734	    (let ((parent-dir (file-name-directory expanded-new-path)))
   735	      (unless (file-exists-p parent-dir)
   736	        (make-directory parent-dir t)))
   737	
   738	    ;; Rename the file
   739	    (condition-case err
   740	        (progn
   741	          (rename-file expanded-old-path expanded-new-path)
   742	          ;; Stage both old and new paths (git mv operation)
   743	          (let ((git-result (greger-stdlib--git-stage-and-commit
   744	                             (list expanded-old-path expanded-new-path)
   745	                             git-commit-message buffer)))
   746	            (format "Successfully renamed %s to %s. %s" expanded-old-path expanded-new-path git-result)))
   747	      (error "Failed to rename file: %s" (error-message-string err)))))
   748	
   749	(defun greger-stdlib--delete-files (paths git-commit-message &optional buffer)
   750	  "Delete files at PATHS and stage the deletion in git if tracked.
   751	GIT-COMMIT-MESSAGE will be used for the git commit.
   752	If BUFFER is provided, it will be staged and committed with deleted files."
   753	  (greger-stdlib--assert-arg-string-vector "paths" paths)
   754	  (greger-stdlib--assert-arg-string "git-commit-message" git-commit-message)
   755	
   756	  (let ((expanded-paths '())
   757	        (deleted-files '())
   758	        (git-tracked-files '()))
   759	
   760	    ;; Validate all files exist first
   761	    (seq-doseq (path paths)
   762	      (let ((expanded-path (expand-file-name path)))
   763	        (unless (file-exists-p expanded-path)
   764	          (error "File does not exist: %s" expanded-path))
   765	        (when (file-directory-p expanded-path)
   766	          (error "Cannot delete directories: %s (only files are supported)" expanded-path))
   767	        (push expanded-path expanded-paths)))
   768	
   769	    ;; Check which files are tracked by git before deletion
   770	    (dolist (expanded-path (reverse expanded-paths))
   771	      (let* ((file-dir (file-name-directory expanded-path))
   772	             (repo-root (greger-stdlib--find-git-repo-root file-dir)))
   773	        (when (and repo-root
   774	                   (greger-stdlib--is-file-tracked-by-git expanded-path repo-root))
   775	          (push expanded-path git-tracked-files))))
   776	
   777	    ;; Delete the files
   778	    (condition-case err
   779	        (dolist (expanded-path (reverse expanded-paths))
   780	          (delete-file expanded-path)
   781	          (push expanded-path deleted-files))
   782	      (error "Failed to delete file: %s" (error-message-string err)))
   783	
   784	    ;; Stage and commit the deletions for git-tracked files
   785	    (let ((git-result
   786	           (if git-tracked-files
   787	               (greger-stdlib--git-stage-and-commit
   788	                (reverse git-tracked-files)
   789	                git-commit-message
   790	                buffer)
   791	             "No files were tracked by git")))
   792	
   793	      (format "Successfully deleted %d file(s): %s. Git status: %s"
   794	              (length deleted-files)
   795	              (mapconcat #'identity (reverse deleted-files) ", ")
   796	              git-result))))
   797	
   798	(defun greger-stdlib--replace-file (path contents git-commit-message &optional buffer)
   799	  "Replace the entire contents of PATH with CONTENTS.
   800	GIT-COMMIT-MESSAGE will be used for the git commit.
   801	If BUFFER is provided, it will be staged and committed along with the file."
   802	  (greger-stdlib--assert-arg-string "path" path)
   803	  (greger-stdlib--assert-arg-string "contents" contents)
   804	  (greger-stdlib--assert-arg-string "git-commit-message" git-commit-message)
   805	
   806	  (let ((expanded-path (expand-file-name path)))
   807	
   808	    ;; Check if file exists
   809	    (unless (file-exists-p expanded-path)
   810	      (error "File does not exist: %s" expanded-path))
   811	
   812	    ;; Check if it's actually a file and not a directory
   813	    (when (file-directory-p expanded-path)
   814	      (error "Path is a directory, not a file: %s" expanded-path))
   815	
   816	    (with-current-buffer (find-file-noselect expanded-path)
   817	      ;; Select all content and replace it
   818	      (erase-buffer)
   819	      (insert contents)
   820	
   821	      ;; Save the file
   822	      (save-buffer))
   823	
   824	    ;; Stage and commit the file
   825	    (let ((git-result (greger-stdlib--git-stage-and-commit (list expanded-path) git-commit-message buffer)))
   826	      (format "Successfully replaced contents of %s with %d characters. %s"
   827	              expanded-path (length contents) git-result))))
   828	
   829	(defun greger-stdlib--count-paren-balance (content)
   830	  "Count paren balance in CONTENT, ignoring parens in strings and comments.
   831	Returns the difference between left and right parens (left - right).
   832	Uses `parse-partial-sexp' to properly handle strings and comments."
   833	  (with-temp-buffer
   834	    ;; Set up the buffer with lisp-mode syntax table for proper parsing
   835	    (with-syntax-table lisp-data-mode-syntax-table
   836	      (insert content)
   837	      (goto-char (point-min))
   838	      (let ((balance 0)
   839	            (state nil)
   840	            (pos (point-min)))
   841	        (while (< pos (point-max))
   842	          ;; Parse to the next character
   843	          (setq state (parse-partial-sexp pos (1+ pos) nil nil state))
   844	          (let ((char (char-after pos)))
   845	            ;; Only count parens if we're not in a string or comment
   846	            (unless (or (nth 3 state)  ; in string
   847	                        (nth 4 state)) ; in comment
   848	              (cond
   849	               ((eq char ?\() (setq balance (1+ balance)))
   850	               ((eq char ?\)) (setq balance (1- balance))))))
   851	          (setq pos (1+ pos)))
   852	        balance))))
   853	
   854	(defun greger-stdlib--str-replace (path original-content new-content
   855	                                        git-commit-message &optional
   856	                                        replace-all buffer)
   857	  "Replace ORIGINAL-CONTENT with NEW-CONTENT in PATH.
   858	GIT-COMMIT-MESSAGE will be used for the git commit.
   859	If REPLACE-ALL is non-nil, replace all instances; otherwise replace only the
   860	first instance.
   861	If BUFFER is provided, it will be staged and committed along with the file.
   862	For Emacs Lisp files (.el), checks that parentheses balance is maintained."
   863	  (greger-stdlib--assert-arg-string "path" path)
   864	  (greger-stdlib--assert-arg-string "original-content" original-content)
   865	  (greger-stdlib--assert-arg-string "new-content" new-content)
   866	  (greger-stdlib--assert-arg-string "git-commit-message" git-commit-message)
   867	
   868	  (let ((expanded-path (expand-file-name path)))
   869	
   870	    ;; Check if file exists
   871	    (unless (file-exists-p expanded-path)
   872	      (error "File does not exist: %s" expanded-path))
   873	
   874	    ;; Check if it's actually a file and not a directory
   875	    (when (file-directory-p expanded-path)
   876	      (error "Path is a directory, not a file: %s" expanded-path))
   877	
   878	    ;; Check paren balance for Emacs Lisp files
   879	    (when (string-suffix-p ".el" expanded-path)
   880	      (let ((orig-balance (greger-stdlib--count-paren-balance original-content))
   881	            (new-balance (greger-stdlib--count-paren-balance new-content)))
   882	        (unless (= orig-balance new-balance)
   883	          (error "Parentheses balance mismatch in Emacs Lisp content: original has balance %d, new has balance %d.  They must be equal.  Try again!"
   884	                 orig-balance new-balance))))
   885	
   886	    (let ((replacements-made 0))
   887	      (with-current-buffer (find-file-noselect expanded-path)
   888	        (let ((case-fold-search nil)) ; Make search case-sensitive
   889	          (goto-char (point-min))
   890	          (if replace-all
   891	              ;; Replace all instances
   892	              (progn
   893	                (while (search-forward original-content nil t)
   894	                  (replace-match new-content nil t)
   895	                  (setq replacements-made (1+ replacements-made)))
   896	                (when (= replacements-made 0)
   897	                  (error "Original content not found in file: %s -- Try again!" expanded-path)))
   898	            ;; Replace only first instance (original behavior)
   899	            ;; But first check if there are multiple occurrences
   900	            (let ((first-occurrence-pos nil)
   901	                  (occurrence-count 0))
   902	              (while (search-forward original-content nil t)
   903	                (setq occurrence-count (1+ occurrence-count))
   904	                (when (= occurrence-count 1)
   905	                  (setq first-occurrence-pos (match-beginning 0))))
   906	              (cond
   907	               ((= occurrence-count 0)
   908	                (error "Original content not found in file: %s -- Try again!" expanded-path))
   909	               ((> occurrence-count 1)
   910	                (error "Found %d occurrences of original content in file: %s. Use replace-all=t to replace all instances, or make the original content more specific -- Try again!" occurrence-count expanded-path))
   911	               (t
   912	                ;; Exactly one occurrence, replace it
   913	                (goto-char first-occurrence-pos)
   914	                (search-forward original-content nil t)
   915	                (replace-match new-content nil t)
   916	                (setq replacements-made 1)))))
   917	
   918	          ;; Save the file
   919	          (save-buffer)))
   920	
   921	      ;; Stage and commit the file
   922	      (let ((git-result (greger-stdlib--git-stage-and-commit (list expanded-path) git-commit-message buffer))
   923	            (count-msg (if (> replacements-made 1)
   924	                           (format " (made %d replacements)" replacements-made)
   925	                         "")))
   926	        (format "Successfully replaced content in %s%s. %s" expanded-path count-msg git-result)))))
   927	
   928	(defun greger-stdlib--shell-command (command callback working-directory timeout enable-environment use-vterm streaming-callback metadata)
   929	  "Execute COMMAND in WORKING-DIRECTORY and call CALLBACK with (result error).
   930	Prompts for permission before running the command for security.
   931	TIMEOUT is the maximum time in sconds to wait for completion (default 600).
   932	ENABLE-ENVIRONMENT, if non-nil, sources shell initialization files which
   933	may contain secrets and environment variables.  User will be warned in
   934	permission prompt.
   935	USE-VTERM, if non-nil, uses vterm for full terminal emulation with colors
   936	and ANSI sequences. Falls back to regular subprocess if vterm is not available.
   937	If METADATA contains safe-shell-commands and COMMAND is in that list, skips
   938	permission prompt.
   939	Returns a cancel function that can interrupt the command execution."
   940	  (greger-stdlib--assert-arg-string "command" command :min-length 1)
   941	  (when working-directory
   942	    (greger-stdlib--assert-arg-string "working-directory" working-directory))
   943	
   944	  (let* ((work-dir (or working-directory "."))
   945	         (expanded-work-dir (expand-file-name work-dir))
   946	         (safe-commands (plist-get metadata :safe-shell-commands))
   947	         (allow-all-shell-commands (plist-get metadata :allow-all-shell-commands)))
   948	
   949	    (unless (file-exists-p expanded-work-dir)
   950	      (error "Working directory does not exist: %s" expanded-work-dir))
   951	    (unless (file-directory-p expanded-work-dir)
   952	      (error "Working directory path is not a directory: %s" expanded-work-dir))
   953	    (when (and (not allow-all-shell-commands)
   954	               (not (member command safe-commands))
   955	               (not (y-or-n-p (format "Execute shell command: '%s' in directory '%s'%s? "
   956	                                      command
   957	                                      expanded-work-dir
   958	                                      (if enable-environment
   959	                                          " (with full environment including secrets)"
   960	                                        "")))))
   961	      (error "Shell command execution cancelled by user"))
   962	
   963	    ;; Use vterm if explicitly requested and available
   964	    (if (and use-vterm 
   965	             (condition-case nil
   966	                 (progn (require 'vterm) t)
   967	               (error nil))
   968	             (fboundp 'vterm-mode))
   969	        (greger-stdlib--run-shell-command-with-vterm
   970	         command
   971	         expanded-work-dir
   972	         callback
   973	         timeout
   974	         enable-environment
   975	         streaming-callback)
   976	      ;; Check if vterm was requested but not available
   977	      (if use-vterm
   978	          (error "VTERM ERROR: vterm is not available. Please install the vterm package or set use-vterm to false")
   979	        ;; Use traditional subprocess execution
   980	        (let* ((bash-args (if enable-environment
   981	                              ;; Interactive to source .bash_profile and .bashrc
   982	                              (list "-i" "-c" command)
   983	                            ;; Non-interactive shell (current behavior)
   984	                            (list "-c" command)))
   985	               (base-env '(("PAGER" . "cat")))
   986	               (shell-env base-env))
   987	
   988	          (greger-stdlib--run-async-subprocess
   989	           :command "bash"
   990	           :args bash-args
   991	           :working-directory expanded-work-dir
   992	           :callback callback
   993	           :timeout timeout
   994	           :streaming-callback streaming-callback
   995	           :env shell-env))))))
   996	
   997	(defun greger-stdlib--ripgrep (pattern path callback case-sensitive file-type
   998	                                       context-lines fixed-strings word-regexp
   999	                                       line-regexp max-results allow-trailing-double-quote)
  1000	  "Search for PATTERN in PATH using the rg command line tool directly.
  1001	CALLBACK is called with (result error) when search completes.
  1002	CASE-SENSITIVE, FILE-TYPE, CONTEXT-LINES, FIXED-STRINGS, WORD-REGEXP,
  1003	LINE-REGEXP, MAX-RESULTS and ALLOW-TRAILING-DOUBLE-QUOTE are optional."
  1004	
  1005	  (unless (executable-find "rg")
  1006	    (error "Command not found: ripgrep (rg).  Please install ripgrep"))
  1007	
  1008	  (greger-stdlib--assert-arg-string "pattern" pattern)
  1009	  (greger-stdlib--assert-arg-string "path" path)
  1010	  (greger-stdlib--assert-arg-bool "case-sensitive" case-sensitive)
  1011	  (greger-stdlib--assert-arg-bool "fixed-strings" fixed-strings)
  1012	  (greger-stdlib--assert-arg-bool "word-regexp" word-regexp)
  1013	  (greger-stdlib--assert-arg-bool "line-regexp" line-regexp)
  1014	  (greger-stdlib--assert-arg-int "context-lines" context-lines :ge 0)
  1015	  (greger-stdlib--assert-arg-int "max-results" max-results :ge 1)
  1016	  (greger-stdlib--assert-arg-bool "allow-trailing-double-quote" allow-trailing-double-quote)
  1017	
  1018	  (when (and (not allow-trailing-double-quote) 
  1019	             (string-suffix-p "\"" pattern))
  1020	    (error "Pattern ends with trailing double quote. This is likely an error. If you really want to search for patterns ending with a double quote, set allow-trailing-double-quote to true"))
  1021	
  1022	  (let ((expanded-path (expand-file-name path)))
  1023	
  1024	    (if (not (file-exists-p expanded-path))
  1025	        (funcall callback nil (format "Path does not exist: %s" expanded-path))
  1026	
  1027	      (let ((args '()))
  1028	        (if case-sensitive
  1029	            (setq args (append args '("--case-sensitive")))
  1030	          (setq args (append args '("--smart-case"))))
  1031	
  1032	        (when (and context-lines (> context-lines 0))
  1033	          (setq args (append args (list "--context" (number-to-string context-lines)))))
  1034	
  1035	        (when (and max-results (> max-results 0))
  1036	          (setq args (append args (list "--max-count" (number-to-string max-results)))))
  1037	
  1038	        (when (and file-type (not (string-empty-p file-type)))
  1039	          (setq args (append args (list "--type" file-type))))
  1040	
  1041	        (when fixed-strings
  1042	          (setq args (append args '("--fixed-strings"))))
  1043	
  1044	        (when word-regexp
  1045	          (setq args (append args '("--word-regexp"))))
  1046	
  1047	        (when line-regexp
  1048	          (setq args (append args '("--line-regexp"))))
  1049	
  1050	        (setq args (append args '("--line-number" "--no-heading")))
  1051	
  1052	        (setq args (append args (list pattern expanded-path)))
  1053	
  1054	        (greger-stdlib--run-async-subprocess
  1055	         :command "rg"
  1056	         :args args
  1057	         :working-directory nil
  1058	         :callback (lambda (output error)
  1059	                     (if error
  1060	                         ;; Check if it's a "no matches" error (exit code 1 with no output)
  1061	                         (if (string-match-p "failed with exit code 1" error)
  1062	                             (funcall callback "No matches found" nil)
  1063	                           (funcall callback nil (format "Failed to execute ripgrep search: %s" error)))
  1064	                       (funcall callback
  1065	                                (if (string-empty-p (string-trim output))
  1066	                                    "No matches found"
  1067	                                  output)
  1068	                                nil))))))))
  1069	
  1070	(defun greger-stdlib--read-webpage (url &optional extract-text use-highest-readability)
  1071	  "Read webpage content from URL.
  1072	If EXTRACT-TEXT is non-nil (default t), extract and return text content.
  1073	If EXTRACT-TEXT is nil, return raw HTML.
  1074	If USE-HIGHEST-READABILITY is non-nil, use eww's aggressive readability setting."
  1075	  (greger-stdlib--assert-arg-string-web-url "url" url)
  1076	
  1077	  (condition-case err
  1078	      (greger-web-download-page url extract-text use-highest-readability)
  1079	    (error "Failed to read webpage: %s" (error-message-string err))))
  1080	
  1081	
  1082	
  1083	(defun greger-stdlib--query-claude-for-interactive-input (context prompt)
  1084	  "Query Claude to determine if it can answer an interactive prompt.
  1085	CONTEXT is the current command output and context.
  1086	PROMPT is the interactive prompt text.
  1087	Returns the response or 'USER' if the user should respond."
  1088	  (condition-case err
  1089	      (let ((response nil)
  1090	            (error-msg nil)
  1091	            (completed nil)
  1092	            (auth-key (or (getenv "ANTHROPIC_API_KEY")
  1093	                         (when (functionp greger-anthropic-key-fn)
  1094	                           (funcall greger-anthropic-key-fn)))))
  1095	        
  1096	        (if (not auth-key)
  1097	            (progn
  1098	              (message "No Claude API key available, falling back to user input")
  1099	              "USER")
  1100	          
  1101	          ;; Truncate context if it's too long to avoid token limits
  1102	          (let ((truncated-context (if (> (length context) 2000)
  1103	                                      (concat (substring context 0 2000) "\n...[truncated]...")
  1104	                                    context)))
  1105	            
  1106	            (let ((dialog `(((role . "system")
  1107	                             (content . "You are helping to automate interactive shell commands. You will be given context from a command execution and an interactive prompt. If you can reasonably answer the prompt based on the context, provide a brief appropriate response. If the user should respond themselves (especially for personal information, passwords, or complex decisions), respond with exactly 'USER' and nothing else. Never try to respond to password prompts."))
  1108	                           ((role . "user")
  1109	                             (content . ,(format "Command context:\n%s\n\nInteractive prompt: %s\n\nAnswer this if you can, otherwise let the user respond. If the user should respond, respond with the string USER and nothing else." truncated-context prompt))))))
  1110	              
  1111	              (greger-client-stream
  1112	               :model 'claude-sonnet-4-20250514
  1113	               :dialog dialog
  1114	               :auth-key auth-key
  1115	               :max-tokens 100
  1116	               :thinking-budget 0
  1117	               :text-delta-callback (lambda (text)
  1118	                                     (setq response (concat (or response "") text)))
  1119	               :complete-callback (lambda (content-blocks)
  1120	                                   (setq completed t))
  1121	               :error-callback (lambda (error-message)
  1122	                                (setq error-msg error-message)
  1123	                                (setq completed t)))
  1124	              
  1125	              ;; Wait for completion with timeout
  1126	              (let ((start-time (current-time)))
  1127	                (while (and (not completed) 
  1128	                           (< (float-time (time-subtract (current-time) start-time)) 
  1129	                              greger-stdlib-claude-interactive-timeout))
  1130	                  (accept-process-output nil 0.1)))
  1131	              
  1132	              (cond
  1133	               (error-msg
  1134	                (message "Claude API error: %s" error-msg)
  1135	                "USER")
  1136	               ((not completed)
  1137	                (message "Claude API timeout")
  1138	                "USER")
  1139	               (t
  1140	                (let ((trimmed-response (string-trim (or response ""))))
  1141	                  (if (string-empty-p trimmed-response)
  1142	                      "USER"
  1143	                    trimmed-response))))))))
  1144	    
  1145	    (error
  1146	     (message "Claude query error: %s" (error-message-string err))
  1147	     "USER")))
  1148	
  1149	(defun greger-stdlib--run-shell-command-with-vterm (command working-directory callback timeout enable-environment streaming-callback)
  1150	  "Execute COMMAND using vterm in WORKING-DIRECTORY and call CALLBACK with (result error).
  1151	This function creates a fresh vterm buffer for each command execution.
  1152	Returns a cancel function that can interrupt the command execution."
  1153	  (require 'vterm)
  1154	  (let* ((buffer-name (format " *greger-vterm-%s*" (random 100000)))
  1155	         (vterm-buffer (get-buffer-create buffer-name))
  1156	         (timer nil)
  1157	         (process nil)
  1158	         (command-completed nil)
  1159	         (last-output-point 0)
  1160	         (prompt-check-timer nil))
  1161	    
  1162	    (with-current-buffer vterm-buffer
  1163	      ;; Set up working directory
  1164	      (setq default-directory working-directory)
  1165	      
  1166	      ;; Configure vterm environment
  1167	      (let ((vterm-environment (list "PAGER=cat"))
  1168	            (vterm-kill-buffer-on-exit nil)
  1169	            (vterm-shell (if enable-environment "bash -i" "bash")))
  1170	        
  1171	        ;; Initialize vterm
  1172	        (vterm-mode)
  1173	        
  1174	        ;; Get the process and configure it for non-interactive cleanup
  1175	        (setq process vterm--process)
  1176	        (when process
  1177	          (set-process-query-on-exit-flag process nil))
  1178	        
  1179	        ;; Set up timeout
  1180	        (when timeout
  1181	          (setq timer (run-with-timer timeout nil
  1182	                                     (lambda ()
  1183	                                       (unless command-completed
  1184	                                         (setq command-completed t)
  1185	                                         (when prompt-check-timer
  1186	                                           (cancel-timer prompt-check-timer))
  1187	                                         (when (and process (process-live-p process))
  1188	                                           (delete-process process))
  1189	                                         (funcall callback nil "Command timed out")
  1190	                                         (when (buffer-live-p vterm-buffer)
  1191	                                           (kill-buffer vterm-buffer)))))))
  1192	        
  1193	        ;; Function to extract clean output
  1194	        (defun extract-clean-output ()
  1195	          "Extract command output, filtering out shell prompts and command echoes."
  1196	          (let ((content (buffer-string)))
  1197	            ;; Remove form feed characters (^L) from vterm-clear and other control chars
  1198	            (setq content (replace-regexp-in-string "[\f\r]" "" content))
  1199	            
  1200	            ;; Split into lines and remove shell artifacts
  1201	            (let ((lines (split-string content "\n")))
  1202	              (let ((filtered-lines
  1203	                     (seq-remove 
  1204	                      (lambda (line)
  1205	                        (let ((trimmed (string-trim line)))
  1206	                          (or 
  1207	                           ;; Shell prompts (user@host:path format)
  1208	                           (string-match "^[^@]*@[^:]*:" trimmed)
  1209	                           ;; Command prompts that start with $
  1210	                           (string-match "^\\$ " trimmed)
  1211	                           ;; Exact command match
  1212	                           (string-equal trimmed command)
  1213	                           ;; Exit command
  1214	                           (string-equal trimmed "exit"))))
  1215	                      lines)))
  1216	                ;; Join lines but don't trim the result to avoid removing first characters
  1217	                (let ((result (string-join filtered-lines "\n")))
  1218	                  ;; Only remove leading/trailing newlines, not other whitespace
  1219	                  (replace-regexp-in-string "\\`\n+\\|\n+\\'" "" result))))))
  1220	        
  1221	        ;; Function to detect interactive prompts
  1222	        (defun detect-interactive-prompt ()
  1223	          "Check if there's an interactive prompt at the end of the buffer."
  1224	          (save-excursion
  1225	            (goto-char (point-max))
  1226	            (forward-line 0)
  1227	            (let ((line (buffer-substring-no-properties (point) (point-max))))
  1228	              (let ((trimmed (string-trim line)))
  1229	                (when (and (not (string-empty-p trimmed))
  1230	                          ;; Exclude normal shell prompts
  1231	                          (not (string-match-p "^[^@]*@[^:]*:" trimmed))
  1232	                          (not (string-match-p "^\\$ " trimmed))
  1233	                          ;; Common interactive prompt patterns
  1234	                          (or (string-match-p ":\\s-*$" trimmed)         ; ends with colon
  1235	                              (string-match-p "\\?\\s-*$" trimmed)       ; ends with question mark
  1236	                              (string-match-p "\\]\\s-*$" trimmed)       ; ends with closing bracket
  1237	                              (string-match-p ">>\\s-*$" trimmed)        ; ends with >>
  1238	                              (string-match-p "Password:" trimmed)       ; password prompt
  1239	                              (string-match-p "Enter " trimmed)          ; "Enter something" prompt
  1240	                              (string-match-p "\\(y/n\\|Y/N\\)" trimmed) ; yes/no prompt
  1241	                              (string-match-p "Press" trimmed)           ; "Press key" prompt
  1242	                              (string-match-p "Continue" trimmed)        ; continue prompt
  1243	                              (string-match-p "Confirm" trimmed)         ; confirm prompt
  1244	                              (string-match-p "Type" trimmed)            ; type something prompt
  1245	                              (string-match-p "Input" trimmed)           ; input prompt
  1246	                              (string-match-p "Select" trimmed)          ; select prompt
  1247	                              (string-match-p "Please" trimmed)          ; please prompt
  1248	                              (string-match-p "\\bname\\b" trimmed)      ; name prompt
  1249	                              (string-match-p "\\bage\\b" trimmed)       ; age prompt
  1250	                              (string-match-p "\\[.*\\]" trimmed)        ; options in brackets
  1251	                              (string-match-p ">>.*" trimmed)            ; any >> prompt
  1252	                              (string-match-p ".*:\\s-*$" trimmed)))     ; any colon at end
  1253	                  trimmed)))))
  1254	        
  1255	        ;; Function to handle interactive input
  1256	        (defun handle-interactive-input ()
  1257	          "Handle interactive input when a prompt is detected."
  1258	          (let ((prompt (detect-interactive-prompt)))
  1259	            (when prompt
  1260	              (let ((is-password (string-match-p "password\\|Password\\|PASS" prompt))
  1261	                    (user-input nil))
  1262	                
  1263	                ;; For password prompts, always ask the user
  1264	                (if is-password
  1265	                    (setq user-input (read-passwd (format "Shell prompt: %s " prompt)))
  1266	                  
  1267	                  ;; For non-password prompts, try Claude first if enabled
  1268	                  (if greger-stdlib-claude-interactive-input
  1269	                      (let* ((context (buffer-string))
  1270	                             (claude-response (greger-stdlib--query-claude-for-interactive-input context prompt)))
  1271	                        
  1272	                        (if (string= claude-response "USER")
  1273	                            ;; Claude says user should respond
  1274	                            (setq user-input (read-from-minibuffer (format "Shell prompt: %s " prompt)))
  1275	                          ;; Claude provided a response
  1276	                          (progn
  1277	                            (message "Claude responding: %s" claude-response)
  1278	                            (setq user-input claude-response))))
  1279	                    
  1280	                    ;; Claude integration disabled, ask user directly
  1281	                    (setq user-input (read-from-minibuffer (format "Shell prompt: %s " prompt)))))
  1282	                
  1283	                (vterm-send-string user-input)
  1284	                (vterm-send-return)
  1285	                ;; Continue monitoring for more prompts
  1286	                (setq prompt-check-timer
  1287	                      (run-with-timer 0.5 nil #'handle-interactive-input))))))
  1288	        
  1289	        ;; Set up process sentinel to capture output when shell terminates
  1290	        (when process
  1291	          (set-process-sentinel process
  1292	                                (lambda (proc event)
  1293	                                  (when (and (not command-completed)
  1294	                                            (string-match "\\(finished\\|exited\\)" event))
  1295	                                    (setq command-completed t)
  1296	                                    (when timer (cancel-timer timer))
  1297	                                    (when prompt-check-timer
  1298	                                      (cancel-timer prompt-check-timer))
  1299	                                    
  1300	                                    ;; Get the final output
  1301	                                    (let ((final-output (if (buffer-live-p vterm-buffer)
  1302	                                                           (with-current-buffer vterm-buffer
  1303	                                                             (extract-clean-output))
  1304	                                                         "")))
  1305	                                      (funcall callback final-output nil))
  1306	                                    
  1307	                                    (when (buffer-live-p vterm-buffer)
  1308	                                      (kill-buffer vterm-buffer))))))
  1309	        
  1310	        ;; Set up streaming callback if provided
  1311	        (when streaming-callback
  1312	          (add-hook 'after-change-functions
  1313	                    (lambda (start end old-len)
  1314	                      (let ((current-content (extract-clean-output)))
  1315	                        (unless (string-empty-p current-content)
  1316	                          (funcall streaming-callback 
  1317	                                  (concat "VTERM_FULL_REPLACE:" current-content))))
  1318	                      ;; Check for interactive prompts on content change
  1319	                      (unless command-completed
  1320	                        (when prompt-check-timer
  1321	                          (cancel-timer prompt-check-timer))
  1322	                        (setq prompt-check-timer
  1323	                              (run-with-timer 0.5 nil #'handle-interactive-input))))
  1324	                    nil t))
  1325	        
  1326	        ;; Wait for shell to be ready, then execute command
  1327	        (run-with-timer 0.5 nil
  1328	                       (lambda ()
  1329	                         (when (buffer-live-p vterm-buffer)
  1330	                           (with-current-buffer vterm-buffer
  1331	                             ;; Clear the buffer - this causes the ^L character
  1332	                             ;; We'll filter it out in extract-clean-output
  1333	                             (vterm-clear)
  1334	                             
  1335	                             ;; Change to working directory if needed
  1336	                             (when (and enable-environment 
  1337	                                       (not (string= working-directory default-directory)))
  1338	                               (vterm-send-string (format "cd %s" (shell-quote-argument working-directory)))
  1339	                               (vterm-send-return)
  1340	                               (sleep-for 0.2))
  1341	                             
  1342	                             ;; Execute the command
  1343	                             (vterm-send-string command)
  1344	                             (vterm-send-return)
  1345	                             
  1346	                             ;; Set up interactive prompt monitoring if no streaming callback
  1347	                             (unless streaming-callback
  1348	                               (setq prompt-check-timer
  1349	                                     (run-with-timer 1.0 nil #'handle-interactive-input)))
  1350	                             
  1351	                             ;; Wait a bit for command to complete, then exit
  1352	                             ;; But only if we haven't detected an interactive prompt
  1353	                             (run-with-timer 0.1 nil
  1354	                                            (lambda ()
  1355	                                              (when (buffer-live-p vterm-buffer)
  1356	                                                (with-current-buffer vterm-buffer
  1357	                                                  ;; Check if there's an interactive prompt before exiting
  1358	                                                  (run-with-timer 2.0 nil
  1359	                                                                 (lambda ()
  1360	                                                                   (when (and (buffer-live-p vterm-buffer)
  1361	                                                                             (not command-completed))
  1362	                                                                     (with-current-buffer vterm-buffer
  1363	                                                                       (unless (detect-interactive-prompt)
  1364	                                                                         (vterm-send-string "exit")
  1365	                                                                         (vterm-send-return))))))))))))))
  1366	        
  1367	        ;; Return cancel function
  1368	        (lambda ()
  1369	          (when timer (cancel-timer timer))
  1370	          (when prompt-check-timer (cancel-timer prompt-check-timer))
  1371	          (setq command-completed t)
  1372	          (when (and process (process-live-p process))
  1373	            (delete-process process))
  1374	          (when (buffer-live-p vterm-buffer)
  1375	            (kill-buffer vterm-buffer))
  1376	          (funcall callback nil "Command cancelled by user"))))))
  1377	
  1378	
  1379	(provide 'greger-stdlib)
  1380	
  1381	;;; greger-stdlib.el ends here

