    57	;;; Public API
    58	
    59	(cl-defun greger-client-stream (&key model dialog tools server-tools buffer block-start-callback text-delta-callback block-stop-callback complete-callback thinking-budget max-tokens auth-key error-callback)
    60	  "Send API request to the Claude streaming API.
    61	Streaming responses are handled using callbacks.
    62	MODEL specifies which AI model to use.
    63	DIALOG contains the conversation,
    64	TOOLS and SERVER-TOOLS enable function calling.
    65	BUFFER is the output target.
    66	BLOCK-START-CALLBACK is called when content blocks begin.
    67	TEXT-DELTA-CALLBACK for incremental text.
    68	BLOCK-STOP-CALLBACK when blocks complete.
    69	COMPLETE-CALLBACK when the entire response finishes.
    70	THINKING-BUDGET is the number of thinking tokens.
    71	MAX-TOKENS is the maximum number of tokens to generate.
    72	AUTH-KEY is the Anthropic API key to use for authentication.
    73	ERROR-CALLBACK is called when errors occur during processing."
    74	  (let* ((output-buffer (or buffer (current-buffer)))
    75	         (undo-handle (prepare-change-group output-buffer))
    76	         (request-spec (greger-client--build-request model dialog tools server-tools thinking-budget max-tokens auth-key))
    77	         (restore-callback (lambda (state)
    78	                             (let ((buffer (greger-client-state-output-buffer state)))
    79	                               (when (buffer-live-p buffer)
    80	                                 (with-current-buffer buffer
    81	                                   (undo-amalgamate-change-group (greger-client-state-undo-handle state))
    82	                                   (accept-change-group (greger-client-state-undo-handle state)))))))
    83	
    84	         (process (greger-client--start-curl-process request-spec))
    85	         (state (make-greger-client-state
    86	                 :accumulated-output ""
    87	                 :content-blocks '()
    88	                 :process process
    89	                 :block-start-callback block-start-callback
    90	                 :text-delta-callback text-delta-callback
    91	                 :block-stop-callback block-stop-callback
    92	                 :complete-callback complete-callback
    93	                 :restore-callback restore-callback
    94	                 :output-buffer output-buffer
    95	                 :undo-handle undo-handle
    96	                 :error-callback error-callback)))
    97	
    98	    (activate-change-group undo-handle)
    99	
   100	    (set-process-filter process
   101	                        (lambda (_proc output)
   102	                          (greger-client--process-output-chunk output state)))
   103	
   104	    (set-process-sentinel process
   105	                          (lambda (proc _event)
   106	                            (greger-client--handle-completion proc state)))
   107	
   108	    (set-process-query-on-exit-flag process nil)
   109	
   110	    state))
