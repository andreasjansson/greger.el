   374	;;;###autoload
   375	(defun greger-set-grammar-branch (branch)
   376	  "Set the git branch to use for greger grammar installation and install it.
   377	BRANCH should be a git branch name (e.g., 'main', 'dev', 'feature-branch').
   378	Use nil to revert to the default 'main' branch."
   379	  (interactive "sBranch name (empty for main): ")
   380	  (if (and branch (not (string-empty-p branch)))
   381	      (progn
   382	        (setq greger-local-grammar-path branch)
   383	        (message "Grammar branch set to: %s" branch)
   384	        (greger-install-grammar))
   385	    (progn
   386	      (setq greger-local-grammar-path nil)
   387	      (message "Reverted to main branch")
   388	      (greger-install-grammar))))
   389	
   390	(defun greger--install-eval-grammars ()
   391	  "Install language grammars needed for eval tag support."
   392	  (let ((grammars '((elisp "https://github.com/Wilfred/tree-sitter-elisp")
   393	                    (bash "https://github.com/tree-sitter/tree-sitter-bash"))))
   394	    (dolist (grammar grammars)
   395	      (let ((lang (car grammar)))
   396	        (unless (treesit-language-available-p lang)
   397	          (add-to-list 'treesit-language-source-alist grammar)
   398	          (treesit-install-language-grammar lang))))))
   399	
   400	;;;###autoload
   401	(defun greger-install-grammar ()
   402	  "Install greger tree-sitter grammar.
   403	Uses branch from `greger-local-grammar-path' if set, otherwise uses 'main'."
   404	  (interactive)
   405	  (message "=== GREGER GRAMMAR INSTALLATION DEBUG ===")
   406	  (message "greger-local-grammar-path: %S" greger-local-grammar-path)
   407	  
   408	  ;; Remove any existing greger entries first
   409	  (message "treesit-language-source-alist before cleanup: %S" treesit-language-source-alist)
   410	  (setq treesit-language-source-alist
   411	        (assq-delete-all 'greger treesit-language-source-alist))
   412	  (message "treesit-language-source-alist after cleanup: %S" treesit-language-source-alist)
   413	  
   414	  (let* ((grammar-source 
   415	          (cond 
   416	           ;; Local path (starts with / or ~)
   417	           ((and greger-local-grammar-path
   418	                 (or (string-prefix-p "/" greger-local-grammar-path)
   419	                     (string-prefix-p "~" greger-local-grammar-path)))
   420	            (let ((expanded-path (expand-file-name greger-local-grammar-path)))
   421	              (message "Installing greger grammar from local path: %s" expanded-path)
   422	              (list 'greger expanded-path)))
   423	           ;; Git branch name
   424	           (greger-local-grammar-path
   425	            (message "Installing greger grammar from branch: %s" greger-local-grammar-path)
   426	            (list 'greger "https://github.com/andreasjansson/greger-grammar" greger-local-grammar-path))
   427	           ;; Default to main branch
   428	           (t
   429	            (message "Installing greger grammar from main branch")
   430	            (list 'greger "https://github.com/andreasjansson/greger-grammar" "main")))))
   431	    
   432	    (message "Grammar source: %S" grammar-source)
   433	    (add-to-list 'treesit-language-source-alist grammar-source)
   434	    (message "treesit-language-source-alist after adding: %S" treesit-language-source-alist)
   435	    
   436	    (message "Calling treesit-install-language-grammar...")
   437	    (treesit-install-language-grammar 'greger)
   438	    (message "treesit-install-language-grammar completed")
   439	    
   440	    (message "Checking grammar availability...")
   441	    (message "treesit-language-available-p result: %S" (treesit-language-available-p 'greger))
   442	    (message "treesit-ready-p result: %S" (treesit-ready-p 'greger))
   443	    
   444	    ;; Try to get detailed info
   445	    (condition-case err
   446	        (progn
   447	          (message "Testing query validation...")
   448	          (treesit-query-validate 'greger '((eval)))
   449	          (message "Query validation succeeded!"))
   450	      (error 
   451	       (message "Query validation failed: %S" err)))
   452	    
   453	    (unless (treesit-ready-p 'greger)
   454	      (error "Tree-sitter for Greger isn't available"))
   455	    
   456	    (message "=== GREGER GRAMMAR INSTALLATION DEBUG END ===")))
   457	
   458	;;;###autoload
   459	(define-derived-mode greger-mode prog-mode "Greger"
   460	  "Major mode for editing Greger files with tree-sitter support."
   461	  ;; Try to use tree-sitter if available
   462	  (unless (treesit-language-available-p 'greger)
   463	    (greger-install-grammar))
   464	  (unless (treesit-ready-p 'greger)
   465	    (error "Greger grammar is not installed"))
   466	
   467	  (treesit-parser-create 'greger)
   468	  (setq-local treesit-font-lock-settings greger--treesit-font-lock-settings)
   469	  (setq-local treesit-font-lock-feature-list
   470	              '((tool-tags tool-syntax-highlighting eval-tags code-styling)
   471	                (headers folding comments tool-result-syntax)
   472	                (error)))
   473	  (setq-local treesit-simple-indent-rules greger--treesit-indent-rules)
   474	
   475	  ;; This crashes Emacs 29.0.91 but not Emacs 30.1. TODO: test if it crashes Emacs 29.1
   476	  ;; Reproduce: At beginning of buffer, run (treesit-search-forward-goto (treesit-node-at (point)) "" t t t)
   477	  (setq-local treesit-defun-type-regexp (rx line-start
   478	                                            (or "system"
   479	                                                "user"
   480	                                                "assistant"
   481	                                                "tool_use"
   482	                                                "server_tool_user"
   483	                                                "tool_result"
   484	                                                "web_search_tool_result")
   485	                                            line-end))
   486	
   487	  ;; Install eval grammars and set up embedded language parsing
   488	  (greger--install-eval-grammars)
   489	  (setq-local treesit-range-settings
   490	              (treesit-range-rules
   491	               :embed 'bash
   492	               :host 'greger
   493	               :local t
   494	               '(((eval (eval_start_brace (eval_language) @lang) (eval_content) @content)
   495	                  (:match "sh" @lang)))
   496	               :embed 'elisp
   497	               :host 'greger
   498	               :local t
   499	               '((eval (eval_content) @content))))
   500	
   501	  (treesit-major-mode-setup)
   502	
   503	  (setq-local mode-line-misc-info '(:eval (greger--mode-line-info)))
   504	  (use-local-map greger-mode-map)
   505	
   506	  (setq-local greger-current-thinking-budget greger-thinking-budget))
   507	
   508	;;;###autoload
   509	(defun greger (&optional with-context)
   510	  "Create a new buffer and switch to `greger-mode`.
   511	With WITH-CONTEXT (e.g. \[universal-argument] \[greger]), save
   512	the current buffer, split the window if not already split, and
   513	insert location information at the beginning of the user section."
   514	  (interactive "P")
   515	  (let ((buffer (generate-new-buffer "*greger*"))
   516	        (source-info (when with-context
   517	                       (save-buffer)
   518	                       (list (buffer-file-name)
   519	                             (line-number-at-pos)
   520	                             (current-column)))))
   521	    (when with-context
   522	      ;; Split horizontally if not already split
   523	      (when (= (length (window-list)) 1)
   524	        (split-window-right))
   525	      ;; Move to the next window
   526	      (other-window 1))
   527	    (switch-to-buffer buffer)
   528	    (greger-mode)
   529	    (insert greger-parser-system-tag
   530	            "\n\n" greger-default-system-prompt "\n\n"
   531	            greger-parser-user-tag
   532	            "\n\n")
   533	    (when source-info
   534	      (let ((file-name (nth 0 source-info))
   535	            (line-num (nth 1 source-info))
   536	            (column (nth 2 source-info)))
   537	        (insert (format "In %s, at line %d%s, implement the following:\n\n"
   538	                        file-name
   539	                        line-num
   540	                        (if (> column 0)
   541	                            (format " and column %d" column)
   542	                          "")))))
   543	    buffer))
   544	
   545	(defun greger-insert-assistant-tag ()
   546	  "Insert the assistant tag into the buffer."
   547	  (interactive)
   548	  (insert greger-parser-assistant-tag "\n\n"))
   549	
   550	(defun greger-insert-user-tag ()
   551	  "Insert the user tag into the buffer."
   552	  (interactive)
   553	  (insert greger-parser-user-tag "\n\n"))
   554	
   555	(defun greger-insert-system-tag ()
   556	  "Insert the system tag into the buffer."
   557	  (interactive)
   558	  (insert greger-parser-system-tag "\n\n"))
   559	
   560	(defun greger-interrupt ()
   561	  "Interrupt ongoing generation if active, otherwise call `keyboard-quit'."
   562	  (interactive)
   563	
   564	  ;; to not get stuck in read only
   565	  (greger--set-buffer-read-only nil)
   566	
   567	  (let* ((buffer (current-buffer))
   568	         (state (buffer-local-value 'greger--current-state buffer)))
   569	    (cond
   570	
   571	     ;; If there are executing tools, cancel them
   572	     ((and state
   573	           (greger-state-executing-tools state)
   574	           (> (hash-table-count (greger-state-executing-tools state)) 0))
   575	      (let ((executing-tools (greger-state-executing-tools state)))
   576	        (maphash (lambda (_tool-id greger-tool)
   577	                   (let ((cancel-fn (greger-tool-cancel-fn greger-tool)))
   578	                     (when (functionp cancel-fn)
   579	                       (funcall cancel-fn))))
   580	                 executing-tools)
   581	        (greger--update-buffer-state))
   582	      'executing)
   583	
   584	     ;; If there's an active client state, cancel the streaming request
   585	     ((and state (greger-state-client-state state))
   586	      (greger-client--cancel-request (greger-state-client-state state))
   587	      (greger--finish-response state)
   588	      'generating)
   589	
   590	     ;; Default case: call keyboard-quit
   591	     (t
   592	      (keyboard-quit)
   593	      'idle))))
   594	
   595	(defun greger-set-model ()
   596	  "Set the current model."
   597	  (interactive)
   598	  (let ((model (completing-read "Choose model: " greger-available-models nil t)))
   599	    (customize-set-variable 'greger-model (intern model))
   600	    (message "Model set to %s" model)))
   601	
   602	(defun greger-toggle-thinking ()
   603	  "Toggle thinking on/off."
   604	  (interactive)
   605	  (if (> greger-current-thinking-budget 0)
   606	      (progn
   607	        (setq-local greger-current-thinking-budget 0)
   608	        (message "Thinking disabled"))
   609	    (progn
   610	      (setq-local greger-current-thinking-budget greger-thinking-budget)
   611	      (message "Thinking enabled (budget: %d tokens)" greger-current-thinking-budget)))
   612	  (force-mode-line-update))
   613	
   614	(defun greger-toggle-follow-mode ()
   615	  "Toggle follow mode on/off.
   616	When follow mode is enabled, point moves to the bottom during chat updates.
   617	When disabled, point position is preserved using `save-excursion'."
   618	  (interactive)
   619	  (setq-local greger-follow-mode (not greger-follow-mode))
   620	  (when greger-follow-mode
   621	    (goto-char (point-max)))
   622	  (message "Follow mode %s" (if greger-follow-mode "enabled" "disabled"))
   623	  (force-mode-line-update))
   624	
   625	(defun greger-mention-buffer-file (buffer)
   626	  "Insert the file path of BUFFER at point.
   627	When called interactively, prompts for buffer selection.
   628	When called programmatically, BUFFER can be a buffer object or buffer name.
   629	Uses relative path if file is in current working directory or subdirectory.
   630	Uses ~/path notation if file is in home directory or subdirectory."
   631	  (interactive "bBuffer: ")
   632	
   633	  (if-let* ((buf (if (bufferp buffer) buffer (get-buffer buffer)))
   634	            (file-path (when buf (buffer-file-name buf))))
   635	      (let* ((file-path-abs (expand-file-name file-path))
   636	             (home-dir (expand-file-name "~/"))
   637	             (cwd (file-name-as-directory (expand-file-name default-directory)))
   638	             (formatted-path (cond
   639	                              ;; If file is in cwd or subdirectory, use relative path
   640	                              ((string-prefix-p cwd file-path-abs)
   641	                               (file-relative-name file-path))
   642	                              ;; If file is in home directory or subdirectory, use ~/path
   643	                              ((string-prefix-p home-dir file-path-abs)
   644	                               (concat "~/" (file-relative-name file-path home-dir)))
   645	                              ;; Otherwise, use absolute path
   646	                              (t file-path))))
   647	        (insert formatted-path))
   648	    (user-error "Buffer %s has no associated file" (or (buffer-name buf) buffer))))
   649	
   650	(defun greger-set-provider ()
   651	  "Interactively set the API provider."
   652	  (interactive)
   653	  (let ((choice (completing-read
   654	                 "Select provider: "
   655	                 '(("Anthropic (Claude) - Default" . anthropic)
   656	                   ("OpenRouter (Beta)" . openrouter))
   657	                 nil t)))
   658	    (setq greger-provider (cdr (assoc choice 
   659	                                      '(("Anthropic (Claude) - Default" . anthropic)
   660	                                        ("OpenRouter (Beta)" . openrouter)))))
   661	    (message "Provider set to: %s" choice)))
   662	
   663	(defun greger-set-openrouter-model ()
   664	  "Set the OpenRouter model when using OpenRouter provider."
   665	  (interactive)
   666	  (unless (eq greger-provider 'openrouter)
   667	    (user-error "OpenRouter provider not active. Use M-x greger-set-provider first"))
   668	  (let ((models '("openai/gpt-5"
   669	                  "openai/gpt-5-codex" 
   670	                  "openai/gpt-5-mini"
   671	                  "anthropic/claude-sonnet-4"
   672	                  "anthropic/claude-opus-4"
   673	                  "google/gemini-2.5-pro")))
   674	    (setq greger-openrouter-model 
   675	          (completing-read "OpenRouter model: " models nil nil))
   676	    (message "OpenRouter model set to: %s" greger-openrouter-model)))
   677	
   678	(defun greger-debug-request ()
   679	  "Debug the request data by parsing the buffer and saving the request data output.
   680	After saving, opens the JSON file in a new buffer for inspection."
   681	  (interactive)
   682	  (let* ((filename (read-string "Save to filename (default: request.json): " nil nil "request.json"))
   683	         (dialog (greger-parser-markdown-buffer-to-dialog (current-buffer)))
   684	         (tools (when greger-tools
   685	                  (greger-tools-get-schemas greger-tools)))
   686	         (server-tools (when greger-server-tools
   687	                         (greger-server-tools-get-schemas greger-server-tools)))
   688	         (model greger-model)
   689	         (request-data (greger-client--build-data model dialog tools server-tools greger-current-thinking-budget greger-max-tokens))
   690	         (parsed-json (json-read-from-string request-data)))
   691	
   692	    (with-temp-file filename
   693	      (let ((json-encoding-pretty-print t))
   694	        (insert (json-encode parsed-json))))
   695	    (message "Request data saved to %s" filename)
   696	    ;; Open the file in a new buffer for inspection
   697	    (find-file filename)))
   698	
   699	(defun greger-buffer (&optional no-tools)
   700	  "Send buffer content to AI as an agent dialog with tool support.
   701	When NO-TOOLS is set, disable tools and thinking."
   702	  (interactive "P")
   703	  (greger--ensure-buffer-can-be-submitted)
   704	
   705	  (let ((greger-tools (if no-tools '() greger-tools))
   706	        (greger-server-tools (if no-tools '() greger-server-tools))
   707	        (greger-current-thinking-budget (if no-tools 0 greger-current-thinking-budget)))
   708	    (greger--process-evals)
   709	    
   710	    (greger--run-agent-loop (make-greger-state
   711	                             :current-iteration 0
   712	                             :chat-buffer (current-buffer)
   713	                             :directory default-directory
   714	                             :tool-use-metadata `(:safe-shell-commands () :allow-all-shell-commands ,greger-allow-all-shell-commands)))))
   715	
   716	(defun greger-buffer-no-tools ()
   717	  "Send the buffer content to AI as a dialog without tool use or thinking."
   718	  (interactive)
   719	  (greger-buffer t))
   720	
   721	(defmacro greger--maybe-save-excursion (&rest body)
   722	  "Execute BODY, optionally preserving point position.
   723	If `greger-follow-mode' is enabled, point follows output
   724	at the end of the buffer.
   725	If `greger-follow-mode' is disabled, use `save-excursion'
   726	to preserve point position."
   727	  `(if greger-follow-mode
   728	       (progn ,@body)
   729	     (save-excursion ,@body)))
   730	
   731	(defun greger--live-chat-buffer (state)
   732	  "Return the chat buffer from STATE if it's still live."
   733	  (let ((buffer (greger-state-chat-buffer state)))
   734	    (when (buffer-live-p buffer)
   735	      buffer)))
   736	
   737	(defun greger--get-current-status ()
   738	  "Get the current greger status: \='idle, \='generating, or \='executing."
   739	  (let ((state (buffer-local-value 'greger--current-state (current-buffer))))
   740	    (cond
   741	     ;; Check if we're executing tools
   742	     ((and state
   743	           (greger-state-executing-tools state)
   744	           (> (hash-table-count (greger-state-executing-tools state)) 0))
   745	      'executing)
   746	     ;; Check if we're generating (client-state is active)
   747	     ((and state (greger-state-client-state state))
   748	      'generating)
   749	     ;; Otherwise we're idle
   750	     (t 'idle))))
   751	
   752	(defun greger--mode-line-info ()
   753	  "Generate mode line information showing model and current state."
   754	  (let ((status (greger--get-current-status))
   755	        (model-name (symbol-name greger-model)))
   756	    (concat model-name
   757	            (if (> greger-current-thinking-budget 0)
   758	                (format " [T:%d]" greger-current-thinking-budget)
   759	              "")
   760	            (pcase status
   761	              ('generating " [Generating]")
   762	              ('executing " [Executing]")
   763	              ('idle "")))))
   764	
   765	(defun greger--set-buffer-read-only (read-only)
   766	  "Set buffer read-only state for greger operations.
   767	READ-ONLY is t to make read-only, nil to make writable."
   768	  (if read-only
   769	      (unless greger--buffer-read-only-by-greger
   770	        (setq greger--buffer-read-only-by-greger t)
   771	        (setq buffer-read-only t))
   772	    (when greger--buffer-read-only-by-greger
   773	      (setq greger--buffer-read-only-by-greger nil)
   774	      (setq buffer-read-only nil))))
   775	
   776	(defun greger--update-buffer-state ()
   777	  "Update buffer read-only state based on current greger state."
   778	  (let ((status (greger--get-current-status)))
   779	    (greger--set-buffer-read-only (not (eq status 'idle)))
   780	    ;; Force mode line update
   781	    (force-mode-line-update)))
   782	
   783	(defun greger--ensure-buffer-can-be-submitted ()
   784	  "Ensure buffer can be submitted by fixing common issues with last message.
   785	Uses tree-sitter to find the last node and applies heuristics:
   786	- If last assistant text is empty or whitespace-only, insert '.'
   787	- If last assistant text ends with whitespace, trim it
   788	- If last message is thinking, insert '# ASSISTANT\\n\\n.' before submitting"
   789	  (let* ((root-node (treesit-buffer-root-node))
   790	         (last-node (greger--find-last-message-node root-node)))
   791	
   792	    (when last-node
   793	      (let ((node-type (treesit-node-type last-node)))
   794	        (cond
   795	         ((string= node-type "user")
   796	          (greger--insert-if-empty-content last-node "Continue"))
   797	
   798	         ((string= node-type "assistant")
   799	          (greger--insert-if-empty-content last-node "."))
   800	
   801	         ((string= node-type "thinking")
   802	          (greger--insert-assistant-after-thinking last-node)))))))
   803	
   804	(defun greger--find-last-message-node (root-node)
   805	  "Find the last message node in ROOT-NODE."
   806	  (let ((children (treesit-node-children root-node))
   807	        (last-message-node nil))
   808	    (dolist (child children)
   809	      (let ((node-type (treesit-node-type child)))
   810	        (when (member node-type '("assistant" "thinking" "user" "system"
   811	                                  "tool_use" "server_tool_use" "tool_result"
   812	                                  "web_search_tool_result" "untagged_text"))
   813	          (setq last-message-node child))))
   814	    last-message-node))
   815	
   816	(defun greger--insert-if-empty-content (node text)
   817	  "Add TEXT to NODE content if content is empty."
   818	  (let* ((header (treesit-node-child node 0 t))
   819	         (start-pos (treesit-node-end header))
   820	         (end-pos (treesit-node-end node))
   821	         (content (buffer-substring-no-properties start-pos end-pos)))
   822	
   823	    ;; Insert a dot if content is empty
   824	    (when (string= (string-trim content) "")
   825	      (greger--maybe-save-excursion
   826	       (goto-char end-pos)
   827	       (insert text)))))
   828	
   829	(defun greger--insert-assistant-after-thinking (thinking-node)
   830	  "Insert assistant response after THINKING-NODE."
   831	  (let ((end-pos (treesit-node-end thinking-node)))
   832	    (greger--maybe-save-excursion
   833	     (goto-char end-pos)
   834	     (insert "\n\n# ASSISTANT\n\n."))))
   835	
   836	(defun greger--run-agent-loop (state)
   837	  "Run the main agent loop with STATE.
   838	Dispatches to provider-specific implementation based on greger-provider."
   839	  (if (eq greger-provider 'openrouter)
   840	      (greger-openrouter--run-agent-loop state)
   841	    (greger--run-agent-loop-claude state)))
   842	
   843	(defun greger--run-agent-loop-claude (state)
   844	  "Run the main agent loop with STATE using Claude/Anthropic.
   845	This is the original implementation, unchanged."
   846	  (let* ((tools (greger-tools-get-schemas greger-tools))
   847	         (server-tools (when greger-server-tools
   848	                         (greger-server-tools-get-schemas greger-server-tools)))
   849	         (chat-buffer (greger-state-chat-buffer state))
   850	         (dialog (greger-parser-markdown-buffer-to-dialog chat-buffer))
   851	         (safe-shell-commands (greger-parser-find-safe-shell-commands-in-buffer chat-buffer))
   852	         (tool-use-metadata (greger-state-tool-use-metadata state))
   853	         (current-iteration (greger-state-current-iteration state))
   854	         (auth-key (or (and greger-anthropic-key-fn (funcall greger-anthropic-key-fn))
   855	                       (getenv "ANTHROPIC_API_KEY"))))
   856	
   857	    (setf (plist-get tool-use-metadata :safe-shell-commands) safe-shell-commands)
   858	
   859	    (when (>= current-iteration greger-max-iterations)
   860	      (error "Maximum iterations (%d) reached, stopping agent execution" greger-max-iterations))
   861	
   862	    (unless auth-key
   863	      (error "No API key found.  Set ANTHROPIC_API_KEY environment variable or configure greger-anthropic-key-fn"))
   864	
   865	
   866	    (with-current-buffer chat-buffer
   867	      (let ((client-state (greger-client-stream
   868	                           :model greger-model
   869	                           :dialog dialog
   870	                           :tools tools
   871	                           :server-tools server-tools
   872	                           :buffer chat-buffer
   873	                           :thinking-budget greger-current-thinking-budget
   874	                           :auth-key auth-key
   875	                           :block-start-callback (lambda (content-block)
   876	                                                   (greger--append-streaming-content-header state content-block))
   877	                           :text-delta-callback (lambda (text)
   878	                                                  (greger--append-text state (greger--clean-excessive-newlines text)))
   879	                           :block-stop-callback (lambda (type content-block)
   880	                                                  (greger--append-handle-content-block-stop state type content-block))
   881	                           :complete-callback (lambda (content-blocks) (greger--handle-stream-completion state content-blocks))
   882	                           :error-callback (lambda (error-message)
   883	                                             (greger--handle-client-error state error-message))
   884	                           :max-tokens greger-max-tokens)))
   885	
   886	        ;; Store the client state for potential cancellation
   887	        (setf (greger-state-client-state state) client-state)
   888	        ;; Set buffer-local variable for greger-interrupt to access
   889	        (setq greger--current-state state) ;; TODO: why do we set that _here_? Or should it be greger--current-client-state instead?
   890	        (greger--update-buffer-state)))))
   891	
   892	(defun greger--clean-excessive-newlines (text)
   893	  "Remove excessive newlines from the end of TEXT, keeping at most two.
   894	If TEXT ends with more than two consecutive newlines, remove all but the
   895	first two."
   896	  (replace-regexp-in-string "\n\n\n+\\'" "\n\n" text))
   897	
   898	(defun greger--force-code-close (state)
   899	  (with-current-buffer (greger-state-chat-buffer state)
   900	    (let ((end-is-code nil)
   901	          (inhibit-read-only t))
   902	     (save-excursion
   903	       (goto-char (point-max))
   904	       (insert "\n")
   905	       (when (string= (treesit-node-type (treesit-node-at (1- (point-max)))) "code_content")
   906	         (setq end-is-code t))
   907	       (delete-char -1))
   908	     (when end-is-code
   909	       (insert "<$code-close/>")))))
   910	
   911	(defun greger--append-streaming-content-header (state content-block)
   912	  "Append appropriate header for streaming CONTENT-BLOCK to STATE."
   913	
   914	  (greger--force-code-close state)
   915	
   916	  (let ((type (alist-get 'type content-block))
   917	        (has-citations (assq 'citations content-block)))
   918	    (cond
   919	     ((and (string= type "text") (not has-citations))
   920	      (greger--append-text state (concat "\n\n" greger-parser-assistant-tag "\n\n")))
   921	     ((string= type "thinking")
   922	      (greger--append-text state (concat "\n\n" greger-parser-thinking-tag "\n\n")))
   923	     (t nil))))
   924	
   925	(defun greger--handle-stream-completion (state content-blocks)
   926	  "Handle completion of stream with STATE and CONTENT-BLOCKS."
   927	  (if-let ((tool-calls (greger--extract-tool-calls content-blocks)))
   928	      (progn
   929	        (setf (greger-state-current-iteration state)
   930	              (1+ (greger-state-current-iteration state)))
   931	        ;; TODO: execute tool calls in greger--append-content-block instead
   932	        (greger--execute-tools tool-calls state))
   933	    (greger--finish-response state))
   934	
   935	  (when-let ((buffer (greger--live-chat-buffer state)))
   936	    (with-current-buffer buffer
   937	      (greger--update-buffer-state))))
   938	
   939	(defun greger--content-block-supports-streaming (content-block)
   940	  "Check if CONTENT-BLOCK can be streamed incrementally.
   941	Returns non-nil for text and thinking blocks without citations, which can
   942	be displayed as they arrive rather than waiting for completion."
   943	  (let ((type (alist-get 'type content-block))
   944	        (citations (alist-get 'citations content-block)))
   945	    (and (or (string= type "text") (string= type "thinking"))
   946	         (not citations))))
   947	
   948	(defun greger--append-handle-content-block-stop (state type content-block)
   949	  "Append non-streaming CONTENT-BLOCK of TYPE to STATE."
   950	  ;; Only append markdown if it hasn't done that already during streaming
   951	  (unless (greger--content-block-supports-streaming content-block)
   952	    (let ((markdown (greger-parser--block-to-markdown content-block)))
   953	      (greger--append-text state (concat "\n\n" markdown))))
   954	
   955	  ;; Special cases for tool use and thinking
   956	  (cond
   957	   ((string= type "tool_use")
   958	    (let ((tool-id (alist-get 'id content-block)))
   959	      (greger--append-text state (concat "\n\n" (greger--tool-result-placeholder tool-id)))))
   960	   ((string= type "thinking")
   961	    (let ((signature (alist-get 'signature content-block)))
   962	      (greger--insert-thinking-signature state signature))))
   963	
   964	  ;; Update buffer state after client completes
   965	  (when-let ((buffer (greger--live-chat-buffer state)))
   966	    (with-current-buffer buffer
   967	      (greger--update-buffer-state))))
   968	
   969	(defun greger--insert-thinking-signature (state signature)
   970	  "Insert thinking SIGNATURE after the last thinking tag, using STATE.
   971	Assumes the last inserted thing is a thinking tag."
   972	  (with-current-buffer (greger-state-chat-buffer state)
   973	    (save-excursion
   974	      (goto-char (point-max))
   975	      (re-search-backward "^# THINKING")
   976	      (forward-line 1)
   977	      (let ((inhibit-read-only t))
   978	        (insert "\n"
   979	                "Signature: " signature
   980	                "\n")))))
   981	
   982	(defun greger--extract-tool-calls (content-blocks)
   983	  "Extract tool call from CONTENT-BLOCKS."
   984	  (let ((tool-calls '()))
   985	    (dolist (block content-blocks)
   986	      (when (string= (alist-get 'type block) "tool_use")
   987	        (push block tool-calls)))
   988	    (reverse tool-calls)))
   989	
   990	(defun greger--tool-result-placeholder (tool-id)
   991	  "Generate placeholder string for TOOL-ID."
   992	  ;; It's ugly that we need to insert the trailing \n
   993	  ;; But we need it because otherwise the closing tool tag is not recognized.
   994	  ;; TODO: update greger-grammar
   995	  (let ((placeholder (concat (greger-parser--wrapped-tool-content greger-parser-tool-result-tag tool-id "") "\n")))
   996	    ;; Add a text property to the first character to indicate this is a generating tool result
   997	    (put-text-property 0 1 'greger-tool-result-generating t placeholder)
   998	    placeholder))
   999	
  1000	(defun greger--execute-tools (tool-calls state)
  1001	  "Execute TOOL-CALLS using STATE in parallel with callbacks."
  1002	  (let* ((total-tools (length tool-calls))
  1003	         (completed-tools 0)
  1004	         (executing-tools-map (make-hash-table :test 'equal)))
  1005	
  1006	    ;; Initialize executing-tools in state if not already set
  1007	    (unless (greger-state-executing-tools state)
  1008	      (setf (greger-state-executing-tools state) executing-tools-map))
  1009	
  1010	    ;; Update buffer state to show we're executing tools
  1011	    (when-let ((buffer (greger--live-chat-buffer state)))
  1012	      (with-current-buffer buffer
  1013	        (greger--update-buffer-state)
  1014	
  1015	        (greger--maybe-save-excursion
  1016	         (goto-char (point-max)))))
  1017	
  1018	    ;; Execute all tools in parallel
  1019	    (dolist (tool-call tool-calls)
  1020	      (let* ((tool-name (alist-get 'name tool-call))
  1021	             (tool-input (alist-get 'input tool-call))
  1022	             (tool-id (alist-get 'id tool-call))
  1023	             (default-directory (greger-state-directory state))
  1024	
  1025	             ;; TODO: This is ugly, we really should be separating the creation and execution of tools
  1026	             ;; We're only doing this because for synchronous tools we can't set the tool in the
  1027	             ;; hashmap after execution, because sync tools have already removed the key then.
  1028	             (placeholder-tool (make-greger-tool :cancel-fn nil)))
  1029	
  1030	        (puthash tool-id placeholder-tool (greger-state-executing-tools state))
  1031	
  1032	        (greger--update-buffer-state)
  1033	        (sit-for 0.001) ;; update the buffer state
  1034	
  1035	        (let ((greger-tool (greger-tools-execute
  1036	                            :tool-name tool-name
  1037	                            :args tool-input
  1038	                            :callback (lambda (result error)
  1039	                                        ;; Remove tool from executing-tools when complete
  1040	                                        (remhash tool-id (greger-state-executing-tools state))
  1041	
  1042	                                        (greger--handle-tool-completion
  1043	                                         :tool-id tool-id
  1044	                                         :result result
  1045	                                         :error error
  1046	                                         :state state
  1047	                                         :completion-callback (lambda ()
  1048	                                                                ;; TODO: add completed-tools to state instead of this nested callback
  1049	                                                                (setq completed-tools (1+ completed-tools))
  1050	                                                                (when (and (= completed-tools total-tools)
  1051	                                                                           (greger-state-chat-buffer state))
  1052	                                                                  (greger--run-agent-loop state)))))
  1053	                            :streaming-callback (lambda (text)
  1054	                                                  (greger--append-tool-result-text state tool-id text))
  1055	                            :buffer (greger-state-chat-buffer state)
  1056	                            :metadata (greger-state-tool-use-metadata state))))
  1057	
  1058	          ;; TODO: here again, it's ugly
  1059	          (when (greger-tool-cancel-fn greger-tool)
  1060	            (puthash tool-id greger-tool (greger-state-executing-tools state))))))))
  1061	
  1062	(defun greger--append-text (state text)
  1063	  "Append TEXT to the chat buffer in STATE."
  1064	  (let ((buffer (greger-state-chat-buffer state)))
  1065	    (with-current-buffer buffer
  1066	      (let ((inhibit-read-only t))
  1067	        (greger--maybe-save-excursion
  1068	         (goto-char (point-max))
  1069	         (insert text))))))
  1070	
  1071	(cl-defun greger--handle-tool-completion (&key tool-id result error state completion-callback)
  1072	  "Handle completion of a tool execution.
  1073	Updates buffer and calls callback when tool execution finishes.
  1074	TOOL-ID is the tool identifier.
  1075	RESULT is the tool execution result.
  1076	ERROR is any error that occurred.
  1077	STATE contains the current agent state.
  1078	COMPLETION-CALLBACK is called when complete."
  1079	  (let ((tool-result-text (if error
  1080	                              (if (listp error)
  1081	                                  (error-message-string error)
  1082	                                error)
  1083	                            result)))
  1084	
  1085	    (greger--append-tool-result-text state tool-id tool-result-text t)
  1086	
  1087	    ;; Call completion callback
  1088	    (funcall completion-callback)))
  1089	
  1090	(defun greger--append-tool-result-text (state tool-id text &optional is-completed)
  1091	  "Append TEXT to the tool result content node for TOOL-ID in STATE's buffer.
  1092	When IS-COMPLETED is non-nil, also trim trailing newline after the tool's
  1093	end tag and update the buffer state."
  1094	  (when-let ((buffer (greger--live-chat-buffer state)))
  1095	    (with-current-buffer buffer
  1096	      (when-let ((inhibit-read-only t)
  1097	                 (tool-result-content-node (greger--find-tool-result-content-node tool-id))
  1098	                 (tool-result-content-start (treesit-node-start tool-result-content-node))
  1099	                 (tool-result-content-end (treesit-node-end tool-result-content-node)))
  1100	        (greger--maybe-save-excursion
  1101	         ;; Check if this is a vterm full replacement
  1102	         (if (string-prefix-p "VTERM_FULL_REPLACE:" text)
  1103	             ;; Replace entire tool result content with vterm buffer content
  1104	             (let ((vterm-content (substring text (length "VTERM_FULL_REPLACE:"))))
  1105	               (delete-region tool-result-content-start (1- tool-result-content-end))
  1106	               (goto-char tool-result-content-start)
  1107	               (insert vterm-content))
  1108	           ;; Regular streaming - append text directly (no terminal sequence processing)
  1109	           (progn
  1110	             (goto-char (1- tool-result-content-end))
  1111	             (insert text)))
  1112	
  1113	         (when is-completed
  1114	           ;; Trim trailing newline after closing tag
  1115	           (when-let* ((tool-result-content-node (greger--find-tool-result-content-node tool-id)) ;; content node might have gotten outdated, so need to get it again
  1116	                       (tool-end-tag (treesit-node-next-sibling tool-result-content-node t)))
  1117	             (when (string= (treesit-node-type tool-end-tag) "tool_end_tag")
  1118	               (goto-char (treesit-node-end tool-end-tag))
  1119	               (when (looking-at-p "\n")
  1120	                 (delete-char 1))))
  1121	
  1122	           ;; Remove the generating property from the tool result
  1123	           (when-let ((tool-result-node (greger--find-tool-result-node tool-id)))
  1124	             (let ((start (treesit-node-start tool-result-node))
  1125	                   (end (treesit-node-end tool-result-node)))
  1126	               (remove-text-properties start end '(greger-tool-result-generating))))
  1127	
  1128	           ;; Update buffer state after tool completion
  1129	           (greger--update-buffer-state)))))))
  1130	
  1131	(defun greger--find-tool-result-content-node (tool-id)
  1132	  "Find the tool_content node for the tool_result with TOOL-ID.
  1133	Uses treesit to query for a tool_result with matching id and returns
  1134	the tool_content node within its content section."
  1135	  (when-let* ((query `((tool_result (id (value) @id) (:match ,tool-id @id)
  1136	                                    (content) @content)))
  1137	              (capture (treesit-query-capture (treesit-buffer-root-node) query))
  1138	              (content-node (alist-get 'content capture))
  1139	              ;; for some reason, querying directly for tool_content fails, but this works
  1140	              (content-node-first-child (car (treesit-node-children content-node))))
  1141	    (treesit-search-subtree content-node-first-child "tool_content")))
  1142	
  1143	(defun greger--find-tool-result-node (tool-id)
  1144	  "Find the tool_result node with TOOL-ID.
  1145	Uses treesit to query for a tool_result with matching id and returns
  1146	the tool_result node itself."
  1147	  (let* ((query `((tool_result (id (value) @id) (:match ,tool-id @id)) @tool-result))
  1148	         (capture (treesit-query-capture (treesit-buffer-root-node) query)))
  1149	    (alist-get 'tool-result capture)))
  1150	
  1151	(defun greger--handle-client-error (state error-message)
  1152	  "Handle client error with STATE and ERROR-MESSAGE."
  1153	  ;; This will be called from the main thread via the completion handler
  1154	  (when-let ((buffer (greger--live-chat-buffer state)))
  1155	    (with-current-buffer buffer
  1156	      ;; Clear the buffer-local agent state
  1157	      (setq greger--current-state nil)
  1158	      ;; Update buffer state to idle
  1159	      (greger--update-buffer-state)))
  1160	  ;; Reset the state
  1161	  (setf (greger-state-current-iteration state) 0)
  1162	  (setf (greger-state-client-state state) nil)
  1163	  ;; Raise the error in the main thread where it can be caught by tests
  1164	  (warn "%s" error-message))
  1165	
  1166	(defun greger--finish-response (state)
  1167	  "Finish the agent response using STATE."
  1168	  (when-let ((buffer (greger--live-chat-buffer state)))
  1169	    (with-current-buffer buffer
  1170	      (let ((inhibit-read-only t))
  1171	        (greger--maybe-save-excursion
  1172	         (goto-char (point-max))
  1173	         (unless (looking-back (concat greger-parser-user-tag "\n\n") nil)
  1174	           (greger--force-code-close state)
  1175	           (insert "\n\n" greger-parser-user-tag "\n\n"))))
  1176	      ;; Clear the buffer-local agent state
  1177	      (setq greger--current-state nil)
  1178	      ;; Update buffer state to idle
  1179	      (greger--update-buffer-state)))
  1180	  ;; Reset the state
  1181	  (setf (greger-state-current-iteration state) 0)
  1182	  (setf (greger-state-client-state state) nil))
  1183	
  1184	;; Eval functionality
  1185	
  1186	(defun greger--eval-code (language code)
  1187	  "Evaluate CODE in the specified LANGUAGE.
  1188	Returns the result as a string.
  1189	Raises an error if evaluation fails."
  1190	  (cond
  1191	   ((string= language "elisp")
  1192	    (greger--eval-elisp code))
  1193	   ((string= language "sh")
  1194	    (greger--eval-bash code))
  1195	   (t
  1196	    (error "Unsupported eval language: %s. Supported languages are: elisp (default) and sh (bash)"))))
  1197	
  1198	(defun greger--eval-elisp (code)
  1199	  "Evaluate Emacs Lisp CODE and return the result as a string."
  1200	  (condition-case err
  1201	      (let ((result (eval (read (format "(progn %s)" code)))))
  1202	        (substring-no-properties (format "%s" result)))
  1203	    (error
  1204	     (error "Elisp evaluation failed: %s" (error-message-string err)))))
  1205	
  1206	(defun greger--eval-bash (code)
  1207	  "Evaluate Bash CODE and return the result as a string."
  1208	  (let* ((process-name (format "greger-bash-eval-%s" (make-temp-name "")))
  1209	         (process-buffer (generate-new-buffer (format " *%s*" process-name)))
  1210	         (result nil)
  1211	         (error-msg nil)
  1212	         (process (let ((inhibit-message t))
  1213	                    (start-process process-name process-buffer "bash" "-c" code)))
  1214	         (exit-status nil))
  1215	    (unwind-protect
  1216	        (progn
