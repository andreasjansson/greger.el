   356	;;;###autoload
   357	(defun greger-set-grammar-branch (branch)
   358	  "Set the git branch to use for greger grammar installation and install it.
   359	BRANCH should be a git branch name (e.g., 'main', 'dev', 'feature-branch').
   360	Use nil to revert to the default 'main' branch."
   361	  (interactive "sBranch name (empty for main): ")
   362	  (if (and branch (not (string-empty-p branch)))
   363	      (progn
   364	        (setq greger-local-grammar-path branch)
   365	        (message "Grammar branch set to: %s" branch)
   366	        (greger-install-grammar))
   367	    (progn
   368	      (setq greger-local-grammar-path nil)
   369	      (message "Reverted to main branch")
   370	      (greger-install-grammar))))
   371	
   372	(defun greger--install-eval-grammars ()
   373	  "Install language grammars needed for eval tag support."
   374	  (let ((grammars '((elisp "https://github.com/Wilfred/tree-sitter-elisp")
   375	                    (bash "https://github.com/tree-sitter/tree-sitter-bash"))))
   376	    (dolist (grammar grammars)
   377	      (let ((lang (car grammar)))
   378	        (unless (treesit-language-available-p lang)
   379	          (add-to-list 'treesit-language-source-alist grammar)
   380	          (treesit-install-language-grammar lang))))))
   381	
   382	;;;###autoload
   383	(defun greger-install-grammar ()
   384	  "Install greger tree-sitter grammar.
   385	Uses branch from `greger-local-grammar-path' if set, otherwise uses 'main'."
   386	  (interactive)
   387	  (message "=== GREGER GRAMMAR INSTALLATION DEBUG ===")
   388	  (message "greger-local-grammar-path: %S" greger-local-grammar-path)
   389	  
   390	  ;; Remove any existing greger entries first
   391	  (message "treesit-language-source-alist before cleanup: %S" treesit-language-source-alist)
   392	  (setq treesit-language-source-alist
   393	        (assq-delete-all 'greger treesit-language-source-alist))
   394	  (message "treesit-language-source-alist after cleanup: %S" treesit-language-source-alist)
   395	  
   396	  (let* ((grammar-source 
   397	          (cond 
   398	           ;; Local path (starts with / or ~)
   399	           ((and greger-local-grammar-path
   400	                 (or (string-prefix-p "/" greger-local-grammar-path)
   401	                     (string-prefix-p "~" greger-local-grammar-path)))
   402	            (let ((expanded-path (expand-file-name greger-local-grammar-path)))
   403	              (message "Installing greger grammar from local path: %s" expanded-path)
   404	              (list 'greger expanded-path)))
   405	           ;; Git branch name
   406	           (greger-local-grammar-path
   407	            (message "Installing greger grammar from branch: %s" greger-local-grammar-path)
   408	            (list 'greger "https://github.com/andreasjansson/greger-grammar" greger-local-grammar-path))
   409	           ;; Default to main branch
   410	           (t
   411	            (message "Installing greger grammar from main branch")
   412	            (list 'greger "https://github.com/andreasjansson/greger-grammar" "main")))))
   413	    
   414	    (message "Grammar source: %S" grammar-source)
   415	    (add-to-list 'treesit-language-source-alist grammar-source)
   416	    (message "treesit-language-source-alist after adding: %S" treesit-language-source-alist)
   417	    
   418	    (message "Calling treesit-install-language-grammar...")
   419	    (treesit-install-language-grammar 'greger)
   420	    (message "treesit-install-language-grammar completed")
   421	    
   422	    (message "Checking grammar availability...")
   423	    (message "treesit-language-available-p result: %S" (treesit-language-available-p 'greger))
   424	    (message "treesit-ready-p result: %S" (treesit-ready-p 'greger))
   425	    
   426	    ;; Try to get detailed info
   427	    (condition-case err
   428	        (progn
   429	          (message "Testing query validation...")
   430	          (treesit-query-validate 'greger '((eval)))
   431	          (message "Query validation succeeded!"))
   432	      (error 
   433	       (message "Query validation failed: %S" err)))
   434	    
   435	    (unless (treesit-ready-p 'greger)
   436	      (error "Tree-sitter for Greger isn't available"))
   437	    
   438	    (message "=== GREGER GRAMMAR INSTALLATION DEBUG END ===")))
   439	
   440	;;;###autoload
   441	(define-derived-mode greger-mode prog-mode "Greger"
   442	  "Major mode for editing Greger files with tree-sitter support."
   443	  ;; Try to use tree-sitter if available
   444	  (unless (treesit-language-available-p 'greger)
   445	    (greger-install-grammar))
   446	  (unless (treesit-ready-p 'greger)
   447	    (error "Greger grammar is not installed"))
   448	
   449	  (treesit-parser-create 'greger)
   450	  (setq-local treesit-font-lock-settings greger--treesit-font-lock-settings)
   451	  (setq-local treesit-font-lock-feature-list
   452	              '((tool-tags tool-syntax-highlighting eval-tags code-styling)
   453	                (headers folding comments tool-result-syntax)
   454	                (error)))
   455	  (setq-local treesit-simple-indent-rules greger--treesit-indent-rules)
   456	
   457	  ;; This crashes Emacs 29.0.91 but not Emacs 30.1. TODO: test if it crashes Emacs 29.1
   458	  ;; Reproduce: At beginning of buffer, run (treesit-search-forward-goto (treesit-node-at (point)) "" t t t)
   459	  (setq-local treesit-defun-type-regexp (rx line-start
   460	                                            (or "system"
   461	                                                "user"
   462	                                                "assistant"
   463	                                                "tool_use"
   464	                                                "server_tool_user"
   465	                                                "tool_result"
   466	                                                "web_search_tool_result")
   467	                                            line-end))
   468	
   469	  ;; Install eval grammars and set up embedded language parsing
   470	  (greger--install-eval-grammars)
   471	  (setq-local treesit-range-settings
   472	              (treesit-range-rules
   473	               :embed 'bash
   474	               :host 'greger
   475	               :local t
   476	               '(((eval (eval_start_brace (eval_language) @lang) (eval_content) @content)
   477	                  (:match "sh" @lang)))
   478	               :embed 'elisp
   479	               :host 'greger
   480	               :local t
   481	               '((eval (eval_content) @content))))
   482	
   483	  (treesit-major-mode-setup)
   484	
   485	  (setq-local mode-line-misc-info '(:eval (greger--mode-line-info)))
   486	  (use-local-map greger-mode-map)
   487	
   488	  (setq-local greger-current-thinking-budget greger-thinking-budget))
   489	
   490	;;;###autoload
   491	(defun greger (&optional with-context)
   492	  "Create a new buffer and switch to `greger-mode`.
   493	With WITH-CONTEXT (e.g. \[universal-argument] \[greger]), save
   494	the current buffer, split the window if not already split, and
   495	insert location information at the beginning of the user section."
   496	  (interactive "P")
   497	  (let ((buffer (generate-new-buffer "*greger*"))
   498	        (source-info (when with-context
   499	                       (save-buffer)
   500	                       (list (buffer-file-name)
   501	                             (line-number-at-pos)
   502	                             (current-column)))))
   503	    (when with-context
   504	      ;; Split horizontally if not already split
   505	      (when (= (length (window-list)) 1)
   506	        (split-window-right))
   507	      ;; Move to the next window
   508	      (other-window 1))
   509	    (switch-to-buffer buffer)
   510	    (greger-mode)
   511	    (insert greger-parser-system-tag
   512	            "\n\n" greger-default-system-prompt "\n\n"
   513	            greger-parser-user-tag
   514	            "\n\n")
   515	    (when source-info
   516	      (let ((file-name (nth 0 source-info))
   517	            (line-num (nth 1 source-info))
   518	            (column (nth 2 source-info)))
   519	        (insert (format "In %s, at line %d%s, implement the following:\n\n"
   520	                        file-name
   521	                        line-num
   522	                        (if (> column 0)
   523	                            (format " and column %d" column)
   524	                          "")))))
   525	    buffer))
   526	
   527	(defun greger-insert-assistant-tag ()
   528	  "Insert the assistant tag into the buffer."
   529	  (interactive)
   530	  (insert greger-parser-assistant-tag "\n\n"))
   531	
   532	(defun greger-insert-user-tag ()
   533	  "Insert the user tag into the buffer."
   534	  (interactive)
   535	  (insert greger-parser-user-tag "\n\n"))
   536	
   537	(defun greger-insert-system-tag ()
   538	  "Insert the system tag into the buffer."
   539	  (interactive)
   540	  (insert greger-parser-system-tag "\n\n"))
   541	
   542	(defun greger-interrupt ()
   543	  "Interrupt ongoing generation if active, otherwise call `keyboard-quit'."
   544	  (interactive)
   545	
   546	  ;; to not get stuck in read only
   547	  (greger--set-buffer-read-only nil)
   548	
   549	  (let* ((buffer (current-buffer))
   550	         (state (buffer-local-value 'greger--current-state buffer)))
   551	    (cond
   552	
   553	     ;; If there are executing tools, cancel them
   554	     ((and state
   555	           (greger-state-executing-tools state)
   556	           (> (hash-table-count (greger-state-executing-tools state)) 0))
   557	      (let ((executing-tools (greger-state-executing-tools state)))
   558	        (maphash (lambda (_tool-id greger-tool)
   559	                   (let ((cancel-fn (greger-tool-cancel-fn greger-tool)))
   560	                     (when (functionp cancel-fn)
   561	                       (funcall cancel-fn))))
   562	                 executing-tools)
   563	        (greger--update-buffer-state))
   564	      'executing)
   565	
   566	     ;; If there's an active client state, cancel the streaming request
   567	     ((and state (greger-state-client-state state))
   568	      (greger-client--cancel-request (greger-state-client-state state))
   569	      (greger--finish-response state)
   570	      'generating)
   571	
   572	     ;; Default case: call keyboard-quit
   573	     (t
   574	      (keyboard-quit)
   575	      'idle))))
   576	
   577	(defun greger-set-model ()
   578	  "Set the current model."
   579	  (interactive)
   580	  (let ((model (completing-read "Choose model: " greger-available-models nil t)))
   581	    (customize-set-variable 'greger-model (intern model))
   582	    (message "Model set to %s" model)))
   583	
   584	(defun greger-toggle-thinking ()
   585	  "Toggle thinking on/off."
   586	  (interactive)
   587	  (if (> greger-current-thinking-budget 0)
   588	      (progn
   589	        (setq-local greger-current-thinking-budget 0)
   590	        (message "Thinking disabled"))
   591	    (progn
   592	      (setq-local greger-current-thinking-budget greger-thinking-budget)
   593	      (message "Thinking enabled (budget: %d tokens)" greger-current-thinking-budget)))
   594	  (force-mode-line-update))
   595	
   596	(defun greger-toggle-follow-mode ()
   597	  "Toggle follow mode on/off.
   598	When follow mode is enabled, point moves to the bottom during chat updates.
   599	When disabled, point position is preserved using `save-excursion'."
   600	  (interactive)
   601	  (setq-local greger-follow-mode (not greger-follow-mode))
   602	  (when greger-follow-mode
   603	    (goto-char (point-max)))
   604	  (message "Follow mode %s" (if greger-follow-mode "enabled" "disabled"))
   605	  (force-mode-line-update))
   606	
   607	(defun greger-mention-buffer-file (buffer)
   608	  "Insert the file path of BUFFER at point.
   609	When called interactively, prompts for buffer selection.
   610	When called programmatically, BUFFER can be a buffer object or buffer name.
   611	Uses relative path if file is in current working directory or subdirectory.
   612	Uses ~/path notation if file is in home directory or subdirectory."
   613	  (interactive "bBuffer: ")
   614	
   615	  (if-let* ((buf (if (bufferp buffer) buffer (get-buffer buffer)))
   616	            (file-path (when buf (buffer-file-name buf))))
   617	      (let* ((file-path-abs (expand-file-name file-path))
   618	             (home-dir (expand-file-name "~/"))
   619	             (cwd (file-name-as-directory (expand-file-name default-directory)))
   620	             (formatted-path (cond
   621	                              ;; If file is in cwd or subdirectory, use relative path
   622	                              ((string-prefix-p cwd file-path-abs)
   623	                               (file-relative-name file-path))
   624	                              ;; If file is in home directory or subdirectory, use ~/path
   625	                              ((string-prefix-p home-dir file-path-abs)
   626	                               (concat "~/" (file-relative-name file-path home-dir)))
   627	                              ;; Otherwise, use absolute path
   628	                              (t file-path))))
   629	        (insert formatted-path))
   630	    (user-error "Buffer %s has no associated file" (or (buffer-name buf) buffer))))
   631	
   632	(defun greger-debug-request ()
   633	  "Debug the request data by parsing the buffer and saving the request data output.
   634	After saving, opens the JSON file in a new buffer for inspection."
   635	  (interactive)
   636	  (let* ((filename (read-string "Save to filename (default: request.json): " nil nil "request.json"))
   637	         (dialog (greger-parser-markdown-buffer-to-dialog (current-buffer)))
   638	         (tools (when greger-tools
   639	                  (greger-tools-get-schemas greger-tools)))
   640	         (server-tools (when greger-server-tools
   641	                         (greger-server-tools-get-schemas greger-server-tools)))
   642	         (model greger-model)
   643	         (request-data (greger-client--build-data model dialog tools server-tools greger-current-thinking-budget greger-max-tokens))
   644	         (parsed-json (json-read-from-string request-data)))
   645	
   646	    (with-temp-file filename
   647	      (let ((json-encoding-pretty-print t))
   648	        (insert (json-encode parsed-json))))
   649	    (message "Request data saved to %s" filename)
   650	    ;; Open the file in a new buffer for inspection
   651	    (find-file filename)))
   652	
   653	(defun greger-buffer (&optional no-tools)
   654	  "Send buffer content to AI as an agent dialog with tool support.
   655	When NO-TOOLS is set, disable tools and thinking."
   656	  (interactive "P")
   657	  (greger--ensure-buffer-can-be-submitted)
   658	
   659	  (let ((greger-tools (if no-tools '() greger-tools))
   660	        (greger-server-tools (if no-tools '() greger-server-tools))
   661	        (greger-current-thinking-budget (if no-tools 0 greger-current-thinking-budget)))
   662	    (greger--process-evals)
   663	    
   664	    (greger--run-agent-loop (make-greger-state
   665	                             :current-iteration 0
   666	                             :chat-buffer (current-buffer)
   667	                             :directory default-directory
   668	                             :tool-use-metadata `(:safe-shell-commands () :allow-all-shell-commands ,greger-allow-all-shell-commands)))))
   669	
   670	(defun greger-buffer-no-tools ()
   671	  "Send the buffer content to AI as a dialog without tool use or thinking."
   672	  (interactive)
   673	  (greger-buffer t))
   674	
   675	(defmacro greger--maybe-save-excursion (&rest body)
   676	  "Execute BODY, optionally preserving point position.
   677	If `greger-follow-mode' is enabled, point follows output
   678	at the end of the buffer.
   679	If `greger-follow-mode' is disabled, use `save-excursion'
   680	to preserve point position."
   681	  `(if greger-follow-mode
   682	       (progn ,@body)
   683	     (save-excursion ,@body)))
   684	
   685	(defun greger--live-chat-buffer (state)
   686	  "Return the chat buffer from STATE if it's still live."
   687	  (let ((buffer (greger-state-chat-buffer state)))
   688	    (when (buffer-live-p buffer)
   689	      buffer)))
   690	
   691	(defun greger--get-current-status ()
   692	  "Get the current greger status: \='idle, \='generating, or \='executing."
   693	  (let ((state (buffer-local-value 'greger--current-state (current-buffer))))
   694	    (cond
   695	     ;; Check if we're executing tools
   696	     ((and state
   697	           (greger-state-executing-tools state)
   698	           (> (hash-table-count (greger-state-executing-tools state)) 0))
   699	      'executing)
   700	     ;; Check if we're generating (client-state is active)
   701	     ((and state (greger-state-client-state state))
   702	      'generating)
   703	     ;; Otherwise we're idle
   704	     (t 'idle))))
   705	
   706	(defun greger--mode-line-info ()
   707	  "Generate mode line information showing model and current state."
   708	  (let ((status (greger--get-current-status))
   709	        (model-name (symbol-name greger-model)))
   710	    (concat model-name
   711	            (if (> greger-current-thinking-budget 0)
   712	                (format " [T:%d]" greger-current-thinking-budget)
   713	              "")
   714	            (pcase status
   715	              ('generating " [Generating]")
   716	              ('executing " [Executing]")
   717	              ('idle "")))))
   718	
   719	(defun greger--set-buffer-read-only (read-only)
   720	  "Set buffer read-only state for greger operations.
   721	READ-ONLY is t to make read-only, nil to make writable."
   722	  (if read-only
   723	      (unless greger--buffer-read-only-by-greger
   724	        (setq greger--buffer-read-only-by-greger t)
   725	        (setq buffer-read-only t))
   726	    (when greger--buffer-read-only-by-greger
   727	      (setq greger--buffer-read-only-by-greger nil)
   728	      (setq buffer-read-only nil))))
   729	
   730	(defun greger--update-buffer-state ()
   731	  "Update buffer read-only state based on current greger state."
   732	  (let ((status (greger--get-current-status)))
   733	    (greger--set-buffer-read-only (not (eq status 'idle)))
   734	    ;; Force mode line update
   735	    (force-mode-line-update)))
   736	
   737	(defun greger--ensure-buffer-can-be-submitted ()
   738	  "Ensure buffer can be submitted by fixing common issues with last message.
   739	Uses tree-sitter to find the last node and applies heuristics:
   740	- If last assistant text is empty or whitespace-only, insert '.'
   741	- If last assistant text ends with whitespace, trim it
   742	- If last message is thinking, insert '# ASSISTANT\\n\\n.' before submitting"
   743	  (let* ((root-node (treesit-buffer-root-node))
   744	         (last-node (greger--find-last-message-node root-node)))
   745	
   746	    (when last-node
   747	      (let ((node-type (treesit-node-type last-node)))
   748	        (cond
   749	         ((string= node-type "user")
   750	          (greger--insert-if-empty-content last-node "Continue"))
   751	
   752	         ((string= node-type "assistant")
   753	          (greger--insert-if-empty-content last-node "."))
   754	
   755	         ((string= node-type "thinking")
   756	          (greger--insert-assistant-after-thinking last-node)))))))
   757	
   758	(defun greger--find-last-message-node (root-node)
   759	  "Find the last message node in ROOT-NODE."
   760	  (let ((children (treesit-node-children root-node))
   761	        (last-message-node nil))
   762	    (dolist (child children)
   763	      (let ((node-type (treesit-node-type child)))
   764	        (when (member node-type '("assistant" "thinking" "user" "system"
   765	                                  "tool_use" "server_tool_use" "tool_result"
   766	                                  "web_search_tool_result" "untagged_text"))
   767	          (setq last-message-node child))))
   768	    last-message-node))
   769	
   770	(defun greger--insert-if-empty-content (node text)
   771	  "Add TEXT to NODE content if content is empty."
   772	  (let* ((header (treesit-node-child node 0 t))
   773	         (start-pos (treesit-node-end header))
   774	         (end-pos (treesit-node-end node))
   775	         (content (buffer-substring-no-properties start-pos end-pos)))
   776	
   777	    ;; Insert a dot if content is empty
   778	    (when (string= (string-trim content) "")
   779	      (greger--maybe-save-excursion
   780	       (goto-char end-pos)
   781	       (insert text)))))
   782	
   783	(defun greger--insert-assistant-after-thinking (thinking-node)
   784	  "Insert assistant response after THINKING-NODE."
   785	  (let ((end-pos (treesit-node-end thinking-node)))
   786	    (greger--maybe-save-excursion
   787	     (goto-char end-pos)
   788	     (insert "\n\n# ASSISTANT\n\n."))))
   789	
   790	(defun greger--run-agent-loop (state)
   791	  "Run the main agent loop with STATE."
   792	  (let* ((tools (greger-tools-get-schemas greger-tools))
   793	         (server-tools (when greger-server-tools
   794	                         (greger-server-tools-get-schemas greger-server-tools)))
   795	         (chat-buffer (greger-state-chat-buffer state))
   796	         (dialog (greger-parser-markdown-buffer-to-dialog chat-buffer))
   797	         (safe-shell-commands (greger-parser-find-safe-shell-commands-in-buffer chat-buffer))
   798	         (tool-use-metadata (greger-state-tool-use-metadata state))
   799	         (current-iteration (greger-state-current-iteration state))
   800	         (auth-key (or (and greger-anthropic-key-fn (funcall greger-anthropic-key-fn))
   801	                       (getenv "ANTHROPIC_API_KEY"))))
   802	
   803	    (setf (plist-get tool-use-metadata :safe-shell-commands) safe-shell-commands)
   804	
   805	    (when (>= current-iteration greger-max-iterations)
   806	      (error "Maximum iterations (%d) reached, stopping agent execution" greger-max-iterations))
   807	
   808	    (unless auth-key
   809	      (error "No API key found.  Set ANTHROPIC_API_KEY environment variable or configure greger-anthropic-key-fn"))
   810	
   811	
   812	    (with-current-buffer chat-buffer
   813	      (let ((client-state (greger-client-stream
   814	                           :model greger-model
   815	                           :dialog dialog
   816	                           :tools tools
   817	                           :server-tools server-tools
   818	                           :buffer chat-buffer
   819	                           :thinking-budget greger-current-thinking-budget
   820	                           :auth-key auth-key
   821	                           :block-start-callback (lambda (content-block)
   822	                                                   (greger--append-streaming-content-header state content-block))
   823	                           :text-delta-callback (lambda (text)
   824	                                                  (greger--append-text state (greger--clean-excessive-newlines text)))
   825	                           :block-stop-callback (lambda (type content-block)
   826	                                                  (greger--append-handle-content-block-stop state type content-block))
   827	                           :complete-callback (lambda (content-blocks) (greger--handle-stream-completion state content-blocks))
   828	                           :error-callback (lambda (error-message)
   829	                                             (greger--handle-client-error state error-message))
   830	                           :max-tokens greger-max-tokens)))
   831	
   832	        ;; Store the client state for potential cancellation
   833	        (setf (greger-state-client-state state) client-state)
   834	        ;; Set buffer-local variable for greger-interrupt to access
   835	        (setq greger--current-state state) ;; TODO: why do we set that _here_? Or should it be greger--current-client-state instead?
   836	        (greger--update-buffer-state)))))
   837	
   838	(defun greger--clean-excessive-newlines (text)
   839	  "Remove excessive newlines from the end of TEXT, keeping at most two.
   840	If TEXT ends with more than two consecutive newlines, remove all but the
   841	first two."
   842	  (replace-regexp-in-string "\n\n\n+\\'" "\n\n" text))
   843	
   844	(defun greger--force-code-close (state)
   845	  (with-current-buffer (greger-state-chat-buffer state)
   846	    (let ((end-is-code nil)
   847	          (inhibit-read-only t))
   848	     (save-excursion
   849	       (goto-char (point-max))
   850	       (insert "\n")
   851	       (when (string= (treesit-node-type (treesit-node-at (1- (point-max)))) "code_content")
   852	         (setq end-is-code t))
   853	       (delete-char -1))
   854	     (when end-is-code
   855	       (insert "<$code-close/>")))))
   856	
   857	(defun greger--append-streaming-content-header (state content-block)
   858	  "Append appropriate header for streaming CONTENT-BLOCK to STATE."
   859	
   860	  (greger--force-code-close state)
   861	
   862	  (let ((type (alist-get 'type content-block))
   863	        (has-citations (assq 'citations content-block)))
   864	    (cond
   865	     ((and (string= type "text") (not has-citations))
   866	      (greger--append-text state (concat "\n\n" greger-parser-assistant-tag "\n\n")))
   867	     ((string= type "thinking")
   868	      (greger--append-text state (concat "\n\n" greger-parser-thinking-tag "\n\n")))
   869	     (t nil))))
   870	
   871	(defun greger--handle-stream-completion (state content-blocks)
   872	  "Handle completion of stream with STATE and CONTENT-BLOCKS."
   873	  (if-let ((tool-calls (greger--extract-tool-calls content-blocks)))
   874	      (progn
   875	        (setf (greger-state-current-iteration state)
   876	              (1+ (greger-state-current-iteration state)))
   877	        ;; TODO: execute tool calls in greger--append-content-block instead
   878	        (greger--execute-tools tool-calls state))
   879	    (greger--finish-response state))
   880	
   881	  (when-let ((buffer (greger--live-chat-buffer state)))
   882	    (with-current-buffer buffer
   883	      (greger--update-buffer-state))))
   884	
   885	(defun greger--content-block-supports-streaming (content-block)
   886	  "Check if CONTENT-BLOCK can be streamed incrementally.
   887	Returns non-nil for text and thinking blocks without citations, which can
   888	be displayed as they arrive rather than waiting for completion."
   889	  (let ((type (alist-get 'type content-block))
   890	        (citations (alist-get 'citations content-block)))
   891	    (and (or (string= type "text") (string= type "thinking"))
   892	         (not citations))))
   893	
   894	(defun greger--append-handle-content-block-stop (state type content-block)
   895	  "Append non-streaming CONTENT-BLOCK of TYPE to STATE."
   896	  ;; Only append markdown if it hasn't done that already during streaming
   897	  (unless (greger--content-block-supports-streaming content-block)
   898	    (let ((markdown (greger-parser--block-to-markdown content-block)))
   899	      (greger--append-text state (concat "\n\n" markdown))))
   900	
   901	  ;; Special cases for tool use and thinking
   902	  (cond
   903	   ((string= type "tool_use")
   904	    (let ((tool-id (alist-get 'id content-block)))
   905	      (greger--append-text state (concat "\n\n" (greger--tool-result-placeholder tool-id)))))
   906	   ((string= type "thinking")
   907	    (let ((signature (alist-get 'signature content-block)))
   908	      (greger--insert-thinking-signature state signature))))
   909	
   910	  ;; Update buffer state after client completes
   911	  (when-let ((buffer (greger--live-chat-buffer state)))
   912	    (with-current-buffer buffer
   913	      (greger--update-buffer-state))))
   914	
   915	(defun greger--insert-thinking-signature (state signature)
   916	  "Insert thinking SIGNATURE after the last thinking tag, using STATE.
   917	Assumes the last inserted thing is a thinking tag."
   918	  (with-current-buffer (greger-state-chat-buffer state)
   919	    (save-excursion
   920	      (goto-char (point-max))
   921	      (re-search-backward "^# THINKING")
   922	      (forward-line 1)
   923	      (let ((inhibit-read-only t))
   924	        (insert "\n"
   925	                "Signature: " signature
   926	                "\n")))))
   927	
   928	(defun greger--extract-tool-calls (content-blocks)
   929	  "Extract tool call from CONTENT-BLOCKS."
   930	  (let ((tool-calls '()))
   931	    (dolist (block content-blocks)
   932	      (when (string= (alist-get 'type block) "tool_use")
   933	        (push block tool-calls)))
   934	    (reverse tool-calls)))
   935	
   936	(defun greger--tool-result-placeholder (tool-id)
   937	  "Generate placeholder string for TOOL-ID."
   938	  ;; It's ugly that we need to insert the trailing \n
   939	  ;; But we need it because otherwise the closing tool tag is not recognized.
   940	  ;; TODO: update greger-grammar
   941	  (let ((placeholder (concat (greger-parser--wrapped-tool-content greger-parser-tool-result-tag tool-id "") "\n")))
   942	    ;; Add a text property to the first character to indicate this is a generating tool result
   943	    (put-text-property 0 1 'greger-tool-result-generating t placeholder)
   944	    placeholder))
   945	
   946	(defun greger--execute-tools (tool-calls state)
   947	  "Execute TOOL-CALLS using STATE in parallel with callbacks."
   948	  (let* ((total-tools (length tool-calls))
   949	         (completed-tools 0)
   950	         (executing-tools-map (make-hash-table :test 'equal)))
   951	
   952	    ;; Initialize executing-tools in state if not already set
   953	    (unless (greger-state-executing-tools state)
   954	      (setf (greger-state-executing-tools state) executing-tools-map))
   955	
   956	    ;; Update buffer state to show we're executing tools
   957	    (when-let ((buffer (greger--live-chat-buffer state)))
   958	      (with-current-buffer buffer
   959	        (greger--update-buffer-state)
   960	
   961	        (greger--maybe-save-excursion
   962	         (goto-char (point-max)))))
   963	
   964	    ;; Execute all tools in parallel
   965	    (dolist (tool-call tool-calls)
   966	      (let* ((tool-name (alist-get 'name tool-call))
   967	             (tool-input (alist-get 'input tool-call))
   968	             (tool-id (alist-get 'id tool-call))
   969	             (default-directory (greger-state-directory state))
   970	
   971	             ;; TODO: This is ugly, we really should be separating the creation and execution of tools
   972	             ;; We're only doing this because for synchronous tools we can't set the tool in the
   973	             ;; hashmap after execution, because sync tools have already removed the key then.
   974	             (placeholder-tool (make-greger-tool :cancel-fn nil)))
   975	
   976	        (puthash tool-id placeholder-tool (greger-state-executing-tools state))
   977	
   978	        (greger--update-buffer-state)
   979	        (sit-for 0.001) ;; update the buffer state
   980	
   981	        (let ((greger-tool (greger-tools-execute
   982	                            :tool-name tool-name
   983	                            :args tool-input
   984	                            :callback (lambda (result error)
   985	                                        ;; Remove tool from executing-tools when complete
   986	                                        (remhash tool-id (greger-state-executing-tools state))
   987	
   988	                                        (greger--handle-tool-completion
   989	                                         :tool-id tool-id
   990	                                         :result result
   991	                                         :error error
   992	                                         :state state
   993	                                         :completion-callback (lambda ()
   994	                                                                ;; TODO: add completed-tools to state instead of this nested callback
   995	                                                                (setq completed-tools (1+ completed-tools))
   996	                                                                (when (and (= completed-tools total-tools)
   997	                                                                           (greger-state-chat-buffer state))
   998	                                                                  (greger--run-agent-loop state)))))
   999	                            :streaming-callback (lambda (text)
  1000	                                                  (greger--append-tool-result-text state tool-id text))
  1001	                            :buffer (greger-state-chat-buffer state)
  1002	                            :metadata (greger-state-tool-use-metadata state))))
  1003	
  1004	          ;; TODO: here again, it's ugly
  1005	          (when (greger-tool-cancel-fn greger-tool)
  1006	            (puthash tool-id greger-tool (greger-state-executing-tools state))))))))
  1007	
  1008	(defun greger--append-text (state text)
  1009	  "Append TEXT to the chat buffer in STATE."
  1010	  (let ((buffer (greger-state-chat-buffer state)))
  1011	    (with-current-buffer buffer
  1012	      (let ((inhibit-read-only t))
  1013	        (greger--maybe-save-excursion
  1014	         (goto-char (point-max))
  1015	         (insert text))))))
  1016	
  1017	(cl-defun greger--handle-tool-completion (&key tool-id result error state completion-callback)
  1018	  "Handle completion of a tool execution.
  1019	Updates buffer and calls callback when tool execution finishes.
  1020	TOOL-ID is the tool identifier.
  1021	RESULT is the tool execution result.
  1022	ERROR is any error that occurred.
  1023	STATE contains the current agent state.
  1024	COMPLETION-CALLBACK is called when complete."
  1025	  (let ((tool-result-text (if error
  1026	                              (if (listp error)
  1027	                                  (error-message-string error)
  1028	                                error)
  1029	                            result)))
  1030	
  1031	    (greger--append-tool-result-text state tool-id tool-result-text t)
  1032	
  1033	    ;; Call completion callback
  1034	    (funcall completion-callback)))
  1035	
  1036	(defun greger--append-tool-result-text (state tool-id text &optional is-completed)
  1037	  "Append TEXT to the tool result content node for TOOL-ID in STATE's buffer.
  1038	When IS-COMPLETED is non-nil, also trim trailing newline after the tool's
  1039	end tag and update the buffer state."
  1040	  (when-let ((buffer (greger--live-chat-buffer state)))
  1041	    (with-current-buffer buffer
  1042	      (when-let ((inhibit-read-only t)
  1043	                 (tool-result-content-node (greger--find-tool-result-content-node tool-id))
  1044	                 (tool-result-content-start (treesit-node-start tool-result-content-node))
  1045	                 (tool-result-content-end (treesit-node-end tool-result-content-node)))
  1046	        (greger--maybe-save-excursion
  1047	         ;; Check if this is a vterm full replacement
  1048	         (if (string-prefix-p "VTERM_FULL_REPLACE:" text)
  1049	             ;; Replace entire tool result content with vterm buffer content
  1050	             (let ((vterm-content (substring text (length "VTERM_FULL_REPLACE:"))))
  1051	               (delete-region tool-result-content-start (1- tool-result-content-end))
  1052	               (goto-char tool-result-content-start)
  1053	               (insert vterm-content))
  1054	           ;; Regular streaming - append text directly (no terminal sequence processing)
  1055	           (progn
  1056	             (goto-char (1- tool-result-content-end))
  1057	             (insert text)))
  1058	
  1059	         (when is-completed
  1060	           ;; Trim trailing newline after closing tag
  1061	           (when-let* ((tool-result-content-node (greger--find-tool-result-content-node tool-id)) ;; content node might have gotten outdated, so need to get it again
  1062	                       (tool-end-tag (treesit-node-next-sibling tool-result-content-node t)))
  1063	             (when (string= (treesit-node-type tool-end-tag) "tool_end_tag")
  1064	               (goto-char (treesit-node-end tool-end-tag))
  1065	               (when (looking-at-p "\n")
  1066	                 (delete-char 1))))
  1067	
  1068	           ;; Remove the generating property from the tool result
  1069	           (when-let ((tool-result-node (greger--find-tool-result-node tool-id)))
  1070	             (let ((start (treesit-node-start tool-result-node))
  1071	                   (end (treesit-node-end tool-result-node)))
  1072	               (remove-text-properties start end '(greger-tool-result-generating))))
  1073	
  1074	           ;; Update buffer state after tool completion
  1075	           (greger--update-buffer-state)))))))
  1076	
  1077	(defun greger--find-tool-result-content-node (tool-id)
  1078	  "Find the tool_content node for the tool_result with TOOL-ID.
  1079	Uses treesit to query for a tool_result with matching id and returns
  1080	the tool_content node within its content section."
  1081	  (when-let* ((query `((tool_result (id (value) @id) (:match ,tool-id @id)
  1082	                                    (content) @content)))
  1083	              (capture (treesit-query-capture (treesit-buffer-root-node) query))
  1084	              (content-node (alist-get 'content capture))
  1085	              ;; for some reason, querying directly for tool_content fails, but this works
  1086	              (content-node-first-child (car (treesit-node-children content-node))))
  1087	    (treesit-search-subtree content-node-first-child "tool_content")))
  1088	
  1089	(defun greger--find-tool-result-node (tool-id)
  1090	  "Find the tool_result node with TOOL-ID.
  1091	Uses treesit to query for a tool_result with matching id and returns
  1092	the tool_result node itself."
  1093	  (let* ((query `((tool_result (id (value) @id) (:match ,tool-id @id)) @tool-result))
  1094	         (capture (treesit-query-capture (treesit-buffer-root-node) query)))
  1095	    (alist-get 'tool-result capture)))
  1096	
  1097	(defun greger--handle-client-error (state error-message)
  1098	  "Handle client error with STATE and ERROR-MESSAGE."
  1099	  ;; This will be called from the main thread via the completion handler
  1100	  (when-let ((buffer (greger--live-chat-buffer state)))
  1101	    (with-current-buffer buffer
  1102	      ;; Clear the buffer-local agent state
  1103	      (setq greger--current-state nil)
  1104	      ;; Update buffer state to idle
  1105	      (greger--update-buffer-state)))
  1106	  ;; Reset the state
  1107	  (setf (greger-state-current-iteration state) 0)
  1108	  (setf (greger-state-client-state state) nil)
  1109	  ;; Raise the error in the main thread where it can be caught by tests
  1110	  (warn "%s" error-message))
  1111	
  1112	(defun greger--finish-response (state)
  1113	  "Finish the agent response using STATE."
  1114	  (when-let ((buffer (greger--live-chat-buffer state)))
  1115	    (with-current-buffer buffer
  1116	      (let ((inhibit-read-only t))
  1117	        (greger--maybe-save-excursion
  1118	         (goto-char (point-max))
  1119	         (unless (looking-back (concat greger-parser-user-tag "\n\n") nil)
  1120	           (greger--force-code-close state)
  1121	           (insert "\n\n" greger-parser-user-tag "\n\n"))))
  1122	      ;; Clear the buffer-local agent state
  1123	      (setq greger--current-state nil)
  1124	      ;; Update buffer state to idle
  1125	      (greger--update-buffer-state)))
  1126	  ;; Reset the state
  1127	  (setf (greger-state-current-iteration state) 0)
  1128	  (setf (greger-state-client-state state) nil))
  1129	
  1130	;; Eval functionality
  1131	
  1132	(defun greger--eval-code (language code)
  1133	  "Evaluate CODE in the specified LANGUAGE.
  1134	Returns the result as a string.
  1135	Raises an error if evaluation fails."
  1136	  (cond
  1137	   ((string= language "elisp")
  1138	    (greger--eval-elisp code))
  1139	   ((string= language "sh")
  1140	    (greger--eval-bash code))
  1141	   (t
  1142	    (error "Unsupported eval language: %s. Supported languages are: elisp (default) and sh (bash)"))))
  1143	
  1144	(defun greger--eval-elisp (code)
  1145	  "Evaluate Emacs Lisp CODE and return the result as a string."
  1146	  (condition-case err
  1147	      (let ((result (eval (read (format "(progn %s)" code)))))
  1148	        (substring-no-properties (format "%s" result)))
  1149	    (error
  1150	     (error "Elisp evaluation failed: %s" (error-message-string err)))))
  1151	
  1152	(defun greger--eval-bash (code)
  1153	  "Evaluate Bash CODE and return the result as a string."
  1154	  (let* ((process-name (format "greger-bash-eval-%s" (make-temp-name "")))
  1155	         (process-buffer (generate-new-buffer (format " *%s*" process-name)))
  1156	         (result nil)
  1157	         (error-msg nil)
  1158	         (process (let ((inhibit-message t))
  1159	                    (start-process process-name process-buffer "bash" "-c" code)))
  1160	         (exit-status nil))
  1161	    (unwind-protect
  1162	        (progn
  1163	          (set-process-query-on-exit-flag process nil)
  1164	          (set-process-sentinel process #'ignore)  ; Suppress process messages
  1165	          (while (process-live-p process)
  1166	            (accept-process-output process 0.1))
  1167	          (setq exit-status (process-exit-status process))
  1168	          (with-current-buffer process-buffer
  1169	            (let ((output (buffer-substring-no-properties (point-min) (point-max))))
  1170	              (if (= exit-status 0)
  1171	                  (setq result (if (string-empty-p output) "(no output)" output))
  1172	                (setq error-msg (format "Bash evaluation failed with exit code %d: %s" 
  1173	                                      exit-status output))))))
  1174	      (when (buffer-live-p process-buffer)
  1175	        (kill-buffer process-buffer)))
  1176	    (if error-msg
  1177	        (error "%s" error-msg)
  1178	      result)))
  1179	
  1180	(defun greger--process-evals ()
  1181	  "Process all eval blocks in current buffer according to greger eval semantics.
  1182	- Evaluate evals in system section every time
  1183	- Evaluate evals in current user section (last user section only)
  1184	- Replace eval blocks with eval results
  1185	- Raise errors if evaluation fails"
  1186	  (when-let* ((root-node (treesit-buffer-root-node))
  1187	              (system-nodes (treesit-query-capture root-node '((system) @system))))
  1188	    (dolist (capture system-nodes)
  1189	      (when (eq (car capture) 'system)
  1190	        (greger--process-evals-in-node (cdr capture) :clear-existing t)))
  1191	    
  1192	    ;; Process evals in the last user section only
  1193	    (when-let* ((user-nodes (treesit-query-capture root-node '((user) @user)))
  1194	                (last-user-node (cdar (last user-nodes))))
  1195	      (greger--process-evals-in-node last-user-node :clear-existing t))))
  1196	
  1197	(cl-defun greger--process-evals-in-node (node &key clear-existing)
  1198	  "Process all eval blocks in NODE.
  1199	If CLEAR-EXISTING, clear any existing eval results."
  1200	  (let ((eval-nodes (treesit-query-capture node '((eval) @eval))))
  1201	    ;; Process eval nodes in reverse order to avoid position shifts
  1202	    (dolist (capture (reverse eval-nodes))
  1203	      (when (eq (car capture) 'eval)
  1204	        (greger--process-single-eval (cdr capture) :clear-existing clear-existing)))))
  1205	
  1206	(cl-defun greger--process-single-eval (eval-node &key clear-existing)
  1207	  "Process a single eval block represented by EVAL-NODE.
  1208	If CLEAR-EXISTING, clear any existing eval results."
  1209	  (let* ((start-tag-node (treesit-search-subtree eval-node "eval_start_brace"))
  1210	         (end-tag-node (treesit-search-subtree eval-node "eval_end_brace"))
  1211	         (content-node (treesit-search-subtree eval-node "eval_content"))
  1212	         (language (greger--extract-eval-language start-tag-node))
  1213	         (code (treesit-node-text content-node t))
  1214	         (eval-id (greger--generate-eval-id))
  1215	         (result (greger--eval-code language (string-trim code)))
  1216	         (existing-result-node (treesit-search-subtree eval-node "eval_result"))
  1217	         (new-result-block (format "<eval-result-%s>%s</eval-result-%s>" eval-id result eval-id))
  1218	         (content-end (treesit-node-end content-node))
  1219	         (end-tag-start (treesit-node-start end-tag-node)))
  1220	
  1221	    (when (or clear-existing (not existing-result-node))
  1222	      (save-excursion
  1223	        (goto-char content-end)
  1224	        (delete-region content-end end-tag-start)
  1225	        (insert new-result-block)))))
  1226	
  1227	(defun greger--extract-eval-language (start-tag-node)
  1228	  "Extract language from eval start tag node, defaulting to elisp."
  1229	  (if start-tag-node
  1230	      (let ((language-node (treesit-search-subtree start-tag-node "language")))
  1231	        (if language-node
  1232	            (treesit-node-text language-node t)
  1233	          "elisp"))  ; default to elisp
  1234	    "elisp"))
  1235	
  1236	(defun greger--generate-eval-id ()
  1237	  "Generate a unique ID for eval results."
  1238	  (format "%s%06d" 
  1239	          (format-time-string "%H%M%S")
  1240	          (random 1000000)))
