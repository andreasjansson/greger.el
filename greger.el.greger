# greger.el:

     1	;;; greger.el --- Agentic coding environment with tool use, using Claude -*- lexical-binding: t -*-
     2	
     3	;; Copyright (C) 2025 Andreas Jansson
     4	
     5	;; Author: Andreas Jansson <andreas@jansson.me.uk>
     6	;; Version: 0.1.0
     7	;; URL: https://github.com/andreasjansson/greger.el
     8	;; Package-Requires: ((emacs "29.1"))
     9	;; Keywords: agent, agentic, ai, chat, language-models, tools
    10	;; SPDX-License-Identifier: MIT
    11	
    12	;; Permission is hereby granted, free of charge, to any person obtaining a copy
    13	;; of this software and associated documentation files (the "Software"), to deal
    14	;; in the Software without restriction, including without limitation the rights
    15	;; to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
    16	;; copies of the Software, and to permit persons to whom the Software is
    17	;; furnished to do so, subject to the following conditions:
    18	
    19	;; The above copyright notice and this permission notice shall be included in all
    20	;; copies or substantial portions of the Software.
    21	
    22	;; THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    23	;; IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    24	;; FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    25	;; AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    26	;; LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
    27	;; OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
    28	;; SOFTWARE.
    29	
    30	;;; Commentary:
    31	;; Agentic coding environment using Claude and a suite of built-in tools.
    32	;; Capable of viewing and editing files, searching code, listing files,
    33	;; searching the web and downloading web pages.  Extensible with custom
    34	;; tools defined in Emacs Lisp.
    35	
    36	;;; Code:
    37	
    38	(require 'cl-lib)
    39	(require 'json)
    40	(require 'treesit)
    41	
    42	(require 'greger-client)
    43	(require 'greger-openrouter)
    44	(require 'greger-parser)
    45	(require 'greger-tools)
    46	(require 'greger-stdlib)
    47	(require 'greger-ui)
    48	(require 'greger-prompt)
    49	
    50	;; Eval functionality
    51	(defconst greger-available-models
    52	  '(claude-sonnet-4-20250514
    53	    claude-opus-4-20250514
    54	    claude-opus-4-1-20250805
    55	    claude-sonnet-4-5)
    56	  "List of available models.")
    57	
    58	(defcustom greger-model 'claude-sonnet-4-20250514
    59	  "The currently used model."
    60	  :type `(choice ,@(mapcar (lambda (model) `(const ,model)) greger-available-models))
    61	  :group 'greger)
    62	
    63	(defcustom greger-default-system-prompt "You are Greger, and expert coding agent.
    64	
    65	${greger-prompt-code-style}"
    66	  "Default system prompt used for AI interactions."
    67	  :type 'string
    68	  :group 'greger)
    69	
    70	(defcustom greger-max-tokens 27000
    71	  "Maximum number of tokens to generate."
    72	  :type 'integer
    73	  :group 'greger)
    74	
    75	(defcustom greger-thinking-budget 4096
    76	  "Default budget for thinking (internal reasoning) content, in tokens.
    77	Set to 0 to disable thinking entirely."
    78	  :type 'integer
    79	  :group 'greger)
    80	
    81	(defcustom greger-local-grammar-path nil
    82	  "Local path or Git branch for greger grammar development.
    83	When set to a local directory path (starting with / or ~), the grammar
    84	will be installed from that local directory. When set to a string not
    85	starting with / or ~, it will be treated as a Git branch name.
    86	This is useful for development when you want to test local changes
    87	or changes from a development branch."
    88	  :type '(choice (const :tag "Use main branch from GitHub" nil)
    89	                 (directory :tag "Local grammar directory path")
    90	                 (string :tag "Git branch name"))
    91	  :group 'greger)
    92	
    93	(defcustom greger-allow-all-shell-commands nil
    94	  "Allow all shell commands to run without permission.
    95	May order 4,000 pounds of meat."
    96	  :type 'boolean
    97	  :group 'greger)
    98	
    99	(defcustom greger-anthropic-key-fn nil
   100	  "Function to call to get the Anthropic API key.
   101	This function should return a string containing the API key.
   102	If nil, the ANTHROPIC_API_KEY environment variable will be used."
   103	  :type '(choice (const nil) function)
   104	  :group 'greger)
   105	
   106	(defcustom greger-provider 'anthropic
   107	  "Provider to use for API calls.
   108	Options: 'anthropic (default) or 'openrouter (beta)."
   109	  :type '(choice (const :tag "Anthropic (Claude)" anthropic)
   110	                 (const :tag "OpenRouter (Beta)" openrouter))
   111	  :group 'greger)
   112	
   113	(defcustom greger-openrouter-api-key-fn nil
   114	  "Function to call to get the OpenRouter API key.
   115	If nil, uses OPENROUTER_API_KEY environment variable."
   116	  :type '(choice (const nil) function)
   117	  :group 'greger)
   118	
   119	(defcustom greger-openrouter-model "openai/gpt-5-codex"
   120	  "Model to use when greger-provider is 'openrouter."
   121	  :type 'string
   122	  :group 'greger)
   123	
   124	;; Tool configuration and agent functionality
   125	
   126	(defcustom greger-tools '("read-file" "write-new-file" "replace-file" "str-replace" "make-directory" "rename-file" "delete-files" "list-directory" "ripgrep" "shell-command" "read-webpage")
   127	  "List of tools available to the agent."
   128	  :type '(repeat symbol)
   129	  :group 'greger)
   130	
   131	(defcustom greger-server-tools '("web_search")
   132	  "List of server tools available to the agent (e.g., web_search)."
   133	  :type '(repeat symbol)
   134	  :group 'greger)
   135	
   136	(defcustom greger-max-iterations 100
   137	  "Maximum number of agent iterations before stopping."
   138	  :type 'integer
   139	  :group 'greger)
   140	
   141	;;; Agent state structure
   142	
   143	(cl-defstruct greger-state
   144	  current-iteration
   145	  chat-buffer
   146	  directory
   147	  tool-use-metadata
   148	  client-state
   149	  executing-tools)
   150	
   151	(defvar-local greger--current-state nil
   152	  "Buffer-local variable to track the current state.")
   153	
   154	(defvar-local greger--buffer-read-only-by-greger nil
   155	  "Buffer-local variable to track if buffer is read-only due to greger activity.")
   156	
   157	(defvar-local greger-current-thinking-budget greger-thinking-budget
   158	  "Thinking budget for the current Greger chat.")
   159	
   160	(defvar-local greger-follow-mode t
   161	  "When non-nil, keep point at the bottom of the chat during updates.
   162	When nil, preserve point position using `save-excursion'.")
   163	
   164	(defcustom greger-citation-summary-face 'underline
   165	  "Face to use for citation text when folded."
   166	  :type 'face
   167	  :group 'greger)
   168	
   169	(defface greger-user-header-face
   170	  '((t (:foreground "cyan" :weight bold :height 1.1)))
   171	  "Face for USER headers."
   172	  :group 'greger)
   173	
   174	(defface greger-assistant-header-face
   175	  '((t (:foreground "green" :weight bold :height 1.1)))
   176	  "Face for ASSISTANT headers."
   177	  :group 'greger)
   178	
   179	(defface greger-system-header-face
   180	  '((t (:foreground "orange" :weight bold :height 1.1)))
   181	  "Face for SYSTEM headers."
   182	  :group 'greger)
   183	
   184	(defface greger-thinking-header-face
   185	  '((t (:foreground "magenta" :weight bold :height 1.1)))
   186	  "Face for THINKING headers."
   187	  :group 'greger)
   188	
   189	(defface greger-tool-header-face
   190	  '((t (:foreground "yellow" :weight bold :height 1.1)))
   191	  "Face for tool-related headers (TOOL USE, TOOL RESULT, etc.)."
   192	  :group 'greger)
   193	
   194	(defface greger-field-name-face
   195	  '((t (:foreground "lightyellow")))
   196	  "Face for field names like \='Name:\=', \='ID:\=', etc."
   197	  :group 'greger)
   198	
   199	(defface greger-tool-param-name-face
   200	  '((t (:foreground "lightgreen")))
   201	  "Face for tool parameter names like \='path\=', \='content\=', etc."
   202	  :group 'greger)
   203	
   204	(defface greger-key-face
   205	  '((t (:foreground "lightblue")))
   206	  "Face for tool parameter names like \='path\=', \='content\=', etc."
   207	  :group 'greger)
   208	
   209	(defface greger-tool-tag-face
   210	  '((t (:foreground "gray" :height 0.6)))
   211	  "Face for tool start and end tags."
   212	  :group 'greger)
   213	
   214	(defface greger-citation-face
   215	  '((t (:underline "#555588")))
   216	  "Face for links."
   217	  :group 'greger)
   218	
   219	(defface greger-link-face
   220	  '((t (:foreground "aqua" :weight semi-bold)))
   221	  "Face for links."
   222	  :group 'greger)
   223	
   224	(defface greger-eval-tag-face
   225	  '((t (:foreground "#4A90E2")))
   226	  "Face for eval tags (<eval>, </eval>)."
   227	  :group 'greger)
   228	
   229	(defface greger-eval-language-face
   230	  '((t (:foreground "#4AE290")))
   231	  "Face for eval tags (<eval>, </eval>)."
   232	  :group 'greger)
   233	
   234	(defface greger-eval-result-face
   235	  '((t (:foreground "#8FA5C7")))
   236	  "Face for eval result content - blue-ish gray."
   237	  :group 'greger)
   238	
   239	(defface greger-eval-arrow-face
   240	  '((t (:foreground "#5A7BA7" :weight bold)))
   241	  "Face for eval result arrow overlay - darker blue-ish gray."
   242	  :group 'greger)
   243	
   244	(defface greger-error-face
   245	  '((t (:background "red" :foreground "white")))
   246	  "Face for parse errors in greger-mode."
   247	  :group 'greger)
   248	
   249	(defface greger-code-content-face
   250	  '((((class color) (background dark))
   251	     (:background "#2a2a2a"))
   252	    (((class color) (background light))
   253	     (:background "#f8f8f8"))
   254	    (t (:background "gray")))
   255	  "Face for code content blocks.
   256	Background is slightly less dark than default for dark themes,
   257	or slightly less bright than default for light themes."
   258	  :group 'greger)
   259	
   260	(defface greger-code-backtick-face
   261	  '((((class color) (background dark))
   262	     (:foreground "#b5651d" :background "#2a2a2a"))
   263	    (((class color) (background light))
   264	     (:foreground "#8b4513" :background "#f8f8f8"))
   265	    (t (:foreground "orange" :background "gray")))
   266	  "Face for backticks around code content - orange-ish gray color."
   267	  :group 'greger)
   268	
   269	(defvar greger-mode-map
   270	  (let ((map (make-sparse-keymap)))
   271	    (define-key map (kbd "M-<return>") #'greger-buffer)
   272	    (define-key map (kbd "M-RET") #'greger-buffer)  ; Alternative for Linux compatibility
   273	    (define-key map (kbd "C-M-<return>") #'greger-buffer-no-tools)
   274	    (define-key map (kbd "C-M-RET") #'greger-buffer-no-tools)  ; Alternative for Linux compatibility
   275	    (define-key map (kbd "C-g") #'greger-interrupt)
   276	    (define-key map (kbd "C-; a") #'greger-insert-assistant-tag)
   277	    (define-key map (kbd "C-; u") #'greger-insert-user-tag)
   278	    (define-key map (kbd "C-; s") #'greger-insert-system-tag)
   279	    (define-key map (kbd "C-; m") #'greger-set-model)
   280	    (define-key map (kbd "C-; c") #'greger-ui-copy-code)
   281	    (define-key map (kbd "C-; t") #'greger-toggle-thinking)
   282	    (define-key map (kbd "C-; f") #'greger-toggle-follow-mode)
   283	    (define-key map (kbd "C-; C-f") #'greger-ui-toggle-folding)
   284	    (define-key map (kbd "C-; b") #'greger-mention-buffer-file)
   285	    map)
   286	  "Keymap for `greger-mode'.")
   287	
   288	(defvar greger--treesit-font-lock-settings
   289	  (treesit-font-lock-rules
   290	   :language 'greger
   291	   :feature 'headers
   292	   :override t
   293	   '((user_header) @greger-user-header-face
   294	     (assistant_header) @greger-assistant-header-face
   295	     (system_header) @greger-system-header-face
   296	     (thinking_header) @greger-thinking-header-face
   297	     (tool_use_header) @greger-tool-header-face
   298	     (tool_result_header) @greger-tool-header-face
   299	     (server_tool_use_header) @greger-tool-header-face
   300	     (web_search_tool_result_header) @greger-tool-header-face)
   301	
   302	   :language 'greger
   303	   :feature 'tool-syntax-highlighting
   304	   :override t
   305	   '((tool_use) @greger-ui--tool-use-syntax-highlighting
   306	     (tool_result) @greger-ui--tool-result-syntax-highlighting)
   307	
   308	   :language 'greger
   309	   :feature 'folding
   310	   :override t
   311	   '((assistant (citation_entry) @greger-ui--citation-entry-folding)
   312	     (tool_content_tail) @greger-ui--tool-content-tail-folding
   313	     (tool_content_head) @greger-ui--tool-content-head-folding
   314	     (thinking_signature) @greger-ui--thinking-signature-hiding
   315	     (eval_result_content_head) @greger-ui--eval-result-content-head-folding
   316	     (eval_result_content_tail) @greger-ui--eval-result-content-tail-folding)
   317	
   318	   :language 'greger
   319	   :feature 'tool-tags
   320	   :override t
   321	   '((tool_start_tag) @greger-ui--make-tool-tag-invisible
   322	     (tool_end_tag) @greger-ui--make-tool-tag-invisible
   323	     (tool_use (id) @greger-ui--make-tool-use-id-invisible)
   324	     (tool_result (id) @greger-ui--make-tool-result-id-invisible)
   325	     (server_tool_use (id) @greger-ui--make-tool-use-id-invisible)
   326	     (web_search_tool_result (id) @greger-ui--make-tool-result-id-invisible)
   327	     (tool_param_header) @greger-tool-param-name-face
   328	     (key) @greger-key-face
   329	     (url) @greger-ui--url-link
   330	     (eval_result_start_tag) @greger-ui--eval-result-start-tag-with-arrow
   331	     (eval_result_end_tag) @greger-ui--make-eval-result-tag-invisible)
   332	
   333	   :language 'greger
   334	   :feature 'eval-tags
   335	   :override t
   336	   '((eval_start_brace) @greger-eval-tag-face
   337	     (eval_end_brace) @greger-eval-tag-face
   338	     (eval_language) @greger-eval-language-face
   339	     (eval_result_content) @greger-eval-result-face)
   340	
   341	   :language 'greger
   342	   :feature 'comments
   343	   :override t
   344	   '((html_comment) @font-lock-comment-face)
   345	
   346	   :language 'greger
   347	   :feature 'code-styling
   348	   :override t
   349	   '((code_content) @greger-code-content-face
   350	     (code_start_tag) @greger-code-backtick-face
   351	     (code_end_tag) @greger-code-backtick-face
   352	     (code_close_tag) @greger-ui--make-code-close-invisible)
   353	
   354	   :language 'greger
   355	   :feature 'error
   356	   :override t
   357	   '((ERROR) @greger-error-face))
   358	  "Tree-sitter font-lock settings for `greger-mode'.")
