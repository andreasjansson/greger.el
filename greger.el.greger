   126	                      :properties '((path . ((type . "string")
   127	                                             (description . "Path to the directory to create")))
   128	                                    (git-commit-message . ((type . "string")
   129	                                                           (description . "Git commit message for this change"))))
   130	                      :required '("path" "git-commit-message")
   131	                      :function 'greger-stdlib--make-directory
   132	                      :pass-buffer t)
