   373	;; Code blocks
   374	
   375	(defun greger-ui-copy-code ()
   376	  "Copy code block content at point to kill ring."
   377	  (interactive)
   378	  (let ((node (treesit-node-at (point))))
   379	    (if (string= (treesit-node-type node) "code_block_content")
   380	        (let ((code (treesit-node-text node t)))
   381	          (kill-new code)
   382	          (message "Copied code:\n%s" (greger-ui--truncate-with-ellipsis code 40)))
   383	      (message "Not inside a code block"))))
   384	
   385	(defun greger-ui--truncate-with-ellipsis (str max-width)
   386	  "Truncate STR to MAX-WIDTH characters, adding an ellipsis if necessary."
   387	  (let ((len (length str)))
   388	    (if (<= len max-width)
   389	        str
   390	      (concat (substring str 0 (- max-width 3)) "..."))))
   391	
   392	;; TAB toggles
   393	
   394	(defun greger-ui--toggle-citation-fold ()
   395	  "Toggle folding of citation or tool content at point."
   396	  (interactive)
   397	  (let* ((node (treesit-node-at (point)))
   398	         (node-start (treesit-node-start node))
   399	         (invisible-start (get-text-property node-start 'invisible-start))
   400	         (invisible-end (get-text-property node-start 'invisible-end))
   401	         (is-expanded (get-text-property node-start 'greger-ui-citation-expanded))
   402	         (inhibit-read-only t))
   403	
   404	    (put-text-property node-start (1+ node-start) 'greger-ui-citation-expanded (not is-expanded))
   405	    (font-lock-flush invisible-start invisible-end)))
   406	
   407	(defun greger-ui--toggle-tool-content-head-fold ()
   408	  "Toggle folding of citation or tool content at point."
   409	  (interactive)
   410	  (let* ((tail-start (get-text-property (point) 'greger-ui-tool-tail-start))
   411	         (tail-end (get-text-property (point) 'greger-ui-tool-tail-end)))
   412	    (when (and tail-start tail-end)
   413	      (let ((is-tail-visible (get-text-property tail-start 'greger-ui-tool-content-expanded))
   414	            (inhibit-read-only t))
   415	        (put-text-property tail-start (min (1+ tail-start) tail-end) 'greger-ui-tool-content-expanded (not is-tail-visible))
   416	        ;; Also need to flush both head and tail for overlay updates
   417	        (font-lock-flush (point) tail-end)))))
   418	
   419	(defun greger-ui--toggle-tool-content-tail-fold ()
   420	  "Toggle folding of citation or tool content at point."
   421	  (interactive)
   422	  (let* ((node (treesit-node-at (point)))
   423	         (tail-start (treesit-node-start node))
   424	         (tail-end (treesit-node-end node))
   425	         (is-tail-visible (get-text-property tail-start 'greger-ui-tool-content-expanded))
   426	         (parent (treesit-node-parent node))
   427	         (head-node (treesit-search-subtree parent "^tool_content_head$" nil nil 1))
   428	         (inhibit-read-only t))
   429	
   430	    (if is-tail-visible
   431	        (progn
   432	          (put-text-property tail-start (1+ tail-start) 'greger-ui-tool-content-expanded nil)
   433	          (font-lock-flush (treesit-node-start head-node) tail-end))
   434	
   435	      (put-text-property tail-start (1+ tail-start) 'greger-ui-tool-content-expanded t)
   436	      (font-lock-flush (treesit-node-start head-node) tail-end))))
   437	
   438	(defun greger-ui-toggle-eval-result-content (&optional pos)
   439	  "Toggle visibility of eval result content tail at POS (or point)."
   440	  (interactive)
   441	  (when-let* ((pos (or pos (point)))
   442	              (current-node (treesit-node-at pos))
   443	              (content-node (treesit-node-parent current-node))
   444	              (tail-node (treesit-search-subtree content-node "eval_result_content_tail"))
   445	              (tail-start (treesit-node-start tail-node))
   446	              (tail-end (treesit-node-end tail-node))
   447	              (eval-result-node (treesit-parent-until
   448	                                 current-node
   449	                                 (lambda (n) (string= (treesit-node-type n) "eval_result")))))
   450	    (let* ((currently-visible (get-text-property tail-start 'greger-ui-eval-result-content-expanded)))
   451	      
   452	      ;; Toggle the expanded state
   453	      (put-text-property tail-start tail-end 'greger-ui-eval-result-content-expanded (not currently-visible))
   454	      
   455	      ;; Update invisibility
   456	      (put-text-property tail-start tail-end 'invisible
   457	                         (and greger-ui-folding-mode (not (not currently-visible))))
   458	      
   459	      ;; Force fontification refresh for this region
   460	      (font-lock-flush (treesit-node-start eval-result-node)
   461	                       (treesit-node-end eval-result-node)))))
   462	
   463	;; Tool use syntax highlighting
   464	
   465	(defun greger-ui--syntax-highlighted-p (node)
   466	  "Return non-nil if NODE has already been syntax highlighted."
   467	  (let* ((node-start (treesit-node-start node))
   468	         (overlays (overlays-at node-start)))
   469	    (if (seq-find (lambda (ov) (overlay-get ov 'greger-ui-syntax-highlighted)) overlays)
   470	        t
   471	      nil)))
   472	
   473	(defun greger-ui--set-syntax-highlighted (tool-use-node)
   474	  "Mark TOOL-USE-NODE as syntax highlighted with an overlay."
   475	  (condition-case nil
   476	      (let* ((node-start (treesit-node-start tool-use-node))
   477	             (overlay (make-overlay node-start (1+ node-start))))
   478	        (overlay-put overlay 'greger-ui-syntax-highlighted t)
   479	        (overlay-put overlay 'evaporate t)
   480	        overlay)
   481	    (treesit-node-outdated
   482	     ;; Node became outdated, likely due to buffer modification
   483	     ;; This can happen after str-replace diff content transformation
   484	     nil)))
   485	
   486	(defun greger-ui--tool-use-syntax-highlighting (tool-use-node _override start end)
   487	  "Font-lock function to transform tool content for syntax highlighting.
   488	
   489	TOOL-USE-NODE is the matched tree-sitter node for tool_use block.
   490	_OVERRIDE is ignored.  START and END define the fontification range.
   491	Expensive operations are deferred to idle time to avoid blocking scrolling."
   492	  (unless (greger-ui--syntax-highlighted-p tool-use-node)
   493	    (when-let ((tool-use-name (greger-parser--extract-tool-use-name tool-use-node)))
   494	      (cond
   495	       ((string= tool-use-name "str-replace")
   496	        (greger-ui--str-replace-syntax-highlighting tool-use-node start end))
   497	       ((member tool-use-name '("replace-file" "write-new-file"))
   498	        (greger-ui--file-syntax-highlighting tool-use-node))
   499	       (t nil)))
   500	    (greger-ui--set-syntax-highlighted tool-use-node)))
   501	
   502	(defun greger-ui--str-replace-syntax-highlighting (tool-use-node start end)
   503	  "Apply syntax highlighting to str-replace TOOL-USE-NODE from START to END."
   504	  (let* ((params (greger-parser--extract-tool-use-params tool-use-node))
   505	         (has-diff (alist-get 'diff params))
   506	         (has-original-new (and (alist-get 'original-content params)
   507	                                (alist-get 'new-content params))))
   508	    (cond
   509	     (has-diff
   510	      (greger-ui--apply-diff-syntax-highlighting tool-use-node start end))
   511	     (has-original-new
   512	      (greger-ui--apply-str-replace-diff-content tool-use-node start end))
   513	     (t nil))))
   514	
   515	(defun greger-ui--apply-str-replace-diff-content (tool-use-node _start _end)
   516	  "Apply diff overlay to str-replace TOOL-USE-NODE content.
   517	_START and _END are ignored font-lock parameters."
   518	  (let* ((params (greger-parser--extract-tool-use-params tool-use-node))
   519	         (original-content (alist-get 'original-content params))
   520	         (new-content (alist-get 'new-content params))
   521	         (path (alist-get 'path params))
   522	         (param-nodes (greger-parser--extract-tool-use-param-nodes tool-use-node))
   523	         (original-content-node (alist-get 'original-content param-nodes))
   524	         (new-content-node (alist-get 'new-content param-nodes))
   525	         (replace-start (treesit-node-start original-content-node))
   526	         (replace-end (treesit-node-end new-content-node))
   527	         (tool-use-id (greger-parser--extract-tool-id tool-use-node))
   528	         (diff-content (greger-ui--generate-diff-content original-content new-content path))
   529	         (wrapped-diff (greger-parser--wrapped-tool-param "diff" tool-use-id diff-content t))
   530	         (inhibit-read-only t))
   531	
   532	    ;; Replace buffer content with diff
   533	    (goto-char replace-start)
   534	    (delete-region replace-start replace-end)
   535	    (insert wrapped-diff)))
   536	
   537	(defun greger-ui--apply-diff-syntax-highlighting (tool-use-node _start _end)
   538	  "Apply syntax highlighting to existing diff content in str-replace TOOL-USE-NODE.
   539	_START and _END are ignored font-lock parameters."
   540	  (let* ((params (greger-parser--extract-tool-use-params tool-use-node))
   541	         (raw-diff-content (alist-get 'diff params))
   542	         (path (alist-get 'path params))
   543	         (undiff-result (greger-parser-undiff-strings raw-diff-content))
   544	         (original-content (car undiff-result))
   545	         (new-content (cdr undiff-result))
   546	         (param-nodes (greger-parser--extract-tool-use-param-nodes tool-use-node))
   547	         (diff-node (alist-get 'diff param-nodes))
   548	         (replace-start (treesit-node-start diff-node))
   549	         (replace-end (treesit-node-end diff-node))
   550	         (tool-use-id (greger-parser--extract-tool-id tool-use-node))
   551	         (diff-content (greger-ui--generate-diff-content original-content new-content path))
   552	         (wrapped-diff (greger-parser--wrapped-tool-param "diff" tool-use-id diff-content t))
   553	         (inhibit-read-only t))
   554	
   555	    ;; Replace buffer content with diff
   556	    (goto-char replace-start)
   557	    (delete-region replace-start replace-end)
   558	    (insert wrapped-diff)))
   559	
   560	(defun greger-ui--generate-diff-content (original new path)
   561	  "Generate diff content from ORIGINAL to NEW for PATH using diff.el."
   562	  (let* ((ext (or (file-name-extension path t) ""))
   563	         (original-file (make-temp-file "greger-original-" nil ext))
   564	         (new-file (make-temp-file "greger-new-" nil ext))
   565	         (diff-buffer (get-buffer-create "*greger-diff-temp*"))
   566	         (diff-refine nil)
   567	         (diff-switches '("-u" "-U" "100000")))
   568	
   569	    (unwind-protect
   570	        (progn
   571	          ;; Write content to temp files
   572	          (let ((coding-system-for-write 'raw-text))
   573	            (with-temp-file original-file
   574	              (insert original)))
   575	          (let ((coding-system-for-write 'raw-text))
   576	            (with-temp-file new-file
   577	              (insert new)))
   578	
   579	          ;; Set up the buffer to prevent dir-local variable issues
   580	          (with-current-buffer diff-buffer
   581	            (setq buffer-file-name nil)
   582	            (setq default-directory (temporary-file-directory)))
   583	
   584	          (diff-no-select original-file new-file nil t diff-buffer)
   585	          (with-current-buffer diff-buffer
   586	            ;; Ensure buffer is still alive before processing
   587	            (unless (buffer-live-p diff-buffer)
   588	              (error "Diff buffer was killed unexpectedly"))
   589	
   590	            ;; Ensure font-lock is active and force fontification
   591	            (font-lock-ensure (point-min) (point-max))
   592	
   593	            ;; Turn off read-only mode and we'll do operations on the
   594	            ;; fontified text
   595	            (setq buffer-read-only nil)
   596	
   597	            ;; Convert 'face to 'font-lock-face for tree-sitter compatibility
   598	            (greger-ui--convert-faces-for-tree-sitter)
   599	
   600	            ;; Remove headers/footers inserted by the diff command and diff.el
   601	            (greger-ui--remove-diff-headers)
   602	
   603	            ;; Make diff indicators (space, minus, plus) less prominent
   604	            (greger-ui--diff-make-newline-messages-smaller)
   605	
   606	            (buffer-string)))
   607	
   608	      ;; Cleanup temp files
   609	      (when (file-exists-p original-file) (delete-file original-file))
   610	      (when (file-exists-p new-file) (delete-file new-file))
   611	      (when (buffer-live-p diff-buffer)
   612	        (kill-buffer diff-buffer)))))
   613	
   614	(defun greger-ui--convert-faces-for-tree-sitter ()
   615	  "Convert \='face text properties and overlay faces to \='font-lock-face.
   616	This is needed for tree-sitter compatibility."
   617	  (let* ((background-mode (frame-parameter nil 'background-mode))
   618	         (is-dark-theme (eq background-mode 'dark))
   619	         (red-bg (if is-dark-theme "#32171E" "#ffe6e6")) ; Dark red vs light red
   620	         (green-bg (if is-dark-theme "#173714" "#e6ffe6"))) ; Dark green vs light green
   621	
   622	    ;; First pass: Set background on all characters in diff lines
   623	    (save-excursion
   624	      (goto-char (point-min))
   625	      (while (not (eobp))
   626	        (let* ((line-start (line-beginning-position))
   627	               (line-end (line-end-position))
   628	               (line-start-char (char-after line-start)))
   629	          (cond
   630	           ;; Lines starting with - get red background
   631	           ((eq line-start-char ?-)
   632	            (put-text-property (1+ line-start) line-end 'font-lock-face
   633	                               (list :background red-bg)))
   634	           ;; Lines starting with + get green background
   635	           ((eq line-start-char ?+)
   636	            (put-text-property (1+ line-start) line-end 'font-lock-face
   637	                               (list :background green-bg))))
   638	          (forward-line 1))))
   639	
   640	    ;; Second pass: Convert overlays with 'face property (syntax highlighting overlays)
   641	    (dolist (overlay (overlays-in (point-min) (point-max)))
   642	      (when-let* ((face (overlay-get overlay 'face))
   643	                  (face-attrs (greger-ui--get-face-attributes face))
   644	                  (start (overlay-start overlay))
   645	                  (end (overlay-end overlay)))
   646	
   647	        ;; Check if this overlay spans any diff lines and modify background accordingly
   648	        (save-excursion
   649	          (goto-char start)
   650	          (while (< (point) end)
   651	            (let* ((line-start (line-beginning-position))
   652	                   (line-end (min (line-end-position) end))
   653	                   (overlay-start-in-line (max start line-start))
   654	                   (overlay-end-in-line (min end (1+ line-end)))
   655	                   (line-start-char (char-after line-start)))
   656	
   657	              (cond
   658	               ;; Lines starting with - get red background
   659	               ((eq line-start-char ?-)
   660	                (plist-put face-attrs :background red-bg)
   661	                (put-text-property overlay-start-in-line overlay-end-in-line
   662	                                   'font-lock-face face-attrs))
   663	               ;; Lines starting with + get green background
   664	               ((eq line-start-char ?+)
   665	                (plist-put face-attrs :background green-bg)
   666	                (put-text-property overlay-start-in-line overlay-end-in-line
   667	                                   'font-lock-face face-attrs))
   668	               ;; Other lines get just the overlay face
   669	               (t
   670	                (put-text-property overlay-start-in-line overlay-end-in-line
   671	                                   'font-lock-face face))))
   672	            (forward-line 1))))))
   673	
   674	  ;; Mark as fontified to prevent re-fontification
   675	  (add-text-properties (point-min) (point-max) '(fontified t)))
   676	
   677	(defun greger-ui--get-face-attributes (face)
   678	  "Get all non-unspecified attributes of FACE as a plist."
   679	  (let ((attrs '(:family :foundry :width :height :weight :slant
   680	                         :underline :overline :strike-through :box
   681	                         :inverse-video :foreground :background
   682	                         :stipple :font :inherit))
   683	        result)
   684	    ;; If face is a list, use the first element,
   685	    ;; otheriwse face-attribute will error
   686	    (when (listp face)
   687	      (setq face (car face)))
   688	    (dolist (attr attrs)
   689	      (let ((value (face-attribute face attr nil t)))
   690	        (when (not (eq value 'unspecified))
   691	          (setq result (plist-put result attr value)))))
   692	
   693	    result))
   694	
   695	(defun greger-ui--remove-diff-headers ()
   696	  "Process diff output, remove headers and apply syntax highlighting."
   697	  (goto-char (point-min))
   698	  (when (looking-at "^diff -u")
   699	    (delete-region (point) (progn (forward-line 1) (point))))
   700	  (when (looking-at "^--- ")
   701	    (delete-region (point) (progn (forward-line 1) (point))))
   702	  (when (looking-at "^\\+\\+\\+ ")
   703	    (delete-region (point) (progn (forward-line 1) (point))))
   704	
   705	  ;; Remove hunk headers (@@ lines)
   706	  (goto-char (point-min))
   707	  (while (re-search-forward "^@@.*@@\\s-*\n" nil t)
   708	    (replace-match ""))
   709	
   710	  (goto-char (point-max))
   711	  (re-search-backward "\nDiff finished" nil t)
   712	  (delete-region (point) (point-max)))
   713	
   714	(defun greger-ui--diff-make-newline-messages-smaller ()
   715	  "Apply visual de-emphasis to diff indicators.
   716	Makes indicators small and muted while keeping them readable."
   717	  ;; Make "\ No newline at end of file" messages less prominent
   718	  (goto-char (point-min))
   719	  (while (re-search-forward "^\\\\ No newline at end of file$" nil t)
   720	    (put-text-property (line-beginning-position) (1+ (line-end-position))
   721	                       'font-lock-face '(:height 0.6 :foreground "gray50"))))
   722	
   723	(defun greger-ui--file-syntax-highlighting (tool-use-node)
   724	  "Apply syntax highlighting to TOOL-USE-NODE content based on file path."
   725	  (when-let* ((params (greger-parser--extract-tool-use-params tool-use-node))
   726	              (param-nodes (greger-parser--extract-tool-use-param-nodes tool-use-node))
   727	              (path (alist-get 'path params))
   728	              (contents-node (alist-get 'contents param-nodes))
   729	              (start (treesit-node-start contents-node))
   730	              (end (treesit-node-end contents-node))
   731	              (text (treesit-node-text contents-node)))
   732	    (greger-ui--syntax-highlight-text start end text path)))
   733	
   734	;; Tool result syntax highlighting
   735	
   736	(defun greger-ui--tool-result-syntax-highlighting (tool-result-node _override _start _end)
   737	  "Apply syntax highlighting to TOOL-RESULT-NODE based on corresponding tool use.
   738	_OVERRIDE, _START, and _END are font-lock parameters."
   739	  (unless (or (greger-ui--syntax-highlighted-p tool-result-node)
   740	              (get-text-property (treesit-node-start tool-result-node) 'greger-tool-result-generating))
   741	    (when-let* ((tool-use-node (greger-ui--find-corresponding-tool-use tool-result-node))
   742	                (tool-name (greger-parser--extract-tool-use-name tool-use-node))
   743	                (content-node (treesit-search-subtree tool-result-node "content"))
   744	                (start (treesit-node-start content-node))
   745	                (end (treesit-node-end content-node))
   746	                (text (treesit-node-text content-node))
   747	                (tool-use-params (greger-parser--extract-tool-use-params tool-use-node)))
   748	
   749	      (cond
   750	       ((string= tool-name "read-file")
   751	        (when-let ((path (alist-get 'path tool-use-params)))
   752	          (greger-ui--syntax-highlight-text start end text path)))
   753	       (t nil)))
   754	    (greger-ui--set-syntax-highlighted tool-result-node)))
   755	
   756	(defun greger-ui--find-corresponding-tool-use (tool-result-node)
   757	  "Find the tool_use node that corresponds to TOOL-RESULT-NODE by matching IDs."
   758	  (when-let* ((tool-result-id (greger-parser--extract-tool-id tool-result-node))
   759	              (prev-node (treesit-node-prev-sibling tool-result-node))
   760	              ((string= (treesit-node-type prev-node) "tool_use"))
   761	              (tool-use-node prev-node)
   762	              (tool-use-id (greger-parser--extract-tool-id tool-use-node))
   763	              ((string= tool-use-id tool-result-id)))
   764	    tool-use-node))
   765	
   766	(defun greger-ui--syntax-highlight-text (start end content path)
   767	  "Apply syntax highlighting to CONTENT between START and END based on FILE-PATH."
   768	  ;; Skip highlighting for very long content to avoid performance issues
   769	  (when (and (< (length content) 50000)
   770	             (not (string-suffix-p ".greger" path)))
   771	    ;; Create a temporary buffer to get proper syntax highlighting
   772	    (let ((temp-buffer (generate-new-buffer "*greger-syntax-temp*"))
   773	          (original-buffer (current-buffer)))
   774	      (unwind-protect
   775	          (with-current-buffer temp-buffer
   776	            ;; Insert content and set buffer-file-name for major mode detection
   777	            (insert content)
   778	
   779	            ;; Let Emacs determine the major mode based on the file name
   780	            ;; Don't run hooks that might assume buffer-file-name really associates buffer with a file
   781	            (let ((enable-local-variables nil)
   782	                  (buffer-file-name path))
   783	              (delay-mode-hooks (set-auto-mode)))
   784	
   785	            ;; Enable font-lock and force fontification
   786	            (font-lock-mode 1)
   787	            (font-lock-ensure (point-min) (point-max))
   788	
   789	            ;; Copy the font-lock-face properties to the original buffer
   790	            (let ((temp-start (point-min))
   791	                  (temp-end (point-max))
   792	                  (original-pos start))
   793	
   794	              (while (< temp-start temp-end)
   795	                (let* ((next-change (or (next-single-property-change temp-start 'face (current-buffer) temp-end)
   796	                                        temp-end))
   797	                       (face (get-text-property temp-start 'face))
   798	                       (len (- next-change temp-start)))
   799	
   800	                  (when face
   801	                    ;; Apply the face to the corresponding position in the original buffer
   802	                    (with-current-buffer original-buffer
   803	                      (put-text-property original-pos (min (+ original-pos len) end) 'font-lock-face face)))
   804	
   805	                  (setq temp-start next-change
   806	                        original-pos (+ original-pos len))))))
   807	
   808	        ;; Clean up temp buffer
   809	        (with-current-buffer temp-buffer
   810	          (set-buffer-modified-p nil)
   811	          (kill-buffer))))))
   812	
   813	
   814	(provide 'greger-ui)
   815	;;; greger-ui.el ends here
   816	 

---------



# greger-web.el:

     1	;;; greger-web.el --- Web content handling for greger -*- lexical-binding: t -*-
     2	
     3	;; Copyright (C) 2025 Andreas Jansson
     4	
     5	;; Author: Andreas Jansson <andreas@jansson.me.uk>
     6	;; Version: 0.1.0
     7	;; URL: https://github.com/andreasjansson/greger.el
     8	;; SPDX-License-Identifier: MIT
     9	
    10	;; Permission is hereby granted, free of charge, to any person obtaining a copy
    11	;; of this software and associated documentation files (the "Software"), to deal
    12	;; in the Software without restriction, including without limitation the rights
    13	;; to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
    14	;; copies of the Software, and to permit persons to whom the Software is
    15	;; furnished to do so, subject to the following conditions:
    16	
    17	;; The above copyright notice and this permission notice shall be included in all
    18	;; copies or substantial portions of the Software.
    19	
    20	;; THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    21	;; IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    22	;; FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    23	;; AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    24	;; LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
    25	;; OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
    26	;; SOFTWARE.
    27	
    28	;;; Commentary:
    29	;; Functions for downloading web content and extracting text from URLs.
    30	
    31	;;; Code:
    32	
    33	(require 'url)
    34	(require 'dom)
    35	(require 'eww)
    36	
    37	(defun greger-web-text-from-url (url &optional use-highest-readability)
    38	  "Retrieve the text content from URL.
    39	If USE-HIGHEST-READABILITY is non-nil, use eww's readability heuristics."
    40	  (with-current-buffer
    41	      (url-retrieve-synchronously url t nil 10.0)
    42	    ;; Skip HTTP headers - they end with a double newline
    43	    (goto-char (point-min))
    44	    (when (re-search-forward "\r?\n\r?\n" nil t)
    45	      (delete-region (point-min) (point)))
    46	
    47	    ;; Parse the HTML content
    48	    (let ((dom (libxml-parse-html-region (point-min) (point-max))))
    49	      (when use-highest-readability
    50	        (setq dom (eww-highest-readability dom))
    51	        (eww-score-readability dom))
    52	      (greger-web-dom-texts-inline-aware dom))))
    53	
    54	(defun greger-web-dom-texts-inline-aware (node &optional block-separator inline-separator)
    55	  "Extract text from the DOM NODE, aware of inline and block elements.
    56	BLOCK-SEPARATOR separates block elements.
    57	INLINE-SEPARATOR separates inline elements."
    58	  (let ((block-separator (or block-separator "\n"))
    59	        (inline-separator (or inline-separator " ")))
    60	    (mapconcat
    61	     (lambda (elem)
    62	       (cond
    63	        ((stringp elem)
    64	         (when (> (length (string-trim elem)) 0)
    65	           elem))
    66	        ((memq (dom-tag elem) '(head meta script style details footer)) "")
    67	        ((memq (dom-tag elem) '(p div h1 h2 h3 h4 h5 h6 pre br hr ul ol li))
    68	         (concat (greger-web-dom-texts-inline-aware elem block-separator inline-separator)
    69	                 block-separator))
    70	        (t
    71	         (greger-web-dom-texts-inline-aware elem block-separator inline-separator))))
    72	     (dom-children node)
    73	     inline-separator)))
    74	
    75	(defun greger-web-is-web-url-p (path)
    76	  "Return non-nil if PATH is a web URL (starts with http:// or https://)."
    77	  (or (string-prefix-p "http://" path)
    78	      (string-prefix-p "https://" path)))
    79	
    80	(defun greger-web-download-page (url &optional extract-text use-highest-readability)
    81	  "Download webpage from URL and optionally extract text.
    82	If EXTRACT-TEXT is non-nil (default t), extract and return text content.
    83	If EXTRACT-TEXT is nil, return raw HTML.
    84	If USE-HIGHEST-READABILITY is non-nil, use eww's aggressive readability setting."
    85	  (if extract-text
    86	      (greger-web-text-from-url url use-highest-readability)
    87	    ;; Return raw HTML
    88	    (with-current-buffer
    89	        (url-retrieve-synchronously url t nil 10.0)
    90	      ;; Skip HTTP headers - they end with a double newline
    91	      (goto-char (point-min))
    92	      (when (re-search-forward "\r?\n\r?\n" nil t)
    93	        (delete-region (point-min) (point)))
    94	      (buffer-string))))
    95	
    96	(provide 'greger-web)
    97	
    98	;;; greger-web.el ends here

