# greger-openrouter.el:

     1	;;; greger-openrouter.el --- OpenRouter client for greger -*- lexical-binding: t -*-
     2	
     3	;; Copyright (C) 2025 Andreas Jansson
     4	
     5	;; Author: Andreas Jansson <andreas@jansson.me.uk>
     6	;; Version: 0.1.0
     7	;; URL: https://github.com/andreasjansson/greger.el
     8	;; SPDX-License-Identifier: MIT
     9	
    10	;;; Commentary:
    11	;; OpenRouter API client for greger - provides access to 400+ models including
    12	;; GPT-5, GPT-5 Codex, and others through OpenRouter's unified API.
    13	
    14	;;; Code:
    15	
    16	(require 'json)
    17	(require 'cl-lib)
    18	
    19	(defconst greger-openrouter-api-url "https://openrouter.ai/api/v1/chat/completions"
    20	  "OpenRouter API endpoint.")
    21	
    22	(cl-defstruct greger-openrouter-state
    23	  accumulated-output
    24	  current-tool-calls
    25	  current-text
    26	  thinking-started
    27	  text-started
    28	  annotations
    29	  process
    30	  output-buffer
    31	  undo-handle
    32	  block-start-callback
    33	  text-delta-callback
    34	  block-stop-callback
    35	  complete-callback
    36	  restore-callback
    37	  error-callback
    38	  error-message)
    39	
    40	(cl-defun greger-openrouter-stream (&key model dialog tools buffer enable-web-search block-start-callback text-delta-callback block-stop-callback complete-callback thinking-budget max-tokens auth-key error-callback)
    41	  "Stream request to OpenRouter API.
    42	MODEL is the OpenRouter model identifier.
    43	DIALOG is the conversation history.
    44	TOOLS are tool definitions.
    45	BUFFER is the output buffer.
    46	ENABLE-WEB-SEARCH determines if we append :online to the model.
    47	BLOCK-START-CALLBACK is called when content blocks begin.
    48	TEXT-DELTA-CALLBACK for incremental text.
    49	BLOCK-STOP-CALLBACK when blocks complete.
    50	COMPLETE-CALLBACK when the entire response finishes.
    51	THINKING-BUDGET is the number of thinking tokens.
    52	MAX-TOKENS is the maximum number of tokens to generate.
    53	AUTH-KEY is the OpenRouter API key.
    54	ERROR-CALLBACK is called when errors occur."
    55	  (let* ((output-buffer (or buffer (current-buffer)))
    56	         (undo-handle (prepare-change-group output-buffer))
    57	         (request-spec (greger-openrouter--build-request model dialog tools thinking-budget max-tokens auth-key enable-web-search))
    58	         (restore-callback (lambda (state)
    59	                             (let ((buffer (greger-openrouter-state-output-buffer state)))
    60	                               (when (buffer-live-p buffer)
    61	                                 (with-current-buffer buffer
    62	                                   (undo-amalgamate-change-group (greger-openrouter-state-undo-handle state))
    63	                                   (accept-change-group (greger-openrouter-state-undo-handle state)))))))
    64	         (process (greger-openrouter--start-curl-process request-spec))
    65	         (state (make-greger-openrouter-state
    66	                 :accumulated-output ""
    67	                 :current-tool-calls (make-hash-table :test 'equal)
    68	                 :current-text ""
    69	                 :process process
    70	                 :block-start-callback block-start-callback
    71	                 :text-delta-callback text-delta-callback
    72	                 :block-stop-callback block-stop-callback
    73	                 :complete-callback complete-callback
    74	                 :restore-callback restore-callback
    75	                 :output-buffer output-buffer
    76	                 :undo-handle undo-handle
    77	                 :error-callback error-callback)))
    78	    
    79	    (activate-change-group undo-handle)
    80	    
    81	    (set-process-filter process
    82	                        (lambda (_proc output)
    83	                          (greger-openrouter--process-output-chunk output state)))
    84	    
    85	    (set-process-sentinel process
    86	                          (lambda (proc _event)
    87	                            (greger-openrouter--handle-completion proc state)))
    88	    
    89	    (set-process-query-on-exit-flag process nil)
    90	    
    91	    state))
    92	
    93	(defun greger-openrouter--build-request (model dialog tools thinking-budget max-tokens auth-key enable-web-search)
    94	  "Build OpenRouter API request."
    95	  (let* ((headers (greger-openrouter--build-headers auth-key))
    96	         (data (greger-openrouter--build-data model dialog tools thinking-budget max-tokens enable-web-search)))
    97	    (message "url: %s; request data: %s" greger-openrouter-api-url data)
    98	    (list :url greger-openrouter-api-url
    99	          :method "POST"
   100	          :headers headers
   101	          :data data)))
   102	
   103	(defun greger-openrouter--build-headers (api-key)
   104	  "Build OpenRouter headers - Bearer auth."
   105	  `(("Content-Type" . "application/json")
   106	    ("Authorization" . ,(concat "Bearer " api-key))
   107	    ("HTTP-Referer" . "https://github.com/andreasjansson/greger.el")
   108	    ("X-Title" . "Greger.el")))
   109	
   110	(defun greger-openrouter--build-data (model dialog tools thinking-budget max-tokens enable-web-search)
   111	  "Build OpenRouter request data in OpenAI format."
   112	  (let* ((messages (greger-openrouter--convert-dialog-to-messages dialog))
   113	         (actual-model (if enable-web-search
   114	                           (concat model ":online")
   115	                         model))
   116	         (request-data `(("model" . ,actual-model)
   117	                         ("max_tokens" . ,max-tokens)
   118	                         ("stream" . t))))
   119	    
   120	    (push `("messages" . ,messages) request-data)
   121	    
   122	    (when tools
   123	      (let ((converted-tools (greger-openrouter--convert-tools tools)))
   124	        (push `("tools" . ,converted-tools) request-data)
   125	        (push `("tool_choice" . "auto") request-data)))
   126	    
   127	    (when (and thinking-budget (> thinking-budget 0))
   128	      (push `("reasoning" . (("max_tokens" . ,thinking-budget))) request-data)
   129	      (push `("include_reasoning" . t) request-data))
   130	    
   131	    (json-encode request-data)))
   132	
   133	(defun greger-openrouter--convert-dialog-to-messages (dialog)
   134	  "Convert Greger dialog format to OpenAI message format."
   135	  (let (messages
   136	        system-message)
   137	    (dolist (msg dialog)
   138	      (let ((role (alist-get 'role msg))
   139	            (content (alist-get 'content msg)))
   140	        
   141	        (cond
   142	         ((string= role "system")
   143	          (setq system-message content))
   144	         
   145	         ((stringp content)
   146	          (push `((role . ,role) (content . ,content)) messages))
   147	         
   148	         ((listp content)
   149	          (let ((converted (greger-openrouter--convert-content-blocks role content)))
   150	            (when converted
   151	              (setq messages (append converted messages))))))))
   152	    
   153	    (let ((result (nreverse messages)))
   154	      (when system-message
   155	        (setq result (cons `((role . "system") (content . ,system-message)) result)))
   156	      result)))
   157	
   158	(defun greger-openrouter--convert-content-blocks (role content-blocks)
   159	  "Convert Anthropic content blocks to OpenAI format."
   160	  (let (result-messages
   161	        current-text
   162	        tool-calls)
   163	    
   164	    (dolist (block content-blocks)
   165	      (let ((type (alist-get 'type block)))
   166	        (cond
   167	         ((string= type "text")
   168	          (setq current-text (alist-get 'text block)))
   169	         
   170	         ((string= type "thinking")
   171	          (setq current-text (alist-get 'thinking block)))
   172	         
   173	         ((string= type "tool_use")
   174	          (let ((tool-call `((id . ,(alist-get 'id block))
   175	                             (type . "function")
   176	                             (function . ((name . ,(alist-get 'name block))
   177	                                          (arguments . ,(json-encode (alist-get 'input block))))))))
   178	            (push tool-call tool-calls)))
   179	         
   180	         ((string= type "tool_result")
   181	          (let ((tool-msg `((role . "tool")
   182	                            (tool_call_id . ,(alist-get 'tool_use_id block))
   183	                            (content . ,(alist-get 'content block)))))
   184	            (push tool-msg result-messages))))))
   185	    
   186	    (when (or current-text tool-calls)
   187	      (let ((msg `((role . ,role))))
   188	        (when current-text
   189	          (push `(content . ,current-text) msg))
   190	        (when tool-calls
   191	          (push `(tool_calls . ,(vconcat (nreverse tool-calls))) msg))
   192	        (push msg result-messages)))
   193	    
   194	    (nreverse result-messages)))
   195	
   196	(defun greger-openrouter--convert-tools (tools)
   197	  "Convert Anthropic tool format to OpenAI function calling format.
   198	OpenAI doesn't support 'default' values in parameters, so we strip them.
   199	Also ensures 'required' is always a vector (array in JSON) not null."
   200	  (mapcar
   201	   (lambda (tool)
   202	     (let* ((input-schema (alist-get 'input_schema tool))
   203	            (cleaned-schema (greger-openrouter--remove-defaults-from-schema input-schema))
   204	            (fixed-schema (greger-openrouter--fix-required-field cleaned-schema)))
   205	       `((type . "function")
   206	         (function . ((name . ,(alist-get 'name tool))
   207	                      (description . ,(alist-get 'description tool))
   208	                      (parameters . ,fixed-schema))))))
   209	   tools))
   210	
   211	(defun greger-openrouter--fix-required-field (schema)
   212	  "Ensure the 'required' field is always a vector, not nil.
   213	OpenAI expects 'required' to be an array, even if empty."
   214	  (if (not (listp schema))
   215	      schema
   216	    (mapcar
   217	     (lambda (entry)
   218	       (if (and (consp entry) (eq (car entry) 'required))
   219	           ;; Convert nil or empty list to empty vector
   220	           (cons 'required (if (cdr entry)
   221	                               (if (vectorp (cdr entry))
   222	                                   (cdr entry)
   223	                                 (vconcat (cdr entry)))
   224	                             []))
   225	         (if (consp entry)
   226	             (cons (car entry)
   227	                   (greger-openrouter--fix-required-field (cdr entry)))
   228	           entry)))
   229	     schema)))
   230	
   231	(defun greger-openrouter--remove-defaults-from-schema (schema)
   232	  "Remove 'default' keys from SCHEMA recursively.
   233	OpenAI function calling doesn't support default values."
   234	  (cond
   235	   ((not (consp schema)) schema)
   236	   
   237	   ;; Check if this is an alist (list of cons cells)
   238	   ((and (listp schema) (consp (car schema)))
   239	    ;; This is an alist - filter out 'default' keys
   240	    (let ((filtered (seq-filter
   241	                     (lambda (pair)
   242	                       (not (eq (car pair) 'default)))
   243	                     schema)))
   244	      ;; Recursively process values
   245	      (mapcar (lambda (pair)
   246	                (cons (car pair)
   247	                      (greger-openrouter--remove-defaults-from-schema (cdr pair))))
   248	              filtered)))
   249	   
   250	   ;; Regular list - process each element
   251	   ((listp schema)
   252	    (mapcar #'greger-openrouter--remove-defaults-from-schema schema))
   253	   
   254	   ;; Cons cell - process both parts
   255	   ((consp schema)
   256	    (cons (greger-openrouter--remove-defaults-from-schema (car schema))
   257	          (greger-openrouter--remove-defaults-from-schema (cdr schema))))
   258	   
   259	   ;; Atom - return as-is
   260	   (t schema)))
   261	
   262	(defun greger-openrouter--process-output-chunk (output state)
   263	  "Process streaming output chunk."
   264	  (setf (greger-openrouter-state-accumulated-output state)
   265	        (concat (greger-openrouter-state-accumulated-output state) output))
   266	  
   267	  (greger-openrouter--process-events state))
   268	
   269	(defun greger-openrouter--process-events (state)
   270	  "Process OpenAI-style SSE events."
   271	  (let ((accumulated (greger-openrouter-state-accumulated-output state)))
   272	    
   273	    (while (string-match "\n" accumulated)
   274	      (let* ((line-end (match-end 0))
   275	             (line (substring accumulated 0 (1- line-end))))
   276	        
   277	        (when (string-prefix-p "data: " line)
   278	          (let ((data-json (substring line 6)))
   279	            (unless (string= data-json "[DONE]")
   280	              (greger-openrouter--handle-event data-json state))))
   281	        
   282	        (setq accumulated (substring accumulated line-end))))
   283	    
   284	    (setf (greger-openrouter-state-accumulated-output state) accumulated)))
   285	
   286	(defun greger-openrouter--handle-event (data-json state)
   287	  "Handle OpenAI-style streaming event."
   288	
   289	  (message "data-json: %s" data-json)
   290	
   291	  (condition-case err
   292	      (let* ((data (json-read-from-string data-json))
   293	             (error-data (alist-get 'error data)))
   294	        
   295	        ;; Check for API errors first
   296	        (when error-data
   297	          (let ((error-message (format "OpenRouter API error: %s" 
   298	                                       (or (alist-get 'message error-data)
   299	                                           (json-encode error-data)))))
   300	            (setf (greger-openrouter-state-error-message state) error-message)
   301	            (message "OpenRouter error: %s" error-message)
   302	            (error error-message)))
   303	        
   304	        (let* ((choices (alist-get 'choices data))
   305	               (choice (when choices (aref choices 0)))
   306	               (delta (alist-get 'delta choice))
   307	               (message (alist-get 'message choice))
   308	               (finish-reason (alist-get 'finish_reason choice)))
   309	          
   310	          (when delta
   311	            (cond
   312	             ((alist-get 'content delta)
   313	              (let ((text (alist-get 'content delta))
   314	                    (block-start-callback (greger-openrouter-state-block-start-callback state))
   315	                    (text-delta-callback (greger-openrouter-state-text-delta-callback state)))
   316	                
   317	                (unless (greger-openrouter-state-text-started state)
   318	                  (setf (greger-openrouter-state-text-started state) t)
   319	                  (when block-start-callback
   320	                    (funcall block-start-callback
   321	                             `((type . "text")
   322	                               (text . "")))))
   323	                
   324	                (setf (greger-openrouter-state-current-text state)
   325	                      (concat (greger-openrouter-state-current-text state) text))
   326	                (when text-delta-callback
   327	                  (funcall text-delta-callback text))))
   328	             
   329	             ((alist-get 'reasoning delta)
   330	              (greger-openrouter--handle-reasoning-delta delta state))
   331	             
   332	             ((alist-get 'tool_calls delta)
   333	              (greger-openrouter--accumulate-tool-calls delta state))))
   334	          
   335	          (when (and message (alist-get 'annotations message))
   336	            (setf (greger-openrouter-state-annotations state)
   337	                  (alist-get 'annotations message)))
   338	          
   339	          (when finish-reason
   340	            (greger-openrouter--handle-finish state finish-reason))))
   341	    (error
   342	     (let ((error-message (format "Failed to parse event: %s" (error-message-string err))))
   343	       (setf (greger-openrouter-state-error-message state) error-message)
   344	       (message "OpenRouter parse error: %s" error-message)))))
   345	
   346	(defun greger-openrouter--handle-reasoning-delta (delta state)
   347	  "Handle reasoning/thinking delta and convert to Greger thinking format."
   348	  (let ((reasoning-text (alist-get 'reasoning delta))
   349	        (block-start-callback (greger-openrouter-state-block-start-callback state))
   350	        (text-delta-callback (greger-openrouter-state-text-delta-callback state)))
   351	    
   352	    (unless (greger-openrouter-state-thinking-started state)
   353	      (setf (greger-openrouter-state-thinking-started state) t)
   354	      (when block-start-callback
   355	        (funcall block-start-callback
   356	                 `((type . "thinking")
   357	                   (thinking . "")
   358	                   (signature . "")))))
   359	    
   360	    (when (and reasoning-text text-delta-callback)
   361	      (funcall text-delta-callback reasoning-text))))
   362	
   363	(defun greger-openrouter--accumulate-tool-calls (delta state)
   364	  "Accumulate tool call deltas."
   365	  (let ((tool-calls (alist-get 'tool_calls delta))
   366	        (accumulated (greger-openrouter-state-current-tool-calls state)))
   367	    
   368	    (when tool-calls
   369	      (seq-doseq (call tool-calls)
   370	        (let* ((index (alist-get 'index call))
   371	               (id (alist-get 'id call))
   372	               (function-delta (alist-get 'function call))
   373	               (name (alist-get 'name function-delta))
   374	               (arguments (alist-get 'arguments function-delta))
   375	               (existing (gethash index accumulated)))
   376	          
   377	          (if existing
   378	              (let ((existing-args (alist-get 'arguments existing)))
   379	                (setf (alist-get 'arguments existing)
   380	                      (concat existing-args arguments)))
   381	            (puthash index
   382	                     `((id . ,id)
   383	                       (name . ,name)
   384	                       (arguments . ,arguments))
   385	                     accumulated)))))))
   386	
   387	(defun greger-openrouter--handle-finish (state finish-reason)
   388	  "Handle completion based on finish reason."
   389	  (when-let ((callback (greger-openrouter-state-complete-callback state)))
   390	    (funcall callback (greger-openrouter--build-content-blocks state))))
   391	
   392	(defun greger-openrouter--build-content-blocks (state)
   393	  "Build Anthropic-style content blocks from accumulated state."
   394	  (let ((tool-calls (greger-openrouter-state-current-tool-calls state))
   395	        (annotations (greger-openrouter-state-annotations state))
   396	        blocks)
   397	    
   398	    (when (> (hash-table-count tool-calls) 0)
   399	      (maphash
   400	       (lambda (_index call)
   401	         (let* ((id (alist-get 'id call))
   402	                (name (alist-get 'name call))
   403	                (arguments (alist-get 'arguments call))
   404	                (parsed-args (condition-case nil
   405	                                 (json-read-from-string arguments)
   406	                               (error '()))))
   407	           (push `((type . "tool_use")
   408	                   (id . ,id)
   409	                   (name . ,name)
   410	                   (input . ,parsed-args))
   411	                 blocks)))
   412	       tool-calls))
   413	    
   414	    (when annotations
   415	      (let ((citations (seq-filter
   416	                        (lambda (annotation)
   417	                          (string= (alist-get 'type annotation) "url_citation"))
   418	                        annotations)))
   419	        (when citations
   420	          (push `((type . "text")
   421	                  (text . "")
   422	                  (citations . ,(mapcar #'greger-openrouter--convert-annotation-to-citation citations)))
   423	                blocks))))
   424	    
   425	    (nreverse blocks)))
   426	
   427	(defun greger-openrouter--convert-annotation-to-citation (annotation)
   428	  "Convert OpenRouter annotation to Greger citation format."
   429	  `((type . "web_search_result_location")
   430	    (url . ,(alist-get 'url annotation))
   431	    (title . ,(or (alist-get 'title annotation) ""))
   432	    (cited_text . ,(or (alist-get 'text annotation) ""))
   433	    (encrypted_index . "")))
   434	
   435	(defun greger-openrouter--handle-completion (proc state)
   436	  "Handle process completion."
   437	  (when (memq (process-status proc) '(exit signal))
   438	    (funcall (greger-openrouter-state-restore-callback state) state)
   439	    
   440	    (let ((exit-code (process-exit-status proc))
   441	          (stored-error (greger-openrouter-state-error-message state)))
   442	      (cond
   443	       ((and (= exit-code 0) (not stored-error))
   444	        (when-let ((callback (greger-openrouter-state-complete-callback state)))
   445	          (funcall callback (greger-openrouter--build-content-blocks state))))
   446	       
   447	       ((= exit-code 2)
   448	        (message "Process interrupted"))
   449	       
   450	       (t
   451	        (let ((error-message (or stored-error
   452	                                 (format "Process exited with status code %d" exit-code))))
   453	          (when-let ((callback (greger-openrouter-state-error-callback state)))
   454	            (funcall callback error-message))))))))
   455	
   456	(defun greger-openrouter--start-curl-process (request-spec)
   457	  "Start curl process for OpenRouter."
   458	  (start-process-shell-command
   459	   "greger-openrouter-curl" nil
   460	   (greger-openrouter--build-curl-command request-spec)))
   461	
   462	(defun greger-openrouter--build-curl-command (request-spec)
   463	  "Build curl command for OpenRouter."
   464	  (let ((url (plist-get request-spec :url))
   465	        (method (plist-get request-spec :method))
   466	        (headers (plist-get request-spec :headers))
   467	        (data (plist-get request-spec :data)))
   468	    (format "curl -s -X %s %s %s %s"
   469	            method
   470	            (mapconcat (lambda (header)
   471	                         (format "-H \"%s: %s\"" (car header) (cdr header)))
   472	                       headers " ")
   473	            (if data
   474	                (format "--data-raw %s" (shell-quote-argument data))
   475	              "")
   476	            url)))
   477	
   478	(defun greger-openrouter--cancel-request (state)
   479	  "Cancel streaming request."
   480	  (let ((process (greger-openrouter-state-process state)))
   481	    (when (process-live-p process)
   482	      (message "Interrupting generation")
   483	      (interrupt-process process)
   484	      (sit-for 0.1)
   485	      (delete-process process))
   486	    (funcall (greger-openrouter-state-restore-callback state) state)))
   487	
   488	(provide 'greger-openrouter)
   489	
   490	;;; greger-openrouter.el ends here

---------



# greger-parser.el:

     1	;;; greger-parser.el --- Parser for greger dialog format -*- lexical-binding: t -*-
     2	
     3	;; Copyright (C) 2025 Andreas Jansson
     4	
     5	;; Author: Andreas Jansson <andreas@jansson.me.uk>
     6	;; Version: 0.1.0
     7	;; URL: https://github.com/andreasjansson/greger.el
     8	;; SPDX-License-Identifier: MIT
     9	
    10	;; Permission is hereby granted, free of charge, to any person obtaining a copy
    11	;; of this software and associated documentation files (the "Software"), to deal
    12	;; in the Software without restriction, including without limitation the rights
    13	;; to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
