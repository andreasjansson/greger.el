    23	;; IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    24	;; FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    25	;; AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    26	;; LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
    27	;; OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
    28	;; SOFTWARE.
    29	
    30	;;; Commentary:
    31	;; Agentic coding environment using Claude and a suite of built-in tools.
    32	;; Capable of viewing and editing files, searching code, listing files,
    33	;; searching the web and downloading web pages.  Extensible with custom
    34	;; tools defined in Emacs Lisp.
    35	
    36	;;; Code:
    37	
    38	(require 'cl-lib)
    39	(require 'json)
    40	(require 'treesit)
    41	
    42	(require 'greger-client)
    43	(require 'greger-parser)
    44	(require 'greger-tools)
    45	(require 'greger-stdlib)
    46	(require 'greger-ui)
    47	(require 'greger-prompt)
    48	
    49	;; Eval functionality
    50	(defconst greger-available-models
    51	  '(claude-sonnet-4-20250514
    52	    claude-opus-4-20250514
    53	    claude-opus-4-1-20250805
    54	    claude-sonnet-4-5)
    55	  "List of available models.")
    56	
    57	(defcustom greger-model 'claude-sonnet-4-20250514
    58	  "The currently used model."
    59	  :type `(choice ,@(mapcar (lambda (model) `(const ,model)) greger-available-models))
    60	  :group 'greger)
    61	
    62	(defcustom greger-default-system-prompt "You are Greger, and expert coding agent.
    63	
    64	${greger-prompt-code-style}"
    65	  "Default system prompt used for AI interactions."
    66	  :type 'string
    67	  :group 'greger)
    68	
    69	(defcustom greger-max-tokens 27000
    70	  "Maximum number of tokens to generate."
    71	  :type 'integer
    72	  :group 'greger)
    73	
    74	(defcustom greger-thinking-budget 4096
    75	  "Default budget for thinking (internal reasoning) content, in tokens.
    76	Set to 0 to disable thinking entirely."
    77	  :type 'integer
    78	  :group 'greger)
    79	
    80	(defcustom greger-local-grammar-path nil
    81	  "Local path or Git branch for greger grammar development.
    82	When set to a local directory path (starting with / or ~), the grammar
    83	will be installed from that local directory. When set to a string not
    84	starting with / or ~, it will be treated as a Git branch name.
    85	This is useful for development when you want to test local changes
    86	or changes from a development branch."
    87	  :type '(choice (const :tag "Use main branch from GitHub" nil)
    88	                 (directory :tag "Local grammar directory path")
    89	                 (string :tag "Git branch name"))
    90	  :group 'greger)
    91	
    92	(defcustom greger-allow-all-shell-commands nil
    93	  "Allow all shell commands to run without permission.
    94	May order 4,000 pounds of meat."
    95	  :type 'boolean
    96	  :group 'greger)
    97	
    98	(defcustom greger-anthropic-key-fn nil
    99	  "Function to call to get the Anthropic API key.
   100	This function should return a string containing the API key.
   101	If nil, the ANTHROPIC_API_KEY environment variable will be used."
   102	  :type '(choice (const nil) function)
   103	  :group 'greger)
   104	
   105	(defcustom greger-provider 'anthropic
   106	  "Provider to use for API calls.
   107	Options: 'anthropic (default) or 'openrouter (beta)."
   108	  :type '(choice (const :tag "Anthropic (Claude)" anthropic)
   109	                 (const :tag "OpenRouter (Beta)" openrouter))
   110	  :group 'greger)
   111	
   112	(defcustom greger-openrouter-api-key-fn nil
   113	  "Function to call to get the OpenRouter API key.
   114	If nil, uses OPENROUTER_API_KEY environment variable."
   115	  :type '(choice (const nil) function)
   116	  :group 'greger)
   117	
   118	(defcustom greger-openrouter-model "openai/gpt-5-codex"
   119	  "Model to use when greger-provider is 'openrouter."
   120	  :type 'string
   121	  :group 'greger)
   122	
   123	;; Tool configuration and agent functionality
   124	
   125	(defcustom greger-tools '("read-file" "write-new-file" "replace-file" "str-replace" "make-directory" "rename-file" "delete-files" "list-directory" "ripgrep" "shell-command" "read-webpage")
   126	  "List of tools available to the agent."
   127	  :type '(repeat symbol)
   128	  :group 'greger)
   129	
   130	(defcustom greger-server-tools '("web_search")
   131	  "List of server tools available to the agent (e.g., web_search)."
   132	  :type '(repeat symbol)
   133	  :group 'greger)
   134	
   135	(defcustom greger-max-iterations 100
   136	  "Maximum number of agent iterations before stopping."
   137	  :type 'integer
   138	  :group 'greger)
   139	
   140	;;; Agent state structure
   141	
   142	(cl-defstruct greger-state
   143	  current-iteration
   144	  chat-buffer
   145	  directory
   146	  tool-use-metadata
   147	  client-state
   148	  executing-tools)
   149	
   150	(defvar-local greger--current-state nil
   151	  "Buffer-local variable to track the current state.")
   152	
   153	(defvar-local greger--buffer-read-only-by-greger nil
   154	  "Buffer-local variable to track if buffer is read-only due to greger activity.")
   155	
   156	(defvar-local greger-current-thinking-budget greger-thinking-budget
   157	  "Thinking budget for the current Greger chat.")
   158	
   159	(defvar-local greger-follow-mode t
   160	  "When non-nil, keep point at the bottom of the chat during updates.
   161	When nil, preserve point position using `save-excursion'.")
   162	
   163	(defcustom greger-citation-summary-face 'underline
   164	  "Face to use for citation text when folded."
   165	  :type 'face
   166	  :group 'greger)
   167	
   168	(defface greger-user-header-face
   169	  '((t (:foreground "cyan" :weight bold :height 1.1)))
   170	  "Face for USER headers."
   171	  :group 'greger)
   172	
   173	(defface greger-assistant-header-face
   174	  '((t (:foreground "green" :weight bold :height 1.1)))
   175	  "Face for ASSISTANT headers."
   176	  :group 'greger)
   177	
   178	(defface greger-system-header-face
   179	  '((t (:foreground "orange" :weight bold :height 1.1)))
   180	  "Face for SYSTEM headers."
   181	  :group 'greger)
   182	
   183	(defface greger-thinking-header-face
   184	  '((t (:foreground "magenta" :weight bold :height 1.1)))
   185	  "Face for THINKING headers."
   186	  :group 'greger)
   187	
   188	(defface greger-tool-header-face
   189	  '((t (:foreground "yellow" :weight bold :height 1.1)))
   190	  "Face for tool-related headers (TOOL USE, TOOL RESULT, etc.)."
   191	  :group 'greger)
   192	
   193	(defface greger-field-name-face
   194	  '((t (:foreground "lightyellow")))
   195	  "Face for field names like \='Name:\=', \='ID:\=', etc."
   196	  :group 'greger)
   197	
   198	(defface greger-tool-param-name-face
   199	  '((t (:foreground "lightgreen")))
   200	  "Face for tool parameter names like \='path\=', \='content\=', etc."
   201	  :group 'greger)
   202	
   203	(defface greger-key-face
   204	  '((t (:foreground "lightblue")))
   205	  "Face for tool parameter names like \='path\=', \='content\=', etc."
   206	  :group 'greger)
   207	
   208	(defface greger-tool-tag-face
   209	  '((t (:foreground "gray" :height 0.6)))
   210	  "Face for tool start and end tags."
   211	  :group 'greger)
   212	
   213	(defface greger-citation-face
   214	  '((t (:underline "#555588")))
   215	  "Face for links."
   216	  :group 'greger)
   217	
   218	(defface greger-link-face
   219	  '((t (:foreground "aqua" :weight semi-bold)))
   220	  "Face for links."
   221	  :group 'greger)
   222	
   223	(defface greger-eval-tag-face
   224	  '((t (:foreground "#4A90E2")))
   225	  "Face for eval tags (<eval>, </eval>)."
   226	  :group 'greger)
   227	
   228	(defface greger-eval-language-face
   229	  '((t (:foreground "#4AE290")))
   230	  "Face for eval tags (<eval>, </eval>)."
   231	  :group 'greger)
   232	
   233	(defface greger-eval-result-face
   234	  '((t (:foreground "#8FA5C7")))
   235	  "Face for eval result content - blue-ish gray."
   236	  :group 'greger)
   237	
   238	(defface greger-eval-arrow-face
   239	  '((t (:foreground "#5A7BA7" :weight bold)))
   240	  "Face for eval result arrow overlay - darker blue-ish gray."
   241	  :group 'greger)
   242	
   243	(defface greger-error-face
   244	  '((t (:background "red" :foreground "white")))
   245	  "Face for parse errors in greger-mode."
   246	  :group 'greger)
   247	
   248	(defface greger-code-content-face
   249	  '((((class color) (background dark))
   250	     (:background "#2a2a2a"))
   251	    (((class color) (background light))
   252	     (:background "#f8f8f8"))
   253	    (t (:background "gray")))
   254	  "Face for code content blocks.
   255	Background is slightly less dark than default for dark themes,
   256	or slightly less bright than default for light themes."
   257	  :group 'greger)
   258	
   259	(defface greger-code-backtick-face
   260	  '((((class color) (background dark))
   261	     (:foreground "#b5651d" :background "#2a2a2a"))
   262	    (((class color) (background light))
   263	     (:foreground "#8b4513" :background "#f8f8f8"))
   264	    (t (:foreground "orange" :background "gray")))
   265	  "Face for backticks around code content - orange-ish gray color."
   266	  :group 'greger)
   267	
   268	(defvar greger-mode-map
   269	  (let ((map (make-sparse-keymap)))
   270	    (define-key map (kbd "M-<return>") #'greger-buffer)
   271	    (define-key map (kbd "M-RET") #'greger-buffer)  ; Alternative for Linux compatibility
   272	    (define-key map (kbd "C-M-<return>") #'greger-buffer-no-tools)
   273	    (define-key map (kbd "C-M-RET") #'greger-buffer-no-tools)  ; Alternative for Linux compatibility
   274	    (define-key map (kbd "C-g") #'greger-interrupt)
   275	    (define-key map (kbd "C-; a") #'greger-insert-assistant-tag)
   276	    (define-key map (kbd "C-; u") #'greger-insert-user-tag)
   277	    (define-key map (kbd "C-; s") #'greger-insert-system-tag)
   278	    (define-key map (kbd "C-; m") #'greger-set-model)
   279	    (define-key map (kbd "C-; c") #'greger-ui-copy-code)
   280	    (define-key map (kbd "C-; t") #'greger-toggle-thinking)
   281	    (define-key map (kbd "C-; f") #'greger-toggle-follow-mode)
   282	    (define-key map (kbd "C-; C-f") #'greger-ui-toggle-folding)
   283	    (define-key map (kbd "C-; b") #'greger-mention-buffer-file)
   284	    map)
   285	  "Keymap for `greger-mode'.")
