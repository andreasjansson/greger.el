    95	                      :properties '((path . ((type . "string")
    96	                                             (description . "Path to the file to replace")))
    97	                                    (contents . ((type . "string")
    98	                                                 (description . "New contents to replace the entire file")))
    99	                                    (git-commit-message . ((type . "string")
   100	                                                           (description . "Git commit message for this change"))))
