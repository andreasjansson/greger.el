   354	(defun greger-ui--url-link (node _override _start _end)
   355	  "Apply URL link properties to NODE for interactive behavior."
   356	  (let* ((node-start (treesit-node-start node))
   357	         (node-end (treesit-node-end node))
   358	         (url-start (+ node-start 3)))
   359	    (put-text-property url-start node-end 'face 'greger-link-face)
   360	    (put-text-property url-start node-end 'mouse-face 'highlight)
   361	    (put-text-property url-start node-end 'keymap greger-ui-url-link-keymap)))
