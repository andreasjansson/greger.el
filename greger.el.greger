    27	
    28	;;; Commentary:
    29	;; Parses markdown-style dialog format with sections like # USER, # ASSISTANT, etc.
    30	;; Handles tool use, thinking blocks, and complex content structures.
    31	
    32	;;; Code:
    33	
    34	(require 'treesit)
    35	(require 'json)
    36	(require 'cl-lib)
    37	
    38	;; Section tag constants
    39	(defconst greger-parser-system-tag "# SYSTEM")
    40	(defconst greger-parser-user-tag "# USER")
    41	(defconst greger-parser-assistant-tag "# ASSISTANT")
    42	(defconst greger-parser-thinking-tag "# THINKING")
    43	(defconst greger-parser-tool-use-tag "# TOOL USE")
    44	(defconst greger-parser-server-tool-use-tag "# SERVER TOOL USE")
    45	(defconst greger-parser-tool-result-tag "# TOOL RESULT")
    46	(defconst greger-parser-web-search-tool-result-tag "# WEB SEARCH TOOL RESULT")
    47	
    48	;; Entrypoints
    49	
    50	(defun greger-parser-markdown-to-dialog (text)
    51	  "Parse greger conversation TEXT using tree-sitter and return structured dialog."
    52	  (unless (treesit-ready-p 'greger)
    53	    (error "Tree-sitter greger parser not available"))
    54	
    55	  ;; Handle empty or whitespace-only input
    56	  (let ((trimmed-text (string-trim text)))
    57	    (if (string= trimmed-text "")
    58	        '()
    59	      (with-temp-buffer
    60	        (insert text)
    61	        (greger-parser-markdown-buffer-to-dialog (current-buffer))))))
    62	
    63	(defun greger-parser-markdown-buffer-to-dialog (buffer)
    64	  "Parse greger conversation BUFFER into structured dialog data."
    65	  (with-current-buffer buffer
    66	    (let* ((parser (treesit-parser-create 'greger))
    67	           (root-node (treesit-parser-root-node parser)))
    68	      (greger-parser--extract-dialog-from-node root-node))))
    69	
    70	(defun greger-parser-dialog-to-markdown (dialog)
    71	  "Convert DIALOG to markdown format."
    72	  (if (null dialog)
    73	      ""
    74	    (mapconcat #'greger-parser--message-to-markdown dialog "\n\n")))
    75	
    76	(defun greger-parser-find-safe-shell-commands-in-buffer (buffer)
    77	  "Extract safe shell commands from BUFFER for validation.
    78	Finds commands marked as safe for execution without user confirmation,
    79	used by the shell command security system."
    80	  (with-current-buffer buffer
    81	    (let* ((parser (treesit-parser-create 'greger))
    82	           (root-node (treesit-parser-root-node parser)))
    83	      (greger-parser--extract-safe-shell-commands root-node))))
    84	
    85	;; Tree-sitter-based markdown-to-dialog parsing
    86	
    87	(defun greger-parser--extract-dialog-from-node (node)
    88	  "Extract dialog entries from a tree-sitter NODE."
    89	  (let ((raw-entries '()))
    90	    ;; First extract all entries
    91	    (dolist (child (treesit-node-children node))
    92	      (let ((entry (greger-parser--extract-entry-from-node child)))
    93	        (when entry
    94	          (push entry raw-entries))))
    95	
    96	    ;; Reverse after push
    97	    (setq raw-entries (nreverse raw-entries))
    98	
    99	    raw-entries))
   100	
   101	(defun greger-parser--flush-assistant-content (content result)
   102	  "Flush accumulated assistant CONTENT to RESULT list, returning updated result."
   103	  (cons `((role . "assistant")
   104	          (content . ,content))
   105	        result))
   106	
   107	(defun greger-parser--extract-entry-from-node (node)
   108	  "Extract a single dialog entry from NODE."
   109	  (let ((node-type (treesit-node-type node)))
   110	    (cond
   111	     ((string= node-type "untagged_text")
   112	      (greger-parser--extract-user-from-untagged-text node))
   113	     ((string= node-type "user")
   114	      (greger-parser--extract-user node))
   115	     ((string= node-type "assistant")
   116	      (greger-parser--extract-assistant node))
   117	     ((string= node-type "system")
   118	      (greger-parser--extract-system node))
   119	     ((string= node-type "thinking")
   120	      (greger-parser--extract-thinking node))
   121	     ((string= node-type "tool_use")
   122	      (greger-parser--extract-tool-use node))
   123	     ((string= node-type "server_tool_use")
   124	      (greger-parser--extract-server-tool-use node))
   125	     ((string= node-type "tool_result")
   126	      (greger-parser--extract-tool-result node))
   127	     ((string= node-type "web_search_tool_result")
   128	      (greger-parser--extract-web-search-tool-result node))
   129	     ;; citations are assistants too, but they don't have text
   130	     ((string= node-type "citations")
   131	      (greger-parser--extract-assistant node))
   132	     (t nil))))
   133	
   134	(defun greger-parser--extract-user-from-untagged-text (node)
   135	  "Extract user entry from NODE."
   136	  (let ((content (greger-parser--remove-two-trailing-newlines (treesit-node-text node t))))
   137	    `((role . "user")
   138	      (content . ,content))))
   139	
   140	(defun greger-parser--extract-user (node)
   141	  "Extract user entry from NODE."
   142	  (let ((content (greger-parser--extract-text-content node)))
   143	    `((role . "user")
   144	      (content . ,content))))
   145	
   146	(defun greger-parser--extract-system (node)
   147	  "Extract system entry from NODE."
   148	  (let* ((content (greger-parser--extract-text-content node))
   149	         (safe-shell-commands (greger-parser--extract-safe-shell-commands node))
   150	         (safe-shell-commands-text (greger-parser--safe-shell-commands-text safe-shell-commands)))
   151	
   152	    (when safe-shell-commands-text
   153	      (setq content (concat content "\n\n" safe-shell-commands-text)))
   154	
   155	    `((role . "system")
   156	      (content . ,content))))
   157	
   158	(defun greger-parser--extract-safe-shell-commands (node)
   159	  "Extract safe shell commands from NODE.
   160	Use tree walking approach instead of `treesit-search-subtree' to avoid
   161	segfaults when searching for safe_shell_commands nodes."
   162	  (let ((safe-commands '()))
   163	    (greger-parser--walk-tree
   164	     node
   165	     (lambda (n)
   166	       (when (string= (treesit-node-type n) "safe_shell_commands")
   167	         (let ((command-nodes (treesit-node-children n t)))
   168	           (dolist (cmd-node command-nodes)
   169	             (when (string= (treesit-node-type cmd-node) "shell_command")
   170	               (push (treesit-node-text cmd-node t) safe-commands)))))))
   171	    (nreverse safe-commands)))
   172	
   173	(defun greger-parser--walk-tree (node callback)
   174	  "Walk NODE tree calling CALLBACK on each node."
   175	  (funcall callback node)
   176	  (dolist (child (treesit-node-children node))
   177	    (greger-parser--walk-tree child callback)))
   178	
   179	(defun greger-parser--safe-shell-commands-text (commands)
   180	  "Generate descriptive text for safe shell COMMANDS list."
   181	  (when commands
   182	    (concat "# Safe shell commands
   183	
   184	You can run arbitrary shell commands with the shell-command tool, but the following are safe shell commands that will run without requiring user confirmation:
   185	
   186	"
   187	            (mapconcat (lambda (cmd) (format "* `%s`" cmd)) commands "\n"))))
   188	
   189	(defun greger-parser--extract-thinking (node)
   190	  "Extract thinking entry from NODE."
   191	  (let ((content (greger-parser--extract-text-content node))
   192	        (signature (greger-parser--extract-signature node)))
   193	    `((role . "assistant")
   194	      (content . (((type . "thinking")
   195	                   (signature . ,signature)
   196	                   (thinking . ,content)))))))
   197	
   198	(defun greger-parser--extract-signature (node)
   199	  "Extract thinking signature from NODE."
   200	  (let* ((signature-node (treesit-search-subtree node "thinking_signature"))
   201	         (value-node (treesit-node-child-by-field-name signature-node "value"))
   202	         (signature (treesit-node-text value-node t)))
   203	    signature))
   204	
   205	(defun greger-parser--extract-tool-use-param-nodes (node)
   206	  "Extract tool parameter nodes from NODE and return an alist.
   207	The alist maps parameter names to parameter nodes."
   208	  (let* ((tool-param-nodes (treesit-filter-child node (lambda (n) (string= (treesit-node-type n) "tool_param"))))
   209	         (param-map '()))
   210	    (dolist (tool-param-node tool-param-nodes)
   211	      (when-let* ((name-node (treesit-search-subtree tool-param-node "name"))
   212	                  (name (intern (treesit-node-text name-node t))))
   213	        (push `(,name . ,tool-param-node) param-map)))
   214	    (nreverse param-map)))
   215	
   216	(defun greger-parser--extract-tool-use-params (node)
   217	  "Extract tool use parameters from NODE and return an alist.
   218	The alist maps parameter names to their values."
   219	  (let* ((param-node-map (greger-parser--extract-tool-use-param-nodes node))
   220	         (params '()))
   221	    (dolist (param-entry param-node-map)
   222	      (let ((param-node (cdr param-entry)))
   223	        (push (greger-parser--extract-tool-param param-node) params)))
   224	    (nreverse params)))
   225	
   226	(defun greger-parser--extract-tool-use (node)
   227	  "Extract tool use entry from NODE."
   228	  (let* ((name (greger-parser--extract-tool-use-name node))
   229	         (id (greger-parser--extract-tool-id node))
   230	         (params (greger-parser--extract-tool-use-params node)))
   231	
   232	    ;; Check if this is a str-replace tool with diff param and convert back
   233	    (when (string= name "str-replace")
   234	      (setq params (greger-parser--str-replace-undiff-params params)))
   235	
   236	    `((role . "assistant")
   237	      (content . (((type . "tool_use")
   238	                   (id . ,id)
   239	                   (name . ,name)
   240	                   (input . ,params)))))))
   241	
   242	(defun greger-parser--extract-tool-use-name (tool-use-node)
   243	  "Extract the tool name from TOOL-USE-NODE."
   244	  (let ((name-node (treesit-search-subtree tool-use-node "name")))
   245	    (greger-parser--extract-value name-node)))
   246	
   247	(defun greger-parser--extract-tool-id (tool-node)
   248	  "Extract the tool ID from TOOL-NODE."
   249	  (let ((id-node (treesit-search-subtree tool-node "id")))
   250	    (greger-parser--extract-value id-node)))
   251	
   252	(defun greger-parser--extract-tool-result-id (tool-result-node)
   253	  "Extract the tool result ID from TOOL-RESULT-NODE."
   254	  (let ((id-node (treesit-search-subtree tool-result-node "id")))
   255	    (greger-parser--extract-value id-node)))
   256	
   257	(defun greger-parser--extract-server-tool-use (node)
   258	  "Extract tool use entry from NODE."
   259	  (let* ((name-node (treesit-search-subtree node "name"))
   260	         (name (greger-parser--extract-value name-node))
   261	         (id-node (treesit-search-subtree node "id"))
   262	         (id (greger-parser--extract-value id-node))
   263	         (params (greger-parser--extract-tool-use-params node)))
   264	    `((role . "assistant")
   265	      (content . (((type . "server_tool_use")
   266	                   (id . ,id)
   267	                   (name . ,name)
   268	                   (input . ,params)))))))
   269	
   270	(defun greger-parser--extract-value (node)
   271	  "Extract the value field from tree-sitter NODE."
   272	  (let ((child (treesit-node-child-by-field-name node "value")))
   273	    (when child
   274	      (string-trim (treesit-node-text child t)))))
   275	
   276	(defun greger-parser--extract-tool-param (node)
   277	  "Parse tool parameter NODE to extract name-value pair."
   278	  (let* ((name-node (treesit-search-subtree node "name"))
   279	         (name (intern (treesit-node-text name-node t)))
   280	         (value-node (treesit-search-subtree node "value"))
   281	         (value (greger-parser--extract-tool-content value-node)))
   282	    `(,name . ,value)))
   283	
   284	(defun greger-parser--extract-tool-content (node)
   285	  "Extract the value field from tree-sitter NODE."
   286	  (let* ((value-node (treesit-node-child-by-field-name node "value"))
   287	         (value (treesit-node-text value-node t)))
   288	
   289	    (greger-parser--convert-value value)))
   290	
   291	(defun greger-parser--extract-tool-result-content (node)
   292	  "Extract the value field from tree-sitter NODE as a string for tool results.
   293	Tool result content must always be a string for Claude API compatibility."
   294	  (let* ((value-node (treesit-node-child-by-field-name node "value"))
   295	         (value (treesit-node-text value-node t)))
   296	    ;; Always return as string, don't convert to numbers or other types
   297	    (greger-parser--remove-single-leading-and-trailing-newline value)))
   298	
   299	(defun greger-parser--convert-value (str)
   300	  "Convert STR to appropriate Elisp value."
   301	  (let ((trimmed (string-trim str)))
   302	    (cond
   303	     ((string= trimmed "true") t)
   304	     ((string= trimmed "false") nil)
   305	     ((string-match-p "\\`-?[0-9]+\\'" trimmed)
   306	      (string-to-number trimmed))
   307	     ((string-match-p "\\`-?[0-9]*\\.[0-9]+\\'" trimmed)
   308	      (string-to-number trimmed))
   309	     ((and (string-prefix-p "[" trimmed) (string-suffix-p "]" trimmed))
   310	      (greger-parser--parse-json-array trimmed))
   311	     ((and (string-prefix-p "{" trimmed) (string-suffix-p "}" trimmed))
   312	      (greger-parser--parse-json-object trimmed))
   313	     (t (greger-parser--remove-single-leading-and-trailing-newline str)))))
   314	
   315	(defun greger-parser--parse-json-array (str)
   316	  "Parse JSON array STR, ensuring entire string is consumed."
   317	  (condition-case nil
   318	      (let (parsed)
   319	        ;; Use a buffer to parse JSON and ensure entire string is consumed
   320	        (with-temp-buffer
   321	          (insert str)
   322	          (goto-char (point-min))
   323	          (setq parsed (json-read))
   324	          ;; Check if we consumed the entire buffer (ignoring whitespace)
   325	          (skip-chars-forward " \t\n\r")
   326	          (if (eobp)
   327	              ;; If entire string was consumed, return parsed result
   328	              parsed
   329	            ;; If not all consumed, treat as invalid JSON
   330	            (signal 'json-parse-error "Trailing content after JSON"))))
   331	    (error str)))
   332	
   333	(defun greger-parser--parse-json-object (str)
   334	  "Parse JSON object STR, ensuring entire string is consumed."
   335	  (condition-case nil
   336	      (let (parsed)
   337	        ;; Use a buffer to parse JSON and ensure entire string is consumed
   338	        (with-temp-buffer
   339	          (insert str)
   340	          (goto-char (point-min))
   341	          (setq parsed (json-read))
   342	          ;; Check if we consumed the entire buffer (ignoring whitespace)
   343	          (skip-chars-forward " \t\n\r")
   344	          (if (eobp)
   345	              ;; If entire string was consumed, convert to alist and return
   346	              (mapcar (lambda (pair)
   347	                        (cons (intern (symbol-name (car pair))) (cdr pair)))
   348	                      parsed)
   349	            ;; If not all consumed, treat as invalid JSON
   350	            (signal 'json-parse-error "Trailing content after JSON"))))
   351	    (error str)))
   352	
   353	(defun greger-parser--extract-tool-result (node)
   354	  "Extract tool result entry from NODE."
   355	  (let ((id nil)
   356	        (content nil))
   357	    (dolist (child (treesit-node-children node))
   358	      (let ((child-type (treesit-node-type child)))
   359	        (cond
   360	         ((string= child-type "id")
   361	          (setq id (string-trim (greger-parser--extract-value child))))
   362	         ((string= child-type "content")
   363	          (setq content (greger-parser--extract-tool-result-content child))))))
   364	    `((role . "user")
   365	      (content . (((type . "tool_result")
   366	                   (tool_use_id . ,id)
   367	                   (content . ,content)))))))
   368	
   369	(defun greger-parser--extract-web-search-tool-result (node)
   370	  "Extract server tool result entry from NODE."
   371	  (let ((id nil)
   372	        (content nil))
   373	    (dolist (child (treesit-node-children node))
   374	      (let ((child-type (treesit-node-type child)))
   375	        (cond
   376	         ((string= child-type "id")
   377	          (setq id (greger-parser--extract-value child)))
   378	         ((string= child-type "content")
   379	          (setq content (greger-parser--extract-tool-content child))))))
   380	    `((role . "assistant")
   381	      (content . (((type . "web_search_tool_result")
   382	                   (tool_use_id . ,id)
   383	                   (content . ,content)))))))
   384	
   385	(defun greger-parser--extract-assistant (node)
   386	  "Extract citations entry from NODE."
   387	  (let ((text-content (greger-parser--extract-text-content node))
   388	        (citation-entries (greger-parser--extract-citation-entries node))
   389	        (content '((type . "text"))))
   390	    (when citation-entries
   391	      (push `(citations . ,citation-entries) content))
   392	    (when text-content
   393	      (push `(text . ,text-content) content))
   394	    `((role . "assistant")
   395	      (content . (,content)))))
   396	
   397	(defun greger-parser--extract-citation-entries (node)
   398	  "Extract all citation entries from NODE."
   399	  (let ((citation-entries '()))
   400	    (dolist (child (treesit-node-children node))
   401	      (let ((child-type (treesit-node-type child)))
   402	        (when (string= child-type "citation_entry")
   403	          (push (greger-parser--extract-citation-entry child) citation-entries))))
   404	    citation-entries))
   405	
   406	(defun greger-parser--extract-text-content (node)
   407	  "Extract text content from NODE, handling nested structures."
   408	  (let ((result (greger-parser--collect-text-blocks node "")))
   409	    (greger-parser--remove-two-trailing-newlines result)))
   410	
   411	(defun greger-parser--remove-two-trailing-newlines (str)
   412	  "Remove exactly two newlines from the end of STR if they exist."
   413	  (replace-regexp-in-string "\n\n\\'" "" str))
   414	
   415	(defun greger-parser--remove-single-leading-and-trailing-newline (str)
   416	  "Remove one leading and trailing newline from STR."
   417	  (replace-regexp-in-string "\\`\n\\|\n\\'" "" str))
   418	
   419	(defun greger-parser--collect-text-blocks (node result)
   420	  "Recursively collect text from text nodes in NODE and append to RESULT."
   421	  (let ((node-type (treesit-node-type node)))
   422	    (cond
   423	     ((string= node-type "text")
   424	      (concat result (treesit-node-text node t)))
   425	     ;; For code blocks, include the entire text content
   426	     ((string= node-type "code")
   427	      (concat result (treesit-node-text node t)))
   428	     ((string= node-type "html_comment")
   429	      ;; Skip HTML comments outside of code blocks
   430	      result)
   431	     ((string= node-type "eval_result")
   432	      ;; Extract eval result content and concatenate it
   433	      (let ((content-node (treesit-search-subtree node "eval_result_content")))
   434	        (if content-node
   435	            (concat result (treesit-node-text content-node t))
   436	          result)))
   437	     (t
   438	      (let ((text-result result))
   439	        (dolist (child (treesit-node-children node))
   440	          (setq text-result (greger-parser--collect-text-blocks child text-result)))
   441	        text-result)))))
   442	
   443	(defun greger-parser--extract-citation-entry (node)
   444	  "Extract a citation entry from NODE."
   445	  (let ((url nil)
   446	        (title nil)
   447	        (cited-text nil)
   448	        (encrypted-index nil))
   449	    (dolist (child (treesit-node-children node))
   450	      (let ((child-type (treesit-node-type child)))
   451	        (cond
   452	         ((string= child-type "url")
   453	          (setq url (string-trim (substring (treesit-node-text child t) 3))))
   454	         ((string= child-type "title")
   455	          (setq title (or (greger-parser--extract-value child) "(no value)")))
   456	         ((string= child-type "cited_text")
   457	          (setq cited-text (or (greger-parser--extract-value child) "(no value)")))
   458	         ((string= child-type "encrypted_index")
   459	          (setq encrypted-index (greger-parser--extract-value child))))))
   460	    `((type . "web_search_result_location")
   461	      (url . ,url)
   462	      (title . ,title)
   463	      (cited_text . ,cited-text)
   464	      (encrypted_index . ,encrypted-index))))
   465	
   466	;; Dialog to markdown
   467	
   468	(defun greger-parser--message-to-markdown (message)
   469	  "Convert MESSAGE to markdown."
   470	  (let ((role (alist-get 'role message))
   471	        (content (alist-get 'content message)))
   472	    (cond
   473	     ((string= role "user")
   474	      (greger-parser--user-to-markdown content))
   475	     ((string= role "assistant")
   476	      (greger-parser--assistant-to-markdown content))
   477	     ((string= role "system")
   478	      (greger-parser--system-to-markdown content))
   479	     (t ""))))
   480	
   481	(defun greger-parser--user-to-markdown (content)
   482	  "Convert user CONTENT to markdown."
   483	  (if (stringp content)
   484	      (concat greger-parser-user-tag "\n\n" content)
   485	    ;; Check if this is a pure tool result message (only contains tool_result blocks)
   486	    (if (and (= (length content) 1)
   487	             (string= (alist-get 'type (car content)) "tool_result"))
   488	        ;; Pure tool result - just output it directly
   489	        (greger-parser--tool-result-to-markdown (car content))
   490	      ;; Mixed content - add USER header
   491	      (concat greger-parser-user-tag "\n\n"
   492	              (greger-parser--user-content-blocks-to-markdown content)))))
   493	
   494	(defun greger-parser--assistant-to-markdown (content)
   495	  "Convert assistant CONTENT to markdown."
   496	  (if (stringp content)
   497	      (concat greger-parser-assistant-tag "\n\n" content)
   498	    (greger-parser--assistant-content-blocks-to-markdown content)))
   499	
   500	(defun greger-parser--system-to-markdown (content)
   501	  "Convert system CONTENT to markdown."
   502	  (concat greger-parser-system-tag "\n\n" content))
   503	
   504	(defun greger-parser--user-content-blocks-to-markdown (content-blocks)
   505	  "Convert user CONTENT-BLOCKS to markdown format."
   506	  (if (null content-blocks)
   507	      ""
   508	    (mapconcat (lambda (block)
   509	                 (let ((block-type (alist-get 'type block)))
   510	                   (cond
   511	                    ((string= block-type "text")
   512	                     (alist-get 'text block))
   513	                    (t (greger-parser--block-to-markdown block t)))))
   514	               content-blocks "\n\n")))
   515	
   516	(defun greger-parser--assistant-content-blocks-to-markdown (content-blocks)
   517	  "Convert assistant CONTENT-BLOCKS to markdown format."
   518	  (if (null content-blocks)
   519	      ""
   520	    (let ((result "")
   521	          (first-block t))
   522	      (dolist (block content-blocks)
   523	        (let* ((block-type (alist-get 'type block))
   524	               (has-citations (alist-get 'citations block))
   525	               (is-text-block (and (string= block-type "text") (not has-citations)))
   526	               (block-markdown (cond
   527	                                ((and is-text-block first-block)
   528	                                 ;; First text block gets assistant header
   529	                                 (concat greger-parser-assistant-tag "\n\n" (alist-get 'text block)))
   530	                                (is-text-block
   531	                                 ;; Subsequent text blocks need assistant header if previous wasn't text
   532	                                 (concat greger-parser-assistant-tag "\n\n" (alist-get 'text block)))
   533	                                (t
   534	                                 ;; Non-text blocks handle their own headers
   535	                                 (greger-parser--block-to-markdown block t)))))
   536	          (when (not (string= result ""))
   537	            (setq result (concat result "\n\n")))
   538	          (setq result (concat result block-markdown))
   539	          (setq first-block nil)))
   540	      result)))
   541	
   542	(defun greger-parser--citations-list-to-markdown (citations)
   543	  "Convert CITATIONS list to markdown citations section."
   544	  (mapconcat #'greger-parser--citation-to-markdown citations "\n\n"))
   545	
   546	(defun greger-parser--citation-to-markdown (citation)
   547	  "Convert single CITATION to markdown format."
   548	  (let ((url (alist-get 'url citation))
   549	        (title (alist-get 'title citation))
   550	        (cited-text (alist-get 'cited_text citation))
   551	        (encrypted-index (alist-get 'encrypted_index citation)))
   552	    ;; url includes the leading `## `
   553	    (concat "## " url "\n\n"
   554	            "Title: " title "\n"
   555	            "Cited text: " cited-text "\n"
   556	            "Encrypted index: " encrypted-index)))
   557	
   558	(defun greger-parser--block-to-markdown (block &optional skip-header)
   559	  "Convert a content BLOCK to markdown.
   560	If SKIP-HEADER is true, don't add section headers for text blocks."
   561	  (let ((type (alist-get 'type block)))
   562	    (cond
   563	     ((string= type "text")
   564	      (greger-parser--assistant-text-to-markdown block skip-header))
   565	     ((string= type "thinking")
   566	      (greger-parser--thinking-to-markdown block))
   567	     ((string= type "tool_use")
   568	      (greger-parser--tool-use-to-markdown block))
   569	     ((string= type "server_tool_use")
   570	      (greger-parser--server-tool-use-to-markdown block))
   571	     ((string= type "tool_result")
   572	      (greger-parser--tool-result-to-markdown block))
   573	     ((string= type "web_search_tool_result")
   574	      (greger-parser--web-search-tool-result-to-markdown block))
   575	     (t ""))))
   576	
   577	(defun greger-parser--assistant-text-to-markdown (block &optional skip-header)
   578	  "Convert assistant text BLOCK to markdown, including citations.
   579	If SKIP-HEADER is nil, don't include the assistant header tag,
   580	assuming it's already been sent in streaming."
   581	  (let ((text (alist-get 'text block))
   582	        (citations (alist-get 'citations block)))
   583	    (cond
   584	     (citations
   585	      (greger-parser--citations-to-markdown block))
   586	     (skip-header
   587	      text)
   588	     (t
   589	      (concat greger-parser-assistant-tag
   590	              "\n\n"
   591	              text)))))
   592	
   593	(defun greger-parser--thinking-to-markdown (block)
   594	  "Convert thinking BLOCK to markdown (signature and text)."
   595	  (let ((contents (alist-get 'thinking block))
   596	        (signature (alist-get 'signature block)))
   597	    (concat greger-parser-thinking-tag
   598	            (if signature
   599	                (concat "\n\n" "Signature: " signature)
   600	              "")
   601	            "\n\n"
   602	            contents)))
   603	
   604	(defun greger-parser--citations-to-markdown (block)
   605	  "Convert citation BLOCK to markdown with embedded citations."
   606	  (let* ((text (alist-get 'text block))
   607	         (citations (alist-get 'citations block))
   608	         (citations-markdown (greger-parser--citations-list-to-markdown citations)))
   609	
   610	    ;; little hack for parsing to still work if there are citations without text
   611	    (when (not text)
   612	      (setq text " "))
   613	
   614	    (concat greger-parser-assistant-tag
   615	            "\n\n"
   616	            text
   617	            "\n\n"
   618	            citations-markdown)))
   619	
   620	(defun greger-parser--tool-use-to-markdown (tool-use)
   621	  "Convert TOOL-USE to markdown."
   622	  (let ((name (alist-get 'name tool-use))
   623	        (id (alist-get 'id tool-use))
   624	        (input (alist-get 'input tool-use)))
   625	
   626	    (concat greger-parser-tool-use-tag "\n\n"
   627	            "Name: " name "\n"
   628	            "ID: " id "\n\n"
   629	            (greger-parser--tool-params-to-markdown id input))))
   630	
   631	(defun greger-parser--server-tool-use-to-markdown (tool-use)
   632	  "Convert TOOL-USE to markdown."
   633	  (let ((name (alist-get 'name tool-use))
   634	        (id (alist-get 'id tool-use))
   635	        (input (alist-get 'input tool-use)))
   636	
   637	    (concat greger-parser-server-tool-use-tag "\n\n"
   638	            "Name: " name "\n"
   639	            "ID: " id "\n\n"
   640	            (greger-parser--tool-params-to-markdown id input))))
   641	
   642	(defun greger-parser--tool-result-to-markdown (tool-result)
   643	  "Convert TOOL-RESULT to markdown."
   644	  (let ((id (alist-get 'tool_use_id tool-result))
   645	        (content (greger-parser--tool-content-to-markdown tool-result)))
   646	
   647	    (greger-parser--wrapped-tool-content greger-parser-tool-result-tag id content)))
   648	
   649	(defun greger-parser--wrapped-tool-content (tag id content)
   650	  "Wrap CONTENT with TAG and ID for tool display formatting."
   651	  (concat tag
   652	          "\n\n"
   653	          "ID: " id "\n\n"
   654	          "<tool." id ">\n"
   655	          content
   656	          "\n"
   657	          "</tool." id ">"))
   658	
   659	(defun greger-parser--web-search-tool-result-to-markdown (tool-result)
   660	  "Convert TOOL-RESULT to markdown."
   661	  (let ((id (alist-get 'tool_use_id tool-result))
   662	        (content (greger-parser--tool-content-to-markdown tool-result)))
   663	    (greger-parser--wrapped-tool-content greger-parser-web-search-tool-result-tag id content)))
   664	
   665	(defun greger-parser--tool-content-to-markdown (block)
   666	  "Convert tool content BLOCK to markdown format."
   667	  (let ((content (alist-get 'content block)))
   668	    (if (stringp content)
   669	        content
   670	      (greger-parser--value-to-string content))))
   671	
   672	(defun greger-parser--tool-params-to-markdown (id input)
   673	  "Convert tool parameters with ID and INPUT to markdown."
   674	  (if (null input)
   675	      ""
   676	    (mapconcat (lambda (param)
   677	                 (let ((name (if (symbolp (car param))
   678	                                 (symbol-name (car param))
   679	                               (format "%s" (car param))))
   680	                       (value (cdr param)))
   681	                   (greger-parser--wrapped-tool-param name id value)))
   682	               input "\n\n")))
   683	
   684	(defun greger-parser--wrapped-tool-param (name id value &optional raw-value)
   685	  "Wrap tool parameter NAME with ID and VALUE.
   686	If RAW-VALUE is non-nil, use VALUE directly without formatting."
   687	  (let ((formatted-value (if raw-value
   688	                             value
   689	                           (greger-parser--value-to-string value))))
   690	    (concat "## " name "\n\n"
   691	            "<tool." id ">\n"
   692	            formatted-value "\n"
   693	            "</tool." id ">")))
   694	
   695	(defun greger-parser--value-to-string (value)
   696	  "Convert VALUE to string representation."
   697	  (let ((json-encoding-pretty-print t))
   698	    (cond
   699	     ((stringp value)
   700	      ;; Try to parse as JSON and pretty print if valid
   701	      (condition-case nil
   702	          (let (parsed)
   703	            ;; Use a buffer to parse JSON and ensure entire string is consumed
   704	            (with-temp-buffer
   705	              (insert value)
   706	              (goto-char (point-min))
   707	              (setq parsed (json-read))
   708	              ;; Check if we consumed the entire buffer (ignoring whitespace)
   709	              (skip-chars-forward " \t\n\r")
   710	              (if (eobp)
   711	                  ;; If entire string was consumed, encode back with pretty print
   712	                  (json-encode parsed)
   713	                ;; If not all consumed, treat as invalid JSON
   714	                (signal 'json-parse-error "Trailing content after JSON"))))
   715	        (error
   716	         ;; If parsing failed, return original string
   717	         value)))
   718	     ((numberp value) (number-to-string value))
   719	     ((eq value t) "true")
   720	     ((null value) "false")
   721	     ((vectorp value) (json-encode value))
   722	     ((listp value) (json-encode value))
   723	     (t (format "%s" value)))))
   724	
   725	;; Undiff functionality for str-replace
   726	
   727	(defun greger-parser--str-replace-undiff-params (params)
   728	  "Convert diff parameter to original-content and new-content in PARAMS."
   729	  (let ((diff-content (alist-get 'diff params))
   730	        (other-params (cl-remove-if (lambda (param)
   731	                                      (eq (car param) 'diff))
   732	                                    params)))
   733	    (if diff-content
   734	        ;; Undiff the content back to original and new
   735	        (let ((undiff-result (greger-parser-undiff-strings diff-content)))
   736	          (append other-params
   737	                  `((original-content . ,(car undiff-result))
   738	                    (new-content . ,(cdr undiff-result)))))
   739	      ;; No diff content found, return params as-is
   740	      params)))
   741	
   742	(defun greger-parser-undiff-strings (unified-diff-str)
   743	  "Extract original and new strings from UNIFIED-DIFF-STR.
   744	Handles unified diff format created by the `diff` command, including diffs
   745	without headers (file/hunk headers deleted).
   746	Returns a cons cell (ORIGINAL-STR . NEW-STR)."
   747	  ;; Handle empty diff (identical files)
   748	  (if (string= "" (string-trim unified-diff-str))
   749	      (cons "" "")
   750	
   751	    (let ((lines (split-string unified-diff-str "\n"))
   752	          (original-lines '())
   753	          (new-lines '())
   754	          (in-hunk nil)
   755	          (orig-no-newline nil)
   756	          (new-no-newline nil)
   757	          (has-headers nil)
   758	          (last-operation nil)) ; Track what the last operation was for "No newline" handling
   759	
   760	      ;; Check if the diff has headers (to determine processing mode)
   761	      (dolist (line lines)
   762	        (when (string-match "^\\(---\\|\\+\\+\\+\\|@@\\)" line)
   763	          (setq has-headers t)))
   764	
   765	      ;; If no headers found, assume we're directly in hunk content
   766	      (unless has-headers
   767	        (setq in-hunk t))
   768	
   769	      (dolist (line lines)
   770	        (cond
   771	         ;; Skip header lines if they exist
   772	         ((string-match "^\\(---\\|\\+\\+\\+\\|@@\\)" line)
   773	          (when (string-match "^@@" line)
   774	            (setq in-hunk t)))
   775	
   776	         ;; Process hunk content
   777	         (in-hunk
   778	          (cond
   779	           ;; Handle "No newline" messages
   780	           ((string-match "^\\\\ No newline" line)
   781	            ;; Apply "No newline" based on the last operation
   782	            (cond
   783	             ((eq last-operation 'deleted)
   784	              (setq orig-no-newline t))
   785	             ((eq last-operation 'added)
   786	              (setq new-no-newline t))
   787	             ((eq last-operation 'context)
   788	              ;; For context lines, both sides don't have newlines
   789	              (setq orig-no-newline t new-no-newline t))
   790	             (t
   791	              ;; Fallback: if we can't determine, assume it applies to both
   792	              (setq orig-no-newline t new-no-newline t))))
   793	
   794	           ;; Process normal lines
   795	           ((> (length line) 0)
   796	            (let ((prefix (substring line 0 1))
   797	                  (content (substring line 1)))
   798	              (cond
   799	               ;; Unchanged line
   800	               ((string= prefix " ")
   801	                (push content original-lines)
   802	                (push content new-lines)
   803	                (setq last-operation 'context))
   804	
   805	               ;; Deleted line
   806	               ((string= prefix "-")
   807	                (push content original-lines)
   808	                (setq last-operation 'deleted))
   809	
   810	               ;; Added line
   811	               ((string= prefix "+")
   812	                (push content new-lines)
   813	                (setq last-operation 'added))
   814	
   815	               ;; Handle lines without prefix (context)
   816	               ((not (member prefix '("-" "+")))
   817	                (push line original-lines)
   818	                (push line new-lines)
   819	                (setq last-operation 'context)))))))))
   820	
   821	      ;; Build the final strings
   822	      (let ((orig-str (if original-lines
   823	                          (string-join (nreverse original-lines) "\n")
   824	                        ""))
   825	            (new-str (if new-lines
   826	                         (string-join (nreverse new-lines) "\n")
   827	                       "")))
   828	        ;; Add trailing newlines unless explicitly marked as having no newline
   829	        (unless (or orig-no-newline (string= orig-str ""))
   830	          (setq orig-str (concat orig-str "\n")))
   831	        (unless (or new-no-newline (string= new-str ""))
   832	          (setq new-str (concat new-str "\n")))
   833	        ;; Strip text properties to return clean strings
   834	        (cons (substring-no-properties orig-str)
   835	              (substring-no-properties new-str))))))
   836	
   837	(provide 'greger-parser)
   838	
   839	;;; greger-parser.el ends here

