  1235	
  1236	(defun greger--eval-code (language code)
  1237	  "Evaluate CODE in the specified LANGUAGE.
  1238	Returns the result as a string.
  1239	Raises an error if evaluation fails."
  1240	  (cond
  1241	   ((string= language "elisp")
  1242	    (greger--eval-elisp code))
  1243	   ((string= language "sh")
  1244	    (greger--eval-bash code))
  1245	   (t
  1246	    (error "Unsupported eval language: %s. Supported languages are: elisp (default) and sh (bash)"))))
  1247	
  1248	(defun greger--eval-elisp (code)
  1249	  "Evaluate Emacs Lisp CODE and return the result as a string."
  1250	  (condition-case err
  1251	      (let ((result (eval (read (format "(progn %s)" code)))))
  1252	        (substring-no-properties (format "%s" result)))
  1253	    (error
  1254	     (error "Elisp evaluation failed: %s" (error-message-string err)))))
  1255	
  1256	(defun greger--eval-bash (code)
  1257	  "Evaluate Bash CODE and return the result as a string."
  1258	  (let* ((process-name (format "greger-bash-eval-%s" (make-temp-name "")))
  1259	         (process-buffer (generate-new-buffer (format " *%s*" process-name)))
  1260	         (result nil)
  1261	         (error-msg nil)
  1262	         (process (let ((inhibit-message t))
  1263	                    (start-process process-name process-buffer "bash" "-c" code)))
  1264	         (exit-status nil))
  1265	    (unwind-protect
  1266	        (progn
  1267	          (set-process-query-on-exit-flag process nil)
  1268	          (set-process-sentinel process #'ignore)  ; Suppress process messages
  1269	          (while (process-live-p process)
  1270	            (accept-process-output process 0.1))
  1271	          (setq exit-status (process-exit-status process))
  1272	          (with-current-buffer process-buffer
  1273	            (let ((output (buffer-substring-no-properties (point-min) (point-max))))
  1274	              (if (= exit-status 0)
  1275	                  (setq result (if (string-empty-p output) "(no output)" output))
  1276	                (setq error-msg (format "Bash evaluation failed with exit code %d: %s" 
  1277	                                      exit-status output))))))
  1278	      (when (buffer-live-p process-buffer)
  1279	        (kill-buffer process-buffer)))
  1280	    (if error-msg
  1281	        (error "%s" error-msg)
  1282	      result)))
  1283	
  1284	(defun greger--process-evals ()
  1285	  "Process all eval blocks in current buffer according to greger eval semantics.
  1286	- Evaluate evals in system section every time
  1287	- Evaluate evals in current user section (last user section only)
  1288	- Replace eval blocks with eval results
  1289	- Raise errors if evaluation fails"
  1290	  ;; Process system sections
  1291	  (when-let* ((root-node (treesit-buffer-root-node))
  1292	              (system-nodes (treesit-query-capture root-node '((system) @system))))
  1293	    (dolist (capture system-nodes)
  1294	      (when (eq (car capture) 'system)
  1295	        (greger--process-evals-in-node (cdr capture) :clear-existing t))))
  1296	  
  1297	  ;; Get a FRESH root node after system processing
  1298	  ;; Process evals in the last user section only
  1299	  (when-let* ((fresh-root-node (treesit-buffer-root-node))
  1300	              (user-nodes (treesit-query-capture fresh-root-node '((user) @user)))
  1301	              (last-user-node (cdar (last user-nodes))))
  1302	    (greger--process-evals-in-node last-user-node :clear-existing t)))
  1303	
  1304	(cl-defun greger--process-evals-in-node (node &key clear-existing)
  1305	  "Process all eval blocks in NODE.
  1306	If CLEAR-EXISTING, clear any existing eval results."
  1307	  ;; Store the section's start and end positions (positions don't become outdated)
  1308	  (let ((section-start (treesit-node-start node))
  1309	        (section-end (treesit-node-end node))
  1310	        (next-search-pos (treesit-node-start node)))
  1311	    
  1312	    ;; Keep processing evals until we can't find any more
  1313	    (while (< next-search-pos section-end)
  1314	      ;; Get a fresh section node at the original position
  1315	      ;; The parser re-parses automatically after buffer modifications
  1316	      (let* ((fresh-section-node (treesit-node-on section-start section-end))
  1317	             ;; Find first eval at or after our search position
  1318	             (eval-node (treesit-search-subtree 
  1319	                        fresh-section-node
  1320	                        (lambda (n)
  1321	                          (and (string= (treesit-node-type n) "eval")
  1322	                               (>= (treesit-node-start n) next-search-pos))))))
  1323	        
  1324	        (if eval-node
  1325	            (progn
  1326	              (greger--process-single-eval eval-node :clear-existing clear-existing)
  1327	              ;; Move past this eval for next search
  1328	              (setq next-search-pos (1+ (treesit-node-end eval-node))))
  1329	          ;; No more evals found, exit loop
  1330	          (setq next-search-pos section-end))))))
  1331	
  1332	(cl-defun greger--process-single-eval (eval-node &key clear-existing)
  1333	  "Process a single eval block represented by EVAL-NODE.
  1334	If CLEAR-EXISTING, clear any existing eval results."
  1335	  (let* ((start-tag-node (treesit-search-subtree eval-node "eval_start_brace"))
  1336	         (end-tag-node (treesit-search-subtree eval-node "eval_end_brace"))
  1337	         (content-node (treesit-search-subtree eval-node "eval_content"))
  1338	         (language (greger--extract-eval-language start-tag-node))
  1339	         (code (treesit-node-text content-node t))
  1340	         (eval-id (greger--generate-eval-id))
  1341	         (result (greger--eval-code language (string-trim code)))
  1342	         (existing-result-node (treesit-search-subtree eval-node "eval_result"))
  1343	         (new-result-block (format "<eval-result-%s>%s</eval-result-%s>" eval-id result eval-id))
  1344	         (content-end (treesit-node-end content-node))
  1345	         (end-tag-start (treesit-node-start end-tag-node)))
  1346	
  1347	    (when (or clear-existing (not existing-result-node))
  1348	      (save-excursion
  1349	        (goto-char content-end)
  1350	        (delete-region content-end end-tag-start)
  1351	        (insert new-result-block)))))
  1352	
  1353	(defun greger--extract-eval-language (start-tag-node)
  1354	  "Extract language from eval start tag node, defaulting to elisp."
  1355	  (if start-tag-node
  1356	      (let ((language-node (treesit-search-subtree start-tag-node "language")))
  1357	        (if language-node
  1358	            (treesit-node-text language-node t)
  1359	          "elisp"))  ; default to elisp
  1360	    "elisp"))
