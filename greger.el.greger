  1252	  "Process all eval blocks in NODE.
  1253	If CLEAR-EXISTING, clear any existing eval results."
  1254	  (let ((eval-nodes (treesit-query-capture node '((eval) @eval))))
  1255	    ;; Process eval nodes in reverse order to avoid position shifts
  1256	    (dolist (capture (reverse eval-nodes))
  1257	      (when (eq (car capture) 'eval)
  1258	        (greger--process-single-eval (cdr capture) :clear-existing clear-existing)))))
