   221	                                                (description . "Timeout in seconds for command execution")
   222	                                                (default . 600)))
   223	                                    (enable-environment . ((type . "boolean")
   224	                                                           (description . "Whether to source shell initialization files (.bashrc, .bash_profile) which may contain secrets and environment variables. You want to use this whenever you run a command that interacts with the outside world, e.g. pulling git repositories, putting files on S3, etc.")
   225	                                                           (default . nil)))
   226	                                    (use-vterm . ((type . "boolean")
   227	                                                  (description . "Use vterm for full terminal emulation with colors and ANSI sequences. Falls back to regular subprocess if vterm is not available.")
   228	                                                  (default . nil))))
   229	                      :required '("command")
