        response = run_request("resolve-symbol", {
            "workspace_root": str(workspace),
            "symbol_path": "main.ts:createSampleUser",
        })
        result = response["result"]
        assert result["name"] == "createSampleUser"
        assert result["path"].endswith("main.ts")

